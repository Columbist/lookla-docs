index 0000000..f9ad593
--- /dev/null
+++ b/backend/tests/test_cf_ranges.py
@@ -0,0 +1,279 @@
+"""
+T-049: the Cloudflare range list must fail closed.
+
+Placed under `backend/tests/` deliberately. The module under test lives in
+`ops/cloudflare/`, but T-071 established that the only test gate proven to
+execute is the backend pytest job — and a validation guard that never runs is
+the same as no guard. It is loaded by path, the same way `test_test_gate.py`
+loads `scripts/check_test_gate.py`.
+
+Every case asserts the *rejecting* behaviour where rejection is correct. An
+allowlist validator that accepts everything looks identical to a working one
+right up until the day a truncated download takes the site offline.
+"""
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+_MODULE = (
+    Path(__file__).resolve().parents[2] / "ops" / "cloudflare" / "cf_ranges.py"
+)
+_spec = importlib.util.spec_from_file_location("cf_ranges", _MODULE)
+cf = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(cf)
+
+# The real published lists at the time of writing, used as positive controls.
+OFFICIAL_V4 = """173.245.48.0/20
+103.21.244.0/22
+103.22.200.0/22
+103.31.4.0/22
+141.101.64.0/18
+108.162.192.0/18
+190.93.240.0/20
+188.114.96.0/20
+197.234.240.0/22
+198.41.128.0/17
+162.158.0.0/15
+104.16.0.0/13
+104.24.0.0/14
+172.64.0.0/13
+131.0.72.0/22
+"""
+
+OFFICIAL_V6 = """2400:cb00::/32
+2606:4700::/32
+2803:f800::/32
+2405:b500::/32
+2405:8100::/32
+2a06:98c0::/29
+2c0f:f248::/32
+"""
+
+
+# ─────────────────────────── positive controls ───────────────────────────────
+
+
+def test_official_ipv4_list_validates():
+    out = cf.validate_ranges(OFFICIAL_V4, 4)
+    assert len(out) == 15
+    assert "104.16.0.0/13" in out
+
+
+def test_official_ipv6_list_validates():
+    out = cf.validate_ranges(OFFICIAL_V6, 6)
+    assert len(out) == 7
+    assert "2606:4700::/32" in out
+
+
+def test_output_is_deterministically_sorted():
+    # A snapshot diff must reflect a real change, not line-order noise.
+    shuffled = "\n".join(reversed(OFFICIAL_V4.strip().splitlines()))
+    assert cf.validate_ranges(shuffled, 4) == cf.validate_ranges(OFFICIAL_V4, 4)
+
+
+def test_surrounding_whitespace_is_normalised():
+    padded = "\n".join(f"  {line}  " for line in OFFICIAL_V4.strip().splitlines())
+    assert cf.validate_ranges(padded, 4) == cf.validate_ranges(OFFICIAL_V4, 4)
+
+
+def test_duplicates_are_removed_deterministically():
+    doubled = OFFICIAL_V4 + OFFICIAL_V4
+    assert cf.validate_ranges(doubled, 4) == cf.validate_ranges(OFFICIAL_V4, 4)
+
+
+# ───────────────────────────── fail-closed cases ─────────────────────────────
+
+
+@pytest.mark.parametrize("family", [4, 6])
+@pytest.mark.parametrize("raw", ["", "   ", "\n\n\n", None])
+def test_empty_response_is_rejected(raw, family):
+    # The case that matters most: an empty allowlist would either lock the edge
+    # out entirely or, applied naively, remove the control.
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(raw, family)
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        "<!DOCTYPE html><html><body>503 Service Unavailable</body></html>",
+        "<html><head><title>Attention Required</title></head></html>",
+        '{"error": "not found"}',
+        "[]",
+        "<?xml version='1.0'?><error/>",
+    ],
+)
+def test_markup_and_json_bodies_are_rejected(body):
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(body, 4)
+
+
+def test_ipv6_content_in_the_ipv4_list_is_rejected():
+    # Silently accepting this would drop every legitimate IPv4 edge request.
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(OFFICIAL_V4 + "2606:4700::/32\n", 4)
+
+
+def test_ipv4_content_in_the_ipv6_list_is_rejected():
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(OFFICIAL_V6 + "104.16.0.0/13\n", 6)
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "104.16.0.0/33",
+        "999.1.1.1/24",
+        "104.16.0.0/",
+        "/13",
+        "104.16.0.0-104.16.255.255",
+        "not-a-network",
+    ],
+)
+def test_invalid_cidr_is_rejected(bad):
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(OFFICIAL_V4 + bad + "\n", 4)
+
+
+def test_a_bare_address_without_a_prefix_is_rejected():
+    # The official endpoints return CIDRs; a bare address means the format
+    # changed, which is a reason to stop rather than guess an implied /32.
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(OFFICIAL_V4 + "104.16.0.1\n", 4)
+
+
+def test_a_network_with_host_bits_set_is_rejected():
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(OFFICIAL_V4 + "104.16.0.5/13\n", 4)
+
+
+def test_a_truncated_final_line_is_rejected():
+    # A partially delivered response is the realistic failure: the body simply
+    # stops mid-line, and the remaining text is not a valid CIDR.
+    truncated = OFFICIAL_V4.strip().rsplit("\n", 1)[0] + "\n131.0.7"
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(truncated, 4)
+
+
+def test_a_short_list_is_rejected_by_the_minimum_guard():
+    with pytest.raises(cf.RangeValidationError, match="at least"):
+        cf.validate_ranges("104.16.0.0/13\n172.64.0.0/13\n", 4)
+
+
+def test_an_implausibly_long_list_is_rejected_by_the_maximum_guard():
+    many = "\n".join(f"10.{i}.0.0/16" for i in range(cf.MAX_V4 + 5))
+    with pytest.raises(cf.RangeValidationError, match="maximum"):
+        cf.validate_ranges(many, 4)
+
+
+def test_an_unsupported_family_is_rejected():
+    with pytest.raises(cf.RangeValidationError):
+        cf.validate_ranges(OFFICIAL_V4, 5)
+
+
+# ──────────────────────── snapshot / fetch behaviour ─────────────────────────
+
+
+def _fetcher(mapping):
+    def fetch(url, timeout=15):
+        value = mapping[url]
+        if isinstance(value, Exception):
+            raise value
+        return value
+
+    return fetch
+
+
+def test_build_snapshot_records_counts_and_hashes():
+    snap = cf.build_snapshot(
+        _fetcher({cf.IPS_V4_URL: OFFICIAL_V4, cf.IPS_V6_URL: OFFICIAL_V6})
+    )
+    assert snap["counts"] == {"ipv4": 15, "ipv6": 7}
+    assert snap["sha256"]["ipv4"] == cf.sha256_of(OFFICIAL_V4)
+    assert snap["sha256"]["ipv6"] == cf.sha256_of(OFFICIAL_V6)
+    assert snap["retrieved_at_utc"].endswith("Z")
+
+
+def test_a_fetch_failure_aborts_before_any_snapshot_is_produced():
+    with pytest.raises(OSError):
+        cf.build_snapshot(
+            _fetcher({cf.IPS_V4_URL: OFFICIAL_V4, cf.IPS_V6_URL: OSError("connection reset")})
+        )
+
+
+def test_a_validation_failure_aborts_before_any_snapshot_is_produced():
+    with pytest.raises(cf.RangeValidationError):
+        cf.build_snapshot(_fetcher({cf.IPS_V4_URL: "", cf.IPS_V6_URL: OFFICIAL_V6}))
+
+
+def test_check_mode_never_writes_the_snapshot(tmp_path, monkeypatch):
+    # An operator running --check must not have production state changed under
+    # them, and a third party editing their published list must not become an
+    # automatic firewall change.
+    path = tmp_path / "snap.json"
+    good = cf.build_snapshot(
+        _fetcher({cf.IPS_V4_URL: OFFICIAL_V4, cf.IPS_V6_URL: OFFICIAL_V6})
+    )
+    path.write_text(json.dumps(good), encoding="utf-8")
+    before = path.read_bytes()
+
+    changed_v4 = OFFICIAL_V4 + "203.0.113.0/24\n"
+    monkeypatch.setattr(
+        cf, "fetch", _fetcher({cf.IPS_V4_URL: changed_v4, cf.IPS_V6_URL: OFFICIAL_V6})
+    )
+    rc = cf.main(["--snapshot", str(path), "--check"])
+    assert rc == 2, "a detected change must be reported with a distinct exit code"
+    assert path.read_bytes() == before, "check mode must not mutate the snapshot"
+
+
+def test_check_mode_reports_no_change_with_exit_zero(tmp_path, monkeypatch):
+    path = tmp_path / "snap.json"
+    good = cf.build_snapshot(
+        _fetcher({cf.IPS_V4_URL: OFFICIAL_V4, cf.IPS_V6_URL: OFFICIAL_V6})
+    )
+    path.write_text(json.dumps(good), encoding="utf-8")
+    monkeypatch.setattr(
+        cf, "fetch", _fetcher({cf.IPS_V4_URL: OFFICIAL_V4, cf.IPS_V6_URL: OFFICIAL_V6})
+    )
+    assert cf.main(["--snapshot", str(path), "--check"]) == 0
+
+
+def test_a_failed_fetch_leaves_the_stored_snapshot_untouched(tmp_path, monkeypatch):
+    path = tmp_path / "snap.json"
+    good = cf.build_snapshot(
+        _fetcher({cf.IPS_V4_URL: OFFICIAL_V4, cf.IPS_V6_URL: OFFICIAL_V6})
+    )
+    path.write_text(json.dumps(good), encoding="utf-8")
+    before = path.read_bytes()
+
+    def boom(*a, **k):
+        raise OSError("network unreachable")
+
+    monkeypatch.setattr(cf, "fetch", boom)
+    assert cf.main(["--snapshot", str(path), "--write"]) == 1
+    assert path.read_bytes() == before
+
+
+def test_load_snapshot_rejects_a_corrupted_file(tmp_path):
+    path = tmp_path / "snap.json"
+    path.write_text(json.dumps({"ipv4": [], "ipv6": []}), encoding="utf-8")
+    with pytest.raises(cf.RangeValidationError):
+        cf.load_snapshot(path)
+
+
+def test_diff_reports_additions_and_removals():
+    old = {"ipv4": ["104.16.0.0/13"], "ipv6": ["2606:4700::/32"]}
+    new = {"ipv4": ["172.64.0.0/13"], "ipv6": ["2606:4700::/32"]}
+    d = cf.diff_snapshots(old, new)
+    assert d["ipv4_added"] == ["172.64.0.0/13"]
+    assert d["ipv4_removed"] == ["104.16.0.0/13"]
+    assert d["ipv6_added"] == [] and d["ipv6_removed"] == []
+
+
+def test_diff_against_no_previous_snapshot_is_all_additions():
+    new = {"ipv4": ["104.16.0.0/13"], "ipv6": ["2606:4700::/32"]}
+    d = cf.diff_snapshots(None, new)
+    assert d["ipv4_added"] == ["104.16.0.0/13"]
+    assert d["ipv4_removed"] == []
diff --git a/backend/tests/test_t049_enforcement.py b/backend/tests/test_t049_enforcement.py
new file mode 100644
index 0000000..7440621
--- /dev/null
+++ b/backend/tests/test_t049_enforcement.py
@@ -0,0 +1,345 @@
+"""
+T-049: the enforcement layer must be provably scoped.
+
+Two things are being guarded here, and both have a specific failure in mind.
+
+The firewall rules must never widen beyond public TCP/80. Port 443 on this
+host carries a live VPN behind an SNI router, so a rule that reached it would
+disconnect real users; SSH is the operator's only way back in; and the
+unrelated public listeners found during inventory belong to a different
+ticket. "We meant port 80 only" is not evidence — these tests read the bytes
+that would reach the kernel.
+
+The nginx stream routing must send a Lookla SNI from a non-Cloudflare source
+to the reject path and nowhere else, while every non-Lookla path keeps the
+destination it had before, byte for byte.
+"""
+import importlib.util
+import json
+import re
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[2]
+
+
+def _load(name: str, relpath: str):
+    spec = importlib.util.spec_from_file_location(name, _ROOT / relpath)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+cf = _load("cf_ranges_t049", "ops/cloudflare/cf_ranges.py")
+fw = _load("firewall_t049", "ops/cloudflare/firewall.py")
+
+STREAM_CONF = (_ROOT / "ops" / "nginx" / "stream.d" / "port443.conf").read_text(
+    encoding="utf-8"
+)
+SNAPSHOT = json.loads(
+    (_ROOT / "ops" / "cloudflare" / "cloudflare-ranges.json").read_text(encoding="utf-8")
+)
+
+IFACE = "eth0"
+
+
+# ───────────────────────── generated geo includes ────────────────────────────
+
+
+def test_geo_include_contains_every_validated_ipv4_range():
+    rendered = cf.render_geo_include(SNAPSHOT, 4)
+    for cidr in SNAPSHOT["ipv4"]:
+        assert f"{cidr} 1;" in rendered
+    assert rendered.count(" 1;") == len(SNAPSHOT["ipv4"])
+
+
+def test_geo_include_contains_every_validated_ipv6_range():
+    rendered = cf.render_geo_include(SNAPSHOT, 6)
+    for cidr in SNAPSHOT["ipv6"]:
+        assert f"{cidr} 1;" in rendered
+    assert rendered.count(" 1;") == len(SNAPSHOT["ipv6"])
+
+
+def test_geo_include_never_contains_a_default_line():
+    # `default 0;` belongs in the reviewed stream config, not in a generated
+    # file: if generation ever emitted `default 1;` every source on the
+    # internet would be treated as Cloudflare.
+    for family in (4, 6):
+        rendered = cf.render_geo_include(SNAPSHOT, family)
+        assert "default" not in rendered
+        assert " 0;" not in rendered
+
+
+def test_geo_include_is_byte_stable_across_renders():
+    assert cf.render_geo_include(SNAPSHOT, 4) == cf.render_geo_include(SNAPSHOT, 4)
+
+
+def test_geo_rendering_revalidates_and_rejects_a_tampered_snapshot():
+    tampered = dict(SNAPSHOT, ipv4=["not-a-cidr"])
+    with pytest.raises(cf.RangeValidationError):
+        cf.render_geo_include(tampered, 4)
+
+
+def test_geo_rendering_rejects_an_emptied_snapshot():
+    with pytest.raises(cf.RangeValidationError):
+        cf.render_geo_include(dict(SNAPSHOT, ipv4=[]), 4)
+
+
+def test_atomic_write_reports_no_change_and_leaves_the_file_alone(tmp_path):
+    target = tmp_path / "cloudflare-v4.conf"
+    content = cf.render_geo_include(SNAPSHOT, 4)
+    assert cf.write_atomically(target, content) is True
+    stat_before = target.stat().st_mtime_ns
+    assert cf.write_atomically(target, content) is False, "unchanged content must not rewrite"
+    assert target.stat().st_mtime_ns == stat_before, "an unchanged file must not be touched"
+
+
+def test_atomic_write_leaves_no_temp_file_behind(tmp_path):
+    target = tmp_path / "cloudflare-v4.conf"
+    cf.write_atomically(target, cf.render_geo_include(SNAPSHOT, 4))
+    assert list(tmp_path.iterdir()) == [target]
+
+
+def test_a_failed_render_preserves_the_previous_include(tmp_path):
+    target = tmp_path / "cloudflare-v4.conf"
+    good = cf.render_geo_include(SNAPSHOT, 4)
+    cf.write_atomically(target, good)
+    with pytest.raises(cf.RangeValidationError):
+        cf.write_atomically(target, cf.render_geo_include(dict(SNAPSHOT, ipv4=[]), 4))
+    assert target.read_text(encoding="utf-8") == good
+
+
+def test_render_geo_cli_never_reaches_the_network(tmp_path, monkeypatch):
+    # The boot path must work from the stored snapshot with no connectivity;
+    # depending on a live download would leave the policy undefined offline.
+    def explode(*a, **k):
+        raise AssertionError("rendering must not fetch")
+
+    monkeypatch.setattr(cf, "fetch", explode)
+    monkeypatch.setattr(cf, "build_snapshot", explode)
+    snap = tmp_path / "snap.json"
+    snap.write_text(json.dumps(SNAPSHOT), encoding="utf-8")
+    out = tmp_path / "render"
+    assert cf.main(["--snapshot", str(snap), "--render-geo", str(out)]) == 0
+    assert (out / "cloudflare-v4.conf").is_file()
+    assert (out / "cloudflare-v6.conf").is_file()
+
+
+def test_render_geo_cli_fails_and_writes_nothing_when_the_snapshot_is_bad(tmp_path):
+    snap = tmp_path / "snap.json"
+    snap.write_text(json.dumps({"ipv4": [], "ipv6": []}), encoding="utf-8")
+    out = tmp_path / "render"
+    assert cf.main(["--snapshot", str(snap), "--render-geo", str(out)]) == 1
+    assert not (out / "cloudflare-v4.conf").exists()
+
+
+# ──────────────────────── firewall scope (port 80 only) ──────────────────────
+
+
+def _document():
+    return fw.build_restore_document(SNAPSHOT["ipv4"], IFACE)
+
+
+@pytest.mark.parametrize("port", [443, 22, 8888, 3997, 3998, 3999, 3000, 5432, 6379, 8001])
+def test_generated_rules_never_reference_a_forbidden_port(port):
+    doc = _document()
+    assert f"--dport {port}" not in doc
+    assert f"--sport {port}" not in doc
+
+
+def test_the_jump_is_the_only_place_a_port_appears_and_it_is_80():
+    jump = " ".join(fw.build_jump_rule(IFACE))
+    assert "--dport 80" in jump
+    ports = re.findall(r"--dport (\d+)", jump + " " + _document())
+    assert set(ports) == {"80"}
+
+
+@pytest.mark.parametrize("port", [443, 22, 8888, 3999])
+def test_building_a_jump_for_a_forbidden_port_is_refused(port):
+    # The guarantee is enforced in code, not only in review: 443 in particular
+    # would take the VPN down.
+    with pytest.raises(fw.FirewallScopeError):
+        fw.build_jump_rule(IFACE, port)
+
+
+def test_rules_are_scoped_to_the_external_interface():
+    assert f"-i {IFACE}" in " ".join(fw.build_jump_rule(IFACE))
+
+
+def test_docker_chains_are_never_referenced():
+    doc = _document()
+    assert "DOCKER" not in doc
+    with pytest.raises(fw.FirewallScopeError):
+        fw.assert_scope(doc.replace("-j DROP", "-j DOCKER-USER"))
+
+
+def test_only_the_owned_chain_is_populated():
+    doc = _document()
+    assert "-A INPUT" not in doc and "-A FORWARD" not in doc and "-A OUTPUT" not in doc
+    assert doc.count(f"-A {fw.CHAIN}") == len(SNAPSHOT["ipv4"]) + 2
+
+
+def test_established_traffic_returns_before_any_deny():
+    lines = fw.build_chain_rules(SNAPSHOT["ipv4"], IFACE)
+    assert "ESTABLISHED,RELATED" in lines[0] and "-j RETURN" in lines[0]
+    assert "-j DROP" in lines[-1], "the deny must be last, after every accept"
+
+
+def test_every_cloudflare_range_is_accepted():
+    doc = _document()
+    for cidr in SNAPSHOT["ipv4"]:
+        assert f"-s {cidr} " in doc
+
+
+def test_an_empty_allowlist_cannot_produce_a_chain():
+    # A truncated range list must not become "deny all public HTTP".
+    with pytest.raises(fw.FirewallScopeError):
+        fw.build_chain_rules([], IFACE)
+
+
+def test_ipv6_ranges_in_the_ipv4_rule_set_are_refused():
+    with pytest.raises(fw.FirewallScopeError):
+        fw.build_chain_rules(["2606:4700::/32"], IFACE)
+
+
+def test_scope_check_rejects_a_document_with_no_accept_or_no_deny():
+    doc = _document()
+    with pytest.raises(fw.FirewallScopeError, match="deny all"):
+        fw.assert_scope(doc.replace("-j ACCEPT", "-j RETURN"))
+    with pytest.raises(fw.FirewallScopeError, match="control would be absent"):
+        fw.assert_scope(doc.replace("-j DROP", "-j RETURN"))
+
+
+def test_the_transaction_is_a_single_atomic_restore_document():
+    doc = _document()
+    assert doc.startswith("*filter\n")
+    assert doc.rstrip().endswith("COMMIT")
+    # ":CHAIN - [0:0]" both creates and flushes inside the transaction, so the
+    # chain is replaced with no window in which it is empty.
+    assert f":{fw.CHAIN} - [0:0]" in doc
+    assert doc.count("COMMIT") == 1
+
+
+def test_reapplying_produces_an_identical_document():
+    assert _document() == _document()
+
+
+def test_the_jump_is_checked_before_being_inserted(monkeypatch):
+    # Idempotence: a second apply must not stack a duplicate INPUT jump.
+    calls = []
+
+    class R:
+        returncode = 0
+        stdout = ""
+        stderr = ""
+
+    def runner(argv, **kw):
+        calls.append(argv)
+        return R()
+
+    assert fw.jump_exists(IFACE, 80, runner=runner) is True
+    assert calls[0][:3] == ["iptables", "-C", "INPUT"]
+
+
+def test_dry_run_applies_nothing(monkeypatch, tmp_path, capsys):
+    snap = tmp_path / "snap.json"
+    snap.write_text(json.dumps(SNAPSHOT), encoding="utf-8")
+
+    def explode(*a, **k):
+        raise AssertionError("dry run must not execute firewall commands")
+
+    monkeypatch.setattr(fw, "_run", explode)
+    assert fw.main(["--interface", IFACE, "--snapshot", str(snap)]) == 0
+    assert "dry run — nothing applied" in capsys.readouterr().out
+
+
+# ─────────────────── nginx stream routing contract (static) ──────────────────
+
+
+def test_geo_block_defaults_to_not_cloudflare():
+    block = STREAM_CONF[STREAM_CONF.index("geo $lookla_cf_source") :]
+    block = block[: block.index("}")]
+    assert "default 0;" in block, "an unmatched source must never count as Cloudflare"
+    assert "default 1;" not in block
+
+
+def test_geo_block_includes_both_generated_files():
+    assert "include /etc/nginx/stream.d/cloudflare-v4.conf;" in STREAM_CONF
+    assert "include /etc/nginx/stream.d/cloudflare-v6.conf;" in STREAM_CONF
+
+
+def test_the_lookla_sni_list_is_exactly_the_pre_existing_one():
+    # Derived from the production stream map, not invented. Adding a hostname
+    # here would move it off the route it has today.
+    sni_map = STREAM_CONF[STREAM_CONF.index("map $ssl_preread_server_name") :]
+    sni_map = sni_map[: sni_map.index("}")]
+    web_hosts = re.findall(r"^\s*(\S+)\s+web;", sni_map, re.MULTILINE)
+    assert sorted(web_hosts) == ["lookla.gr", "www.lookla.gr"]
+
+
+def test_no_wildcard_or_regex_sni_matching_was_introduced():
+    sni_map = STREAM_CONF[STREAM_CONF.index("map $ssl_preread_server_name") :]
+    sni_map = sni_map[: sni_map.index("}")]
+    for token in ("*.", "~", "~*"):
+        assert token not in sni_map, f"unexpected wildcard/regex matching: {token}"
+
+
+def test_cdn_hostname_is_not_silently_rerouted():
+    # cdn.lookla.gr was not in the previous map; adding it would change its
+    # current destination as a side effect of this ticket.
+    sni_map = STREAM_CONF[STREAM_CONF.index("map $ssl_preread_server_name") :]
+    sni_map = sni_map[: sni_map.index("}")]
+    assert "cdn.lookla.gr" not in sni_map
+
+
+def _decision_map():
+    block = STREAM_CONF[STREAM_CONF.index('map "$lookla_sni_class:$lookla_cf_source"') :]
+    block = block[: block.index("}")]
+    return dict(re.findall(r'"?([\w:]+)"?\s+(127\.0\.0\.1:\d+);', block))
+
+
+@pytest.mark.parametrize(
+    "key,expected",
+    [
+        ("web:1", "127.0.0.1:8443"),   # Lookla SNI from Cloudflare → web
+        ("web:0", "127.0.0.1:9443"),   # Lookla SNI from elsewhere → reject
+        ("nosni:1", "127.0.0.1:8888"), # unchanged
+        ("nosni:0", "127.0.0.1:8888"), # unchanged
+        ("vpn:1", "127.0.0.1:4443"),   # unchanged
+        ("vpn:0", "127.0.0.1:4443"),   # unchanged
+        ("default", "127.0.0.1:4443"), # unchanged
+    ],
+)
+def test_the_routing_decision_matrix_is_exact(key, expected):
+    assert _decision_map().get(key) == expected
+
+
+def test_a_rejected_lookla_connection_can_reach_neither_backend():
+    decisions = _decision_map()
+    assert decisions["web:0"] != decisions["web:1"], "reject must not be the web upstream"
+    assert decisions["web:0"] != decisions["vpn:0"], "reject must not fall through to the VPN"
+    assert decisions["web:0"] != decisions["nosni:0"], "reject must not fall through to tinyproxy"
+
+
+def test_cloudflare_membership_alone_does_not_force_traffic_to_the_web_backend():
+    # A Cloudflare source with an unrelated SNI must still reach the VPN, or
+    # the allowlist would become a hostname-independent redirect.
+    assert _decision_map()["vpn:1"] == "127.0.0.1:4443"
+
+
+def test_the_reject_listener_exists_and_returns_nothing():
+    assert "listen 127.0.0.1:9443;" in STREAM_CONF
+    assert 'return "";' in STREAM_CONF
+
+
+def test_the_public_listener_keeps_ssl_preread_and_both_families():
+    server = STREAM_CONF[STREAM_CONF.index("    listen 443;") :]
+    assert "listen [::]:443;" in server
+    assert "ssl_preread           on;" in server
+    assert "proxy_pass            $lookla_upstream;" in server
+
+
+def test_the_vpn_upstream_port_is_never_changed():
+    assert "127.0.0.1:4443" in STREAM_CONF
+    assert STREAM_CONF.count("127.0.0.1:4443") >= 3, "all three VPN paths must remain"
