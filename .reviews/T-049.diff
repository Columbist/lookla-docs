--- /dev/null
+++ b/ops/cloudflare/cf_ranges.py
@@ -0,0 +1,333 @@
+#!/usr/bin/env python3
+"""
+T-049 — fetch and validate Cloudflare's official reverse-proxy IP ranges.
+
+This module is the only sanctioned source of the allowlist that will gate the
+origin's public web ports. Everything here is built to **fail closed**: the
+active allowlist is only ever replaced by a list that has been fully
+downloaded, parsed and sanity-checked. A truncated download, an HTML error
+page, a captive-portal interception or an empty response must leave the
+previous list in place, because the alternative — a firewall that silently
+falls back to an empty allowlist — takes the site off the internet, and one
+that falls back to "allow everything" quietly removes the control.
+
+Validation is deliberately separated from I/O so the rules can be tested
+without a network: `validate_ranges()` is pure.
+
+Official endpoints only (https://www.cloudflare.com/ips-v4, /ips-v6). Blog
+posts, gists, ASN expansion and remembered CIDRs are not acceptable sources —
+they go stale silently and there is no way to notice.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import ipaddress
+import json
+import sys
+import urllib.request
+from datetime import datetime, timezone
+from pathlib import Path
+
+IPS_V4_URL = "https://www.cloudflare.com/ips-v4"
+IPS_V6_URL = "https://www.cloudflare.com/ips-v6"
+
+# Plausibility bounds. Cloudflare has published ~15 IPv4 and ~7 IPv6 ranges for
+# years. The lower bound is the important one: it stops a truncated or partially
+# served response from shrinking the allowlist to something that would lock the
+# edge out. The upper bound catches a wrong endpoint or a merged product list
+# being fetched by mistake.
+MIN_V4, MAX_V4 = 5, 100
+MIN_V6, MAX_V6 = 3, 100
+
+
+class RangeValidationError(ValueError):
+    """Raised whenever a candidate list must not replace the active one."""
+
+
+def validate_ranges(raw: str, family: int) -> list[str]:
+    """
+    Parse and validate a raw Cloudflare range list.
+
+    Returns the normalised, de-duplicated, deterministically sorted CIDRs.
+    Raises `RangeValidationError` on anything that must not be applied.
+
+    `family` is 4 or 6 and is enforced: fetching the IPv6 list into the IPv4
+    set would produce a firewall that drops all legitimate IPv4 edge traffic.
+    """
+    if family not in (4, 6):
+        raise RangeValidationError(f"unsupported address family: {family!r}")
+
+    if raw is None or not raw.strip():
+        raise RangeValidationError("empty response — refusing to replace the active list")
+
+    # An error page, a captive portal or a redirect body parses as "lines" too,
+    # so reject markup before trying to read CIDRs out of it.
+    lowered = raw.lstrip()[:512].lower()
+    for marker in ("<!doctype", "<html", "<head", "<body", "<?xml", "{", "["):
+        if lowered.startswith(marker):
+            raise RangeValidationError(
+                "response looks like markup or JSON, not a plain CIDR list"
+            )
+
+    networks: list[ipaddress._BaseNetwork] = []
+    for lineno, line in enumerate(raw.splitlines(), start=1):
+        entry = line.strip()
+        if not entry:
+            continue
+        if entry.startswith("#"):
+            raise RangeValidationError(
+                f"line {lineno}: unexpected comment in an official list: {entry[:60]!r}"
+            )
+        if "/" not in entry:
+            # The official endpoints return CIDRs. A bare address means the
+            # format changed, which is a reason to stop and look, not to guess.
+            raise RangeValidationError(
+                f"line {lineno}: expected a CIDR, got {entry[:60]!r}"
+            )
+        try:
+            # strict=True: a network with host bits set (e.g. 1.2.3.4/24) means
+            # the list is not what we think it is.
+            net = ipaddress.ip_network(entry, strict=True)
+        except ValueError as exc:
+            raise RangeValidationError(f"line {lineno}: invalid CIDR {entry[:60]!r}: {exc}") from exc
+
+        if net.version != family:
+            raise RangeValidationError(
+                f"line {lineno}: expected IPv{family}, got IPv{net.version} ({entry})"
+            )
+        networks.append(net)
+
+    if not networks:
+        raise RangeValidationError("no ranges parsed — refusing to replace the active list")
+
+    # Deterministic de-duplication: sorting by network object orders by address
+    # then prefix length, so the same input always yields byte-identical output
+    # and a snapshot diff reflects a real change rather than ordering noise.
+    unique = sorted(set(networks))
+    count = len(unique)
+    lo, hi = (MIN_V4, MAX_V4) if family == 4 else (MIN_V6, MAX_V6)
+    if count < lo:
+        raise RangeValidationError(
+            f"only {count} IPv{family} range(s); expected at least {lo} — "
+            "a short list would lock the Cloudflare edge out of the origin"
+        )
+    if count > hi:
+        raise RangeValidationError(
+            f"{count} IPv{family} ranges exceeds the plausible maximum of {hi} — "
+            "wrong endpoint or a merged product list?"
+        )
+
+    return [str(n) for n in unique]
+
+
+def sha256_of(raw: str) -> str:
+    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
+
+
+def fetch(url: str, timeout: int = 15) -> str:
+    """
+    Fetch a range list over HTTPS.
+
+    Any failure propagates: the caller must treat it as "keep the current
+    snapshot", never as "apply an empty list".
+    """
+    request = urllib.request.Request(url, headers={"User-Agent": "lookla-t049/1.0"})
+    with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310
+        status = getattr(response, "status", None) or response.getcode()
+        if status != 200:
+            raise RangeValidationError(f"{url} returned HTTP {status}")
+        return response.read().decode("utf-8")
+
+
+def build_snapshot(fetcher=None) -> dict:
+    """
+    Fetch both families and return a validated, reviewable snapshot.
+
+    `fetcher` is resolved at call time rather than bound as a default, so tests
+    can substitute the transport without reaching into module internals.
+    """
+    fetcher = fetcher or fetch
+    raw_v4 = fetcher(IPS_V4_URL)
+    raw_v6 = fetcher(IPS_V6_URL)
+    v4 = validate_ranges(raw_v4, 4)
+    v6 = validate_ranges(raw_v6, 6)
+    return {
+        "retrieved_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "source": {"ipv4": IPS_V4_URL, "ipv6": IPS_V6_URL},
+        "sha256": {"ipv4": sha256_of(raw_v4), "ipv6": sha256_of(raw_v6)},
+        "counts": {"ipv4": len(v4), "ipv6": len(v6)},
+        "ipv4": v4,
+        "ipv6": v6,
+    }
+
+
+GEO_HEADER = (
+    "# Generated by ops/cloudflare/cf_ranges.py — do not edit by hand.\n"
+    "# Official Cloudflare {family} reverse-proxy ranges, snapshot {retrieved}.\n"
+    "# sha256({family_key}) = {digest}\n"
+)
+
+
+def render_geo_include(snapshot: dict, family: int) -> str:
+    """
+    Render an `ngx_stream_geo_module` include: one `<cidr> 1;` line per range.
+
+    The surrounding `geo` block supplies `default 0;`, so a source that matches
+    nothing is not Cloudflare. That default lives in the checked-in stream
+    config rather than here: if this generated file were ever truncated to
+    nothing, the result must be "no source is Cloudflare" — which closes the
+    web path — and never "every source is Cloudflare".
+
+    Re-validates the snapshot rather than trusting it, so a hand-edited or
+    corrupted JSON file cannot reach nginx.
+    """
+    key = "ipv4" if family == 4 else "ipv6"
+    ranges = validate_ranges("\n".join(snapshot.get(key, [])), family)
+    header = GEO_HEADER.format(
+        family=f"IPv{family}",
+        family_key=key,
+        retrieved=snapshot.get("retrieved_at_utc", "unknown"),
+        digest=snapshot.get("sha256", {}).get(key, "unknown"),
+    )
+    return header + "".join(f"{cidr} 1;\n" for cidr in ranges)
+
+
+def write_atomically(path: Path, content: str) -> bool:
+    """
+    Replace `path` with `content` via a same-directory temp file and `rename`.
+
+    Returns True when the file changed. An unchanged file is left completely
+    alone so nothing downstream mistakes a rewrite for a real update and
+    reloads nginx for no reason. `rename` within a directory is atomic, so a
+    reader never sees a half-written allowlist.
+    """
+    if path.is_file() and path.read_text(encoding="utf-8") == content:
+        return False
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    tmp.write_text(content, encoding="utf-8")
+    tmp.replace(path)
+    return True
+
+
+def load_snapshot(path: Path) -> dict:
+    """Load and re-validate a stored snapshot; a corrupted file must not apply."""
+    data = json.loads(path.read_text(encoding="utf-8"))
+    validate_ranges("\n".join(data.get("ipv4", [])), 4)
+    validate_ranges("\n".join(data.get("ipv6", [])), 6)
+    return data
+
+
+def diff_snapshots(old: dict | None, new: dict) -> dict[str, list[str]]:
+    """Report what an update would change, for review before anything is applied."""
+    result: dict[str, list[str]] = {}
+    for family in ("ipv4", "ipv6"):
+        before = set((old or {}).get(family, []))
+        after = set(new.get(family, []))
+        result[f"{family}_added"] = sorted(after - before)
+        result[f"{family}_removed"] = sorted(before - after)
+    return result
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--snapshot",
+        type=Path,
+        default=Path(__file__).with_name("cloudflare-ranges.json"),
+        help="path to the known-good snapshot",
+    )
+    parser.add_argument(
+        "--check",
+        action="store_true",
+        help="fetch and compare against the stored snapshot; never writes",
+    )
+    parser.add_argument(
+        "--write",
+        action="store_true",
+        help="fetch, validate and replace the stored snapshot",
+    )
+    parser.add_argument(
+        "--render-geo",
+        type=Path,
+        metavar="DIR",
+        help="render nginx stream geo includes from the stored snapshot into DIR "
+        "(no network access; exits non-zero if the snapshot is unusable)",
+    )
+    args = parser.parse_args(argv)
+
+    if args.render_geo:
+        # Rendering deliberately never fetches: the boot/apply path must work
+        # from the last validated snapshot even when the network is down,
+        # rather than leaving the policy undefined.
+        try:
+            snapshot = load_snapshot(args.snapshot)
+        except (RangeValidationError, ValueError, OSError) as exc:
+            print(f"FAIL: cannot render from {args.snapshot}: {exc}", file=sys.stderr)
+            print("previous includes are left in place", file=sys.stderr)
+            return 1
+        args.render_geo.mkdir(parents=True, exist_ok=True)
+        changed = []
+        for family, name in ((4, "cloudflare-v4.conf"), (6, "cloudflare-v6.conf")):
+            target = args.render_geo / name
+            if write_atomically(target, render_geo_include(snapshot, family)):
+                changed.append(name)
+        print(
+            f"rendered from snapshot {snapshot['retrieved_at_utc']} "
+            f"ipv4={snapshot['counts']['ipv4']} ipv6={snapshot['counts']['ipv6']}"
+        )
+        print("changed: " + (", ".join(changed) if changed else "nothing"))
+        return 0
+
+    current = None
+    if args.snapshot.is_file():
+        try:
+            current = load_snapshot(args.snapshot)
+        except (RangeValidationError, ValueError, OSError) as exc:
+            print(f"WARNING: stored snapshot is unusable: {exc}", file=sys.stderr)
+
+    if not (args.check or args.write):
+        if current is None:
+            print("no valid snapshot stored", file=sys.stderr)
+            return 1
+        print(
+            f"snapshot {args.snapshot}: retrieved {current['retrieved_at_utc']} "
+            f"ipv4={current['counts']['ipv4']} ipv6={current['counts']['ipv6']}"
+        )
+        return 0
+
+    try:
+        snapshot = build_snapshot()
+    except Exception as exc:  # noqa: BLE001 — any failure means "keep what we have"
+        print(f"FAIL: could not obtain a valid range list: {exc}", file=sys.stderr)
+        print("the stored snapshot is unchanged and remains authoritative", file=sys.stderr)
+        return 1
+
+    print(f"retrieved_at_utc : {snapshot['retrieved_at_utc']}")
+    print(f"ipv4  count={snapshot['counts']['ipv4']:<4} sha256={snapshot['sha256']['ipv4']}")
+    print(f"ipv6  count={snapshot['counts']['ipv6']:<4} sha256={snapshot['sha256']['ipv6']}")
+
+    changes = diff_snapshots(current, snapshot)
+    changed = any(changes.values())
+    if changed:
+        print("\nchanges against the stored snapshot:")
+        for key, values in changes.items():
+            for value in values:
+                print(f"  {key}: {value}")
+    else:
+        print("\nno change against the stored snapshot")
+
+    if args.check:
+        # Check mode never mutates. A change is reported, not applied: turning a
+        # third party's list edit into an automatic firewall change is an
+        # operational decision, not this script's to make.
+        return 2 if changed else 0
+
+    args.snapshot.write_text(json.dumps(snapshot, indent=2) + "\n", encoding="utf-8")
+    print(f"\nsnapshot written: {args.snapshot}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
