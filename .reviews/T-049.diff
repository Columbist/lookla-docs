+#!/usr/bin/env python3
+"""
+T-049 — restrict public TCP/80 on the Lookla origin to Cloudflare source ranges.
+
+Scope is deliberately narrow, and the reasons are worth stating because the
+obvious wider rule would break this host:
+
+  * **Port 80 only.** Port 443 on this host is a shared SNI-multiplexed
+    listener — Lookla web and a live Xray VLESS/REALITY VPN arrive on the same
+    socket. A packet filter cannot see SNI, so filtering 443 by source address
+    would terminate the VPN. That layer is handled in the nginx stream config
+    instead (ops/nginx/stream.d/port443.conf).
+  * **`INPUT`, not `DOCKER-USER`.** Ports 80/443 belong to host nginx, not to
+    a published container port. Every Docker-published port on this host is
+    bound to 127.0.0.1 and unreachable from outside, so the Docker forwarding
+    path is not involved and its generated chains are left alone.
+  * **A dedicated chain.** Everything T-049 owns lives in one named chain, so
+    the rules are identifiable, idempotent to reapply, and removable without
+    touching anything else in the filter table.
+
+Rule construction is a pure function so the scope guarantees — nothing on 443,
+nothing on 22, nothing on the unrelated public listeners — are testable
+without a firewall.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+CHAIN = "LOOKLA-CLOUDFLARE"
+COMMENT = "T-049 cloudflare origin allowlist"
+
+#: Ports this ticket is allowed to touch. 443 is excluded on purpose; see the
+#: module docstring. Anything not listed here must never appear in a rule.
+ALLOWED_PORTS = (80,)
+
+#: Ports that must never be matched, asserted rather than assumed: SSH, the
+#: shared 443 listener, and the unrelated public services found during the
+#: T-049 inventory (tinyproxy and three next-server processes), which belong
+#: to a separate ticket and must not be silently firewalled here.
+FORBIDDEN_PORTS = (22, 443, 3997, 3998, 3999, 5432, 6379, 8001, 8888, 3000)
+
+
+class FirewallScopeError(ValueError):
+    """Raised when a generated rule would exceed T-049's approved scope."""
+
+
+def build_chain_rules(ranges_v4: list[str], interface: str) -> list[str]:
+    """
+    Return the `iptables-restore` lines for T-049's chain.
+
+    Order matters: established traffic is preserved first so an in-flight
+    connection is never cut by a reload, then Cloudflare sources are accepted,
+    then everything else reaching port 80 on the public interface is dropped.
+    The chain is only ever entered for TCP/80 on `interface` (see
+    `build_jump_rule`), so the final DROP cannot affect anything else.
+    """
+    if not ranges_v4:
+        # Never emit a chain with no accept rules: it would deny all public
+        # HTTP, and it is exactly what a truncated range list would produce.
+        raise FirewallScopeError("refusing to build a chain with an empty allowlist")
+    if not interface or " " in interface:
+        raise FirewallScopeError(f"implausible interface name: {interface!r}")
+
+    lines = [
+        f"-A {CHAIN} -m conntrack --ctstate ESTABLISHED,RELATED "
+        f'-m comment --comment "{COMMENT} established" -j RETURN',
+    ]
+    for cidr in ranges_v4:
+        if ":" in cidr:
+            raise FirewallScopeError(f"IPv6 range in the IPv4 rule set: {cidr}")
+        lines.append(
+            f"-A {CHAIN} -s {cidr} "
+            f'-m comment --comment "{COMMENT} accept" -j ACCEPT'
+        )
+    lines.append(
+        f'-A {CHAIN} -m comment --comment "{COMMENT} deny" -j DROP'
+    )
+    return lines
+
+
+def build_jump_rule(interface: str, port: int = 80) -> list[str]:
+    """
+    Return the argv that sends new public traffic for `port` into T-049's chain.
+
+    This is the only place a port number enters the rule set, and it is checked
+    against the approved list here so a future edit cannot quietly widen the
+    ticket's blast radius.
+    """
+    if port not in ALLOWED_PORTS:
+        raise FirewallScopeError(
+            f"port {port} is outside T-049's approved scope {ALLOWED_PORTS}"
+        )
+    if port in FORBIDDEN_PORTS:
+        raise FirewallScopeError(f"port {port} must never be filtered by T-049")
+    return [
+        "-i", interface,
+        "-p", "tcp",
+        "--dport", str(port),
+        "-m", "comment", "--comment", f"{COMMENT} jump",
+        "-j", CHAIN,
+    ]
+
+
+def build_restore_document(ranges_v4: list[str], interface: str) -> str:
+    """
+    Build a complete `iptables-restore --noflush` transaction for the chain.
+
+    `:CHAIN - [0:0]` creates the chain if absent and flushes it if present, and
+    `iptables-restore` applies the whole document as one transaction — so the
+    chain is replaced atomically. There is no window in which it is empty and
+    therefore no momentary allow-all, and an interrupted run leaves the
+    previous rules in force. `--noflush` keeps every other chain, including
+    Docker's, untouched.
+    """
+    body = "\n".join(build_chain_rules(ranges_v4, interface))
+    return f"*filter\n:{CHAIN} - [0:0]\n{body}\nCOMMIT\n"
+
+
+def assert_scope(document: str) -> None:
+    """
+    Fail loudly if a generated document strays outside the approved scope.
+
+    Called before anything is applied. The checks are deliberately literal:
+    they are the difference between "we intended port 80 only" and "we know
+    the bytes about to reach the kernel mention no other port".
+    """
+    for port in FORBIDDEN_PORTS:
+        for needle in (f"--dport {port}", f"--sport {port}", f"dpt:{port}"):
+            if needle in document:
+                raise FirewallScopeError(
+                    f"generated rules reference forbidden port {port}: {needle!r}"
+                )
+    if "DOCKER" in document:
+        raise FirewallScopeError("generated rules must not reference Docker chains")
+    if "-A INPUT" in document or "-A FORWARD" in document or "-A OUTPUT" in document:
+        raise FirewallScopeError(
+            "generated rules must only populate T-049's own chain"
+        )
+    if "-j ACCEPT" not in document:
+        raise FirewallScopeError("no accept rule present — this would deny all HTTP")
+    if "-j DROP" not in document:
+        raise FirewallScopeError("no deny rule present — the control would be absent")
+
+
+def _run(argv: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(  # noqa: S603
+        argv, input=input_text, capture_output=True, text=True, check=False
+    )
+
+
+def jump_exists(interface: str, port: int, runner=_run) -> bool:
+    result = runner(["iptables", "-C", "INPUT", *build_jump_rule(interface, port)])
+    return result.returncode == 0
+
+
+def current_chain(runner=_run) -> str | None:
+    """Return the chain's current rules, or None when the chain does not exist."""
+    result = runner(["iptables", "-S", CHAIN])
+    return result.stdout if result.returncode == 0 else None
+
+
+def load_ranges(snapshot_path: Path) -> list[str]:
+    data = json.loads(snapshot_path.read_text(encoding="utf-8"))
+    ranges = data.get("ipv4") or []
+    if not ranges:
+        raise FirewallScopeError(f"{snapshot_path} contains no IPv4 ranges")
+    return ranges
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--interface", required=True)
+    parser.add_argument(
+        "--snapshot",
+        type=Path,
+        default=Path(__file__).with_name("cloudflare-ranges.json"),
+    )
+    parser.add_argument(
+        "--apply",
+        action="store_true",
+        help="apply the rules; without it the transaction is only printed",
+    )
+    args = parser.parse_args(argv)
+
+    try:
+        ranges = load_ranges(args.snapshot)
+        document = build_restore_document(ranges, args.interface)
+        assert_scope(document)
+    except (FirewallScopeError, ValueError, OSError) as exc:
+        print(f"FAIL: {exc}", file=sys.stderr)
+        return 1
+
+    print(f"# {len(ranges)} Cloudflare IPv4 ranges, interface {args.interface}")
+    if not args.apply:
+        print(document, end="")
+        print(f"# jump: iptables -I INPUT 1 {' '.join(build_jump_rule(args.interface))}")
+        print("# dry run — nothing applied")
+        return 0
+
+    restore = _run(["iptables-restore", "--noflush"], input_text=document)
+    if restore.returncode != 0:
+        print(f"FAIL: iptables-restore: {restore.stderr.strip()}", file=sys.stderr)
+        return 1
+
+    # The jump is inserted only after the chain is populated, so the chain is
+    # never reachable while empty.
+    if not jump_exists(args.interface, 80):
+        insert = _run(["iptables", "-I", "INPUT", "1", *build_jump_rule(args.interface)])
+        if insert.returncode != 0:
+            print(f"FAIL: could not install jump: {insert.stderr.strip()}", file=sys.stderr)
+            return 1
+        print("jump installed in INPUT")
+    else:
+        print("jump already present — idempotent, not duplicated")
+
+    print("applied")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/ops/cloudflare/t049-origin-allowlist.service b/ops/cloudflare/t049-origin-allowlist.service
new file mode 100644
index 0000000..c3b5cb0
--- /dev/null
+++ b/ops/cloudflare/t049-origin-allowlist.service
@@ -0,0 +1,41 @@
+# T-049 — reinstate the port-80 Cloudflare allowlist after a reboot.
+#
+# Ordering: after the network is up so the interface exists, and after Docker,
+# because Docker rebuilds its own chains on start and this unit must not race
+# it. It touches only T-049's own chain either way, but running afterwards
+# keeps the INPUT jump above nothing surprising.
+#
+# The unit deliberately does NOT fetch ranges. It applies the last validated
+# snapshot from disk, so a boot with no connectivity still restores the policy
+# instead of leaving the origin open while a download times out. Updating the
+# snapshot is a separate, reviewed action.
+#
+# Install:
+#   cp t049-origin-allowlist.service /etc/systemd/system/
+#   systemctl daemon-reload && systemctl enable t049-origin-allowlist.service
+#
+# The nginx half needs no unit: its configuration lives in /etc/nginx and is
+# loaded by nginx itself at boot.
+
+[Unit]
+Description=T-049 Cloudflare origin allowlist (public TCP/80)
+After=network-online.target docker.service
+Wants=network-online.target
+# Without this the unit can run before Docker has built its chains, which is
+# harmless for our own chain but makes the resulting rule order confusing.
+PartOf=docker.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# Idempotent by construction: the chain is rebuilt in one atomic transaction
+# and the INPUT jump is only inserted when absent, so repeated starts and a
+# daemon-reload cannot stack duplicate rules.
+ExecStart=/usr/bin/python3 /opt/t049/firewall.py --interface eth0 --snapshot /opt/t049/cloudflare-ranges.json --apply
+# A failure must be loud and must not leave a half-applied policy; the atomic
+# restore means the previous chain is still in force if this exits non-zero.
+StandardOutput=journal
+StandardError=journal
+
+[Install]
+WantedBy=multi-user.target
diff --git a/ops/cloudflare/verify_routing.py b/ops/cloudflare/verify_routing.py
new file mode 100755
index 0000000..1abfbc0
--- /dev/null
+++ b/ops/cloudflare/verify_routing.py
@@ -0,0 +1,202 @@
+#!/usr/bin/env python3
+"""
+T-049 — prove the SNI/source routing matrix against a real nginx.
+
+Static inspection of the config is not evidence: `map` precedence, the phase
+in which `$ssl_preread_server_name` becomes available, and how an unmatched
+key falls through are all things nginx decides, not the reader. This starts a
+throwaway nginx with the production routing logic, points its upstreams at
+marker listeners, and drives every cell of the matrix.
+
+Source addresses are varied using 127.0.0.0/8, all of which the kernel already
+routes to loopback — no interface is created or modified, and the host
+firewall is never touched. One loopback address stands in for "a Cloudflare
+range", another for "an ordinary public source".
+
+Run as root only because nginx wants it for the pid file; nothing outside the
+temp prefix is written.
+"""
+
+from __future__ import annotations
+
+import socket
+import ssl
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+MODULE = "/usr/lib/nginx/modules/ngx_stream_module.so"
+FRONT = 19999          # stands in for public :443
+WEB, VPN, NOSNI = 19443, 19444, 18888
+REJECT = 19445
+CF_SOURCE = "127.0.0.2"       # inside the simulated Cloudflare set
+OTHER_SOURCE = "127.0.0.3"    # an ordinary public source
+
+CONF = f"""
+load_module {MODULE};
+events {{ worker_connections 64; }}
+error_log {{prefix}}/logs/error.log warn;
+pid {{prefix}}/logs/nginx.pid;
+stream {{
+    geo $lookla_cf_source {{
+        default 0;
+        include {{prefix}}/conf/cloudflare-v4.conf;
+    }}
+    map $ssl_preread_server_name $lookla_sni_class {{
+        lookla.gr        web;
+        www.lookla.gr    web;
+        ""               nosni;
+        default          vpn;
+    }}
+    map "$lookla_sni_class:$lookla_cf_source" $lookla_upstream {{
+        "web:1"      127.0.0.1:{WEB};
+        "web:0"      127.0.0.1:{REJECT};
+        "nosni:1"    127.0.0.1:{NOSNI};
+        "nosni:0"    127.0.0.1:{NOSNI};
+        "vpn:1"      127.0.0.1:{VPN};
+        "vpn:0"      127.0.0.1:{VPN};
+        default      127.0.0.1:{VPN};
+    }}
+    server {{
+        listen 127.0.0.1:{FRONT};
+        proxy_pass            $lookla_upstream;
+        proxy_connect_timeout 5s;
+        ssl_preread           on;
+    }}
+    server {{
+        listen 127.0.0.1:{REJECT};
+        return "";
+    }}
+}}
+"""
+
+hits: dict[int, int] = {}
+lock = threading.Lock()
+
+
+def marker_listener(port: int, stop: threading.Event) -> None:
+    srv = socket.socket()
+    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    srv.bind(("127.0.0.1", port))
+    srv.listen(16)
+    srv.settimeout(0.3)
+    while not stop.is_set():
+        try:
+            conn, _ = srv.accept()
+        except socket.timeout:
+            continue
+        with lock:
+            hits[port] = hits.get(port, 0) + 1
+        conn.close()
+    srv.close()
+
+
+def probe(source: str, sni: str | None) -> None:
+    """Open a TLS ClientHello from `source` with `sni`; the handshake may fail."""
+    sock = socket.socket()
+    sock.settimeout(4)
+    sock.bind((source, 0))
+    try:
+        sock.connect(("127.0.0.1", FRONT))
+    except OSError:
+        sock.close()
+        return
+    if sni is None:
+        # No SNI at all: a bare TLS 1.0 ClientHello with no extensions.
+        sock.sendall(bytes.fromhex(
+            "160301002c010000280301" + "00" * 32 + "000002002f0100"
+        ))
+        time.sleep(0.4)
+        sock.close()
+        return
+    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+    ctx.check_hostname = False
+    ctx.verify_mode = ssl.CERT_NONE
+    try:
+        wrapped = ctx.wrap_socket(sock, server_hostname=sni)
+        wrapped.close()
+    except (ssl.SSLError, OSError):
+        pass
+    finally:
+        try:
+            sock.close()
+        except OSError:
+            pass
+    time.sleep(0.3)
+
+
+def main() -> int:
+    prefix = Path(tempfile.mkdtemp(prefix="t049-verify-"))
+    (prefix / "logs").mkdir()
+    (prefix / "conf").mkdir()
+    # The simulated Cloudflare membership file, same shape as the generated one.
+    (prefix / "conf" / "cloudflare-v4.conf").write_text(f"{CF_SOURCE}/32 1;\n")
+    conf_path = prefix / "conf" / "nginx.conf"
+    conf_path.write_text(CONF.replace("{prefix}", str(prefix)))
+
+    test = subprocess.run(  # noqa: S603
+        ["nginx", "-t", "-p", str(prefix), "-c", str(conf_path)],
+        capture_output=True, text=True,
+    )
+    if test.returncode != 0:
+        print(test.stderr)
+        return 1
+    print("nginx -t: ok")
+
+    stop = threading.Event()
+    threads = [
+        threading.Thread(target=marker_listener, args=(p, stop), daemon=True)
+        for p in (WEB, VPN, NOSNI)
+    ]
+    for t in threads:
+        t.start()
+    time.sleep(0.4)
+
+    subprocess.run(  # noqa: S603
+        ["nginx", "-p", str(prefix), "-c", str(conf_path)], check=True
+    )
+    time.sleep(0.6)
+
+    names = {WEB: "web", VPN: "xray", NOSNI: "tinyproxy", None: "reject/none"}
+    cases = [
+        ("Cloudflare source + Lookla SNI",      CF_SOURCE,    "lookla.gr",     WEB),
+        ("Cloudflare source + www Lookla SNI",  CF_SOURCE,    "www.lookla.gr", WEB),
+        ("ordinary source + Lookla SNI",        OTHER_SOURCE, "lookla.gr",     None),
+        ("ordinary source + www Lookla SNI",    OTHER_SOURCE, "www.lookla.gr", None),
+        ("ordinary source + VPN/default SNI",   OTHER_SOURCE, "amazon.com",    VPN),
+        ("Cloudflare source + non-Lookla SNI",  CF_SOURCE,    "amazon.com",    VPN),
+        ("ordinary source + unknown SNI",       OTHER_SOURCE, "example.net",   VPN),
+        ("ordinary source + empty SNI",         OTHER_SOURCE, None,            NOSNI),
+    ]
+
+    print(f"\n{'case':38} {'expected':12} {'observed':12} result")
+    ok = True
+    for label, source, sni, expected in cases:
+        with lock:
+            hits.clear()
+        probe(source, sni)
+        time.sleep(0.3)
+        with lock:
+            observed = dict(hits)
+        got = next(iter(observed), None)
+        passed = got == expected
+        ok &= passed
+        print(
+            f"{label:38} {names[expected]:12} {names.get(got, str(got)):12} "
+            f"{'PASS' if passed else 'FAIL'}"
+        )
+
+    subprocess.run(  # noqa: S603
+        ["nginx", "-p", str(prefix), "-c", str(conf_path), "-s", "quit"], check=False
+    )
+    stop.set()
+    time.sleep(0.6)
+    print("\nRESULT:", "PASS" if ok else "FAIL")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/ops/nginx/stream.d/port443.conf b/ops/nginx/stream.d/port443.conf
new file mode 100644
index 0000000..8905922
--- /dev/null
+++ b/ops/nginx/stream.d/port443.conf
@@ -0,0 +1,78 @@
+# T-049 — SNI-aware Cloudflare gate for the shared public :443 listener.
+#
+# This file REPLACES the previous /etc/nginx/stream.d/port443.conf. Deploy it
+# with ops/cloudflare/apply_t049.sh, never by hand — the geo includes it
+# depends on are generated from a validated snapshot and must exist first.
+#
+# Why this is not a firewall rule. Port 443 on this host is not "the Lookla
+# port": it is a multiplexed listener. The previous configuration routed
+# lookla.gr / www.lookla.gr to the web vhost on 127.0.0.1:8443, an empty SNI
+# to tinyproxy, and *everything else* to the Xray VLESS/REALITY VPN on
+# 127.0.0.1:4443 — which serves real clients from ordinary residential
+# addresses. A packet filter sees address and port but not SNI, so an
+# allowlist on TCP/443 would take the VPN down with the web. The gate
+# therefore has to live where SNI is visible.
+#
+# `ssl_preread` reads the SNI out of the TLS ClientHello without terminating
+# TLS, so this decision happens before any HTTP exists and trusts no header —
+# CF-Connecting-IP and X-Forwarded-For are irrelevant here, as they must be.
+#
+# Note on phases: nginx's stream access phase runs BEFORE the preread phase,
+# so `allow`/`deny` cannot see $ssl_preread_server_name. Enforcement is
+# therefore a routing decision in the content phase, not an access rule.
+
+# Is the connection's source one of Cloudflare's published proxy ranges?
+#
+# `default 0` is the load-bearing line and lives here, in the reviewed file,
+# rather than in the generated includes: if a generated include were ever
+# empty or truncated, the result must be "nobody is Cloudflare" — which closes
+# the web path — and never "everybody is Cloudflare".
+geo $lookla_cf_source {
+    default 0;
+    include /etc/nginx/stream.d/cloudflare-v4.conf;
+    include /etc/nginx/stream.d/cloudflare-v6.conf;
+}
+
+# Classify the SNI. The hostname list is exactly the set the previous
+# configuration routed to the web upstream — no wildcard is introduced.
+# cdn.lookla.gr is deliberately absent: it was not in the previous map either,
+# it is served from R2 through Cloudflare, and adding it here would silently
+# move it off the VPN default it currently follows.
+map $ssl_preread_server_name $lookla_sni_class {
+    lookla.gr        web;
+    www.lookla.gr    web;
+    ""               nosni;
+    default          vpn;
+}
+
+# The three-way decision. Only the web class is gated on source; every other
+# class keeps its previous destination byte for byte, so no VPN path changes.
+map "$lookla_sni_class:$lookla_cf_source" $lookla_upstream {
+    "web:1"      127.0.0.1:8443;   # Lookla SNI from Cloudflare → web vhost
+    "web:0"      127.0.0.1:9443;   # Lookla SNI from anywhere else → reject
+    "nosni:1"    127.0.0.1:8888;   # unchanged: no SNI → tinyproxy
+    "nosni:0"    127.0.0.1:8888;   # unchanged
+    "vpn:1"      127.0.0.1:4443;   # unchanged: Cloudflare source, other SNI
+    "vpn:0"      127.0.0.1:4443;   # unchanged: the VPN's normal path
+    default      127.0.0.1:4443;   # unchanged fallback
+}
+
+server {
+    listen 443;
+    listen [::]:443;
+    proxy_pass            $lookla_upstream;
+    proxy_connect_timeout 10s;
+    ssl_preread           on;
+}
+
+# Dedicated reject path for a Lookla SNI arriving from a non-Cloudflare
+# source. A real listener rather than an unreachable address: pointing
+# proxy_pass at a dead port produces connection-refused churn and error-log
+# noise, and its behaviour is an accident of the kernel rather than something
+# stated. `return ""` sends nothing and closes, so the client completes no TLS
+# handshake, sees no certificate, receives no application response, and never
+# reaches either the web or the VPN backend.
+server {
+    listen 127.0.0.1:9443;
+    return "";
+}
