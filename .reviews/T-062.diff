+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'SearchBar.tsx'), 'utf-8');
+
+describe('T-062: SearchBar — form semantics preserved', () => {
+  test('is a real <form role="search"> with a single onSubmit handler', () => {
+    assert.ok(source.includes('role="search"'));
+    assert.ok(source.includes('onSubmit={handleSearch}'));
+  });
+
+  test('input has a real, associated accessible label (not just a placeholder)', () => {
+    assert.ok(source.includes('htmlFor="homepage-search-input"'));
+    assert.ok(source.includes('id="homepage-search-input"'));
+    assert.ok(source.includes('className="sr-only"'));
+  });
+
+  test('submit button has an accessible name via aria-label', () => {
+    assert.ok(/aria-label=\{tHome\('search_button'\)\}/.test(source));
+  });
+
+  test('Enter submits exactly once: native form submit, no duplicate keydown handler', () => {
+    assert.ok(!/onKeyDown/.test(source), 'no extra keydown handler that could double-fire alongside native Enter-submits-form behaviour');
+    const submitCount = (source.match(/handleSearch/g) || []).length;
+    assert.equal(submitCount, 2, 'handleSearch should be defined once and wired once (onSubmit) — not duplicated');
+  });
+
+  test('button submits via type="submit" (no separate onClick handler that could double-navigate)', () => {
+    assert.ok(source.includes('type="submit"'));
+    assert.ok(!/button[\s\S]{0,150}onClick/.test(source.slice(source.indexOf('<button'))), 'the submit button must not also carry an onClick — the native submit event is the only trigger');
+  });
+
+  test('URL contract unchanged: same locale-aware /search?q= path, same encodeURIComponent', () => {
+    assert.ok(source.includes("const path = locale === 'el' ? '/search' : `/${locale}/search`;"));
+    assert.ok(source.includes('router.push(`${path}?q=${encodeURIComponent(q)}`)'));
+  });
+
+  test('320px overflow fix: input carries min-w-0 so it can actually shrink inside the flex row', () => {
+    const inputBlock = source.slice(source.indexOf('<input'), source.indexOf('/>', source.indexOf('<input')));
+    assert.ok(/className="[^"]*\bmin-w-0\b/.test(inputBlock), 'input must have min-w-0 — flexbox default min-width:auto is the root cause of the 320px overflow');
+    assert.ok(/className="[^"]*\bflex-1\b/.test(inputBlock));
+  });
+
+  test('submit button is shrink-0 (fixed, non-collapsing) so it never gets crushed by the shrinking input', () => {
+    const buttonBlock = source.slice(source.indexOf('<button'), source.indexOf('</button>'));
+    assert.ok(/shrink-0/.test(buttonBlock));
+  });
+
+  test('touch targets: input and button both carry min-h-[44px]', () => {
+    assert.equal((source.match(/min-h-\[44px\]/g) || []).length, 2);
+  });
+
+  test('uses the Lucide Search icon via the shared Icon component, not an emoji', () => {
+    assert.ok(source.includes("import { Search } from 'lucide-react';"));
+    assert.ok(source.includes("import Icon from '@/components/ui/Icon';"));
+    assert.ok(source.includes('<Icon icon={Search}'));
+    assert.ok(!/🔍/.test(source), 'the old magnifying-glass emoji must be fully removed');
+  });
+
+  test('no autocomplete/suggestions were added (no datalist, no suggestion state, no debounced fetch)', () => {
+    assert.ok(!/datalist|suggestion|autocomplete=/i.test(source));
+  });
+
+  test('no trackEvent call — no new analytics event, no raw query sent to analytics', () => {
+    assert.ok(!source.includes('trackEvent'));
+    assert.ok(!source.includes("from '@/lib/analytics'"));
+  });
+
+  test('uses Direction B tokens, not the legacy pink-600/gray palette', () => {
+    assert.ok(!source.includes('pink-600'));
+    assert.ok(!source.includes('gray-200'));
+    assert.ok(source.includes('bg-brand'));
+    assert.ok(source.includes('border-border'));
+    assert.ok(source.includes('focus-ring-token'));
+  });
+});
