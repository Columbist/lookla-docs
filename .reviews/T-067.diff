+    const offenders = IN_SCOPE.filter(f => EMOJI.test(codeOnly(read(f))));
+    assert.deepEqual(offenders, [], `emoji remain in: ${JSON.stringify(offenders)}`);
+  });
+
+  test('the rating filter keeps ★ inside <option> — an HTML constraint, not missed work', () => {
+    // <option> may contain text only; an SVG icon cannot be nested inside
