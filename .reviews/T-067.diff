+      'a root not-found.tsx now exists — update the T-067 reachability note and verify which 404 users actually see',
+    );
+  });
+
+  test('carries no legacy palette utilities', () => {
+    const found = codeOnly(read(src)).match(LEGACY_COLOR) ?? [];
+    assert.deepEqual(found, [], `legacy colours remain: ${JSON.stringify(found)}`);
+  });
+
+  test('uses an icon rather than an emoji', () => {
+    const code = codeOnly(read(src));
+    assert.ok(!/💇/.test(code), 'emoji must be replaced by a Lucide icon');
+    assert.ok(code.includes('<Icon icon={Scissors}'), 'must render the shared Icon wrapper');
+  });
+
+  test('the home link has a visible focus ring', () => {
+    assert.ok(codeOnly(read(src)).includes('focus-ring-token'));
+  });
+});
+
+describe('T-067: cross-surface sweep — conversion-facing surfaces stay clean', () => {
+  // The Visual Baseline v1 phase scope: the conversion funnel plus the
+  // shared chrome and legal/consent surfaces. Auth/dashboard/admin are a
+  // separate, larger surface deliberately outside this phase (recorded in
