@@ -0,0 +1,334 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * T-067 — Visual Baseline Consistency & Beta Baseline Verification.
+ *
+ * Covers the final consistency pass: cookie-consent UI, legal pages,
+ * remaining shared surfaces, and the test-coverage guard that keeps this
+ * baseline honest going forward.
+ */
+
+const read = (p: string) => readFileSync(p, 'utf8');
+
+/** Strips comments so assertions never match a component's own prose. */
+const codeOnly = (s: string) =>
+  s.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '').replace(/\{\/\*[\s\S]*?\*\/\}/g, '');
+
+const readMessages = (locale: string) =>
+  JSON.parse(read(`messages/${locale}.json`)) as Record<string, Record<string, string>>;
+
+const LOCALES = ['el', 'en', 'ru', 'uk'] as const;
+
+/** Legacy palette utilities that Direction B replaced. */
+const LEGACY_COLOR =
+  /\b(?:bg|text|border|ring|accent|from|to|via|divide|placeholder)-(?:gray|pink|white|black|blue|green|red|purple|slate|zinc|neutral|amber|yellow|indigo)(?:-\d{2,3})?\b/g;
+
+describe('T-067: test coverage guard — CI must run every test file on disk', () => {
+  // Regression guard for a real gap this ticket found: `npm test` had a
+  // hardcoded 38-file list while 45 test files existed, so every visual
+  // suite added by T-062/T-064/T-065/T-066 had never run in CI. The fix
+  // was file discovery; this test stops the list-based form coming back.
+  test('npm test uses filesystem discovery, not a hardcoded file enumeration', () => {
+    const pkg = JSON.parse(read('package.json'));
+    const script: string = pkg.scripts.test;
+
+    assert.ok(/\bfind\b/.test(script), 'test script must discover test files from the filesystem');
+
+    const hardcoded = script.match(/[\w[\]/.-]+\.test\.tsx?/g) ?? [];
+    assert.equal(
+      hardcoded.length,
+      0,
+      `test script must not enumerate individual test files (found ${JSON.stringify(hardcoded)}) — ` +
+        'a hardcoded list silently drops newly added suites from CI',
+    );
+  });
+
+  test('discovery pattern covers both .test.ts and .test.tsx', () => {
+    const script: string = JSON.parse(read('package.json')).scripts.test;
+    assert.ok(script.includes("*.test.ts'"), 'must match .test.ts');
+    assert.ok(script.includes("*.test.tsx'"), 'must match .test.tsx');
+  });
+
+  test('discovery excludes node_modules and .next', () => {
+    const script: string = JSON.parse(read('package.json')).scripts.test;
+    assert.ok(script.includes('node_modules'), 'must exclude node_modules');
+    assert.ok(script.includes('.next'), 'must exclude .next');
+  });
+});
+
+describe('T-067: legal pages — Direction B tokens and reading measure', () => {
+  const pages = ['app/[locale]/privacy/page.tsx', 'app/[locale]/cookies/page.tsx'];
+
+  for (const page of pages) {
+    test(`${page} uses the named reading-width container, not a bare max-w-3xl`, () => {
+      const src = codeOnly(read(page));
+      assert.ok(src.includes('max-w-shell-reading'), 'must use the T-060 reading token');
+      assert.ok(!/max-w-3xl/.test(src), 'must not keep the untokenized max-w-3xl');
+    });
+
+    test(`${page} carries no legacy palette utilities`, () => {
+      const found = codeOnly(read(page)).match(LEGACY_COLOR) ?? [];
+      assert.deepEqual(found, [], `legacy colours remain: ${JSON.stringify(found)}`);
+    });
+
+    test(`${page} uses the typography scale for headings and body`, () => {
+      const src = codeOnly(read(page));
+      assert.ok(src.includes('text-page-title'), 'h1 must use the page-title token');
+      assert.ok(src.includes('text-section-title'), 'h2 must use the section-title token');
+      assert.ok(src.includes('text-body'), 'body copy must use the body token');
+    });
+
+    test(`${page} keeps its main landmark`, () => {
+      assert.ok(read(page).includes('id="main-content"'), 'main landmark must survive the restyle');
+    });
+
+    test(`${page} allows long tokens to wrap (320px overflow guard)`, () => {
+      // Regression guard: raising the h1 to text-page-title (28px) made the
+      // Russian title "конфиденциальности" overflow 320px, because it is a
+      // single unbreakable token. overflow-wrap is inherited, so this one
+      // class on <main> also protects body literals like
+      // _ga/_ga_<container-id> and «/account/messages».
+      const main = /<main[^>]*id="main-content"[^>]*className="([^"]+)"/.exec(read(page));
+      assert.ok(main, 'expected a main element with a className');
+      assert.ok(
+        main[1].includes('break-words'),
+        `main must allow long tokens to break — got "${main[1]}"`,
+      );
+    });
+  }
+});
+
+describe('T-067: CookieConsent — Direction B tokens, no consent-logic drift', () => {
+  const src = read('components/CookieConsent.tsx');
+
+  test('carries no legacy palette utilities', () => {
+    const found = codeOnly(src).match(LEGACY_COLOR) ?? [];
+    assert.deepEqual(found, [], `legacy colours remain: ${JSON.stringify(found)}`);
+  });
+
+  test('close control is an icon with an accessible name, not a bare glyph', () => {
+    const code = codeOnly(src);
+    assert.ok(!/>\s*×\s*</.test(code), 'raw × glyph must be replaced by an icon');
+    assert.ok(/aria-label=\{t\('close'\)\}/.test(code), 'close control must keep its accessible name');
+  });
+
+  test('interactive controls expose a visible focus ring', () => {
+    const code = codeOnly(src);
+    assert.ok(code.includes('focus-ring-token'), 'must use the shared focus-ring class');
+  });
+
+  test('consent read/write contract is untouched', () => {
+    assert.ok(src.includes('getAnalyticsConsent()'), 'still reads consent');
+    assert.ok(src.includes('setAnalyticsConsent(granted)'), 'still writes consent via the shared helper');
+    assert.ok(
+      src.includes('if (!isAnalyticsConsentFeatureEnabled()) return;'),
+      'feature gate must be unchanged',
+    );
+  });
+
+  test('does not introduce analytics or tracking into the consent surface', () => {
+    assert.ok(!/trackEvent|gtag|dataLayer/.test(codeOnly(src)), 'consent UI must not emit analytics');
+  });
+});
+
+describe('T-067: MapView overlay — hardcoded-locale fix and accessible names', () => {
+  const src = read('components/MapView.tsx');
+  const code = codeOnly(src);
+
+  test('the locating status pill is translated, not a hardcoded Greek string', () => {
+    assert.ok(
+      !/Εντοπισμός τοποθεσίας/.test(code),
+      'hardcoded Greek status text must be gone from code',
+    );
+    assert.ok(code.includes("t('locating_position')"), 'must render the translated key');
+  });
+
+  test('locating_position exists in all four locales and differs per language', () => {
+    const values = LOCALES.map(l => readMessages(l).salon.locating_position);
+    for (const [i, v] of values.entries()) {
+      assert.ok(v && v.length > 0, `${LOCALES[i]} missing locating_position`);
+    }
+    assert.equal(new Set(values).size, LOCALES.length, 'each locale must have its own wording');
+  });
+
+  test('the user-location marker tooltip is translated, not hardcoded Greek + emoji', () => {
+    assert.ok(!/Η θέση σας/.test(code), 'hardcoded Greek location tooltip must be gone');
+    assert.ok(!/📍/.test(code), 'pin emoji must be gone');
+    assert.ok(code.includes("bindTooltip(t('your_location')"), 'must bind the translated key');
+    for (const l of LOCALES) {
+      assert.ok(readMessages(l).salon.your_location, `${l} missing your_location`);
+    }
+  });
+
+  test('preview close control has an accessible name', () => {
+    assert.ok(code.includes("aria-label={t('close_preview')}"), 'close must be named');
+    for (const l of LOCALES) {
+      assert.ok(readMessages(l).salon.close_preview, `${l} missing close_preview`);
+    }
+  });
+
+  test('the quick-dial link is no longer an emoji-only control with no accessible name', () => {
+    assert.ok(!/📞/.test(code), 'phone emoji must be replaced');
+    assert.ok(code.includes("aria-label={t('callSalon')}"), 'quick-dial must expose a name');
+  });
+
+  test('overlay chrome carries no legacy palette utilities', () => {
+    const found = code.match(LEGACY_COLOR) ?? [];
+    assert.deepEqual(found, [], `legacy colours remain: ${JSON.stringify(found)}`);
+  });
+
+  test('T-063 boundary: no keyboard/marker accessibility work was introduced', () => {
+    // T-067 restyles overlay chrome only. Marker/popup keyboard navigation
+    // is reserved for T-063 and must not be started here.
+    assert.ok(!/tabIndex/i.test(code), 'no tabindex added to map internals');
+    assert.ok(!/keydown|onKeyDown/.test(code), 'no keyboard handlers added to map internals');
+  });
+
+  test('salon_open analytics from the map is unchanged in name, shape and source', () => {
+    assert.ok(
+      /trackEvent\('salon_open', \{ salon_id: String\(selected\.id\), source: 'search_map', locale: locale as Locale \}\)/.test(
+        code,
+      ),
+      'map salon_open call must be byte-identical',
+    );
+  });
+});
+
+describe('T-067: 404 page consistency', () => {
+  // NOTE — reachability finding, verified live in the isolated runtime:
+  // this component is NOT what users currently see for a bad URL. There is
+  // no root app/not-found.tsx, so unmatched paths (/zz, /zz/search) render
+  // Next.js's built-in unstyled error page instead. T-067 restyled this
+  // file so it is correct *if* reached, but did not add a root 404 — that
+  // needs an i18n decision (which locale for a prefix-less URL?) and is
+  // recorded in VISUAL_BASELINE_V1.md as follow-up work, not silently
+  // claimed as done here.
+  const src = 'app/[locale]/not-found.tsx';
+
+  test('no root app/not-found.tsx exists yet — pins the documented gap', () => {
+    let exists = true;
+    try {
+      statSync('app/not-found.tsx');
+    } catch {
+      exists = false;
+    }
+    assert.equal(
+      exists,
