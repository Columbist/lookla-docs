+      assert.ok(
+        /^\s*\w+:\s*'[♀♂ ]+',?$/.test(line.trim()) || /CATEGORY_GENDER/.test(line),
+        `gender glyph escaped the CATEGORY_GENDER map: ${line.trim()}`,
+      );
+    }
+  });
+});
+
+describe('T-067: dead code is identified, not silently restyled', () => {
+  test('SearchFilters.tsx is confirmed unreferenced and therefore left untouched', () => {
+    // Documented in T-007 and re-confirmed here: this file is not imported
+    // anywhere. It still carries legacy tokens on purpose — restyling dead
+    // code would imply it ships. It is recorded for deletion, not migration.
+    const roots = ['app', 'components'];
+    const hits: string[] = [];
+    const walk = (dir: string) => {
+      for (const entry of readdirSync(dir)) {
+        const p = join(dir, entry);
+        if (statSync(p).isDirectory()) walk(p);
+        else if (/\.tsx?$/.test(p) && !p.endsWith('SearchFilters.tsx')) {
+          if (/from '@\/components\/SearchFilters'|from '\.\/SearchFilters'/.test(read(p))) hits.push(p);
+        }
+      }
+    };
+    roots.forEach(walk);
+    assert.deepEqual(hits, [], `SearchFilters is now imported by ${JSON.stringify(hits)} — migrate or delete it`);
+  });
+});
