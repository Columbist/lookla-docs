+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'SalonCard.tsx'), 'utf-8');
+
+function codeOnly(src: string): string {
+  return src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '');
+}
+
+describe('T-065: image presentation, fallback, and failure handling', () => {
+  test('image uses a deliberate aspect-[4/3] ratio, not a fixed pixel height', () => {
+    // codeOnly() strips comments — one explains the aspect-ratio change by
+    // naming "the old fixed h-44" in prose, which would otherwise
+    // false-positive as real code still using it.
+    const clean = codeOnly(source);
+    assert.ok(clean.includes('aspect-[4/3]'));
+    assert.ok(!/\bh-44\b/.test(clean));
+  });
+
+  test('a failed image load is tracked via state and swaps to the honest fallback — not just hidden', () => {
+    assert.ok(source.includes("const [imageFailed, setImageFailed] = useState(false);"));
+    assert.ok(source.includes('onError={() => setImageFailed(true)}'));
+    assert.ok(!source.includes("style.display = 'none'"), 'the old hide-only onError handler must be replaced, not just supplemented');
+  });
+
+  test('showPhoto is false both when the URL is absent AND when the image failed to load — same fallback UI for both', () => {
+    assert.ok(source.includes('const showPhoto = salon.primary_photo && !imageFailed;'));
+  });
+
+  test('fallback is a decorative, generic (non-category-specific) icon — not an emoji, not a photo, not implying a real image', () => {
+    assert.ok(source.includes('function PhotoFallback()'));
+    assert.ok(source.includes('<Icon icon={Building2}'));
+    const fallbackFn = source.slice(source.indexOf('function PhotoFallback()'), source.indexOf('export default function SalonCard'));
+    assert.ok(!/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u.test(fallbackFn), 'no emoji in the fallback');
+    assert.ok(!fallbackFn.includes('decorative={false}'), 'fallback icon must stay at its aria-hidden default');
+  });
+
+  test('fallback sits inside the same aspect-ratio frame as the real photo, so card height never changes based on image success/failure', () => {
+    const photoFrameIdx = source.indexOf('aspect-[4/3]');
+    const fallbackIdx = source.indexOf('<PhotoFallback');
+    const showPhotoTernaryEnd = source.indexOf(')}', fallbackIdx);
+    assert.ok(photoFrameIdx < fallbackIdx && fallbackIdx < showPhotoTernaryEnd + 50, 'PhotoFallback must render inside the same aspect-ratio wrapper as <img>');
+  });
+
+  test('no infinite retry loop: onError only ever sets state once, no re-triggering fetch/reload logic', () => {
+    assert.ok(!/retry|reload|refetch/i.test(source.slice(source.indexOf('onError'), source.indexOf('onError') + 100)));
+  });
+
+  test('lazy loading is preserved (no eager/priority loading added)', () => {
+    assert.ok(source.includes('loading="lazy"'));
+  });
+
+  test('no next/image or new image dependency introduced — still a plain <img> against the existing source contract', () => {
+    assert.ok(!source.includes("from 'next/image'"));
+    assert.ok(source.includes('src={salon.primary_photo}'));
+  });
+});
+
+describe('T-065: card surface — Direction B tokens, no legacy palette', () => {
+  test('no legacy bg-white/border-gray-100/hover:border-pink-100/bg-gradient-to-br on the card', () => {
+    assert.ok(!/\bbg-white\b/.test(source));
+    assert.ok(!/border-gray-100/.test(source));
+    assert.ok(!/hover:border-pink-100/.test(source));
+    assert.ok(!/bg-gradient-to-br/.test(source));
+  });
+
+  test('uses the shared shadow tokens (resting default, elevated on hover) instead of shadow-md', () => {
+    assert.ok(source.includes('shadow-resting'));
+    assert.ok(source.includes('hover:shadow-elevated'));
+    assert.ok(!/shadow-md\b/.test(source));
+  });
+
+  test('the outer Link carries both focus-ring-token and overflow-hidden (verified empirically that an element\'s own outline is not clipped by its own overflow:hidden — only descendant content is)', () => {
+    const linkTagStart = source.indexOf('<Link\n');
+    const linkOpenTag = source.slice(linkTagStart, source.indexOf('>', linkTagStart));
+    assert.ok(linkOpenTag.includes('focus-ring-token'));
+    assert.ok(linkOpenTag.includes('overflow-hidden'), 'overflow-hidden clips the rounded card\'s image corners; it does not clip this same element\'s own outline');
+  });
+
+  test('hover only affects shadow/border on the card and scale on the image (inside its own clipped frame) — no card-wide transform', () => {
+    const linkTagStart = source.indexOf('<Link\n');
+    const linkOpenTag = source.slice(linkTagStart, source.indexOf('>', linkTagStart));
+    assert.ok(!/hover:scale/.test(linkOpenTag), 'the outer Link itself must not scale on hover — only the inner image does, inside its own overflow-hidden frame');
+  });
+
+  test('reduced motion disables the image hover-zoom transition', () => {
