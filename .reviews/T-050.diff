@@ -59,8 +72,24 @@ async def send_email(to: str, template: str, lang: str = "el", **kwargs) -> bool
                 timeout=10,
             )
             if r.status_code not in (200, 201):
-                print(f"[email] Resend error {r.status_code}: {r.text}")
+                # Resend echoes the offending address in validation errors, so
+                # the body is third-party text and is scrubbed, not trusted.
+                # Request headers and payload are never logged: they carry the
+                # API key and the message body (reset codes, claim tokens).
+                logger.error(
+                    "[email] Resend rejected request status=%s recipient_ref=%s detail=%s",
+                    r.status_code,
+                    ref,
+                    scrub_and_limit(r.text),
+                )
             return r.status_code in (200, 201)
         except Exception as e:
-            print(f"[email] Error: {e}")
+            # Type is logged separately from the message so a transport fault
+            # stays identifiable even after the message has been scrubbed.
+            logger.error(
+                "[email] request failed type=%s recipient_ref=%s detail=%s",
+                type(e).__name__,
+                ref,
+                scrub_and_limit(str(e)),
