diff --git a/backend/tests/test_email_log_redaction.py b/backend/tests/test_email_log_redaction.py
new file mode 100644
index 0000000..199317a
--- /dev/null
+++ b/backend/tests/test_email_log_redaction.py
@@ -0,0 +1,355 @@
+"""
+T-050: recipient email addresses must never reach application logs.
+
+The defect: `send_email`'s no-API-key fallback printed the intended
+recipient's full address to stdout, which Docker's json-file driver captures
+into an unrotated file. Two further paths leaked the same data without being
+documented — the Resend error body (which echoes the offending address in a
+422) and the exception message.
+
+These tests are deliberately split between behaviour (what the functions
+return, what actually lands in a log record) and source inspection (that the
+call sites cannot regress back to interpolating `to`). Behaviour alone would
+not catch someone re-adding a `print(f"... {to}")` next to a correct call.
+
+The settings this module needs to import app code come from the rootdir
+`conftest.py` (T-071), which pytest loads before collecting anything.
+"""
+import hashlib
+import hmac
+import inspect
+import logging
+import re
+from pathlib import Path
+
+import pytest
+
+from app.core.log_redaction import (
+    RECIPIENT_REF_UNAVAILABLE,
+    REDACTED_EMAIL,
+    recipient_ref,
+    safe_field,
+    scrub,
+    scrub_and_limit,
+)
+
+KEY = "unit-test-hmac-key"
+ADDRESS = "maria.papadopoulou@example.gr"
+
+
+# ───────────────────────────── recipient_ref ─────────────────────────────────
+
+
+def test_ref_is_stable_for_the_same_address_and_key():
+    # Correlating repeated failures for one recipient is the whole reason this
+    # is a pseudonym rather than an omission.
+    assert recipient_ref(ADDRESS, KEY) == recipient_ref(ADDRESS, KEY)
+
+
+def test_ref_differs_between_addresses():
+    assert recipient_ref(ADDRESS, KEY) != recipient_ref("other@example.gr", KEY)
+
+
+def test_ref_differs_between_keys():
+    # Rotating the key must invalidate old references; if it did not, the key
+    # would not actually be participating in the digest.
+    assert recipient_ref(ADDRESS, KEY) != recipient_ref(ADDRESS, "a-different-key")
+
+
+def test_ref_is_short_lowercase_hex():
+    ref = recipient_ref(ADDRESS, KEY)
+    assert len(ref) == 12
+    assert re.fullmatch(r"[0-9a-f]{12}", ref)
+
+
+def test_ref_is_keyed_hmac_not_a_plain_digest():
+    # The load-bearing property: email addresses are dictionary-attackable, so
+    # an unkeyed (or publicly-salted) hash in a log would be reversible by
+    # anyone holding the log. Assert the value is NOT any plain digest of the
+    # address, and IS the HMAC.
+    ref = recipient_ref(ADDRESS, KEY)
+    assert ref != hashlib.sha256(ADDRESS.encode()).hexdigest()[:12]
+    assert ref != hashlib.md5(ADDRESS.encode()).hexdigest()[:12]  # noqa: S324
+    expected = hmac.new(KEY.encode(), ADDRESS.encode(), hashlib.sha256).hexdigest()
+    assert ref == expected[:12]
+
+
+def test_ref_normalises_case_and_surrounding_whitespace():
+    assert recipient_ref("  MARIA.Papadopoulou@Example.GR ", KEY) == recipient_ref(
+        ADDRESS, KEY
+    )
+
+
+@pytest.mark.parametrize("key", ["", None])
+def test_missing_key_yields_unavailable_and_never_a_fallback_digest(key):
+    # Explicitly required by the ticket: no unkeyed SHA-256 fallback, because
+    # that would look like protection while being trivially reversible.
+    ref = recipient_ref(ADDRESS, key)
+    assert ref == RECIPIENT_REF_UNAVAILABLE
+    assert ref != hashlib.sha256(ADDRESS.encode()).hexdigest()[:12]
+
+
+@pytest.mark.parametrize("address", ["", "   ", None, 12345, ["a@b.gr"]])
+def test_ref_handles_empty_and_non_string_addresses(address):
+    assert recipient_ref(address, KEY) == RECIPIENT_REF_UNAVAILABLE
+
+
+def test_ref_never_contains_any_part_of_the_address():
+    ref = recipient_ref(ADDRESS, KEY)
+    for fragment in ("maria", "papadopoulou", "example", "gr", "@"):
+        assert fragment not in ref
+
+
+# ──────────────────────────────── scrub ──────────────────────────────────────
+
+
+def test_scrub_replaces_a_bare_address():
+    assert scrub(f"could not deliver to {ADDRESS} today") == (
+        f"could not deliver to {REDACTED_EMAIL} today"
+    )
+
+
+def test_scrub_handles_a_realistic_resend_validation_body():
+    # This is the shape that made path #2 a leak: the provider hands the
+    # address straight back in the error body.
+    body = '{"statusCode":422,"message":"Invalid `to` field: maria@example.gr","name":"validation_error"}'
+    out = scrub(body)
+    assert "maria@example.gr" not in out
+    assert REDACTED_EMAIL in out
+    # Diagnostic content around the address must survive.
+    assert "422" in out and "validation_error" in out
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "<maria@example.gr>",
+        '"to":["maria@example.gr"]',
+        "maria+booking@example.gr",
+        "maria.p@mail.sub.example.co.uk",
+        "MARIA@EXAMPLE.GR",
+        "contact maria@example.gr, or maria2@example.gr",
+    ],
+)
+def test_scrub_catches_addresses_in_varied_surroundings(text):
+    assert "@" not in scrub(text).replace(REDACTED_EMAIL, "")
+
+
+def test_scrub_catches_percent_encoded_addresses_from_urls():
+    # An address placed in a query string arrives percent-encoded, so the
+    # plain-text pattern alone would miss it.
+    text = "GET https://api.resend.com/x?to=maria%40example.gr failed"
+    out = scrub(text)
+    assert "maria%40example.gr" not in out
+    assert REDACTED_EMAIL in out
+
+
+@pytest.mark.parametrize(
+    "encoded",
+    [
+        "maria%40example.gr",
+        "MARIA%40EXAMPLE.GR",
+        "Maria%40Example.Gr",
+        # The escape itself has no letters to vary (`@` is always %40), so the
+        # case dimension is the address around it; the double-encoded form is
+        # the one that does vary the escape, and appears when a URL that
+        # already contained an address is escaped a second time.
+        "maria%2540example.gr",
+        "MARIA%2540EXAMPLE.GR",
+    ],
+)
+def test_percent_encoded_at_sign_is_caught_in_any_case(encoded):
+    out = scrub(f"failed posting https://api.resend.com/x?to={encoded}")
+    assert "example.gr" not in out.lower()
+    assert REDACTED_EMAIL in out
+
+
+def test_percent_encoded_local_part_is_caught():
+    # A local part carrying an encoded character (`maria%2Bbooking` for
+    # `maria+booking`) still has to be redacted — the `%` is already inside
+    # the accepted local-part character class, but assert it rather than
+    # assume the class covers this shape.
+    out = scrub("to=maria%2Bbooking%40example.gr rejected")
+    assert "example.gr" not in out
+    assert REDACTED_EMAIL in out
+
+
+def test_repr_of_an_exception_is_scrubbed_like_its_str():
+    # `repr()` of an exception embeds the args, so an address reaches a log
+    # through it just as readily as through `str()`. send_email uses str(), but
+    # the scrubber must not depend on which one a future caller picks.
+    err = ValueError(f"could not deliver to {ADDRESS}")
+    assert ADDRESS not in scrub(repr(err))
+    assert ADDRESS not in scrub(str(err))
+    assert REDACTED_EMAIL in scrub(repr(err))
+
+
+def test_exception_chain_text_is_scrubbed():
+    # A wrapped exception carries the inner message; both levels must be clean.
+    inner = ConnectionError(f"refused for {ADDRESS}")
+    outer = RuntimeError(f"send failed: {inner}")
+    assert ADDRESS not in scrub_and_limit(str(outer))
+    assert ADDRESS not in scrub_and_limit(repr(outer))
+
+
+def test_scrub_leaves_non_addresses_alone():
+    # A scrubber that eats ordinary text would destroy the diagnostic value
+    # this ticket is required to preserve.
+    text = "timeout connecting to api.resend.com after 10s (attempt 2)"
+    assert scrub(text) == text
+
+
+@pytest.mark.parametrize("value", [None, 42, ValueError("boom")])
+def test_scrub_accepts_non_string_input(value):
+    assert isinstance(scrub(value), str)
+
+
+# ───────────────────────────── scrub_and_limit ───────────────────────────────
+
+
+def test_scrub_runs_before_truncation():
+    # The trap this ordering exists to avoid: truncating first can cut an
+    # address mid-domain, leaving "maria.papadopoulou@examp" — which no longer
+    # matches the pattern (no TLD) and so survives scrubbing, while still
+    # exposing the entire local part.
+    #
+    # The cut point matters and is asserted, not assumed: an earlier version of
+    # this test used a limit that fell *before* the "@", leaving only a
+    # harmless "mari" fragment. It passed against a deliberately broken
+    # truncate-then-scrub implementation, i.e. it tested nothing.
+    text = "x" * 40 + " " + ADDRESS
+    limit = 65
+    assert text[:limit].endswith("@examp"), "the cut must land inside the domain"
+
+    out = scrub_and_limit(text, limit=limit)
+    assert "maria.papadopoulou" not in out
+    assert "@examp" not in out
+    assert REDACTED_EMAIL in out
+
+
+def test_limit_bounds_provider_text():
+    out = scrub_and_limit("y" * 5000, limit=100)
+    assert len(out) < 200
+    assert out.startswith("y" * 100)
+
+
+def test_short_text_is_not_truncated():
+    assert scrub_and_limit("short detail", limit=100) == "short detail"
+
+
+def test_control_characters_are_removed():
+    # A newline inside third-party text would otherwise let it forge an extra
+    # log record of its own.
+    out = scrub_and_limit("line one\nline two\r\tend")
+    assert "\n" not in out and "\r" not in out and "\t" not in out
+
+
+def test_safe_field_strips_control_characters_and_caps_length():
+    # `lang` reaches send_email from an unvalidated request field.
+    assert "\n" not in safe_field("el\n[email] forged line")
+    assert len(safe_field("z" * 500)) <= 64
+
+
+# ────────────────────── source inspection of the call sites ──────────────────
+
+_EMAIL_SRC = inspect.getsource(
+    __import__("app.services.email", fromlist=["send_email"])
+)
+
+
+def test_email_module_no_longer_uses_print():
+    # print() bypasses logging configuration entirely and was how all three
+    # leaks were written.
+    assert "print(" not in _EMAIL_SRC
+
+
+def test_recipient_is_never_interpolated_into_a_log_line():
+    for forbidden in ("{to}", "%s\", to", "to=%s", ", to,", "{to!r}"):
+        assert forbidden not in _EMAIL_SRC, forbidden
+
+
+def test_send_email_computes_a_recipient_ref():
+    assert "recipient_ref(to, settings.log_pii_hmac_key)" in _EMAIL_SRC
+
+
+def test_provider_text_is_only_logged_through_the_scrubber():
+    # Every occurrence of the response body in the module must be wrapped.
+    for raw in re.finditer(r"r\.text", _EMAIL_SRC):
+        window = _EMAIL_SRC[max(0, raw.start() - 60) : raw.end()]
+        assert "scrub_and_limit(" in window
+
+
+def test_exception_text_is_only_logged_through_the_scrubber():
+    assert "scrub_and_limit(str(e))" in _EMAIL_SRC
+    assert 'detail=%s"' in _EMAIL_SRC or "detail=%s" in _EMAIL_SRC
+
+
+def test_credentials_and_message_body_are_never_logged():
+    log_calls = re.findall(r"logger\.\w+\((.*?)\n\s*\)", _EMAIL_SRC, re.DOTALL)
+    assert log_calls, "expected to find logger calls to inspect"
+    joined = " ".join(log_calls)
+    for forbidden in ("payload", "headers", "resend_api_key", "body", "kwargs"):
+        assert forbidden not in joined, forbidden
+
+
+def test_config_exposes_a_dedicated_hmac_key():
+    config_src = Path(__file__).resolve().parents[1] / "app" / "core" / "config.py"
+    text = config_src.read_text(encoding="utf-8")
+    assert "log_pii_hmac_key" in text
+    # Must not be defaulted to another secret — reusing an auth or provider
+    # credential on a logging path widens the blast radius of a log mistake.
+    assert 'log_pii_hmac_key: str = ""' in text
+
+
+# ─────────────────────────── end-to-end log capture ──────────────────────────
+
+
+def _fallback_records(caplog, address, key):
+    """Run the no-API-key path and return what it logged."""
+    import asyncio
+
+    from app.services import email as email_module
+
+    class _Stub:
+        resend_api_key = ""
+        log_pii_hmac_key = key
+
+    original = email_module.settings
+    email_module.settings = _Stub()
+    try:
+        with caplog.at_level(logging.WARNING, logger=email_module.__name__):
+            sent = asyncio.run(
+                email_module.send_email(address, "reset", lang="ru", code="123456")
+            )
+        return sent, caplog.text
+    finally:
+        email_module.settings = original
+
+
+def test_fallback_path_logs_no_address_and_keeps_returning_false(caplog):
+    sent, text = _fallback_records(caplog, ADDRESS, KEY)
+    # Delivery behaviour is unchanged: this path still reports "not sent".
+    assert sent is False
+    # The actual regression guard.
+    assert ADDRESS not in text
+    assert "maria.papadopoulou" not in text
