new file mode 100644
index 0000000..1212bc8
--- /dev/null
+++ b/backend/app/core/log_redaction.py
@@ -0,0 +1,142 @@
+"""
+T-050 — keep recipient email addresses out of application logs.
+
+Docker's json-file driver captures stdout/stderr, so an application log line is
+effectively durable storage that no retention policy covers. Writing a user's
+email address there turns a transient delivery problem into a standing PII
+disclosure, which is why `send_email` must never log an address in any form
+that identifies the person — neither the full address nor the domain, since a
+corporate or niche domain (`@hospital.example`, `@lawfirm.example`) can single
+out an employer or an organisation on its own.
+
+Two mechanisms, addressing two different exposure routes:
+
+ 1. `recipient_ref()` — a **keyed HMAC** pseudonym for the one address we know
+    we hold. A plain hash (salted or not) is not enough: email addresses have a
+    small, highly predictable structure, so an attacker holding the log can
+    simply hash a dictionary of candidate addresses and match. HMAC with a key
+    held only by the backend removes that offline attack. The result is stable,
+    so repeated failures for the same address stay correlatable in support
+    work, which is the diagnostic value that omitting the recipient entirely
+    would have cost.
+
+ 2. `scrub()` / `scrub_and_limit()` — HMAC only protects the field we control.
+    Addresses also arrive inside text we do not author: Resend echoes the
+    offending recipient in validation errors (a 422 `Invalid \\`to\\` field`
+    body), and exception messages can carry a URL with the address in a query
+    string. Anything originating outside this process is scrubbed before it
+    reaches a log call.
+
+Note on GDPR: an HMAC pseudonym is **pseudonymisation, not anonymisation** —
+it remains personal data, because the backend holding the key can still link a
+reference to an address. It is a large reduction in exposure, not an exemption.
+"""
+
+import hashlib
+import hmac
+import re
+
+#: Substitution written in place of any address found in third-party text.
+REDACTED_EMAIL = "[redacted-email]"
+
+#: Emitted instead of a pseudonym when no HMAC key is configured. There is
+#: deliberately no fallback to an unkeyed digest: a dictionary-attackable hash
+#: of an email address would give the false impression of protection.
+RECIPIENT_REF_UNAVAILABLE = "unavailable"
+
+#: Hex characters kept from the HMAC digest. 12 hex chars = 48 bits, ample to
+#: distinguish the handful of addresses appearing in any real log window while
+#: keeping the line readable.
+_REF_LENGTH = 12
+
+#: Upper bound on any third-party string reaching a log line. Provider bodies
+#: and exception messages are unbounded and attacker-influenceable; a single
+#: error should not be able to write megabytes into an unrotated log.
+_DEFAULT_LIMIT = 500
+
+_TRUNCATION_SUFFIX = "…[truncated]"
+
+# Matches an addr-spec with an explicit TLD. Callers only ever hold addresses
+# that already passed Pydantic's `EmailStr`, and provider errors echo those same
+# addresses, so requiring a dotted domain covers the realistic exposure without
+# redacting unrelated `user@host` tokens.
+_EMAIL_RE = re.compile(
+    r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9\-]+(?:\.[A-Za-z0-9\-]+)*\.[A-Za-z]{2,}"
+)
+
+# The same address percent-encoded, as it appears when an address has been
+# placed in a URL path or query string and that URL surfaces in an exception.
+_ENCODED_EMAIL_RE = re.compile(
+    r"[A-Za-z0-9._%+\-]+(?:%40|%2540)[A-Za-z0-9\-]+(?:\.[A-Za-z0-9\-]+)*\.[A-Za-z]{2,}",
+    re.IGNORECASE,
+)
+
+# Control characters are stripped from anything interpolated into a log line:
+# a newline in a caller-supplied value would otherwise let that value forge an
+# additional, fully attacker-authored log record.
+_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")
+
+
+def recipient_ref(address: object, key: str | None) -> str:
+    """
+    Return a stable, non-reversible reference for `address`.
+
+    Returns `RECIPIENT_REF_UNAVAILABLE` when no key is configured or the
+    address is empty. The raw address is never returned, and never appears in
+    any output of this function, on any path.
+    """
+    if not key:
+        return RECIPIENT_REF_UNAVAILABLE
+    if not isinstance(address, str):
+        return RECIPIENT_REF_UNAVAILABLE
+
+    # Normalised so the same mailbox produces one reference regardless of how
+    # it was typed — otherwise "A@x.gr" and "a@x.gr" would look like two
+    # unrelated recipients and defeat the correlation this exists to provide.
+    normalised = address.strip().lower()
+    if not normalised:
+        return RECIPIENT_REF_UNAVAILABLE
+
+    digest = hmac.new(
+        key.encode("utf-8"), normalised.encode("utf-8"), hashlib.sha256
+    ).hexdigest()
+    return digest[:_REF_LENGTH]
+
+
+def scrub(text: object) -> str:
+    """Replace every email address in `text` with `REDACTED_EMAIL`."""
+    if text is None:
+        return ""
+    if not isinstance(text, str):
+        text = str(text)
+    text = _EMAIL_RE.sub(REDACTED_EMAIL, text)
+    return _ENCODED_EMAIL_RE.sub(REDACTED_EMAIL, text)
+
+
+def scrub_and_limit(text: object, limit: int = _DEFAULT_LIMIT) -> str:
+    """
+    Scrub addresses from `text`, then bound its length.
+
+    Order matters and is the point of this function existing: truncating first
+    can cut an address at its domain (`john@exam`), which no longer matches the
+    pattern and so survives scrubbing while still narrowing who the person is.
+    Scrubbing always runs against the complete string.
+    """
+    scrubbed = _CONTROL_RE.sub(" ", scrub(text))
+    if limit <= 0 or len(scrubbed) <= limit:
+        return scrubbed
+    return scrubbed[:limit] + _TRUNCATION_SUFFIX
+
+
+def safe_field(value: object, limit: int = 64) -> str:
+    """
+    Sanitise a short scalar (a template name, a locale) for a log line.
+
+    `send_email`'s `lang` reaches it from an unvalidated request field, so it
+    is treated as untrusted: control characters are removed to prevent log
+    forging, and the length is capped.
+    """
+    if value is None:
+        return ""
+    text = _CONTROL_RE.sub("", str(value))
+    return text[:limit]
