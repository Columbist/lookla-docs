+  test('the material key formula is unchanged: area|bucket|view|locale, from lib/analytics.ts, not redefined in page.tsx', () => {
+    assert.ok(!source.includes('.join(\'|\')'), 'the key format must live only in buildSearchResultsViewKey, not be re-derived in page.tsx');
+  });
