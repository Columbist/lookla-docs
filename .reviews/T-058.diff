+import { test, describe, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  hasReportedSearchResultsView,
+  markSearchResultsViewReported,
+  __clearSearchResultsViewDedupForTests,
+} from './searchResultsViewDedup';
+
+beforeEach(() => {
+  __clearSearchResultsViewDedupForTests();
+});
+
+describe('T-058: hasReportedSearchResultsView / markSearchResultsViewReported', () => {
+  test('a never-reported entry+key pair returns false', () => {
+    assert.equal(hasReportedSearchResultsView('entry-1', 'athens|6_20|list|en'), false);
+  });
+
+  test('after marking, the exact same entry+key pair returns true', () => {
+    markSearchResultsViewReported('entry-1', 'athens|6_20|list|en');
+    assert.equal(hasReportedSearchResultsView('entry-1', 'athens|6_20|list|en'), true);
+  });
+
+  test('same entry, a materially different key, is NOT considered reported', () => {
+    markSearchResultsViewReported('entry-1', 'athens|6_20|list|en');
+    assert.equal(hasReportedSearchResultsView('entry-1', 'thessaloniki|6_20|list|en'), false);
+  });
+
+  test('same material key under a DIFFERENT entry id is NOT considered reported — no global shared dedup', () => {
+    markSearchResultsViewReported('entry-1', 'athens|6_20|list|en');
+    assert.equal(hasReportedSearchResultsView('entry-2', 'athens|6_20|list|en'), false);
+  });
+
+  test('a null entryId always returns false for hasReportedSearchResultsView — never crashes, never falsely suppresses', () => {
+    assert.equal(hasReportedSearchResultsView(null, 'athens|6_20|list|en'), false);
+    markSearchResultsViewReported('entry-1', 'athens|6_20|list|en');
+    assert.equal(hasReportedSearchResultsView(null, 'athens|6_20|list|en'), false);
+  });
+
+  test('marking with a null entryId is a safe no-op (never throws, never pollutes real entries)', () => {
+    markSearchResultsViewReported(null, 'athens|6_20|list|en');
+    assert.equal(hasReportedSearchResultsView(null, 'athens|6_20|list|en'), false);
+  });
+
+  test('re-marking the same entry with a NEW key overwrites the old one (only the latest material state per entry is remembered)', () => {
+    markSearchResultsViewReported('entry-1', 'athens|6_20|list|en');
+    markSearchResultsViewReported('entry-1', 'athens|21_50|list|en');
+    assert.equal(hasReportedSearchResultsView('entry-1', 'athens|6_20|list|en'), false);
+    assert.equal(hasReportedSearchResultsView('entry-1', 'athens|21_50|list|en'), true);
+  });
+
+  test('the module-scope store starts empty for a fresh realm (simulated here via the test-only clear helper, matching what a real hard reload does)', () => {
+    markSearchResultsViewReported('entry-1', 'athens|6_20|list|en');
+    __clearSearchResultsViewDedupForTests();
+    assert.equal(hasReportedSearchResultsView('entry-1', 'athens|6_20|list|en'), false);
+  });
+
+  test('many distinct entries can be tracked independently without cross-contamination', () => {
+    for (let i = 0; i < 20; i++) {
+      markSearchResultsViewReported(`entry-${i}`, `area${i}|6_20|list|en`);
+    }
+    for (let i = 0; i < 20; i++) {
+      assert.equal(hasReportedSearchResultsView(`entry-${i}`, `area${i}|6_20|list|en`), true);
+      assert.equal(hasReportedSearchResultsView(`entry-${i}`, `area${i}|21_50|list|en`), false);
+    }
+  });
+
+  test('the store is bounded — exceeding the internal cap evicts the oldest entry rather than growing forever', () => {
+    // MAX_ENTRIES is 500; write 501 distinct entries and confirm the very
+    // first one was evicted while a recent one survives. Not asserting the
+    // exact cap value (an implementation detail) — only the bounded-ness.
+    for (let i = 0; i < 501; i++) {
+      markSearchResultsViewReported(`entry-${i}`, `k${i}`);
+    }
+    assert.equal(hasReportedSearchResultsView('entry-0', 'k0'), false, 'the oldest entry should have been evicted once the bound was exceeded');
+    assert.equal(hasReportedSearchResultsView('entry-500', 'k500'), true, 'a recent entry must still be remembered');
+  });
+});
diff --git a/frontend/lib/searchResultsViewDedup.ts b/frontend/lib/searchResultsViewDedup.ts
new file mode 100644
index 0000000..a4558a6
--- /dev/null
+++ b/frontend/lib/searchResultsViewDedup.ts
@@ -0,0 +1,53 @@
+/**
+ * T-058: per-history-entry deduplication for the search_results_view
+ * product event — separate from T-056's SearchReturnSnapshot cache
+ * (lib/searchReturnState.ts) by design, even though both are keyed by the
+ * same entryId. T-056 owns UI restoration (cards/scroll/pagination); this
+ * module owns one narrow analytics-quality question ("has this exact
+ * material result state already been reported for this browser history
+ * entry?") and nothing else. Keeping them separate means a change to one
+ * can never accidentally corrupt the other, and an invalid/expired T-056
+ * snapshot has no bearing on whether this module still remembers what was
+ * already reported.
+ *
+ * Deliberately in-memory (a module-scope Map), matching T-056's own
+ * rationale: never sessionStorage/localStorage/cookies (Cookie Policy
+ * constraint — see searchReturnState.ts), and a hard reload or new tab
+ * starts a fresh JS realm with an empty map, which is exactly the "always
+ * fresh" behavior a reload needs. Only the material event key (a small
+ * derived string containing no query text, counts, or identifiers) is ever
+ * stored — never the GA4 payload itself, never anything sent to Google.
+ */
+
+const MAX_ENTRIES = 500;
+
+const reportedKeys = new Map<string, string>();
+
+/** True only when THIS exact material key was already reported for THIS exact history entry. A null/missing entryId (history API unavailable) always returns false — the same safe "no cross-remount memory" fallback T-056 uses for restoration in that case. */
+export function hasReportedSearchResultsView(entryId: string | null, materialKey: string): boolean {
+  if (!entryId) return false;
+  try {
+    return reportedKeys.get(entryId) === materialKey;
+  } catch {
+    return false;
+  }
+}
+
+/** Records the material key as reported for this entry. Never throws — a failed write must never break the calling render. Bounded: evicts the oldest entry (Map preserves insertion order) once the map would otherwise grow past MAX_ENTRIES, so a very long single-tab session can't leak memory unboundedly. */
+export function markSearchResultsViewReported(entryId: string | null, materialKey: string): void {
+  if (!entryId) return;
+  try {
+    if (!reportedKeys.has(entryId) && reportedKeys.size >= MAX_ENTRIES) {
+      const oldestKey = reportedKeys.keys().next().value;
+      if (oldestKey !== undefined) reportedKeys.delete(oldestKey);
+    }
+    reportedKeys.set(entryId, materialKey);
+  } catch {
+    // swallow — recording a dedup key must never break the render it's attached to
+  }
+}
+
+/** Test-only: clears the module-scope map between test cases. Not used by app code. */
+export function __clearSearchResultsViewDedupForTests(): void {
+  reportedKeys.clear();
+}
