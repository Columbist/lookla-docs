+  test('the event payload sent to trackEvent still contains only the 4 approved SearchResultsViewParams keys', () => {
+    const calls = [...trackingEffect.matchAll(/trackEvent\('search_results_view', \{([^}]*)\}\)/g)];
+    assert.equal(calls.length, 2, 'expected exactly 2 trackEvent(search_results_view, ...) call sites (list branch + map branch)');
+    for (const call of calls) {
+      const body = call[1];
+      const keys = [...body.matchAll(/(\w+):/g)].map(m => m[1]);
+      assert.deepEqual(new Set(keys), new Set(['area', 'result_count_bucket', 'view', 'locale']));
+    }
+  });
+});
+
+describe('T-058: dedup ownership — entryId-scoped store, not a component-local-only ref', () => {
+  test('lib/searchResultsViewDedup is imported and both its functions are used in the tracking effect', () => {
