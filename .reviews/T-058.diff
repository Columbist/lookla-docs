+describe('T-058: event identity — reuses the existing T-015 material key, unchanged', () => {
+  test('buildSearchResultsViewKey and bucketResultCount are imported and used, not reimplemented', () => {
+    assert.ok(source.includes("import { trackEvent, bucketResultCount, buildSearchResultsViewKey } from '@/lib/analytics';"));
+    assert.ok(trackingEffect.includes('buildSearchResultsViewKey(area'));
+    assert.ok(trackingEffect.includes('bucketResultCount('));
+  });
