+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'page.tsx'), 'utf-8');
+
+function slice(startMarker: string, endMarker: string): string {
+  const start = source.indexOf(startMarker);
+  const end = source.indexOf(endMarker, start);
+  if (start === -1 || end === -1) throw new Error(`marker not found: "${startMarker}" or "${endMarker}"`);
+  return source.slice(start, end);
+}
+
+const trackingEffect = slice('T-015/T-058: search_results_view', 'IntersectionObserver — fires loadMore');
