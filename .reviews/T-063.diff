+/**
+ * T-063 — pure geometry/selection helpers for the map's keyboard model.
+ *
+ * Kept free of Leaflet and React so the two genuinely tricky parts (which
+ * markers join the bounded keyboard set, and which marker an arrow key moves
+ * to) are unit-testable without a map instance or a DOM.
+ *
+ * All coordinates here are **screen/container points**, already projected by
+ * Leaflet. Direction is deliberately not derived from latitude/longitude:
+ * under Web Mercator, "north" in degrees is not a constant screen direction,
+ * and at the zoom levels this map uses the divergence is visible.
+ */
+
+/** Max markers exposed to keyboard navigation at once. Rendering is unbounded. */
+export const KEYBOARD_MARKER_LIMIT = 50;
+
+export type ArrowDirection = 'left' | 'right' | 'up' | 'down';
+
+export interface MarkerPoint {
+  /** Stable salon id — also the tie-breaker for equal distances. */
+  id: number;
+  /** Container-space x (px), already projected. */
+  x: number;
+  /** Container-space y (px), already projected. */
+  y: number;
+}
+
+export interface ViewportRect {
+  width: number;
+  height: number;
+}
+
+/** True when the point lies within the visible container box. */
+export function isWithinViewport(p: MarkerPoint, view: ViewportRect): boolean {
+  return p.x >= 0 && p.y >= 0 && p.x <= view.width && p.y <= view.height;
+}
+
+/**
+ * Chooses the bounded keyboard set: markers inside the viewport, and if more
+ * than `limit` of them, the `limit` closest to the viewport centre.
+ *
+ * Ties break on ascending salon id, so the set is deterministic for identical
+ * geometry — without that, two markers at the same distance could swap places
+ * between recomputes and silently reorder arrow navigation.
+ */
+export function selectKeyboardSet(
+  points: MarkerPoint[],
+  view: ViewportRect,
+  limit: number = KEYBOARD_MARKER_LIMIT,
+): MarkerPoint[] {
+  const cx = view.width / 2;
+  const cy = view.height / 2;
+  const visible = points.filter(p => isWithinViewport(p, view));
+  if (visible.length <= limit) return sortVisualOrder(visible);
+
+  const byCentre = [...visible].sort((a, b) => {
+    const da = (a.x - cx) ** 2 + (a.y - cy) ** 2;
+    const db = (b.x - cx) ** 2 + (b.y - cy) ** 2;
+    if (da !== db) return da - db;
+    return a.id - b.id;
+  });
+  return sortVisualOrder(byCentre.slice(0, limit));
+}
+
+/**
+ * Stable reading order (top-to-bottom, then left-to-right) used for Home/End
+ * and for the "N of M" position in each marker's accessible name. Rows are
+ * banded so markers at visually similar heights read left-to-right rather
+ * than by sub-pixel y differences.
+ */
+export function sortVisualOrder(points: MarkerPoint[], rowBand = 24): MarkerPoint[] {
+  return [...points].sort((a, b) => {
+    const rowA = Math.round(a.y / rowBand);
+    const rowB = Math.round(b.y / rowBand);
+    if (rowA !== rowB) return rowA - rowB;
+    if (a.x !== b.x) return a.x - b.x;
+    return a.id - b.id;
+  });
+}
+
+/**
+ * Picks the marker an arrow key should move to, or null to stay put.
+ *
+ * A candidate must lie in the requested direction and inside a widening cone
+ * around it, so ArrowRight cannot jump to something almost directly above.
+ * Deliberately does **not** wrap around the opposite edge: wrapping in a
+ * spatial widget reads as the focus teleporting.
+ */
+export function findSpatialNeighbour(
+  from: MarkerPoint,
+  candidates: MarkerPoint[],
+  direction: ArrowDirection,
+): MarkerPoint | null {
+  /** Decomposes the offset into "towards the direction" and "sideways". */
+  const project = (c: MarkerPoint): { along: number; across: number } => {
+    const dx = c.x - from.x;
+    const dy = c.y - from.y;
+    switch (direction) {
+      case 'right': return { along: dx, across: Math.abs(dy) };
+      case 'left': return { along: -dx, across: Math.abs(dy) };
+      case 'down': return { along: dy, across: Math.abs(dx) };
+      case 'up': return { along: -dy, across: Math.abs(dx) };
+    }
+  };
+
+  const pick = (maxAcross: (along: number) => number): MarkerPoint | null => {
+    let best: MarkerPoint | null = null;
+    let bestScore = Infinity;
+    for (const c of candidates) {
+      if (c.id === from.id) continue;
+      const { along, across } = project(c);
+      if (along <= 0) continue;                  // not in this direction at all
+      if (across > maxAcross(along)) continue;   // outside this pass's cone
+      // Weight lateral drift so a well-aligned far marker beats a skewed near one.
+      const score = along + across * 2;
+      if (score < bestScore || (score === bestScore && best && c.id < best.id)) {
+        bestScore = score;
+        best = c;
+      }
+    }
+    return best;
+  };
+
+  // Two passes. A narrow cone first, so ArrowRight prefers something actually
+  // to the right rather than a diagonal that would equally satisfy ArrowUp —
+  // without it, two different arrows can land on the same marker, which reads
+  // as the direction keys being broken. The wide cone is only a fallback, so
+  // sparse scatters still stay reachable instead of dead-ending everywhere.
+  return pick(along => along * 0.5) ?? pick(along => along * 2 + 24);
+}
+
+/**
+ * After a pan/zoom the previously active marker may have left the set. Falls
+ * back to the geometrically nearest member so focus never lands nowhere.
+ */
+export function nearestInSet(from: MarkerPoint, set: MarkerPoint[]): MarkerPoint | null {
+  let best: MarkerPoint | null = null;
+  let bestD = Infinity;
+  for (const c of set) {
+    const d = (c.x - from.x) ** 2 + (c.y - from.y) ** 2;
+    if (d < bestD || (d === bestD && best && c.id < best.id)) {
+      bestD = d;
+      best = c;
+    }
+  }
+  return best;
+}
+
+/** Maps a KeyboardEvent key to a direction, or null if it isn't an arrow. */
+export function arrowFromKey(key: string): ArrowDirection | null {
+  switch (key) {
+    case 'ArrowLeft': return 'left';
+    case 'ArrowRight': return 'right';
+    case 'ArrowUp': return 'up';
+    case 'ArrowDown': return 'down';
+    default: return null;
+  }
+}
