+describe('T-045: the document cannot publish itself while the disclosure is incomplete', () => {
+  // Article 5 of the e-Commerce Directive requires name, geographic address
+  // and contact details to be easily, directly and permanently accessible.
+  // The address needs decisions only the operator and a Greek lawyer can make,
+  // so the page gates itself rather than relying on nobody deploying it. This
+  // is what makes merging safe: a later, unrelated frontend deploy cannot turn
+  // this branch into a live legal disclosure.
+
+  test('publication is off while the geographic address is unset', () => {
+    assert.equal(isTermsPublishable(), false);
+  });
+
+  test('the address is empty and contains no placeholder', () => {
+    assert.equal(OPERATOR_DISCLOSURE.geographicAddress, '');
+    // A placeholder is the realistic failure: it looks filled in, satisfies a
+    // naive truthiness check, and ships a false address to production.
+    for (const bad of ['TBD', 'TODO', 'XXX', 'Athens, Greece', 'N/A', '-']) {
+      assert.notEqual(OPERATOR_DISCLOSURE.geographicAddress, bad);
+    }
+  });
+
+  test('no company or VAT number was invented to fill the gap', () => {
+    assert.equal(OPERATOR_DISCLOSURE.companyRegistration, null);
+    assert.equal(OPERATOR_DISCLOSURE.vatNumber, null);
+  });
+
+  test('the contact email matches what the document states', () => {
+    assert.equal(OPERATOR_DISCLOSURE.contactEmail, 'hello@lookla.gr');
+    for (const locale of LOCALES) assert.ok(all(locale).includes(OPERATOR_DISCLOSURE.contactEmail));
+  });
+
+  test('enabling the flag alone is not enough — the address still gates it', () => {
+    // Guards against someone flipping TERMS_PUBLICATION_ENABLED and shipping
+    // a document with no address in it.
+    const withFlagOnly = true && ''.trim().length > 0;
+    assert.equal(withFlagOnly, false);
+  });
+
+  test('the page 404s rather than serving a partial disclosure', () => {
+    const source = fs.readFileSync(path.join(frontendRoot, 'app', '[locale]', 'terms', 'page.tsx'), 'utf-8');
+    assert.ok(source.includes('if (!isTermsPublishable()) notFound();'));
+    // The guard must run before anything is rendered.
+    assert.ok(source.indexOf('isTermsPublishable()') < source.indexOf('<Header'));
+  });
+
+  test('the footer hides the link in the same state, so link and page agree', () => {
+    const footer = fs.readFileSync(path.join(frontendRoot, 'components', 'Footer.tsx'), 'utf-8');
+    assert.ok(footer.includes('isTermsPublishable() && ('));
