diff --git a/frontend/lib/termsContent.test.ts b/frontend/lib/termsContent.test.ts
new file mode 100644
index 0000000..5e0ab13
--- /dev/null
+++ b/frontend/lib/termsContent.test.ts
@@ -0,0 +1,237 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { TERMS_CONTENT } from '../app/[locale]/terms/content';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const frontendRoot = path.join(here, '..');
+const LOCALES = ['el', 'en', 'ru', 'uk'] as const;
+
+const all = (locale: (typeof LOCALES)[number]) => JSON.stringify(TERMS_CONTENT[locale]);
+
+describe('T-045: Terms page exists and is SSR', () => {
+  test('page.tsx exists at app/[locale]/terms/page.tsx', () => {
+    assert.ok(fs.existsSync(path.join(frontendRoot, 'app', '[locale]', 'terms', 'page.tsx')));
+  });
+
+  test('page is a server component, like the other legal pages', () => {
+    const source = fs.readFileSync(path.join(frontendRoot, 'app', '[locale]', 'terms', 'page.tsx'), 'utf-8');
+    assert.ok(!source.includes("'use client'"));
+    assert.ok(source.includes('export default async function TermsPage'));
+  });
+
+  test('version and effective date are rendered, not just stored', () => {
+    // Section 16 tells the reader these appear at the top of the page, so the
+    // page has to actually show them or the document contradicts itself.
+    const source = fs.readFileSync(path.join(frontendRoot, 'app', '[locale]', 'terms', 'page.tsx'), 'utf-8');
+    assert.ok(source.includes('{content.version}'));
+    assert.ok(source.includes('{content.effectiveDate}'));
+  });
+});
+
+describe('T-045: structural parity across all four locales', () => {
+  for (const locale of LOCALES) {
+    test(`${locale} content is complete`, () => {
+      const c = TERMS_CONTENT[locale];
+      assert.ok(c.title.length > 0);
+      assert.ok(c.version.length > 0);
+      assert.ok(c.effectiveDate.length > 0);
+      assert.ok(c.intro.length > 0);
+      assert.ok(c.sections.length > 0);
+      for (const s of c.sections) {
+        assert.ok(s.heading.length > 0);
+        assert.ok(s.paragraphs.length > 0, `empty section "${s.heading}" in ${locale}`);
+        for (const p of s.paragraphs) assert.ok(p.trim().length > 0);
+      }
+    });
+
+    test(`${locale} sections are numbered 1..N with no gaps or duplicates`, () => {
+      const numbers = TERMS_CONTENT[locale].sections.map(s => {
+        const m = s.heading.match(/^(\d+)\./);
+        assert.ok(m, `heading "${s.heading}" (${locale}) does not start with "N."`);
+        return Number(m![1]);
+      });
+      const expected = Array.from({ length: numbers.length }, (_, i) => i + 1);
+      assert.deepEqual(numbers, expected, `numbering out of order in ${locale}`);
+    });
+  }
+
+  test('all four locales have the same number of sections', () => {
+    const counts = LOCALES.map(l => TERMS_CONTENT[l].sections.length);
+    assert.ok(counts.every(c => c === counts[0]), `section counts differ: ${JSON.stringify(counts)}`);
+  });
+
+  test('version and effective date are identical across locales', () => {
+    // Four locales disagreeing about which version is in force would make the
+    // document unenforceable in whichever one is wrong.
+    const versions = new Set(LOCALES.map(l => TERMS_CONTENT[l].version));
+    const dates = new Set(LOCALES.map(l => TERMS_CONTENT[l].effectiveDate));
+    assert.equal(versions.size, 1, `versions differ: ${[...versions]}`);
+    assert.equal(dates.size, 1, `effective dates differ: ${[...dates]}`);
+  });
+
+  test('no locale is left in English by accident', () => {
+    // Four consecutive earlier tickets shipped a change in one locale only.
+    assert.ok(/Όροι/.test(TERMS_CONTENT.el.title));
+    assert.ok(/Условия/.test(TERMS_CONTENT.ru.title));
+    assert.ok(/Умови/.test(TERMS_CONTENT.uk.title));
+  });
+});
+
+describe('T-045: the document must not claim capabilities the product lacks', () => {
+  // The same honesty standard as T-017: every statement was checked against
+  // the running application. These guards fail if the product changes and the
+  // document is left behind — which is the realistic failure, since the API
+  // already contains booking and payment endpoints that no page reaches.
+
+  test('states plainly that online booking is not offered', () => {
+    assert.ok(/does not currently offer online booking/i.test(all('en')));
+    assert.ok(/δεν προσφέρει επί του παρόντος online κρατήσεις/i.test(all('el')));
+    assert.ok(/не предлагает онлайн-бронирование/i.test(all('ru')));
+    assert.ok(/не пропонує онлайн-бронювання/i.test(all('uk')));
+  });
+
+  test('never promises that a booking can be made through the site', () => {
+    for (const locale of LOCALES) {
+      const text = all(locale);
+      assert.ok(!/book (an appointment|online) (through|on) (this site|Lookla)/i.test(text));
+      assert.ok(!/reserve your appointment/i.test(text));
+    }
+  });
+
+  test('states that paid plans cannot currently be bought', () => {
+    assert.ok(/not currently available to buy/i.test(all('en')));
+    assert.ok(/no payment provider is configured/i.test(all('en')));
+    assert.ok(/δεν είναι επί του παρόντος διαθέσιμα προς αγορά/i.test(all('el')));
+    assert.ok(/нельзя приобрести/i.test(all('ru')));
+    assert.ok(/неможливо придбати/i.test(all('uk')));
+  });
+
+  test('states that nothing on the site can create a payment obligation', () => {
+    // Assert the sentence the document actually contains. An earlier version
+    // of this test looked for "cannot currently create", while the text reads
+    // "Nothing on Lookla can currently create" — it failed on phrasing that
+    // was never there, not on a missing guarantee.
+    assert.ok(/Nothing on Lookla can currently create a payment obligation/i.test(all('en')));
+    assert.ok(/Τίποτα στο Lookla δεν μπορεί σήμερα να δημιουργήσει υποχρέωση πληρωμής/i.test(all('el')));
+    assert.ok(/Ничто в Lookla сегодня не может создать/i.test(all('ru')));
+    assert.ok(/Ніщо в Lookla сьогодні не може створити/i.test(all('uk')));
+  });
+
+  test('discloses that listings come from public sources and may be wrong', () => {
+    const en = all('en');
+    for (const source of ['Google', 'Vrisko', 'Treatwell', 'Foursquare']) {
+      assert.ok(en.includes(source), `${source} must be disclosed as a listing source`);
+    }
+    assert.ok(/out of date, incomplete or wrong/i.test(en));
+  });
+
+  test('tells listed businesses how to correct or remove a listing without an account', () => {
+    assert.ok(/do not need an account to ask us to remove a listing/i.test(all('en')));
+    for (const locale of LOCALES) assert.ok(all(locale).includes('hello@lookla.gr'));
+  });
+
+  test('states that Lookla is not a party to the transaction', () => {
+    assert.ok(/not a party to any agreement/i.test(all('en')));
+    assert.ok(/δεν είναι συμβαλλόμενο μέρος/i.test(all('el')));
+    assert.ok(/не является стороной/i.test(all('ru')));
+    assert.ok(/не є стороною/i.test(all('uk')));
+  });
+});
+
+describe('T-045: operator identity is stated honestly', () => {
+  test('names the operator as a natural person in every locale', () => {
+    for (const locale of LOCALES) assert.ok(all(locale).includes('Zhuykov Andrey'));
+    assert.ok(/an individual based in Greece/i.test(all('en')));
+  });
+
+  test('does not invent a company, VAT number or registered office', () => {
+    const text = LOCALES.map(all).join('\n');
+    assert.ok(!/VAT number: /i.test(text));
+    assert.ok(!/\bLtd\.|\bLLC\b|S\.A\.|Α\.Ε\.|Ε\.Π\.Ε\./.test(text));
+    assert.ok(!/registered office at/i.test(text));
+  });
+
+  test('says explicitly that there is no company registration to cite', () => {
+    assert.ok(/not currently operated by a company/i.test(all('en')));
+    assert.ok(/no company registration number, VAT number or registered office/i.test(all('en')));
+  });
+});
+
+describe('T-045: acceptance is not faked', () => {
+  test('explains that there is deliberately no acceptance checkbox', () => {
+    assert.ok(/do not ask you to tick a box/i.test(all('en')));
+  });
+
+  test('the registration page does not render a terms-acceptance checkbox', () => {
+    // The document says we do not collect an acceptance record; a checkbox
+    // appearing later would make that statement false.
+    const register = fs.readFileSync(
+      path.join(frontendRoot, 'app', '[locale]', 'register', 'page.tsx'), 'utf-8',
+    );
+    const acceptsTerms = /type=["']checkbox["'][\s\S]{0,400}(terms|Όρο|услови|умов)/i.test(register);
+    assert.ok(!acceptsTerms, 'a terms checkbox exists — the Terms text must be updated to match');
+  });
+});
+
+describe('T-045: consumer protections are not over-claimed away', () => {
+  test('does not exclude liability the law does not allow excluding', () => {
+    assert.ok(/death or personal injury caused by our negligence/i.test(all('en')));
+    assert.ok(/mandatory rights as a consumer/i.test(all('en')));
+  });
+
+  test('every locale keeps the mandatory-rights carve-out', () => {
+    assert.ok(/αναγκαστικού δικαίου δικαιώματά σας ως καταναλωτή/i.test(all('el')));
+    assert.ok(/императивные права потребителя/i.test(all('ru')));
+    assert.ok(/імперативні права споживача/i.test(all('uk')));
+  });
+
+  test('states governing law and preserves the consumer forum', () => {
+    assert.ok(/governed by Greek law/i.test(all('en')));
+    assert.ok(/courts of that country/i.test(all('en')));
+  });
+});
+
+describe('T-045: linked from the footer in every locale', () => {
+  const footer = fs.readFileSync(path.join(frontendRoot, 'components', 'Footer.tsx'), 'utf-8');
+
+  test('Footer links to /terms', () => {
+    assert.ok(footer.includes('${prefix}/terms'));
+    assert.ok(footer.includes("t('terms')"));
+  });
+
+  test('the existing privacy and cookies links are not disturbed', () => {
+    assert.ok(footer.includes('${prefix}/privacy'));
+    assert.ok(footer.includes('${prefix}/cookies'));
+  });
+
+  test('every locale has a translated footer label', () => {
+    for (const locale of LOCALES) {
+      const messages = JSON.parse(
+        fs.readFileSync(path.join(frontendRoot, 'messages', `${locale}.json`), 'utf-8'),
+      );
+      assert.ok(messages.footer?.terms, `${locale}.json is missing footer.terms`);
+    }
+    const el = JSON.parse(fs.readFileSync(path.join(frontendRoot, 'messages', 'el.json'), 'utf-8'));
+    const ru = JSON.parse(fs.readFileSync(path.join(frontendRoot, 'messages', 'ru.json'), 'utf-8'));
+    assert.notEqual(el.footer.terms, 'Terms of Service', 'el label was left in English');
+    assert.notEqual(ru.footer.terms, 'Terms of Service', 'ru label was left in English');
+  });
+});
+
+describe('T-045: cross-references to the other legal documents', () => {
+  test('points at the Privacy and Cookie policies', () => {
+    assert.ok(/Privacy Policy/i.test(all('en')) && /Cookie Policy/i.test(all('en')));
+    assert.ok(/Πολιτική Απορρήτου/.test(all('el')) && /Πολιτική Cookies/.test(all('el')));
+    assert.ok(/Политикой конфиденциальности/.test(all('ru')));
+    assert.ok(/Політикою конфіденційності/.test(all('uk')));
+  });
+
+  test('defers retention and deletion detail to the Privacy Policy rather than restating it', () => {
+    // Two documents stating retention independently is how they drift apart.
+    assert.ok(/described in our Privacy Policy/i.test(all('en')));
+    assert.ok(!/we keep messages for \d+ (months|years)/i.test(all('en')));
+  });
+});
