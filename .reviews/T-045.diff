+   */
+  companyRegistration: null,
+  vatNumber: null,
+} as const;
+
+export function isTermsPublishable(): boolean {
+  return TERMS_PUBLICATION_ENABLED && OPERATOR_DISCLOSURE.geographicAddress.trim().length > 0;
+}
