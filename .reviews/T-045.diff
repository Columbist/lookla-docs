+import type { Metadata } from 'next';
+import { notFound } from 'next/navigation';
+import Header from '@/components/Header';
+import { TERMS_CONTENT, isTermsPublishable } from './content';
+
+const LOCALES = ['el', 'en', 'ru', 'uk'] as const;
+type Locale = (typeof LOCALES)[number];
+
+function isLocale(value: string): value is Locale {
+  return (LOCALES as readonly string[]).includes(value);
+}
+
+export async function generateMetadata({ params }: { params: Promise<{ locale: string }> }): Promise<Metadata> {
+  const { locale } = await params;
+  const content = TERMS_CONTENT[isLocale(locale) ? locale : 'el'];
+  return { title: content.title };
+}
+
+export default async function TermsPage({ params }: { params: Promise<{ locale: string }> }) {
+  // The disclosure required by Article 5 of the e-Commerce Directive is
+  // incomplete until the operator's geographic address is decided, so the page
+  // is not served. 404 rather than a partial document: publishing an
+  // incomplete legal notice is worse than publishing none, and a merged branch
+  // must not become a live disclosure by accident.
+  if (!isTermsPublishable()) notFound();
+
+  const { locale } = await params;
+  const resolved: Locale = isLocale(locale) ? locale : 'el';
+  const content = TERMS_CONTENT[resolved];
+  const prefix = resolved === 'el' ? '' : `/${resolved}`;
+
+  return (
+    <div className="min-h-screen bg-surface-subtle">
+      <Header locale={resolved} variant="legal" backHref={prefix || '/'} />
+
+      {/* Same reading measure and wrapping treatment as the Privacy Policy —
+          see that page for why break-words/hyphens-auto sit on the container:
+          overflow-wrap is inherited, and legal copy carries long unbreakable
+          tokens that overflow 320px otherwise. */}
+      <main id="main-content" className="max-w-shell-reading mx-auto px-4 py-8 break-words hyphens-auto">
+        <h1 className="text-page-title text-text mb-1">{content.title}</h1>
+        {/* Version and effective date are shown together and always: the
+            document's own "Changes" section points here, so this line is part
+            of the contract rather than decoration. */}
+        <p className="text-caption text-text-muted mb-6">
+          {content.version} · {content.effectiveDate}
+        </p>
+
+        {content.intro.map((p, i) => (
+          <p key={`intro-${i}`} className="text-body text-text-secondary mb-4 leading-relaxed">{p}</p>
+        ))}
+
+        {content.sections.map((section, si) => (
+          <section key={`section-${si}`} className="mt-8">
+            <h2 className="text-section-title text-text mb-3">{section.heading}</h2>
+            {section.paragraphs.map((p, pi) => (
+              <p key={`section-${si}-p-${pi}`} className="text-body text-text-secondary mb-3 leading-relaxed">{p}</p>
+            ))}
+          </section>
+        ))}
+      </main>
+    </div>
+  );
+}
