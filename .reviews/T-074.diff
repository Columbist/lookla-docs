index 0000000..f3461fe
--- /dev/null
+++ b/backend/tests/test_t074_apply.py
@@ -0,0 +1,364 @@
+"""
+T-074: the apply script, the rollback it generates, and the systemd unit.
+
+Text inspection of a script that mutates a production firewall is not enough,
+so `docker`, `ip`, `iptables`, `iptables-save`, `iptables-restore`,
+`systemd-run` and `systemctl` are replaced by stub executables on a temporary
+`PATH`. Each stub appends its argv to a log, so the tests assert on the actual
+sequence of calls — in particular that the rollback timer is armed *before* the
+first firewall mutation, which no amount of reading the source proves.
+
+The four failure modes that motivated this file, all of which look fine until
+the day they do not:
+
+  1. the unattended systemd path arming a rollback timer nobody will cancel;
+  2. an old timer firing after a newer apply and deleting current protection;
+  3. a rollback that half-succeeds because a rule it expected is already gone;
+  4. an unresolvable bridge producing a rule that matches nothing while the
+     run still reports success.
+"""
+import os
+import re
+import shutil
+import stat
+import subprocess
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[2]
+APPLY = _ROOT / "ops" / "t074" / "apply_t074.sh"
+UNIT = _ROOT / "ops" / "t074" / "t074-smtp-egress.service"
+UNIT_TEXT = UNIT.read_text(encoding="utf-8")
+
+BRIDGE = "br-7ee6b79d9884"
+IFACE = "eth0"
+
+# Stub behaviour per command. `{log}` is substituted with the call-log path.
+_STUB = """#!/usr/bin/env bash
+printf '%s\\n' "$0 $*" >> "{log}"
+{body}
+"""
+
+
+def _make_env(tmp_path: Path, *, bridge_ok=True, iptables_c_rc=1, extra=None):
+    """Build a PATH of stubs and return (env, log_path)."""
+    bindir = tmp_path / "bin"
+    bindir.mkdir(parents=True, exist_ok=True)
+    log = tmp_path / "calls.log"
+    log.touch()
+
+    bodies = {
+        # `docker network inspect` returns the bridge name, or fails.
+        "docker": (
+            f'echo "{BRIDGE}"' if bridge_ok
+            else "exit 1"
+        ),
+        # `ip link show <bridge>` succeeds only when the bridge exists.
+        "ip": "exit 0" if bridge_ok else "exit 1",
+        # -C is the "does this rule exist" probe; default: it does not.
+        "iptables": f'case " $* " in *" -C "*) exit {iptables_c_rc};; esac; exit 0',
+        "iptables-save": 'echo "*filter"; echo "COMMIT"',
+        "iptables-restore": "exit 0",
+        "systemd-run": "exit 0",
+        "systemctl": "exit 0",
+        "python3": "exit 0",  # the rule generator is covered by its own tests
+    }
+    bodies.update(extra or {})
+
+    for name, body in bodies.items():
+        path = bindir / name
+        path.write_text(_STUB.format(log=log, body=body))
+        path.chmod(path.stat().st_mode | stat.S_IEXEC)
+
+    env = dict(os.environ)
+    env["PATH"] = f"{bindir}:{env['PATH']}"
+    env["EUID"] = "0"
+    # Never touch the host's /run or /var/backups from a test.
+    env["T074_STATE_DIR"] = str(tmp_path / "state")
+    env["T074_BACKUP_DIR"] = str(tmp_path / "backups")
+    return env, log
+
+
+def _run(tmp_path, args, env, expect_rc=None):
+    result = subprocess.run(  # noqa: S603
+        ["bash", str(APPLY), *args],
+        env=env, capture_output=True, text=True, cwd=tmp_path,
+    )
+    if expect_rc is not None:
+        assert result.returncode == expect_rc, result.stderr[-800:]
+    return result
+
+
+def _calls(log: Path) -> list[str]:
+    return [ln for ln in log.read_text().splitlines() if ln.strip()]
+
+
+pytestmark = pytest.mark.skipif(
+    shutil.which("bash") is None, reason="bash required"
+)
+
+
+# ───────────────────────── mode separation (failure mode 1) ──────────────────
+
+
+def test_a_mode_must_be_chosen_explicitly(tmp_path):
+    env, _ = _make_env(tmp_path)
+    r = _run(tmp_path, ["--interface", IFACE], env, expect_rc=2)
+    assert "--rollout or --ensure" in r.stderr
+
+
+def test_ensure_mode_never_arms_a_rollback_timer(tmp_path):
+    # The failure this whole split exists to prevent: Docker restarts, systemd
+    # re-applies, a timer is armed that nobody will cancel, and the protection
+    # deletes itself.
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--ensure"], env)
+    assert not any("systemd-run" in c for c in _calls(log)), (
+        "unattended mode armed a rollback timer"
+    )
+
+
+def test_rollout_mode_does_arm_a_timer(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    assert any("systemd-run" in c for c in _calls(log))
+
+
+def test_the_systemd_unit_uses_ensure_and_never_rollout():
+    assert "--ensure" in UNIT_TEXT
+    assert "--rollout" not in re.sub(r"^#.*$", "", UNIT_TEXT, flags=re.M), (
+        "the unit references --rollout outside comments"
+    )
+
+
+# ─────────────────────── ordering: timer before mutation ─────────────────────
+
+
+def test_the_timer_is_armed_before_the_first_firewall_mutation(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    calls = _calls(log)
+    timer = next(i for i, c in enumerate(calls) if "systemd-run" in c)
+    mutation = next(
+        (i for i, c in enumerate(calls)
+         if "python3" in c and "--apply" in c), None,
+    )
+    assert mutation is not None, "no apply call was made"
+    assert timer < mutation, "the firewall was mutated before the rollback was armed"
+
+
+def test_a_failed_timer_stops_the_run_before_any_mutation(tmp_path):
+    env, log = _make_env(tmp_path, extra={"systemd-run": "exit 1"})
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env, expect_rc=1)
+    assert not any("--apply" in c for c in _calls(log)), (
+        "the firewall was mutated even though the rollback could not be armed"
+    )
+
+
+# ───────────────────── bridge resolution (failure mode 4) ────────────────────
+
+
+def test_an_unresolvable_bridge_stops_rollout_before_any_mutation(tmp_path):
+    env, log = _make_env(tmp_path, bridge_ok=False)
+    r = _run(tmp_path, ["--interface", IFACE, "--rollout"], env, expect_rc=1)
+    assert "cannot resolve the bridge" in r.stderr
+    calls = _calls(log)
+    assert not any("iptables-save" in c for c in calls), "backups began despite no bridge"
+    assert not any("systemd-run" in c for c in calls)
+    assert not any("--apply" in c for c in calls)
+
+
+def test_a_bridge_missing_from_ip_link_also_blocks(tmp_path):
+    # `docker network inspect` can name a bridge that no longer exists on the
+    # host. Trusting the metadata alone would produce a rule matching nothing.
+    env, _ = _make_env(tmp_path, extra={"ip": "exit 1"})
+    r = _run(tmp_path, ["--interface", IFACE, "--rollout"], env, expect_rc=1)
+    assert "cannot resolve the bridge" in r.stderr
+
+
+def test_ensure_waits_and_retries_rather_than_failing_immediately(tmp_path):
+    # After=docker.service orders us after the daemon, not after the network it
+    # then recreates. A single attempt would lose that race.
+    assert "BRIDGE_WAIT_SECONDS" in APPLY.read_text(encoding="utf-8")
+    body = APPLY.read_text(encoding="utf-8")
+    ensure_block = body[body.index('if [[ "$MODE" == "ensure" ]]; then'):]
+    assert "until BRIDGE=" in ensure_block and "sleep 2" in ensure_block
+
+
+def test_the_unit_retries_on_failure():
+    assert "Restart=on-failure" in UNIT_TEXT
+    assert re.search(r"RestartSec=\S+", UNIT_TEXT)
+    assert "StartLimitBurst=" in UNIT_TEXT
+
+
+def test_start_limit_keys_are_in_the_unit_section_not_service():
+    # systemd has ignored StartLimitIntervalSec/StartLimitBurst under [Service]
+    # since v229, so putting them there silently disables the restart limit —
+    # the unit looks rate-limited and is not. `systemd-analyze verify` reported
+    # it as an unknown key, which is the only visible symptom.
+    # Parse by section headers at line starts, not by substring index: the
+    # explanatory comment above these keys contains the literal "[Service]",
+    # and an index() search finds the comment rather than the header — which
+    # is exactly how the first version of this test failed against a correct
+    # unit file.
+    sections, current = {}, None
+    for line in UNIT_TEXT.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("[") and stripped.endswith("]"):
+            current = stripped
+            sections[current] = []
+        elif current and stripped and not stripped.startswith("#"):
+            sections[current].append(stripped)
+
+    unit_keys = {ln.split("=", 1)[0] for ln in sections.get("[Unit]", [])}
+    service_keys = {ln.split("=", 1)[0] for ln in sections.get("[Service]", [])}
+    for key in ("StartLimitIntervalSec", "StartLimitBurst"):
+        assert key in unit_keys, f"{key} must be in [Unit]"
+        assert key not in service_keys, f"{key} is ignored in [Service]"
+
+
+def test_the_unit_does_not_report_active_without_live_rules():
+    # ExecStart verifies before exiting 0, so a unit that is "active" means the
+    # rules are really there.
+    body = APPLY.read_text(encoding="utf-8")
+    assert "verify_live || fail \"ensure:" in body
+
+
+# ───────────────── generation scoping (failure mode 2) ───────────────────────
+
+
+def _generated_rollback(tmp_path, env):
+    _run(tmp_path, ["--interface", IFACE, "--rollout", "--dry-run"], env)
+    found = sorted(Path(env["T074_STATE_DIR"]).glob("*/rollback.sh"))
+    assert found, "no rollback script was generated"
+    return found[-1]
+
+
+def test_each_rollout_gets_its_own_rollback_artifact(tmp_path):
+    env, _ = _make_env(tmp_path)
+    first = _generated_rollback(tmp_path, env)
+    second = _generated_rollback(tmp_path, env)
+    assert first != second, (
+        "a later rollout overwrote the earlier rollback — an old timer would "
+        "then execute the newer transaction's rollback"
+    )
+
+
+def test_the_rollback_refuses_to_run_when_superseded(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env).read_text()
+    assert "superseded" in script
+    assert "CURRENT_FILE" in script
+
+
+def test_the_timer_unit_name_carries_the_generation(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    armed = next(c for c in _calls(log) if "systemd-run" in c)
+    assert "lookla-t074-rollback-" in armed
+    assert "--unit=lookla-t074-rollback\n" not in armed  # not a bare, shared name
+
+
+def test_stale_timers_are_stopped_explicitly_before_a_new_rollout(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    assert any("list-units" in c for c in _calls(log)), (
+        "a previous rollout's timer would be left to coexist silently"
+    )
+
+
+# ────────────────── rollback content and idempotence (mode 3) ────────────────
+
+
+def test_the_rollback_removes_both_jumps_and_the_chain(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env).read_text()
+    assert "drop_rule OUTPUT" in script
+    assert "drop_rule DOCKER-USER" in script
+    assert "-F LOOKLA-T074-DENY" in script
+    assert "-X LOOKLA-T074-DENY" in script
+
+
+def test_the_rollback_guards_every_removal_with_an_existence_test(tmp_path):
+    # A missing rule must not turn the rollback into a partial failure.
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env).read_text()
+    assert 'iptables -w -C "$chain" "$@"' in script
+    assert "already absent" in script
+
+
+def test_the_rollback_removes_by_full_match_not_line_number(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env).read_text()
+    assert not re.search(r"iptables\s+(-w\s+)?-D\s+\w+\s+\d+\b", script), (
+        "removal by line number shifts when other rules change"
+    )
+
+
+@pytest.mark.parametrize(
+    "forbidden",
+    ["LOOKLA-CLOUDFLARE", "LOOKLA-T072-DENY", "iptables-restore", "-F OUTPUT", "-F DOCKER-USER"],
+)
+def test_the_rollback_never_touches_neighbouring_or_builtin_chains(tmp_path, forbidden):
+    env, _ = _make_env(tmp_path)
+    assert forbidden not in _generated_rollback(tmp_path, env).read_text()
+
+
+def test_the_apply_refuses_to_arm_a_rollback_that_names_a_neighbour(tmp_path):
+    # The check is in the script, not only in this test file, so a future edit
+    # to the heredoc cannot quietly arm a destructive rollback.
+    assert 'fail "generated rollback references' in APPLY.read_text(encoding="utf-8")
+
+
+def test_the_generated_rollback_is_valid_shell_and_runs_twice(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    subprocess.run(["bash", "-n", str(script)], check=True)  # noqa: S603
+
+    # Behavioural: first run removes, second run finds nothing and still exits 0.
+    # The generation guard is satisfied by construction — this rollback belongs
+    # to the only generation in its own state dir.
+    env2, _ = _make_env(tmp_path / "second", iptables_c_rc=0)
+    env2["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    first = subprocess.run(  # noqa: S603
+        ["bash", str(script)], env=env2, capture_output=True, text=True,
+    )
+    assert first.returncode == 0, first.stderr
+    assert "removed jump" in first.stdout
+
+    env3, _ = _make_env(tmp_path / "third", iptables_c_rc=1)
+    env3["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    second = subprocess.run(  # noqa: S603
+        ["bash", str(script)], env=env3, capture_output=True, text=True,
+    )
+    assert second.returncode == 0, second.stderr
+    assert "already absent" in second.stdout
+
+
+# ───────────────────────────── shared defaults ───────────────────────────────
+
+
+def test_the_rollback_window_is_a_single_named_default_of_900(tmp_path):
+    body = APPLY.read_text(encoding="utf-8")
+    assert "DEFAULT_ROLLBACK_AFTER=900" in body, (
+        "unified with T-049 and T-072; the smoke covers host, six containers, "
+        "WireGuard, 465/587 and the neighbouring chains"
+    )
+    assert "default: $DEFAULT_ROLLBACK_AFTER" in body, "the help must show it"
+
+
+def test_the_window_is_overridable(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout", "--rollback-after", "120"], env)
+    armed = next(c for c in _calls(log) if "systemd-run" in c)
+    assert "--on-active=120" in armed
+
+
+def test_dry_run_mutates_nothing_in_either_mode(tmp_path):
+    for mode in ("--rollout", "--ensure"):
+        env, log = _make_env(tmp_path / mode.strip("-"))
+        _run(tmp_path, ["--interface", IFACE, mode, "--dry-run"], env)
+        calls = _calls(log)
+        assert not any("--apply" in c for c in calls), mode
+        assert not any("systemd-run" in c for c in calls), mode
