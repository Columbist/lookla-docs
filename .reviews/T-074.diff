index 0000000..5d84126
--- /dev/null
+++ b/ops/t074/t074-smtp-egress.service
@@ -0,0 +1,60 @@
+# T-074 — reinstate the outbound SMTP denial after boot or a Docker restart.
+#
+# Runs the apply script in ensure mode, never rollout mode. Rollout arms a
+# timed rollback and waits for an operator to smoke-test and cancel it; running
+# that from systemd would mean a Docker restart re-applies the rule, arms a
+# timer nobody is watching, and the protection deletes itself minutes later. A
+# test asserts this unit never names the rollout mode.
+#
+# PartOf=docker.service re-runs this when Docker restarts, which matters
+# because recreating the compose network changes the bridge name: ensure mode
+# re-resolves it from current state instead of reusing a stored value.
+#
+# Restart=on-failure exists for a race that ordering alone does not fix.
+# After=docker.service orders this after the daemon, not after the network and
+# containers the daemon then recreates, so the first attempt can find no
+# bridge. Ensure mode already waits up to 60s internally; the restart is the
+# second line of defence. The unit fails loudly rather than sitting active with
+# no rule, because the script verifies the live rules before exiting 0.
+#
+# Install:
+#   cp t074-smtp-egress.service /etc/systemd/system/
+#   systemctl daemon-reload && systemctl enable t074-smtp-egress.service
+#
+# Documented limitation: recreating the compose network *without* restarting
+# Docker produces no systemd event, so this unit does not re-run and the
+# container jump will name a bridge that no longer exists.
+#
+#   detect:   iptables -S DOCKER-USER | grep -q "$(docker network inspect \
+#               beauty-gr_default \
+#               --format '{{index .Options "com.docker.network.bridge.name"}}')" \
+#               || echo "T-074 rule points at a stale bridge"
+#   recover:  systemctl restart t074-smtp-egress.service
+
+[Unit]
+Description=T-074 outbound SMTP restriction (TCP/25)
+Documentation=file:/opt/t074/apply_t074.sh
+Wants=network-online.target
+After=network-online.target docker.service
+Requires=docker.service
+PartOf=docker.service
+# These two belong here, not in the service section. systemd has ignored them
+# there since v229, so putting them below would silently disable the restart
+# limit — the unit looks rate-limited and is not. `systemd-analyze verify`
+# reports it only as an unknown key, which is easy to miss.
+StartLimitIntervalSec=300
+StartLimitBurst=5
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# Idempotent: the chain is rebuilt in one atomic transaction and each jump is
+# inserted only when absent, so repeated starts cannot stack duplicates.
+ExecStart=/opt/t074/apply_t074.sh --interface eth0 --ensure
+Restart=on-failure
+RestartSec=10s
+StandardOutput=journal
+StandardError=journal
+
+[Install]
+WantedBy=multi-user.target
