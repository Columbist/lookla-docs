+++ b/ops/t074/apply_t074.sh
@@ -0,0 +1,263 @@
+#!/usr/bin/env bash
+# T-074 — apply the outbound SMTP restriction.
+#
+# Two modes, and the distinction is the whole point of this script.
+#
+#   --rollout   An operator is present. Takes backups, arms a timed rollback
+#               BEFORE the first mutation, applies, and then waits for that
+#               operator to smoke-test and cancel the timer.
+#
+#   --ensure    Nobody is present. Used by the systemd unit after a boot or a
+#               Docker restart. Resolves the bridge from current state, applies
+#               idempotently, verifies the live rule, and arms NO timer.
+#
+# Running --rollout from systemd would be the worst failure this script could
+# have: Docker restarts, the unit re-applies, a ten-minute rollback timer is
+# armed, nobody is there to cancel it, and the protection deletes itself.
+# `--ensure` exists so that cannot happen, and a test asserts the unit uses it.
+#
+# Rollback artifacts are generation-scoped. Each rollout gets its own directory
+# and its own transient timer, and records itself as the current generation. A
+# timer whose generation is no longer current exits without touching anything —
+# otherwise an old timer could fire after a newer apply and delete protection
+# that a different transaction installed.
+
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# Overridable so tests can exercise the real script without writing to the
+# host's /run and /var/backups. Production never sets these.
+STATE_DIR="${T074_STATE_DIR:-/run/lookla-t074}"
+BACKUP_DIR="${T074_BACKUP_DIR:-/var/backups/t074}"
+NETWORK="beauty-gr_default"
+CHAIN="LOOKLA-T074-DENY"
+COMMENT="T-074 deny outbound SMTP"
+
+#: Single named default, shared with T-049 and T-072. The smoke that follows a
+#: rollout covers the host, six containers, WireGuard, 465/587 and the
+#: neighbouring chains; ten minutes is not enough to do that unhurried.
+DEFAULT_ROLLBACK_AFTER=900
+
+#: How long --ensure waits for Docker to finish restoring the compose network.
+#: `After=docker.service` orders us after the daemon, not after the network and
+#: containers it then recreates, so a bounded wait is required or the unit
+#: races the very thing it depends on.
+BRIDGE_WAIT_SECONDS=60
+
+MODE=""
+INTERFACE=""
+ROLLBACK_AFTER="$DEFAULT_ROLLBACK_AFTER"
+DRY_RUN=0
+
+usage() {
+  cat <<USAGE
+usage: apply_t074.sh --interface IFACE (--rollout | --ensure) [options]
+
+  --rollout                 attended: backups, timed rollback, manual cancel
+  --ensure                  unattended: idempotent, verified, NO timer
+  --interface IFACE         external interface (required)
+  --network NAME            compose network (default: $NETWORK)
+  --rollback-after SECONDS  rollout only (default: $DEFAULT_ROLLBACK_AFTER)
+  --dry-run                 print what would happen, mutate nothing
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --rollout)        MODE="rollout"; shift ;;
+    --ensure)         MODE="ensure"; shift ;;
+    --interface)      INTERFACE="$2"; shift 2 ;;
+    --network)        NETWORK="$2"; shift 2 ;;
+    --rollback-after) ROLLBACK_AFTER="$2"; shift 2 ;;
+    --dry-run)        DRY_RUN=1; shift ;;
+    -h|--help)        usage; exit 0 ;;
+    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
+  esac
+done
+
+[[ -n "$INTERFACE" ]] || { echo "--interface is required" >&2; exit 2; }
+[[ -n "$MODE" ]] || { echo "one of --rollout or --ensure is required" >&2; exit 2; }
+[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 2; }
+
+log()  { printf '[t074] %s\n' "$*"; }
+fail() { printf '[t074] FAIL: %s\n' "$*" >&2; exit 1; }
+
+# ── bridge resolution, with a bounded wait in --ensure ───────────────────────
+# A stale or unresolvable bridge produces a rule that matches nothing while the
+# run still reports success — the failure that would leave containers able to
+# send. So resolution failing is fatal, never a warning.
+resolve_bridge() {
+  local name id
+  name="$(docker network inspect "$NETWORK" \
+    --format '{{index .Options "com.docker.network.bridge.name"}}' 2>/dev/null || true)"
+  if [[ -z "$name" || "$name" == "<no value>" ]]; then
+    id="$(docker network inspect "$NETWORK" --format '{{.Id}}' 2>/dev/null || true)"
+    [[ -n "$id" ]] || return 1
+    name="br-${id:0:12}"
+  fi
+  ip link show "$name" >/dev/null 2>&1 || return 1
+  printf '%s' "$name"
+}
+
+BRIDGE=""
+if [[ "$MODE" == "ensure" ]]; then
+  deadline=$(( SECONDS + BRIDGE_WAIT_SECONDS ))
+  until BRIDGE="$(resolve_bridge)"; do
+    (( SECONDS < deadline )) || fail "compose network $NETWORK did not appear within ${BRIDGE_WAIT_SECONDS}s"
+    sleep 2
+  done
+else
+  BRIDGE="$(resolve_bridge)" \
+    || fail "cannot resolve the bridge for network $NETWORK — refusing to apply a rule that would match nothing"
+fi
+log "compose bridge: $BRIDGE"
+
+apply_rules() {
+  python3 "$HERE/smtp_egress.py" --interface "$INTERFACE" --bridge "$BRIDGE" --apply
+}
+
+# Assert the live rules exist. `--ensure` must not report success while the
+# firewall is unprotected, or systemd will show the unit active and green with
+# no rule in place.
+verify_live() {
+  iptables -w -C OUTPUT -o "$INTERFACE" -p tcp --dport 25 \
+    -m comment --comment "$COMMENT host" -j "$CHAIN" 2>/dev/null \
+    || return 1
+  iptables -w -C DOCKER-USER -i "$BRIDGE" -o "$INTERFACE" -p tcp --dport 25 \
+    -m comment --comment "$COMMENT containers" -j "$CHAIN" 2>/dev/null \
+    || return 1
+}
+
+# ── unattended path ──────────────────────────────────────────────────────────
+if [[ "$MODE" == "ensure" ]]; then
+  if [[ $DRY_RUN -eq 1 ]]; then
+    log "dry run (ensure)"
+    python3 "$HERE/smtp_egress.py" --interface "$INTERFACE" --bridge "$BRIDGE"
+    exit 0
+  fi
+  apply_rules || fail "ensure: apply failed"
+  verify_live || fail "ensure: rules are not present after apply — refusing to report success"
+  log "ensure: rules verified live (no rollback timer armed, by design)"
+  exit 0
+fi
+
+# ── attended rollout ─────────────────────────────────────────────────────────
+GENERATION="$(date -u +%Y%m%dT%H%M%SZ)-$$"
+GEN_DIR="$STATE_DIR/$GENERATION"
+BACKUP="$BACKUP_DIR/$GENERATION"
+mkdir -p "$GEN_DIR" "$BACKUP"
+chmod 700 "$STATE_DIR"
+
+iptables-save > "$BACKUP/iptables.rules"
+[[ -s "$BACKUP/iptables.rules" ]] || fail "iptables backup is empty — refusing to continue"
+# Captured separately so the neighbouring tickets can be diffed afterwards and
+# shown untouched.
+iptables -S LOOKLA-CLOUDFLARE > "$BACKUP/t049-chain.txt" 2>/dev/null || true
+iptables -S LOOKLA-T072-DENY  > "$BACKUP/t072-chain.txt" 2>/dev/null || true
+ln -sfn "$BACKUP" "$BACKUP_DIR/latest"
+log "backup: $BACKUP"
+log "generation: $GENERATION"
+
+ROLLBACK="$GEN_DIR/rollback.sh"
+cat > "$ROLLBACK" <<ROLLBACK_EOF
+#!/usr/bin/env bash
+# T-074 rollback for generation $GENERATION.
+#
+# Removes exactly what this transaction added and nothing else. Needs no
+# network and no repository. Idempotent: every removal is guarded by a -C test,
+# so running it twice succeeds and changes nothing the second time.
+set -euo pipefail
+
+GENERATION="$GENERATION"
+CURRENT_FILE="$STATE_DIR/current"
+
+# Generation guard. A timer from an earlier rollout must not fire after a later
+# apply and delete protection that a different transaction installed.
+if [[ -r "\$CURRENT_FILE" ]]; then
+  current="\$(cat "\$CURRENT_FILE")"
+  if [[ "\$current" != "\$GENERATION" ]]; then
+    echo "[t074] rollback \$GENERATION superseded by \$current — doing nothing"
+    exit 0
+  fi
+fi
+
+drop_rule() {
+  local chain="\$1"; shift
+  if iptables -w -C "\$chain" "\$@" 2>/dev/null; then
+    iptables -w -D "\$chain" "\$@"
+    echo "[t074] removed jump from \$chain"
+  else
+    echo "[t074] jump already absent from \$chain"
+  fi
+}
+
+# 1. exact jumps, by full match — never by line number, which shifts.
+drop_rule OUTPUT -o $INTERFACE -p tcp --dport 25 -m comment --comment "$COMMENT host" -j $CHAIN
+drop_rule DOCKER-USER -i $BRIDGE -o $INTERFACE -p tcp --dport 25 -m comment --comment "$COMMENT containers" -j $CHAIN
+
+# 2 & 3. our own chain, flushed then removed, and only if it exists.
+if iptables -w -S $CHAIN >/dev/null 2>&1; then
+  iptables -w -F $CHAIN
+  iptables -w -X $CHAIN
+  echo "[t074] removed chain $CHAIN"
+else
+  echo "[t074] chain $CHAIN already absent"
+fi
+
+# 4. Nothing else is touched. This script flushes no built-in chain, restores
+#    no whole ruleset, and names no other ticket's chain — the generator
+#    refuses to arm a rollback that does, so the guarantee is enforced rather
+#    than merely intended. (Naming the forbidden strings here would trip that
+#    check, which is why they are described instead of listed.)
+rm -f "\$CURRENT_FILE"
+echo "[t074] rolled back generation \$GENERATION"
+ROLLBACK_EOF
+chmod +x "$ROLLBACK"
+bash -n "$ROLLBACK" || fail "generated rollback script is not valid shell"
+for forbidden in "LOOKLA-CLOUDFLARE" "LOOKLA-T072-DENY" "iptables-restore" "-F OUTPUT" "-F DOCKER-USER"; do
+  grep -q -- "$forbidden" "$ROLLBACK" && fail "generated rollback references '$forbidden' — refusing to arm it"
+done
+log "rollback: $ROLLBACK"
+
+if [[ $DRY_RUN -eq 1 ]]; then
+  log "dry run (rollout) — rollback generated and validated, nothing applied"
+  python3 "$HERE/smtp_egress.py" --interface "$INTERFACE" --bridge "$BRIDGE"
+  exit 0
+fi
+
+# Any timer left armed by an earlier rollout is dealt with explicitly rather
+# than left to coexist silently.
+for unit in $(systemctl list-units --all --no-legend 'lookla-t074-rollback-*.timer' 2>/dev/null | awk '{print $1}'); do
+  log "stopping stale rollback timer: $unit"
+  systemctl stop "$unit" 2>/dev/null || true
+done
+
+printf '%s' "$GENERATION" > "$STATE_DIR/current"
+
+TIMER_UNIT="lookla-t074-rollback-$GENERATION"
+systemd-run --on-active="$ROLLBACK_AFTER" --unit="$TIMER_UNIT" \
+  --description="T-074 automatic rollback ($GENERATION)" "$ROLLBACK" >/dev/null \
+  || fail "could not arm the rollback timer — nothing has been applied"
+log "rollback armed: ${ROLLBACK_AFTER}s as $TIMER_UNIT.timer"
+
+# Only now is the firewall touched.
+apply_rules || fail "apply failed — the armed rollback will restore automatically"
+verify_live || fail "rules are not present after apply — the armed rollback will restore automatically"
+
+cat <<NEXT
+
+[t074] Applied, generation $GENERATION. Verify, then cancel:
+
+    1. host:        TCP connect to a public MX on 25 refused IMMEDIATELY
+    2. containers:  the same from each of the six on $BRIDGE
+    3. positive:    443 and 53 work; 465/587 not blocked
+    4. wg0:         VPN egress policy unchanged
+    5. neighbours:  T-049 and T-072 chains byte-identical to the backup
+    6. app:         lookla.gr in all locales, API, Resend HTTPS path
+
+  systemctl stop $TIMER_UNIT.timer
+
+Roll back now:
+
+  $ROLLBACK
+NEXT
