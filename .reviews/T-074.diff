+"""
+T-074: the apply script, the rollback it generates, and the systemd unit.
+
+Text inspection of a script that mutates a production firewall is not enough,
+so `docker`, `ip`, `iptables`, `iptables-save`, `iptables-restore`,
+`systemd-run` and `systemctl` are replaced by stub executables on a temporary
+`PATH`. Each stub appends its argv to a log, so the tests assert on the actual
+sequence of calls — in particular that the rollback timer is armed *before* the
+first firewall mutation, which no amount of reading the source proves.
+
+The four failure modes that motivated this file, all of which look fine until
+the day they do not:
+
+  1. the unattended systemd path arming a rollback timer nobody will cancel;
+  2. an old timer firing after a newer apply and deleting current protection;
+  3. a rollback that half-succeeds because a rule it expected is already gone;
+  4. an unresolvable bridge producing a rule that matches nothing while the
+     run still reports success.
+"""
+import os
+import re
+import shutil
+import stat
+import subprocess
+import time
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[2]
+APPLY = _ROOT / "ops" / "t074" / "apply_t074.sh"
+UNIT = _ROOT / "ops" / "t074" / "t074-smtp-egress.service"
+UNIT_TEXT = UNIT.read_text(encoding="utf-8")
+
+BRIDGE = "br-7ee6b79d9884"
+IFACE = "eth0"
+
+# Stub behaviour per command. `{log}` is substituted with the call-log path.
+_STUB = """#!/usr/bin/env bash
+printf '%s\\n' "$0 $*" >> "{log}"
+{body}
+"""
+
+
+def _make_env(tmp_path: Path, *, bridge_ok=True, iptables_c_rc=1, extra=None):
+    """Build a PATH of stubs and return (env, log_path)."""
+    bindir = tmp_path / "bin"
+    bindir.mkdir(parents=True, exist_ok=True)
+    log = tmp_path / "calls.log"
+    log.touch()
+
+    bodies = {
+        # `docker network inspect` returns the bridge name, or fails.
+        "docker": (
+            f'echo "{BRIDGE}"' if bridge_ok
+            else "exit 1"
+        ),
+        # `ip link show <bridge>` succeeds only when the bridge exists.
+        "ip": "exit 0" if bridge_ok else "exit 1",
+        # -C is the "does this rule exist" probe; default: it does not.
+        "iptables": f'case " $* " in *" -C "*) exit {iptables_c_rc};; esac; exit 0',
+        "iptables-save": 'echo "*filter"; echo "COMMIT"',
+        # Records the document it was given, so tests can assert on what would
+        # actually reach the kernel rather than on log lines.
+        "iptables-restore": f'cat > "{tmp_path}/restore-input"; exit 0',
+        "systemd-run": "exit 0",
+        "systemctl": "exit 0",
+        "python3": "exit 0",  # the rule generator is covered by its own tests
+    }
+    bodies.update(extra or {})
+
+    for name, body in bodies.items():
+        path = bindir / name
+        path.write_text(_STUB.format(log=log, body=body))
+        path.chmod(path.stat().st_mode | stat.S_IEXEC)
+
+    env = dict(os.environ)
+    env["PATH"] = f"{bindir}:{env['PATH']}"
+    env["EUID"] = "0"
+    # Never touch the host's /run or /var/backups from a test.
+    env["T074_STATE_DIR"] = str(tmp_path / "state")
+    env["T074_BACKUP_DIR"] = str(tmp_path / "backups")
+    return env, log
+
+
+def _run(tmp_path, args, env, expect_rc=None):
+    result = subprocess.run(  # noqa: S603
+        ["bash", str(APPLY), *args],
+        env=env, capture_output=True, text=True, cwd=tmp_path,
+    )
+    if expect_rc is not None:
+        assert result.returncode == expect_rc, result.stderr[-800:]
+    return result
+
+
+def _calls(log: Path) -> list[str]:
+    return [ln for ln in log.read_text().splitlines() if ln.strip()]
+
+
+pytestmark = pytest.mark.skipif(
+    shutil.which("bash") is None, reason="bash required"
+)
+
+
+# ───────────────────────── mode separation (failure mode 1) ──────────────────
+
+
+def test_a_mode_must_be_chosen_explicitly(tmp_path):
+    env, _ = _make_env(tmp_path)
+    r = _run(tmp_path, ["--interface", IFACE], env, expect_rc=2)
+    assert "--rollout or --ensure" in r.stderr
+
+
+def test_ensure_mode_never_arms_a_rollback_timer(tmp_path):
+    # The failure this whole split exists to prevent: Docker restarts, systemd
+    # re-applies, a timer is armed that nobody will cancel, and the protection
+    # deletes itself.
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--ensure"], env)
+    assert not any("systemd-run" in c for c in _calls(log)), (
+        "unattended mode armed a rollback timer"
+    )
+
+
+def test_rollout_mode_does_arm_a_timer(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    assert any("systemd-run" in c for c in _calls(log))
+
+
+def test_the_systemd_unit_uses_ensure_and_never_rollout():
+    assert "--ensure" in UNIT_TEXT
+    assert "--rollout" not in re.sub(r"^#.*$", "", UNIT_TEXT, flags=re.M), (
+        "the unit references --rollout outside comments"
+    )
+
+
+# ─────────────────────── ordering: timer before mutation ─────────────────────
+
+
+def test_the_timer_is_armed_before_the_first_firewall_mutation(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    calls = _calls(log)
+    timer = next(i for i, c in enumerate(calls) if "systemd-run" in c)
+    mutation = next(
+        (i for i, c in enumerate(calls)
+         if "python3" in c and "--apply" in c), None,
+    )
+    assert mutation is not None, "no apply call was made"
+    assert timer < mutation, "the firewall was mutated before the rollback was armed"
+
+
+def test_a_failed_timer_stops_the_run_before_any_mutation(tmp_path):
+    env, log = _make_env(tmp_path, extra={"systemd-run": "exit 1"})
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env, expect_rc=1)
+    assert not any("--apply" in c for c in _calls(log)), (
+        "the firewall was mutated even though the rollback could not be armed"
+    )
+
+
+# ───────────────────── bridge resolution (failure mode 4) ────────────────────
+
+
+def test_an_unresolvable_bridge_stops_rollout_before_any_mutation(tmp_path):
+    env, log = _make_env(tmp_path, bridge_ok=False)
+    r = _run(tmp_path, ["--interface", IFACE, "--rollout"], env, expect_rc=1)
+    assert "cannot resolve the bridge" in r.stderr
+    calls = _calls(log)
+    assert not any("iptables-save" in c for c in calls), "backups began despite no bridge"
+    assert not any("systemd-run" in c for c in calls)
+    assert not any("--apply" in c for c in calls)
+
+
+def test_a_bridge_missing_from_ip_link_also_blocks(tmp_path):
+    # `docker network inspect` can name a bridge that no longer exists on the
+    # host. Trusting the metadata alone would produce a rule matching nothing.
+    env, _ = _make_env(tmp_path, extra={"ip": "exit 1"})
+    r = _run(tmp_path, ["--interface", IFACE, "--rollout"], env, expect_rc=1)
+    assert "cannot resolve the bridge" in r.stderr
+
+
+def test_ensure_waits_and_retries_rather_than_failing_immediately(tmp_path):
+    # After=docker.service orders us after the daemon, not after the network it
+    # then recreates. A single attempt would lose that race.
+    assert "BRIDGE_WAIT_SECONDS" in APPLY.read_text(encoding="utf-8")
+    body = APPLY.read_text(encoding="utf-8")
+    ensure_block = body[body.index('if [[ "$MODE" == "ensure" ]]; then'):]
+    assert "until BRIDGE=" in ensure_block and "sleep 2" in ensure_block
+
+
+def test_the_unit_retries_on_failure():
+    assert "Restart=on-failure" in UNIT_TEXT
+    assert re.search(r"RestartSec=\S+", UNIT_TEXT)
+    assert "StartLimitBurst=" in UNIT_TEXT
+
+
+def test_start_limit_keys_are_in_the_unit_section_not_service():
+    # systemd has ignored StartLimitIntervalSec/StartLimitBurst under [Service]
+    # since v229, so putting them there silently disables the restart limit —
+    # the unit looks rate-limited and is not. `systemd-analyze verify` reported
+    # it as an unknown key, which is the only visible symptom.
+    # Parse by section headers at line starts, not by substring index: the
+    # explanatory comment above these keys contains the literal "[Service]",
+    # and an index() search finds the comment rather than the header — which
+    # is exactly how the first version of this test failed against a correct
+    # unit file.
+    sections, current = {}, None
+    for line in UNIT_TEXT.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("[") and stripped.endswith("]"):
+            current = stripped
+            sections[current] = []
+        elif current and stripped and not stripped.startswith("#"):
+            sections[current].append(stripped)
+
+    unit_keys = {ln.split("=", 1)[0] for ln in sections.get("[Unit]", [])}
+    service_keys = {ln.split("=", 1)[0] for ln in sections.get("[Service]", [])}
+    for key in ("StartLimitIntervalSec", "StartLimitBurst"):
+        assert key in unit_keys, f"{key} must be in [Unit]"
+        assert key not in service_keys, f"{key} is ignored in [Service]"
+
+
+def test_the_unit_does_not_report_active_without_live_rules():
+    # ExecStart verifies before exiting 0, so a unit that is "active" means the
+    # rules are really there.
+    body = APPLY.read_text(encoding="utf-8")
+    assert "verify_live || fail \"ensure:" in body
+
+
+# ───────────────── generation scoping (failure mode 2) ───────────────────────
+
+
+def _generated_rollback(tmp_path, env):
+    _run(tmp_path, ["--interface", IFACE, "--rollout", "--dry-run"], env)
+    found = sorted(Path(env["T074_STATE_DIR"]).glob("*/rollback.sh"))
+    assert found, "no rollback script was generated"
+    return found[-1]
+
+
+def test_each_rollout_gets_its_own_rollback_artifact(tmp_path):
+    env, _ = _make_env(tmp_path)
+    first = _generated_rollback(tmp_path, env)
+    second = _generated_rollback(tmp_path, env)
+    assert first != second, (
+        "a later rollout overwrote the earlier rollback — an old timer would "
+        "then execute the newer transaction's rollback"
+    )
+
+
+def test_the_rollback_refuses_to_run_when_superseded(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env).read_text()
+    assert "CURRENT_FILE" in script
+    assert "not current" in script
+    # And it refuses on absence too — see the fail-closed tests below.
+    assert "no current-generation marker" in script
+
+
+def test_the_timer_unit_name_carries_the_generation(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    armed = next(c for c in _calls(log) if "systemd-run" in c)
+    assert "lookla-t074-rollback-" in armed
+    assert "--unit=lookla-t074-rollback\n" not in armed  # not a bare, shared name
+
+
+def test_stale_timers_are_stopped_explicitly_before_a_new_rollout(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], env)
+    assert any("list-units" in c for c in _calls(log)), (
+        "a previous rollout's timer would be left to coexist silently"
+    )
+
+
+# ────────────────── rollback content and idempotence (mode 3) ────────────────
+
+
+@pytest.mark.parametrize(
+    "forbidden",
+    ["LOOKLA-CLOUDFLARE", "LOOKLA-T072-DENY", "-F OUTPUT", "-F DOCKER-USER"],
+)
+def test_the_rollback_never_touches_neighbouring_or_builtin_chains(tmp_path, forbidden):
+    env, _ = _make_env(tmp_path)
+    assert forbidden not in _generated_rollback(tmp_path, _with_lock(env, tmp_path)).read_text()
+
+
+def test_the_apply_refuses_to_arm_a_rollback_that_names_a_neighbour(tmp_path):
+    # The check is in the script, not only in this test file, so a future edit
+    # to the heredoc cannot quietly arm a destructive rollback.
+    assert 'fail "generated rollback references' in APPLY.read_text(encoding="utf-8")
+
+
+# ───────────────────────────── shared defaults ───────────────────────────────
+
+
+def test_the_rollback_window_is_a_single_named_default_of_900(tmp_path):
+    body = APPLY.read_text(encoding="utf-8")
+    assert "DEFAULT_ROLLBACK_AFTER=900" in body, (
+        "unified with T-049 and T-072; the smoke covers host, six containers, "
+        "WireGuard, 465/587 and the neighbouring chains"
+    )
+    assert "default: $DEFAULT_ROLLBACK_AFTER" in body, "the help must show it"
+
+
+def test_the_window_is_overridable(tmp_path):
+    env, log = _make_env(tmp_path)
+    _run(tmp_path, ["--interface", IFACE, "--rollout", "--rollback-after", "120"], env)
+    armed = next(c for c in _calls(log) if "systemd-run" in c)
+    assert "--on-active=120" in armed
+
+
+def test_dry_run_mutates_nothing_in_either_mode(tmp_path):
+    for mode in ("--rollout", "--ensure"):
+        env, log = _make_env(tmp_path / mode.strip("-"))
+        _run(tmp_path, ["--interface", IFACE, mode, "--dry-run"], env)
+        calls = _calls(log)
+        assert not any("--apply" in c for c in calls), mode
+        assert not any("systemd-run" in c for c in calls), mode
+
+
+# ───────────────── generation guard: fail-closed (T-074 review) ──────────────
+# The marker's ABSENCE is not evidence that this generation is current, so the
+# guard refuses then too. A legitimate automatic rollback always has it: the
+# rollout writes the marker before arming the timer, and arms the timer before
+# touching the firewall.
+
+
+def _rollback_with_marker(tmp_path, marker: str | None):
+    """Generate a rollback, set /run's marker to `marker`, run it, return stdout."""
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    generation = script.parent.name
+    current = Path(env["T074_STATE_DIR"]) / "current"
+
+    if marker is None:
+        current.unlink(missing_ok=True)
+    else:
+        current.write_text(marker.replace("<self>", generation))
+
+    run_env, _ = _make_env(tmp_path / "runner", iptables_c_rc=0)
+    run_env["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    result = subprocess.run(  # noqa: S603
+        ["bash", str(script)], env=run_env, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    return result.stdout
+
+
+def test_rollback_runs_when_the_marker_matches(tmp_path):
+    out = _rollback_with_marker(tmp_path, "<self>")
+    assert "rolled back generation" in out
+    assert "not current" not in out
+
+
+def test_rollback_is_a_noop_for_a_different_generation(tmp_path):
+    out = _rollback_with_marker(tmp_path, "20200101T000000Z-1")
+    assert "not current" in out
+    assert "rolled back generation" not in out
+
+
+def test_rollback_refuses_when_the_marker_is_absent(tmp_path):
+    # Previously this ran the rollback — fail-open authorisation for a
+    # destructive operation.
+    out = _rollback_with_marker(tmp_path, None)
+    assert "no current-generation marker" in out
+    assert "rolled back generation" not in out
+
+
+def test_rollback_refuses_when_the_marker_is_empty(tmp_path):
+    out = _rollback_with_marker(tmp_path, "")
+    assert "rolled back generation" not in out
+    assert "not current" in out or "no current-generation marker" in out
+
+
+def test_rollback_refuses_when_the_marker_is_unreadable(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    current = Path(env["T074_STATE_DIR"]) / "current"
+    current.write_text("whatever")
+    current.chmod(0o000)
+    try:
+        run_env, _ = _make_env(tmp_path / "runner2", iptables_c_rc=0)
+        run_env["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+        result = subprocess.run(  # noqa: S603
+            ["bash", str(script)], env=run_env, capture_output=True, text=True,
+        )
+        assert result.returncode == 0, result.stderr
+        assert "rolled back generation" not in result.stdout
+    finally:
+        current.chmod(0o600)
+
+
+def test_the_boot_scoping_of_the_marker_is_documented(tmp_path):
+    # /run is tmpfs and the timer is transient, so both are scoped to this
+    # boot. That is a design choice, not the reason the guard is safe — the
+    # script says so, because relying on it silently would be a trap.
+    env, _ = _make_env(tmp_path)
+    body = APPLY.read_text(encoding="utf-8")
+    assert "current boot" in body
+    assert "not the reason the" in body and "guard is safe" in body
+
+
+# ────────────── verify_live now checks the contract, not existence ───────────
+
+
+def test_verify_live_delegates_to_the_generator_contract():
+    # The contract must not be restated in shell, where it would drift from
+    # what the generator actually produces.
+    body = APPLY.read_text(encoding="utf-8")
+    verify_block = body[body.index("verify_live() {"):body.index("}", body.index("verify_live() {"))]
+    assert "--verify" in verify_block
+    assert "iptables -w -C" not in verify_block, (
+        "the contract is duplicated in shell instead of delegated"
+    )
+
+
+def test_ensure_fails_when_verification_fails(tmp_path):
+    # A failing --verify must stop `ensure` reporting success, or systemd shows
+    # the unit active with the firewall open.
+    env, _ = _make_env(tmp_path, extra={
+        "python3": 'case " $* " in *" --verify "*) exit 1;; esac; exit 0',
+    })
+    r = _run(tmp_path, ["--interface", IFACE, "--ensure"], env, expect_rc=1)
+    assert "not present after apply" in r.stderr or "ensure" in r.stderr
+
+
+# ──────────────── shared lock across all three paths (T-074 review) ──────────
+# The generation marker alone does not close this race: stopping a .timer does
+# not stop a .service that has already started, so a rollback which has passed
+# its guard can still be running while a newer rollout applies — and would then
+# delete the newer generation's protection. One lock, taken by rollout, ensure
+# and the generated rollback, before anything else any of them does.
+
+
+def _lock_path(tmp_path) -> Path:
+    return tmp_path / "t074.lock"
+
+
+def _with_lock(env, tmp_path):
+    env["T074_LOCK_FILE"] = str(_lock_path(tmp_path))
+    return env
+
+
+def _hold_lock(tmp_path, seconds: float):
+    """Start a process holding the same lock, and wait until it really has it."""
+    lock = _lock_path(tmp_path)
+    lock.parent.mkdir(parents=True, exist_ok=True)
+    ready = tmp_path / "held"
+    proc = subprocess.Popen(  # noqa: S603
+        ["bash", "-c",
+         f'exec 9>"{lock}"; flock 9; touch "{ready}"; sleep {seconds}'],
+    )
+    for _ in range(200):
+        if ready.exists():
+            return proc
+        time.sleep(0.05)
+    proc.kill()
+    raise AssertionError("helper never acquired the lock")
+
+
+def test_all_three_paths_use_the_same_lock_path(tmp_path):
+    body = APPLY.read_text(encoding="utf-8")
+    assert body.count("T074_LOCK_FILE") >= 2, "rollout/ensure and the rollback heredoc"
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, _with_lock(env, tmp_path))
+    assert "flock 9" in script.read_text()
+
+
+def test_ensure_gives_up_immediately_when_the_lock_is_held(tmp_path):
+    # Non-blocking on purpose: a conflicting run is already converging the same
+    # state, and Restart=on-failure will retry this one.
+    holder = _hold_lock(tmp_path, 5)
+    try:
+        env, log = _make_env(tmp_path)
+        r = _run(tmp_path, ["--interface", IFACE, "--ensure"], _with_lock(env, tmp_path),
+                 expect_rc=1)
+        assert "holds the lock" in r.stderr
+        calls = _calls(log)
+        assert not any("docker" in c for c in calls), "bridge resolution ran despite the lock"
+        assert not any("--apply" in c for c in calls)
+    finally:
+        holder.kill()
+
+
+def test_rollout_waits_for_the_lock_rather_than_failing(tmp_path):
+    # An attended rollout should queue, not abort: the operator is present and
+    # a transient conflict is not a reason to refuse.
+    holder = _hold_lock(tmp_path, 2)
+    try:
+        env, log = _make_env(tmp_path)
+        started = time.monotonic()
+        _run(tmp_path, ["--interface", IFACE, "--rollout", "--dry-run"],
+             _with_lock(env, tmp_path))
+        assert time.monotonic() - started >= 1.5, "rollout did not wait for the lock"
+        assert any("docker" in c for c in _calls(log)), "rollout never ran after acquiring"
+    finally:
+        holder.kill()
+
+
+def test_the_lock_is_taken_before_bridge_resolution(tmp_path):
+    body = APPLY.read_text(encoding="utf-8")
+    assert body.index("flock") < body.index("resolve_bridge()"), (
+        "resolving the bridge before locking lets two runs disagree about it"
+    )
+    assert body.index("flock") < body.index("STATE_DIR/current"), (
+        "the marker must not be read or written outside the lock"
+    )
+
+
+def test_a_failing_run_releases_the_lock(tmp_path):
+    # The descriptor closes on exit, including on failure, so the next run is
+    # not blocked by a crashed predecessor.
+    env, _ = _make_env(tmp_path, bridge_ok=False)
+    _run(tmp_path, ["--interface", IFACE, "--rollout"], _with_lock(env, tmp_path),
+         expect_rc=1)
+
+    env2, log2 = _make_env(tmp_path / "after")
+    _run(tmp_path, ["--interface", IFACE, "--ensure"], _with_lock(env2, tmp_path))
+    assert any("docker" in c for c in _calls(log2)), "the lock was left held"
+
+
+def test_the_rollback_takes_the_lock_before_reading_the_marker(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, _with_lock(env, tmp_path)).read_text()
+    assert script.index("flock 9") < script.index("CURRENT_FILE\"") , (
+        "reading the marker outside the lock reintroduces the race"
+    )
+
+
+def test_a_stale_rollback_waiting_on_the_lock_becomes_a_noop(tmp_path):
+    # The exact race: rollback A passes nothing yet, waits for the lock; a
+    # newer rollout writes current=B; A acquires the lock, re-reads the marker,
+    # sees B, and must not remove anything.
+    env, _ = _make_env(tmp_path)
+    _with_lock(env, tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    marker = Path(env["T074_STATE_DIR"]) / "current"
+    marker.write_text(script.parent.name)
+
+    holder = _hold_lock(tmp_path, 2)
+    run_env, _ = _make_env(tmp_path / "stale", iptables_c_rc=0)
+    run_env["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    _with_lock(run_env, tmp_path)
+
+    proc = subprocess.Popen(  # noqa: S603
+        ["bash", str(script)], env=run_env,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+    )
+    time.sleep(0.5)
+    marker.write_text("20991231T235959Z-999")  # a newer rollout takes over
+    holder.kill()
+    out, _err = proc.communicate(timeout=30)
+
+    assert proc.returncode == 0, _err
+    assert "rolled back generation" not in out, "a stale rollback acted on a newer generation"
+    assert "not current" in out
+
+
+# ───────── rollback derives teardown from the live ruleset (review #2) ───────
+# Pinning the teardown to the bridge recorded at rollout time produced the
+# worst outcome in this whole ticket: after --ensure reconciled onto a new
+# bridge, rollback removed the host jump, could not find the old container
+# jump, flushed the chain, then failed to delete it because the live jump still
+# referenced it — aborting under set -e with an empty chain and TCP/25 open.
+
+
+def test_the_rollback_reads_the_live_ruleset_not_the_recorded_bridge(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, _with_lock(env, tmp_path)).read_text()
+    assert "iptables -w -S" in script, "teardown must be derived from the live ruleset"
+    assert "-j LOOKLA-T074-DENY$" in script or "-j $CHAIN" in script or "LOOKLA-T074-DENY" in script
+    assert BRIDGE not in script, (
+        "the rollout-time bridge must not be baked into the teardown"
+    )
+
+
+def test_the_rollback_is_one_transaction(tmp_path):
+    env, _ = _make_env(tmp_path)
+    script = _generated_rollback(tmp_path, _with_lock(env, tmp_path)).read_text()
+    assert "iptables-restore --noflush" in script
+    assert script.count("iptables-restore") == 1, (
+        "a multi-step teardown can land half-removed"
+    )
+
+
+def test_the_rollback_selector_is_anchored_so_foreign_rules_never_qualify(tmp_path):
+    """
+    The protective property is the selector, not the guard behind it.
+
+    An earlier test asserted the guard's error string appeared in the script,
+    which passed even with the ownership condition deleted — the other branch
+    contained the same word. Trying to make it behavioural then showed why:
+    the selector is anchored to `-j CHAIN` at end of line, so a foreign rule
+    can never reach the guard at all. The guard is belt-and-braces and
+    unreachable by construction; what actually protects neighbouring rules is
+    the anchor, so that is what is tested.
+    """
+    env, _ = _make_env(tmp_path)
+    _with_lock(env, tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    assert 'grep -- "-j LOOKLA-T074-DENY$"' in script.read_text(), (
+        "an unanchored selector would sweep in rules merely mentioning the chain"
+    )
+    (Path(env["T074_STATE_DIR"]) / "current").write_text(script.parent.name)
+
+    # A neighbouring rule that names our chain in a comment but jumps
+    # elsewhere. It must be ignored, and the rollback must finish cleanly.
+    live = (
+        '-A INPUT -m comment --comment "see LOOKLA-T074-DENY" -j LOOKLA-CLOUDFLARE\n'
+    )
+    run_env, log = _make_env(tmp_path / "neighbour", extra={
+        "iptables": (
+            'case "$*" in '
+            '*"-S LOOKLA-T074-DENY"*) exit 1;; '
+            f'*"-S"*) printf %s {live!r}; exit 0;; '
+            'esac; exit 0'
+        ),
+    })
+    run_env["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    _with_lock(run_env, tmp_path)
+
+    result = subprocess.run(  # noqa: S603
+        ["bash", str(script)], env=run_env, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    assert "nothing to roll back" in result.stdout
+    assert not any("iptables-restore" in c for c in _calls(log)), (
+        "a neighbouring rule was swept into the teardown"
+    )
+
+def test_the_rollback_survives_a_bridge_change_between_rollout_and_fire(tmp_path):
+    # The scenario end to end: rollout on br-A, ensure reconciles to br-B, then
+    # timer A fires. The teardown must remove the *current* jumps.
+    env, _ = _make_env(tmp_path)
+    _with_lock(env, tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    (Path(env["T074_STATE_DIR"]) / "current").write_text(script.parent.name)
+
+    live = (
+        "-P OUTPUT ACCEPT\n"
+        "-N LOOKLA-T074-DENY\n"
+        '-A OUTPUT -o eth0 -p tcp -m tcp --dport 25 -m comment '
+        '--comment "T-074 deny outbound SMTP host" -j LOOKLA-T074-DENY\n'
+        '-A DOCKER-USER -i br-BBBBBBBBBBBB -o eth0 -p tcp -m tcp --dport 25 -m comment '
+        '--comment "T-074 deny outbound SMTP containers" -j LOOKLA-T074-DENY\n'
+        "-A INPUT -i eth0 -p tcp -m tcp --dport 80 -j LOOKLA-CLOUDFLARE\n"
+    )
+    # The ruleset goes in a file and the stub cats it: embedding it in the stub
+    # via printf %s collapses the newlines into literal backslash-n, so the
+    # rollback's grep finds nothing and the test silently exercises the empty
+    # case instead of the one it names.
+    live_file = tmp_path / "live-ruleset"
+    live_file.write_text(live)
+    run_env, log = _make_env(tmp_path / "fire", extra={
+        "iptables": f'case "$*" in *"-S"*) cat "{live_file}"; exit 0;; esac; exit 0',
+    })
+    run_env["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    _with_lock(run_env, tmp_path)
+
+    result = subprocess.run(  # noqa: S603
+        ["bash", str(script)], env=run_env, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+
+    restored = [c for c in _calls(log) if "iptables-restore" in c]
+    assert restored, "no teardown transaction was issued"
+
+    # Assert on the document itself. The previous version checked
+    # `"removed" in result.stdout`, which is printed unconditionally — so it
+    # passed whether or not the current bridge was actually torn down.
+    doc = (tmp_path / "fire" / "restore-input").read_text()
+    assert "-D DOCKER-USER -i br-BBBBBBBBBBBB" in doc, (
+        "the live container jump was not removed — the teardown used a stale bridge"
+    )
+    assert "-D OUTPUT -o eth0" in doc
+    assert "-F LOOKLA-T074-DENY" in doc and "-X LOOKLA-T074-DENY" in doc
+    assert "LOOKLA-CLOUDFLARE" not in doc, "a neighbouring rule was swept in"
+
+
+def test_the_rollback_is_a_noop_when_nothing_is_installed(tmp_path):
+    env, _ = _make_env(tmp_path)
+    _with_lock(env, tmp_path)
+    script = _generated_rollback(tmp_path, env)
+    (Path(env["T074_STATE_DIR"]) / "current").write_text(script.parent.name)
+
+    # The stub must distinguish `-S` (whole ruleset) from `-S <chain>` (does
+    # this chain exist), or the script concludes the chain is present and the
+    # test proves the opposite of what it claims.
+    run_env, _ = _make_env(tmp_path / "empty", extra={
+        "iptables": (
+            'case "$*" in '
+            '*"-S LOOKLA-T074-DENY"*) exit 1;; '
+            '*"-S"*) echo "-P OUTPUT ACCEPT"; exit 0;; '
+            'esac; exit 0'
+        ),
+    })
+    run_env["T074_STATE_DIR"] = env["T074_STATE_DIR"]
+    _with_lock(run_env, tmp_path)
+
+    result = subprocess.run(  # noqa: S603
+        ["bash", str(script)], env=run_env, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    assert "nothing to roll back" in result.stdout
diff --git a/backend/tests/test_t074_smtp_egress.py b/backend/tests/test_t074_smtp_egress.py
new file mode 100644
index 0000000..f727546
--- /dev/null
+++ b/backend/tests/test_t074_smtp_egress.py
@@ -0,0 +1,598 @@
+"""
+T-074: outbound SMTP egress must be denied on exactly one port, in exactly two
+chains, and nowhere else.
+
+The two failure modes worth guarding are opposite in shape. Widening — a rule
+that catches 443 or 53 takes the site off the internet, and one that catches
+465/587 forecloses a legitimate mail setup later. Narrowing — a rule placed
+only in OUTPUT looks correct and covers nothing that runs in a container,
+which is the scenario the control exists for. Both are asserted against the
+generated rules rather than against intent.
+"""
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[2]
+_spec = importlib.util.spec_from_file_location(
+    "smtp_egress_t074", _ROOT / "ops" / "t074" / "smtp_egress.py"
+)
+eg = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(eg)
+
+IFACE = "eth0"
+BRIDGE = "br-7ee6b79d9884"
+
+
+def _jumps():
+    return eg.build_jump_rules(IFACE, BRIDGE)
+
+
+def _text():
+    return eg.build_restore_document() + " " + " ".join(" ".join(j) for j in _jumps()) + " "
+
+
+# ────────────────────────────── scope: the port ──────────────────────────────
+
+
+def test_tcp_25_is_denied():
+    assert "--dport 25 " in _text()
+
+
+@pytest.mark.parametrize("port", [22, 53, 80, 443, 465, 587, 3997, 3998, 3999, 4443, 8443, 8888])
+def test_no_other_port_is_ever_touched(port):
+    # 443 and 53 would break Resend and DNS; 465/587 are the submission ports a
+    # legitimate sender would use and are left open on purpose.
+    assert f"--dport {port} " not in _text()
+
+
+@pytest.mark.parametrize("port", [465, 587, 443, 53])
+def test_building_a_rule_for_another_port_is_refused(port):
+    with pytest.raises(eg.EgressScopeError):
+        eg.build_jump_rules(IFACE, BRIDGE, port=port)
+
+
+def test_the_chain_itself_matches_no_port():
+    # The chain is entered by the jumps; a port match inside it would be a
+    # second, unreviewed place for scope to drift.
+    assert "--dport" not in eg.build_restore_document()
+
+
+# ───────────────────────── scope: which chains, and why ──────────────────────
+
+
+def test_both_chains_are_covered():
+    chains = [j[0] for j in _jumps()]
+    assert chains == ["OUTPUT", "DOCKER-USER"]
+
+
+def test_output_alone_would_not_be_enough():
+    # FORWARD jumps to DOCKER-USER before anything else, so container traffic
+    # never traverses OUTPUT. A single-chain rule would report success while
+    # covering none of the containers.
+    assert any(j[0] == "DOCKER-USER" for j in _jumps()), (
+        "containers would be uncovered — this is the scenario the rule exists for"
+    )
+
+
+def test_docker_generated_chains_are_never_written_to():
+    text = _text()
+    for generated in ("-A DOCKER ", "-A DOCKER-FORWARD", "-A DOCKER-INGRESS"):
+        assert generated not in text
+    with pytest.raises(eg.EgressScopeError):
+        eg.assert_scope(eg.build_restore_document(), [["DOCKER-FORWARD", "-j", eg.CHAIN]])
+
+
+def test_wireguard_is_out_of_scope():
+    # wg0 peer traffic also traverses DOCKER-USER. An unscoped rule there would
+    # silently change what the operator's own VPN clients may do, which is a
+    # VPN policy decision and not this ticket's.
+    assert "wg0" not in _text()
+    # Probe the document, because the document is what gets applied. An earlier
+    # version passed a wg0 rule in the `jumps` argument instead, which
+    # assert_scope now only uses for a coverage check — so it proved nothing
+    # about what would reach the kernel.
+    doc = eg.build_reconciliation_document(
+        _save(f":{eg.CHAIN} - [0:0]"), IFACE, BRIDGE
+    )
+    tampered = doc.replace(f"-I DOCKER-USER 1 -i {BRIDGE}", "-I DOCKER-USER 1 -i wg0")
+    assert tampered != doc, "the tamper did not apply"
+    with pytest.raises(eg.EgressScopeError, match="WireGuard"):
+        eg.assert_scope(tampered, eg.build_jump_rules(IFACE, BRIDGE))
+
+
+def test_the_container_jump_is_scoped_to_the_compose_bridge():
+    container = next(j for j in _jumps() if j[0] == "DOCKER-USER")
+    assert "-i" in container and BRIDGE in container
+
+
+def test_both_jumps_are_scoped_to_the_external_interface():
+    # Keeps loopback and container-to-container traffic untouched.
+    for jump in _jumps():
+        assert "-o" in jump and IFACE in jump
+
+
+def test_only_the_owned_chain_is_populated():
+    doc = eg.build_restore_document()
+    assert "-A INPUT" not in doc and "-A FORWARD" not in doc and "-A OUTPUT" not in doc
+
+
+# ───────────────────────────── behaviour of the rule ─────────────────────────
+
+
+def test_the_verdict_is_reject_not_drop():
+    # Egress from our own software: a drop leaves a process hanging until its
+    # timeout, turning a policy decision into an intermittent stall that is
+    # hard to attribute. A rejection fails immediately and legibly.
+    doc = eg.build_restore_document()
+    assert "-j REJECT" in doc
+    assert "--reject-with icmp-port-unreachable" in doc
+    assert "-j DROP" not in doc
+
+
+def test_scope_check_catches_a_removed_verdict():
+    doc = eg.build_restore_document().replace("-j REJECT", "-j RETURN")
+    with pytest.raises(eg.EgressScopeError, match="control would be absent"):
+        eg.assert_scope(doc, _jumps())
+
+
+def test_scope_check_catches_a_missing_smtp_rule():
+    with pytest.raises(eg.EgressScopeError, match="control would be absent"):
+        eg.assert_scope(eg.build_restore_document(), [["OUTPUT", "-o", IFACE, "-j", eg.CHAIN]])
+
+
+# ──────────────────────────── atomicity and identity ─────────────────────────
+
+
+def test_the_transaction_is_a_single_atomic_restore_document():
+    doc = eg.build_restore_document()
+    assert doc.startswith("*filter\n")
+    assert f":{eg.CHAIN} - [0:0]" in doc
+    assert doc.rstrip().endswith("COMMIT")
+    assert doc.count("COMMIT") == 1
+
+
+def test_reapplying_produces_an_identical_document():
+    assert eg.build_restore_document() == eg.build_restore_document()
+
+
+def test_apply_reads_the_live_ruleset_then_restores_once(monkeypatch):
+    # Idempotence is now a property of reconciliation rather than of a -C
+    # probe: every apply reads the current ruleset and converges it in one
+    # transaction, so there is no "already present" shortcut left to assert on.
+    calls = []
+    applied = {"done": False}
+
+    class R:
+        def __init__(self, stdout):
+            self.returncode = 0
+            self.stdout = stdout
+            self.stderr = ""
+
+    def runner(argv, **kw):
+        calls.append(argv)
+        if argv[0] == "iptables-restore":
+            applied["done"] = True
+            return R("")
+        if argv[0] == "iptables-save":
+            # Model the ruleset actually changing: the post-apply verification
+            # is real, so a stub that always returns an empty ruleset would
+            # make main() fail — as it should.
+            return R(_healthy() if applied["done"] else _save())
+        return R("")
+
+    monkeypatch.setattr(eg, "_run", runner)
+    assert eg.main(["--interface", IFACE, "--bridge", BRIDGE, "--apply"]) == 0
+
+    programs = [c[0] for c in calls]
+    assert programs.count("iptables-restore") == 1, "the policy must be one transaction"
+    assert "iptables-save" in programs, "reconciliation must read the live ruleset"
+    assert not any(c[:2] == ["iptables", "-I"] for c in calls), (
+        "jumps must be part of the transaction, not separate commands"
+    )
+    assert programs.count("iptables-save") == 2, (
+        "read before reconciling, and read again to prove the contract holds"
+    )
+
+
+def test_apply_fails_when_the_result_does_not_match_the_contract(monkeypatch):
+    # If the restore silently leaves the ruleset wrong, apply must not report
+    # success — otherwise systemd shows the unit active with a broken policy.
+    class R:
+        def __init__(self, stdout=""):
+            self.returncode = 0
+            self.stdout = stdout
+            self.stderr = ""
+
+    monkeypatch.setattr(
+        eg, "_run",
+        lambda argv, **kw: R(_save()) if argv[0] == "iptables-save" else R(),
+    )
+    assert eg.main(["--interface", IFACE, "--bridge", BRIDGE, "--apply"]) == 1
+
+
+def test_dry_run_reads_but_never_mutates(monkeypatch, capsys):
+    # Reconciliation has to read iptables-save even to print what it would do;
+    # what must not happen is a restore or an insert.
+    seen = []
+
+    class R:
+        returncode = 0
+        stdout = "*filter\nCOMMIT\n"
+        stderr = ""
+
+    def runner(argv, **kw):
+        seen.append(argv[0])
+        if argv[0] != "iptables-save":
+            raise AssertionError(f"dry run executed a mutating command: {argv}")
+        return R()
+
+    monkeypatch.setattr(eg, "_run", runner)
+    assert eg.main(["--interface", IFACE, "--bridge", BRIDGE]) == 0
+    assert "dry run — nothing applied" in capsys.readouterr().out
+    assert seen == ["iptables-save"]
+
+
+# ─────────────────────────── bridge detection safety ─────────────────────────
+
+
+def test_the_bridge_is_resolved_at_apply_time_not_hardcoded():
+    calls = []
+
+    class R:
+        returncode = 0
+        stdout = "br-abc123def456\n"
+        stderr = ""
+
+    def runner(argv, **kw):
+        calls.append(argv)
+        return R()
+
+    assert eg.detect_bridge("beauty-gr_default", runner=runner) == "br-abc123def456"
+    assert calls[0][:3] == ["docker", "network", "inspect"]
+
+
+def test_bridge_detection_falls_back_to_the_network_id():
+    class Empty:
+        returncode = 0
+        stdout = "<no value>\n"
+        stderr = ""
+
+    class WithId:
+        returncode = 0
+        stdout = "7ee6b79d9884abcdef0123456789\n"
+        stderr = ""
+
+    answers = iter([Empty(), WithId()])
+    assert eg.detect_bridge("net", runner=lambda *a, **k: next(answers)) == "br-7ee6b79d9884"
+
+
+def test_an_unresolvable_bridge_stops_the_run():
+    # A stale or missing bridge name would silently produce a rule matching
+    # nothing, leaving containers able to send while the run reports success.
+    class Fail:
+        returncode = 1
+        stdout = ""
+        stderr = "no such network"
+
+    with pytest.raises(eg.EgressScopeError, match="cannot resolve the bridge"):
+        eg.detect_bridge("nope", runner=lambda *a, **k: Fail())
+
+
+@pytest.mark.parametrize("bad", ["", "br 0", None])
+def test_an_implausible_bridge_name_is_refused(bad):
+    with pytest.raises(eg.EgressScopeError):
+        eg.build_jump_rules(IFACE, bad)
+
+
+# ─────────────────── full-contract verification (T-074 review) ───────────────
+# The old check asked only whether two jumps existed. A jump can point at a
+# chain that is empty, rejects the wrong port, or DROPs where it should
+# REJECT — and in every one of those cases it passed, systemd reported active,
+# and TCP/25 was open. These assert the whole contract instead.
+
+
+def _save(*lines: str) -> str:
+    return "*filter\n" + "\n".join(lines) + "\nCOMMIT\n"
+
+
+def _healthy() -> str:
+    # As iptables-save renders it: `-p tcp` gains an implicit `-m tcp`.
+    return _save(
+        f":{eg.CHAIN} - [0:0]",
+        f'-A OUTPUT -o {IFACE} -p tcp -m tcp --dport 25 -m comment '
+        f'--comment "T-074 deny outbound SMTP host" -j {eg.CHAIN}',
+        f'-A DOCKER-USER -i {BRIDGE} -o {IFACE} -p tcp -m tcp --dport 25 -m comment '
+        f'--comment "T-074 deny outbound SMTP containers" -j {eg.CHAIN}',
+        f'-A {eg.CHAIN} -p tcp -m comment --comment "T-074 deny outbound SMTP" '
+        f"-j REJECT --reject-with icmp-port-unreachable",
+    )
+
+
+def test_a_healthy_ruleset_verifies_clean():
+    assert eg.verify(IFACE, BRIDGE, _healthy()) == []
+
+
+def test_an_empty_chain_fails_even_though_both_jumps_exist():
+    # The precise false-green the reviewer identified.
+    ruleset = "\n".join(
+        ln for ln in _healthy().splitlines() if not ln.startswith(f"-A {eg.CHAIN} ")
+    )
+    problems = eg.verify(IFACE, BRIDGE, ruleset)
+    assert any("missing" in p and "REJECT" in p for p in problems)
+
+
+def test_drop_instead_of_reject_fails():
+    ruleset = _healthy().replace("-j REJECT --reject-with icmp-port-unreachable", "-j DROP")
+    assert eg.verify(IFACE, BRIDGE, ruleset)
+
+
+def test_the_wrong_port_fails():
+    assert eg.verify(IFACE, BRIDGE, _healthy().replace("--dport 25", "--dport 587"))
+
+
+def test_a_stale_bridge_fails():
+    # The failure that leaves containers able to send while everything looks
+    # applied: the jump exists, but names a bridge that no longer carries them.
+    assert eg.verify(IFACE, BRIDGE, _healthy().replace(BRIDGE, "br-000000000000"))
+
+
+def test_a_missing_container_jump_fails():
+    ruleset = "\n".join(
+        ln for ln in _healthy().splitlines() if "DOCKER-USER" not in ln
+    )
+    assert any("missing" in p for p in eg.verify(IFACE, BRIDGE, ruleset))
+
+
+def test_a_duplicated_jump_is_reported():
+    # Not merely untidy: evidence that an idempotence guarantee has broken.
+    dup = next(ln for ln in _healthy().splitlines() if ln.startswith("-A OUTPUT"))
+    ruleset = _healthy().replace(dup, dup + "\n" + dup)
+    assert any("duplicated" in p for p in eg.verify(IFACE, BRIDGE, ruleset))
+
+
+def test_an_unexpected_extra_rule_in_our_chain_is_reported():
+    extra = f"-A {eg.CHAIN} -p tcp --dport 587 -j ACCEPT"
+    assert any("unexpected" in p for p in eg.verify(IFACE, BRIDGE, _healthy() + extra + "\n"))
+
+
+def test_an_accept_smuggled_into_our_chain_is_reported():
+    extra = f"-A {eg.CHAIN} -j ACCEPT"
+    assert any("unexpected" in p for p in eg.verify(IFACE, BRIDGE, _healthy() + extra + "\n"))
+
+
+def test_an_entirely_absent_chain_fails():
+    assert len(eg.verify(IFACE, BRIDGE, _save("-A INPUT -j ACCEPT"))) >= 3
+
+
+def test_normalisation_ignores_only_the_implicit_tcp_match():
+    assert eg.normalise("-p tcp -m tcp --dport 25") == "-p tcp --dport 25"
+    # It must not swallow anything else that happens to follow -m.
+    assert eg.normalise("-m comment --comment x") == "-m comment --comment x"
+    assert eg.normalise("-m conntrack --ctstate NEW") == "-m conntrack --ctstate NEW"
+
+
+def test_the_contract_covers_chain_rule_and_both_jumps():
+    lines = eg.expected_lines(IFACE, BRIDGE)
+    assert any(ln.startswith(f":{eg.CHAIN}") for ln in lines)
+    assert any(ln.startswith("-A OUTPUT") for ln in lines)
+    assert any(ln.startswith("-A DOCKER-USER") for ln in lines)
+    assert any("REJECT" in ln for ln in lines)
+    assert len(lines) == 4
+
+
+# ───────────────── reconciliation of stale jumps (T-074 review) ──────────────
+# The previous apply only ever ADDED a missing jump. Recreating the compose
+# network changes the bridge name, so the new jump was added and the old one
+# stayed; --verify then reported the stale jump forever and Restart=on-failure
+# rebuilt the same state every time. A changing bridge is the entire reason the
+# systemd unit exists, so that was the one case it could not handle.
+
+
+def _with_jumps(*jump_lines: str) -> str:
+    return _save(f":{eg.CHAIN} - [0:0]", *jump_lines)
+
+
+_HOST_JUMP = (
+    f'-A OUTPUT -o {IFACE} -p tcp -m tcp --dport 25 -m comment '
+    f'--comment "T-074 deny outbound SMTP host" -j {eg.CHAIN}'
+)
+_OLD_CONTAINER_JUMP = (
+    f'-A DOCKER-USER -i br-OLDOLDOLD -o {IFACE} -p tcp -m tcp --dport 25 -m comment '
+    f'--comment "T-074 deny outbound SMTP containers" -j {eg.CHAIN}'
+)
+
+
+def test_a_stale_bridge_jump_is_deleted_not_merely_supplemented():
+    doc = eg.build_reconciliation_document(
+        _with_jumps(_HOST_JUMP, _OLD_CONTAINER_JUMP), IFACE, BRIDGE
+    )
+    assert "-D DOCKER-USER -i br-OLDOLDOLD" in doc
+    assert f"-I DOCKER-USER 1 -i {BRIDGE}" in doc
+
+
+def test_a_duplicated_jump_collapses_to_one():
+    doc = eg.build_reconciliation_document(
+        _with_jumps(_HOST_JUMP, _HOST_JUMP), IFACE, BRIDGE
+    )
+    assert doc.count("-D OUTPUT") == 2, "both copies must be removed"
+    assert doc.count("-I OUTPUT 1") == 1, "exactly one must be installed"
+
+
+def test_an_unexpected_owned_parent_jump_is_removed():
+    rogue = f'-A FORWARD -p tcp --dport 25 -j {eg.CHAIN}'
+    doc = eg.build_reconciliation_document(_with_jumps(_HOST_JUMP, rogue), IFACE, BRIDGE)
+    assert "-D FORWARD -p tcp --dport 25" in doc
+
+
+def test_rules_belonging_to_other_tickets_are_never_deleted():
+    # Ownership is decided solely by jumping to our chain.
+    others = _with_jumps(
+        _HOST_JUMP,
+        "-A INPUT -i eth0 -p tcp -m tcp --dport 80 -j LOOKLA-CLOUDFLARE",
+        "-A INPUT -i eth0 -p tcp -m tcp --dport 8888 -j LOOKLA-T072-DENY",
+    )
+    doc = eg.build_reconciliation_document(others, IFACE, BRIDGE)
+    assert "LOOKLA-CLOUDFLARE" not in doc
+    assert "LOOKLA-T072-DENY" not in doc
+
+
+def test_deletions_are_derived_from_the_live_ruleset_only():
+    # Deleting a rule that does not exist aborts the whole restore, so nothing
+    # may be deleted speculatively.
+    doc = eg.build_reconciliation_document(_with_jumps(), IFACE, BRIDGE)
+    assert "-D " not in doc
+
+
+def test_the_owned_chain_is_flushed_and_refilled():
+    doc = eg.build_reconciliation_document(_with_jumps(_HOST_JUMP), IFACE, BRIDGE)
+    assert f":{eg.CHAIN} - [0:0]" in doc
+    assert doc.count("-j REJECT") == 1
+
+
+def test_parent_jumps_are_inserted_at_position_one_not_appended():
+    # Docker may leave a RETURN at the end of DOCKER-USER; a rule appended
+    # after it would never be evaluated.
+    doc = eg.build_reconciliation_document(_with_jumps(), IFACE, BRIDGE)
+    assert "-I OUTPUT 1 " in doc and "-I DOCKER-USER 1 " in doc
+    assert "-A OUTPUT " not in doc and "-A DOCKER-USER " not in doc
+
+
+def test_the_whole_policy_is_one_transaction():
+    # Not just the owned chain: the deletions and both parent jumps are in the
+    # same document, so there is no window with a half-applied policy.
+    doc = eg.build_reconciliation_document(
+        _with_jumps(_HOST_JUMP, _OLD_CONTAINER_JUMP), IFACE, BRIDGE
+    )
+    assert doc.startswith("*filter\n")
+    assert doc.rstrip().endswith("COMMIT")
+    assert doc.count("COMMIT") == 1
+    for fragment in ("-D OUTPUT", "-D DOCKER-USER", f":{eg.CHAIN}", "-j REJECT",
+                     "-I OUTPUT 1", "-I DOCKER-USER 1"):
+        assert fragment in doc, fragment
+
+
+def test_reapplying_converges_rather_than_accumulating():
+    after_first = _with_jumps(
+        _HOST_JUMP,
+        f'-A DOCKER-USER -i {BRIDGE} -o {IFACE} -p tcp -m tcp --dport 25 -m comment '
+        f'--comment "T-074 deny outbound SMTP containers" -j {eg.CHAIN}',
+    )
+    doc = eg.build_reconciliation_document(after_first, IFACE, BRIDGE)
+    assert doc.count("-I OUTPUT 1") == 1
+    assert doc.count("-I DOCKER-USER 1") == 1
+    assert doc.count("-D ") == 2, "the current jumps are replaced, not stacked"
+
+
+def test_scope_check_rejects_a_document_touching_another_chain():
+    doc = eg.build_reconciliation_document(_with_jumps(), IFACE, BRIDGE)
+    tampered = doc.replace("COMMIT", "-A INPUT -j ACCEPT\nCOMMIT")
+    with pytest.raises(eg.EgressScopeError, match="another chain"):
+        eg.assert_scope(tampered, eg.build_jump_rules(IFACE, BRIDGE))
+
+
+def test_scope_check_rejects_a_jump_targeting_something_else():
+    # The tamper has to change where the line *ends*, since that is what
+    # ownership is decided by. An earlier version of this test appended text
+    # mid-line, leaving the trailing "-j LOOKLA-T074-DENY" intact — so nothing
+    # raised and the test proved nothing.
+    doc = eg.build_reconciliation_document(_with_jumps(), IFACE, BRIDGE)
+    tampered = doc.replace(f"-j {eg.CHAIN}\n-I DOCKER-USER", "-j ACCEPT\n-I DOCKER-USER")
+    assert tampered != doc, "the tamper did not apply"
+    with pytest.raises(eg.EgressScopeError, match="does not target"):
+        eg.assert_scope(tampered, eg.build_jump_rules(IFACE, BRIDGE))
+
+
+# ─────────────────── teardown: removing T-074 entirely ───────────────────────
+# These were missing entirely: build_teardown_document had no direct tests, so
+# three mutations against it survived — deleting the chain removal, dropping
+# the ownership check on -D, and loosening assert_scope's -D branch.
+
+
+def test_teardown_removes_every_owned_jump_whatever_its_shape():
+    live = _save(
+        f":{eg.CHAIN} - [0:0]",
+        _HOST_JUMP,
+        f'-A DOCKER-USER -i br-ANCIENT -o eth9 -p tcp -m tcp --dport 587 -j {eg.CHAIN}',
+        f'-A FORWARD -i wg0 -j {eg.CHAIN}',
+        "-A INPUT -i eth0 -p tcp --dport 80 -j LOOKLA-CLOUDFLARE",
+    )
+    doc = eg.build_teardown_document(live)
+    assert doc.count("-D ") == 3, "every owned jump must go, regardless of shape"
+    assert "br-ANCIENT" in doc and "wg0" in doc and "--dport 587" in doc
+    assert "LOOKLA-CLOUDFLARE" not in doc
+
+
+def test_teardown_flushes_and_deletes_the_chain():
+    doc = eg.build_teardown_document(_save(f":{eg.CHAIN} - [0:0]", _HOST_JUMP))
+    assert f"-F {eg.CHAIN}" in doc, "leaving the chain behind orphans it"
+    assert f"-X {eg.CHAIN}" in doc
+
+
+def test_teardown_is_one_transaction():
+    doc = eg.build_teardown_document(_save(f":{eg.CHAIN} - [0:0]", _HOST_JUMP))
+    assert doc.startswith("*filter\n") and doc.rstrip().endswith("COMMIT")
+    assert doc.count("COMMIT") == 1
+
+
+def test_teardown_of_an_absent_installation_is_empty():
+    assert eg.build_teardown_document(_save("-A INPUT -j ACCEPT")) == ""
+
+
+def test_teardown_scope_refuses_a_foreign_deletion():
+    doc = "*filter\n-D INPUT -i eth0 -j LOOKLA-CLOUDFLARE\nCOMMIT\n"
+    with pytest.raises(eg.EgressScopeError, match="do not own"):
+        eg.assert_scope_teardown(doc)
+
+
+def test_teardown_scope_refuses_flushing_another_chain():
+    doc = f"*filter\n-F LOOKLA-T072-DENY\n-X {eg.CHAIN}\nCOMMIT\n"
+    with pytest.raises(eg.EgressScopeError, match="another chain"):
+        eg.assert_scope_teardown(doc)
+
+
+def test_teardown_scope_refuses_anything_that_is_not_a_removal():
+    doc = f"*filter\n-A {eg.CHAIN} -j ACCEPT\nCOMMIT\n"
+    with pytest.raises(eg.EgressScopeError, match="may not contain"):
+        eg.assert_scope_teardown(doc)
+
+
+def test_reconciliation_scope_refuses_a_foreign_deletion():
+    # The -D branch of assert_scope must still prove ownership; a mutation that
+    # let any deletion through survived until this test existed.
+    doc = eg.build_reconciliation_document(_save(f":{eg.CHAIN} - [0:0]"), IFACE, BRIDGE)
+    tampered = doc.replace("*filter\n", "*filter\n-D INPUT -i eth0 -j LOOKLA-CLOUDFLARE\n")
+    with pytest.raises(eg.EgressScopeError, match="do not own"):
+        eg.assert_scope(tampered, eg.build_jump_rules(IFACE, BRIDGE))
+
+
+def test_reconciliation_scope_still_permits_owned_malformed_deletions():
+    # The point of splitting the check: a malformed owned rule is exactly what
+    # reconciliation must be able to remove.
+    live = _save(
+        f":{eg.CHAIN} - [0:0]",
+        f'-A DOCKER-USER -i wg0 -o eth0 -p tcp -m tcp --dport 587 -j {eg.CHAIN}',
+    )
+    doc = eg.build_reconciliation_document(live, IFACE, BRIDGE)
+    assert "wg0" in doc and "--dport 587" in doc
+    eg.assert_scope(doc, eg.build_jump_rules(IFACE, BRIDGE))  # must not raise
+
+
+def test_reconciliation_scope_also_guards_flush_and_drop_lines():
+    # Reconciliation does not emit -F/-X today — it declares the chain with
+    # ":CHAIN - [0:0]" instead — so this branch of assert_scope is unreachable
+    # from the current generator, and a mutation against it survived until this
+    # test existed. It is kept as defence against a future change that starts
+    # emitting them, and asserted directly rather than left as dead code.
+    doc = eg.build_reconciliation_document(_save(f":{eg.CHAIN} - [0:0]"), IFACE, BRIDGE)
+    with pytest.raises(eg.EgressScopeError, match="another chain"):
+        eg.assert_scope(
+            doc.replace("*filter\n", "*filter\n-F LOOKLA-CLOUDFLARE\n"),
+            eg.build_jump_rules(IFACE, BRIDGE),
+        )
+    with pytest.raises(eg.EgressScopeError, match="another chain"):
+        eg.assert_scope(
+            doc.replace("*filter\n", "*filter\n-X LOOKLA-T072-DENY\n"),
+            eg.build_jump_rules(IFACE, BRIDGE),
+        )
