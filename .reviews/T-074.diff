@@ -0,0 +1,466 @@
+#!/usr/bin/env python3
+"""
+T-074 — deny outbound direct-to-MX SMTP from this host and its containers.
+
+Port 25 is the port a compromised process uses to deliver mail itself, without
+any provider's authentication or rate limiting in the way. Nothing here needs
+it: the consumer audit found no local MTA, no listener on 25/465/587, no
+established connection to any mail port, no SMTP client code in the backend,
+crawler or frontend, and no mail-related cron entry. The application sends
+through Resend's **HTTPS** API. The host also publishes no PTR record, so
+direct-to-MX delivery from it would be penalised or refused by most receivers
+anyway.
+
+This matters more than it would on a clean host: this address spent seven days
+as an open HTTP relay (T-072) and was listed by Barracuda for it (T-073).
+Outbound mail is the obvious second act, and the point of closing it now is
+that no legitimate sender loses anything.
+
+**Two chains, because one would be a false assurance.** `FORWARD` jumps to
+`DOCKER-USER` before anything else, so a container's traffic to the internet
+never traverses `OUTPUT`. A rule placed only in `OUTPUT` would cover host
+processes and quietly miss all six containers — which is precisely the
+scenario the rule exists for. So:
+
+    OUTPUT       host processes leaving via the external interface
+    DOCKER-USER  container processes, scoped to the compose bridge
+
+Note this does not contradict T-049's conclusion that `DOCKER-USER` was the
+wrong layer there. That was about *inbound* 80/443, which host nginx owns and
+which never reaches Docker's forwarding path. For *outbound from containers*,
+`DOCKER-USER` is exactly the documented hook, and unlike `DOCKER` or
+`DOCKER-FORWARD` it is the one Docker leaves to the operator.
+
+**WireGuard is deliberately out of scope.** `FORWARD` also carries wg0 peer
+traffic through `DOCKER-USER`, so an unscoped rule there would silently change
+what the operator's own VPN clients may do. That is a VPN policy decision, not
+this ticket's, so the container rule is scoped to the compose bridge and wg0 is
+left alone.
+
+**465 and 587 are deliberately left open.** They are authenticated submission
+ports — what a legitimate sender would use through a provider. Blocking 25
+removes the abuse path without foreclosing a proper mail setup later. There is
+also no evidence they are unused in the same strong sense: the audit shows no
+current consumer, but leaving them open costs nothing and closing them would
+be a guess.
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+
+CHAIN = "LOOKLA-T074-DENY"
+COMMENT = "T-074 deny outbound SMTP"
+
+#: The only port this ticket may touch.
+SMTP_PORT = 25
+
+#: Ports that must never appear in a T-074 rule. 465/587 are submission ports
+#: (see the module docstring); 53 and 443 would break DNS and every outbound
+#: API call including Resend's; the rest belong to other tickets.
+FORBIDDEN_PORTS = (22, 53, 80, 443, 465, 587, 3997, 3998, 3999, 4443, 8443, 8888)
+
+
+class EgressScopeError(ValueError):
+    """Raised when a generated rule would exceed T-074's approved scope."""
+
+
+def build_chain_rules() -> list[str]:
+    """
+    Return the `iptables-restore` lines for T-074's chain.
+
+    `REJECT` rather than `DROP`, deliberately: this is egress from our own
+    software. A dropped connection leaves a process hanging until its timeout,
+    which turns a policy decision into an intermittent stall that is hard to
+    attribute. A rejection fails immediately and legibly, which is what an
+    operator wants when something unexpected tries to send mail.
+    """
+    return [
+        f'-A {CHAIN} -p tcp -m comment --comment "{COMMENT}" '
+        f"-j REJECT --reject-with icmp-port-unreachable",
+    ]
+
+
+def build_jump_rules(interface: str, bridge: str, port: int = SMTP_PORT) -> list[list[str]]:
+    """
+    Return the two jumps: host egress, and container egress.
+
+    Both are scoped to leaving via `interface`, so loopback and
+    container-to-container traffic are untouched.
+    """
+    if port != SMTP_PORT:
+        raise EgressScopeError(
+            f"port {port} is outside T-074's scope — only TCP/{SMTP_PORT} may be denied"
+        )
+    if port in FORBIDDEN_PORTS:
+        raise EgressScopeError(f"port {port} must never be denied by T-074")
+    if not interface or " " in interface:
+        raise EgressScopeError(f"implausible interface name: {interface!r}")
+    if not bridge or " " in bridge:
+        raise EgressScopeError(f"implausible bridge name: {bridge!r}")
+
+    common = [
+        "-p", "tcp",
+        "--dport", str(port),
+        "-m", "comment", "--comment",
+    ]
+    return [
+        # Host processes.
+        ["OUTPUT", "-o", interface, *common, f"{COMMENT} host", "-j", CHAIN],
+        # Container processes. Scoped by the compose bridge so wg0 peer traffic,
+        # which also traverses DOCKER-USER, keeps its current policy.
+        ["DOCKER-USER", "-i", bridge, "-o", interface, *common, f"{COMMENT} containers", "-j", CHAIN],
+    ]
+
+
+def build_restore_document() -> str:
+    """One atomic `iptables-restore --noflush` transaction for the chain."""
+    body = "\n".join(build_chain_rules())
+    return f"*filter\n:{CHAIN} - [0:0]\n{body}\nCOMMIT\n"
+
+
+def owned_parent_jumps(save_output: str) -> list[str]:
+    """
+    Every parent-chain rule currently pointing at our chain, verbatim.
+
+    Returned exactly as `iptables-save` printed them, because that text is what
+    `-D` needs to match. Ownership is decided solely by the rule jumping to
+    `LOOKLA-T074-DENY`; nothing else is ever considered ours.
+    """
+    found = []
+    for raw in save_output.splitlines():
+        line = raw.strip()
+        if line.startswith("-A ") and line.endswith(f"-j {CHAIN}"):
+            found.append(line)
+    return found
+
+
+def build_reconciliation_document(save_output: str, interface: str, bridge: str) -> str:
+    """
+    One transaction that converges the live ruleset onto the contract.
+
+    The previous version only ever *added* a missing jump. That left the main
+    persistence scenario broken: recreate the compose network, the bridge name
+    changes, the new jump is added and the old one stays. `--verify` then
+    reports the stale jump as unexpected and fails forever, and
+    `Restart=on-failure` cannot help because every retry rebuilds the same
+    state. Since a changing bridge is the entire reason the systemd unit
+    exists, that was the one case it could not handle.
+
+    So every existing owned jump is deleted first — stale, duplicated or
+    simply current — and the two correct ones are re-inserted. Deleting a rule
+    we just read from `iptables-save` is safe; deleting one that does not exist
+    would abort the whole transaction, which is why the deletions are derived
+    from the live ruleset rather than guessed.
+
+    `-I <chain> 1` rather than `-A`: Docker may leave a `RETURN` at the end of
+    `DOCKER-USER`, and a rule appended after it would never be evaluated.
+    """
+    lines = []
+    for existing in owned_parent_jumps(save_output):
+        lines.append("-D " + existing[len("-A "):])
+    lines.append(f":{CHAIN} - [0:0]")
+    lines.extend(build_chain_rules())
+    for chain, *rule in build_jump_rules(interface, bridge):
+        lines.append(f"-I {chain} 1 " + " ".join(_quote(r) for r in rule))
+    return "*filter\n" + "\n".join(lines) + "\nCOMMIT\n"
+
+
+def assert_scope(document: str, jumps: list[list[str]]) -> None:
+    """
+    Validate a transaction before it is applied.
+
+    Additions and deletions are judged by different rules, and conflating them
+    was a real defect: a malformed owned jump — one naming wg0, or port 587,
+    or some other interface — is exactly what reconciliation exists to clean
+    up, but a single strict check rejected the document that would have removed
+    it, so `--ensure` looped forever without ever fixing anything.
+
+    Removing a rule that jumps to our chain always *narrows* T-074's effect, so
+    a deletion needs only to prove ownership. Adding one widens it, so an
+    addition must satisfy the full contract.
+    """
+    for raw in document.splitlines():
+        line = raw.strip()
+        if not line or line.startswith(("*", "COMMIT", ":")):
+            continue
+
+        if line.startswith("-D "):
+            # Ownership is the only question. The text came from a live
+            # `iptables-save`, and its target decides whether it is ours.
+            if not line.endswith(f"-j {CHAIN}"):
+                raise EgressScopeError(f"refusing to delete a rule we do not own: {line}")
+            continue
+
+        if line.startswith(("-F ", "-X ")):
+            if line.split()[1] != CHAIN:
+                raise EgressScopeError(f"refusing to flush or drop another chain: {line}")
+            continue
+
+        if line.startswith("-A ") and not line.startswith(f"-A {CHAIN} "):
+            raise EgressScopeError(f"unexpected append to another chain: {line}")
+
+        if line.startswith("-I ") and not line.endswith(f"-j {CHAIN}"):
+            raise EgressScopeError(f"rule does not target {CHAIN}: {line}")
+
+        # Everything that survives to here is an addition, and must satisfy the
+        # full contract.
+        for port in FORBIDDEN_PORTS:
+            if f"--dport {port} " in line + " ":
+                raise EgressScopeError(f"addition references forbidden port {port}: {line}")
+        if "wg0" in line:
+            raise EgressScopeError(f"WireGuard is deliberately out of scope: {line}")
+        if "DOCKER-FORWARD" in line or "DOCKER-INGRESS" in line or "-A DOCKER " in line:
+            raise EgressScopeError("must not write into Docker-generated chains")
+
+    joined = document + " " + " ".join(" ".join(j) for j in jumps) + " "
+    if f"--dport {SMTP_PORT} " not in joined:
+        raise EgressScopeError("no rule denies TCP/25 — the control would be absent")
+    if "-j REJECT" not in document:
+        raise EgressScopeError("no reject rule present — the control would be absent")
+
+
+def assert_scope_teardown(document: str) -> None:
+    """A teardown may only delete rules we own, and only touch our chain."""
+    for raw in document.splitlines():
+        line = raw.strip()
+        if not line or line.startswith(("*", "COMMIT")):
+            continue
+        if line.startswith("-D "):
+            if not line.endswith(f"-j {CHAIN}"):
+                raise EgressScopeError(f"refusing to delete a rule we do not own: {line}")
+        elif line.startswith(("-F ", "-X ")):
+            if line.split()[1] != CHAIN:
+                raise EgressScopeError(f"refusing to flush or drop another chain: {line}")
+        else:
+            raise EgressScopeError(f"a teardown may not contain: {line}")
+
+
+def build_teardown_document(save_output: str) -> str:
+    """
+    One transaction that removes T-074 entirely, whatever shape it is in.
+
+    Used by rollback. It deliberately does **not** reuse the interface and
+    bridge recorded when the rollout ran: after a Docker restart, `--ensure`
+    reconciles onto a new bridge without touching the generation marker, so a
+    rollback pinned to the old bridge would remove the host jump, fail to find
+    the container one, flush the chain, and then fail to delete it because the
+    live jump still references it — leaving an empty chain, no protection, and
+    a non-zero exit halfway through. Reading the live ruleset instead makes the
+    teardown correct regardless of what has changed underneath.
+    """
+    owned = owned_parent_jumps(save_output)
+    lines = ["-D " + rule[len("-A "):] for rule in owned]
+    if f":{CHAIN} " in save_output or f"-A {CHAIN} " in save_output:
+        lines.append(f"-F {CHAIN}")
+        lines.append(f"-X {CHAIN}")
+    if not lines:
+        return ""
+    return "*filter\n" + "\n".join(lines) + "\nCOMMIT\n"
+
+
+#: `iptables-save` renders `-p tcp` with an implicit `-m tcp` match that is
+#: absent from the arguments we pass in. Normalising it away lets the live
+#: ruleset be compared against what this module generates, instead of the
+#: contract being restated by hand in shell — where it would drift.
+def normalise(line: str) -> str:
+    parts = [p for p in line.split() if p]
+    out, skip = [], 0
+    for i, part in enumerate(parts):
+        if skip:
+            skip -= 1
+            continue
+        if part == "-m" and i + 1 < len(parts) and parts[i + 1] == "tcp":
+            skip = 1
+            continue
+        out.append(part)
+    return " ".join(out)
+
+
+def _quote(token: str) -> str:
+    return f'"{token}"' if " " in token else token
+
+
+def expected_lines(interface: str, bridge: str) -> list[str]:
+    """
+    Every `iptables-save` line T-074 owns, in normalised form.
+
+    The whole contract in one place: the chain, its single reject rule, and
+    both jumps. `verify` compares the live ruleset against exactly this, so an
+    empty chain, a DROP where a REJECT belongs, a wrong port, a stale bridge or
+    a duplicated jump are all the same kind of failure — a mismatch — rather
+    than each needing its own hand-written check.
+    """
+    lines = [f":{CHAIN} - [0:0]"]
+    lines += [normalise(r) for r in build_chain_rules()]
+    for chain, *rule in build_jump_rules(interface, bridge):
+        lines.append(normalise(f"-A {chain} " + " ".join(_quote(r) for r in rule)))
+    return lines
+
+
+def owned_lines(save_output: str) -> list[str]:
+    """T-074-owned lines from `iptables-save`, normalised, order-insensitive."""
+    found = []
+    for raw in save_output.splitlines():
+        line = raw.strip()
+        if not line:
+            continue
+        if line.startswith(f":{CHAIN} ") or CHAIN in line:
+            found.append(normalise(line))
+    return found
+
+
+def verify(interface: str, bridge: str, save_output: str) -> list[str]:
+    """
+    Return the problems with the live ruleset; empty means the contract holds.
+
+    Missing and unexpected lines are reported separately, and duplicates are
+    counted: a second jump is not merely untidy, it is evidence that an
+    idempotence guarantee has broken somewhere.
+    """
+    expected = expected_lines(interface, bridge)
+    actual = owned_lines(save_output)
+    problems = []
+
+    for line in expected:
+        count = actual.count(line)
+        if count == 0:
+            problems.append(f"missing: {line}")
+        elif count > 1:
+            problems.append(f"duplicated {count}x: {line}")
+
+    for line in actual:
+        if line not in expected:
+            problems.append(f"unexpected: {line}")
+
+    return problems
+
+
+def _run(argv: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(  # noqa: S603
+        argv, input=input_text, capture_output=True, text=True, check=False
+    )
+
+
+def detect_bridge(network: str = "beauty-gr_default", runner=_run) -> str:
+    """
+    Resolve the compose network's bridge interface at apply time.
+
+    Not hardcoded: the name contains the network id and changes if the compose
+    network is recreated. A stale name would silently produce a rule that
+    matches nothing, leaving containers able to send while the run reports
+    success.
+    """
+    result = runner([
+        "docker", "network", "inspect", network,
+        "--format", '{{index .Options "com.docker.network.bridge.name"}}',
+    ])
+    name = (result.stdout or "").strip()
+    if result.returncode == 0 and name and name != "<no value>":
+        return name
+    result = runner(["docker", "network", "inspect", network, "--format", "{{.Id}}"])
+    if result.returncode != 0 or not result.stdout.strip():
+        raise EgressScopeError(f"cannot resolve the bridge for network {network!r}")
+    return "br-" + result.stdout.strip()[:12]
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--interface", required=True)
+    parser.add_argument("--network", default="beauty-gr_default")
+    parser.add_argument("--bridge", help="override bridge detection")
+    parser.add_argument("--apply", action="store_true")
+    parser.add_argument(
+        "--teardown",
+        action="store_true",
+        help="remove every T-074 rule found in the live ruleset, in one transaction",
+    )
+    parser.add_argument(
+        "--verify",
+        action="store_true",
+        help="check the live ruleset against the full contract and exit non-zero on any mismatch",
+    )
+    args = parser.parse_args(argv)
+
+    try:
+        bridge = args.bridge or detect_bridge(args.network)
+    except EgressScopeError as exc:
+        print(f"FAIL: {exc}", file=sys.stderr)
+        return 1
+
+    saved = _run(["iptables-save"])
+    if saved.returncode != 0:
+        print(f"FAIL: iptables-save: {saved.stderr.strip()}", file=sys.stderr)
+        return 1
+
+    if args.teardown:
+        document = build_teardown_document(saved.stdout)
+        if not document:
+            print("teardown: nothing owned by T-074 is present")
+            return 0
+        try:
+            assert_scope_teardown(document)
+        except EgressScopeError as exc:
+            print(f"FAIL: {exc}", file=sys.stderr)
+            return 1
+        if not args.apply:
+            print(document, end="")
+            print("# dry run — nothing applied")
+            return 0
+        removed = _run(["iptables-restore", "--noflush"], input_text=document)
+        if removed.returncode != 0:
+            print(f"FAIL: iptables-restore: {removed.stderr.strip()}", file=sys.stderr)
+            return 1
+        print(f"teardown: removed {document.count('-D ')} jump(s) and the chain")
+        return 0
+
+    if args.verify:
+        problems = verify(args.interface, bridge, saved.stdout)
+        if problems:
+            for problem in problems:
+                print(f"FAIL: {problem}", file=sys.stderr)
+            return 1
+        print(f"verified: {len(expected_lines(args.interface, bridge))} owned rules match the contract")
+        return 0
+
+    try:
+        document = build_reconciliation_document(saved.stdout, args.interface, bridge)
+        assert_scope(document, build_jump_rules(args.interface, bridge))
+    except EgressScopeError as exc:
+        print(f"FAIL: {exc}", file=sys.stderr)
+        return 1
+
+    stale = len(owned_parent_jumps(saved.stdout))
+    print(f"# deny outbound TCP/{SMTP_PORT} via {args.interface}; container bridge {bridge}")
+    print(f"# reconciling: {stale} existing owned jump(s) removed, 2 installed")
+
+    if not args.apply:
+        print(document, end="")
+        print("# dry run — nothing applied")
+        return 0
+
+    restore = _run(["iptables-restore", "--noflush"], input_text=document)
+    if restore.returncode != 0:
+        print(f"FAIL: iptables-restore: {restore.stderr.strip()}", file=sys.stderr)
+        return 1
+
+    # The whole policy is one transaction now, so a success here means the
+    # contract holds — but it is cheap to prove rather than assume.
+    confirm = _run(["iptables-save"])
+    if confirm.returncode != 0:
+        print(f"FAIL: iptables-save after apply: {confirm.stderr.strip()}", file=sys.stderr)
+        return 1
+    problems = verify(args.interface, bridge, confirm.stdout)
+    if problems:
+        for problem in problems:
+            print(f"FAIL: after apply: {problem}", file=sys.stderr)
+        return 1
+
+    print("applied")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
