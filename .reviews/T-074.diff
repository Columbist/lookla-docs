@@ -0,0 +1,226 @@
+"""
+T-074: outbound SMTP egress must be denied on exactly one port, in exactly two
+chains, and nowhere else.
+
+The two failure modes worth guarding are opposite in shape. Widening — a rule
+that catches 443 or 53 takes the site off the internet, and one that catches
+465/587 forecloses a legitimate mail setup later. Narrowing — a rule placed
+only in OUTPUT looks correct and covers nothing that runs in a container,
+which is the scenario the control exists for. Both are asserted against the
+generated rules rather than against intent.
+"""
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[2]
+_spec = importlib.util.spec_from_file_location(
+    "smtp_egress_t074", _ROOT / "ops" / "t074" / "smtp_egress.py"
+)
+eg = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(eg)
+
+IFACE = "eth0"
+BRIDGE = "br-7ee6b79d9884"
+
+
+def _jumps():
+    return eg.build_jump_rules(IFACE, BRIDGE)
+
+
+def _text():
+    return eg.build_restore_document() + " " + " ".join(" ".join(j) for j in _jumps()) + " "
+
+
+# ────────────────────────────── scope: the port ──────────────────────────────
+
+
+def test_tcp_25_is_denied():
+    assert "--dport 25 " in _text()
+
+
+@pytest.mark.parametrize("port", [22, 53, 80, 443, 465, 587, 3997, 3998, 3999, 4443, 8443, 8888])
+def test_no_other_port_is_ever_touched(port):
+    # 443 and 53 would break Resend and DNS; 465/587 are the submission ports a
+    # legitimate sender would use and are left open on purpose.
+    assert f"--dport {port} " not in _text()
+
+
+@pytest.mark.parametrize("port", [465, 587, 443, 53])
+def test_building_a_rule_for_another_port_is_refused(port):
+    with pytest.raises(eg.EgressScopeError):
+        eg.build_jump_rules(IFACE, BRIDGE, port=port)
+
+
+def test_the_chain_itself_matches_no_port():
+    # The chain is entered by the jumps; a port match inside it would be a
+    # second, unreviewed place for scope to drift.
+    assert "--dport" not in eg.build_restore_document()
+
+
+# ───────────────────────── scope: which chains, and why ──────────────────────
+
+
+def test_both_chains_are_covered():
+    chains = [j[0] for j in _jumps()]
+    assert chains == ["OUTPUT", "DOCKER-USER"]
+
+
+def test_output_alone_would_not_be_enough():
+    # FORWARD jumps to DOCKER-USER before anything else, so container traffic
+    # never traverses OUTPUT. A single-chain rule would report success while
+    # covering none of the containers.
+    assert any(j[0] == "DOCKER-USER" for j in _jumps()), (
+        "containers would be uncovered — this is the scenario the rule exists for"
+    )
+
+
+def test_docker_generated_chains_are_never_written_to():
+    text = _text()
+    for generated in ("-A DOCKER ", "-A DOCKER-FORWARD", "-A DOCKER-INGRESS"):
+        assert generated not in text
+    with pytest.raises(eg.EgressScopeError):
+        eg.assert_scope(eg.build_restore_document(), [["DOCKER-FORWARD", "-j", eg.CHAIN]])
+
+
+def test_wireguard_is_out_of_scope():
+    # wg0 peer traffic also traverses DOCKER-USER. An unscoped rule there would
+    # silently change what the operator's own VPN clients may do, which is a
+    # VPN policy decision and not this ticket's.
+    assert "wg0" not in _text()
+    # The probe must be a rule that is otherwise valid, or assert_scope stops
+    # at the earlier "no rule denies TCP/25" check and never reaches the wg0
+    # one — which is how an earlier version of this test passed without
+    # exercising the guarantee it names.
+    wg_jump = ["DOCKER-USER", "-i", "wg0", "-o", IFACE,
+               "-p", "tcp", "--dport", "25", "-j", eg.CHAIN]
+    with pytest.raises(eg.EgressScopeError, match="WireGuard"):
+        eg.assert_scope(eg.build_restore_document(), [wg_jump])
+
+
+def test_the_container_jump_is_scoped_to_the_compose_bridge():
+    container = next(j for j in _jumps() if j[0] == "DOCKER-USER")
+    assert "-i" in container and BRIDGE in container
+
+
+def test_both_jumps_are_scoped_to_the_external_interface():
+    # Keeps loopback and container-to-container traffic untouched.
+    for jump in _jumps():
+        assert "-o" in jump and IFACE in jump
+
+
+def test_only_the_owned_chain_is_populated():
+    doc = eg.build_restore_document()
+    assert "-A INPUT" not in doc and "-A FORWARD" not in doc and "-A OUTPUT" not in doc
+
+
+# ───────────────────────────── behaviour of the rule ─────────────────────────
+
+
+def test_the_verdict_is_reject_not_drop():
+    # Egress from our own software: a drop leaves a process hanging until its
+    # timeout, turning a policy decision into an intermittent stall that is
+    # hard to attribute. A rejection fails immediately and legibly.
+    doc = eg.build_restore_document()
+    assert "-j REJECT" in doc
+    assert "--reject-with icmp-port-unreachable" in doc
+    assert "-j DROP" not in doc
+
+
+def test_scope_check_catches_a_removed_verdict():
+    doc = eg.build_restore_document().replace("-j REJECT", "-j RETURN")
+    with pytest.raises(eg.EgressScopeError, match="control would be absent"):
+        eg.assert_scope(doc, _jumps())
+
+
+def test_scope_check_catches_a_missing_smtp_rule():
+    with pytest.raises(eg.EgressScopeError, match="control would be absent"):
+        eg.assert_scope(eg.build_restore_document(), [["OUTPUT", "-o", IFACE, "-j", eg.CHAIN]])
+
+
+# ──────────────────────────── atomicity and identity ─────────────────────────
+
+
+def test_the_transaction_is_a_single_atomic_restore_document():
+    doc = eg.build_restore_document()
+    assert doc.startswith("*filter\n")
+    assert f":{eg.CHAIN} - [0:0]" in doc
+    assert doc.rstrip().endswith("COMMIT")
+    assert doc.count("COMMIT") == 1
+
+
+def test_reapplying_produces_an_identical_document():
+    assert eg.build_restore_document() == eg.build_restore_document()
+
+
+def test_jumps_are_checked_before_insertion(monkeypatch, capsys):
+    class R:
+        returncode = 0
+        stdout = ""
+        stderr = ""
+
+    monkeypatch.setattr(eg, "_run", lambda *a, **k: R())
+    assert eg.main(["--interface", IFACE, "--bridge", BRIDGE, "--apply"]) == 0
+    assert capsys.readouterr().out.count("already present") == 2
+
+
+def test_dry_run_executes_nothing(monkeypatch, capsys):
+    def explode(*a, **k):
+        raise AssertionError("dry run must not execute firewall commands")
+
+    monkeypatch.setattr(eg, "_run", explode)
+    assert eg.main(["--interface", IFACE, "--bridge", BRIDGE]) == 0
+    assert "dry run — nothing applied" in capsys.readouterr().out
+
+
+# ─────────────────────────── bridge detection safety ─────────────────────────
+
+
+def test_the_bridge_is_resolved_at_apply_time_not_hardcoded():
+    calls = []
+
+    class R:
+        returncode = 0
+        stdout = "br-abc123def456\n"
+        stderr = ""
+
+    def runner(argv, **kw):
+        calls.append(argv)
+        return R()
+
+    assert eg.detect_bridge("beauty-gr_default", runner=runner) == "br-abc123def456"
+    assert calls[0][:3] == ["docker", "network", "inspect"]
+
+
+def test_bridge_detection_falls_back_to_the_network_id():
+    class Empty:
+        returncode = 0
+        stdout = "<no value>\n"
+        stderr = ""
+
+    class WithId:
+        returncode = 0
+        stdout = "7ee6b79d9884abcdef0123456789\n"
+        stderr = ""
+
+    answers = iter([Empty(), WithId()])
+    assert eg.detect_bridge("net", runner=lambda *a, **k: next(answers)) == "br-7ee6b79d9884"
+
+
+def test_an_unresolvable_bridge_stops_the_run():
+    # A stale or missing bridge name would silently produce a rule matching
+    # nothing, leaving containers able to send while the run reports success.
+    class Fail:
+        returncode = 1
+        stdout = ""
+        stderr = "no such network"
+
+    with pytest.raises(eg.EgressScopeError, match="cannot resolve the bridge"):
+        eg.detect_bridge("nope", runner=lambda *a, **k: Fail())
+
+
+@pytest.mark.parametrize("bad", ["", "br 0", None])
+def test_an_implausible_bridge_name_is_refused(bad):
+    with pytest.raises(eg.EgressScopeError):
+        eg.build_jump_rules(IFACE, bad)
