@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""
+T-074 — deny outbound direct-to-MX SMTP from this host and its containers.
+
+Port 25 is the port a compromised process uses to deliver mail itself, without
+any provider's authentication or rate limiting in the way. Nothing here needs
+it: the consumer audit found no local MTA, no listener on 25/465/587, no
+established connection to any mail port, no SMTP client code in the backend,
+crawler or frontend, and no mail-related cron entry. The application sends
+through Resend's **HTTPS** API. The host also publishes no PTR record, so
+direct-to-MX delivery from it would be penalised or refused by most receivers
+anyway.
+
+This matters more than it would on a clean host: this address spent seven days
+as an open HTTP relay (T-072) and was listed by Barracuda for it (T-073).
+Outbound mail is the obvious second act, and the point of closing it now is
+that no legitimate sender loses anything.
+
+**Two chains, because one would be a false assurance.** `FORWARD` jumps to
+`DOCKER-USER` before anything else, so a container's traffic to the internet
+never traverses `OUTPUT`. A rule placed only in `OUTPUT` would cover host
+processes and quietly miss all six containers — which is precisely the
+scenario the rule exists for. So:
+
+    OUTPUT       host processes leaving via the external interface
+    DOCKER-USER  container processes, scoped to the compose bridge
+
+Note this does not contradict T-049's conclusion that `DOCKER-USER` was the
+wrong layer there. That was about *inbound* 80/443, which host nginx owns and
+which never reaches Docker's forwarding path. For *outbound from containers*,
+`DOCKER-USER` is exactly the documented hook, and unlike `DOCKER` or
+`DOCKER-FORWARD` it is the one Docker leaves to the operator.
+
+**WireGuard is deliberately out of scope.** `FORWARD` also carries wg0 peer
+traffic through `DOCKER-USER`, so an unscoped rule there would silently change
+what the operator's own VPN clients may do. That is a VPN policy decision, not
+this ticket's, so the container rule is scoped to the compose bridge and wg0 is
+left alone.
+
+**465 and 587 are deliberately left open.** They are authenticated submission
+ports — what a legitimate sender would use through a provider. Blocking 25
+removes the abuse path without foreclosing a proper mail setup later. There is
+also no evidence they are unused in the same strong sense: the audit shows no
+current consumer, but leaving them open costs nothing and closing them would
+be a guess.
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+
+CHAIN = "LOOKLA-T074-DENY"
+COMMENT = "T-074 deny outbound SMTP"
+
+#: The only port this ticket may touch.
+SMTP_PORT = 25
+
+#: Ports that must never appear in a T-074 rule. 465/587 are submission ports
+#: (see the module docstring); 53 and 443 would break DNS and every outbound
+#: API call including Resend's; the rest belong to other tickets.
+FORBIDDEN_PORTS = (22, 53, 80, 443, 465, 587, 3997, 3998, 3999, 4443, 8443, 8888)
+
+
+class EgressScopeError(ValueError):
+    """Raised when a generated rule would exceed T-074's approved scope."""
+
+
+def build_chain_rules() -> list[str]:
+    """
+    Return the `iptables-restore` lines for T-074's chain.
+
+    `REJECT` rather than `DROP`, deliberately: this is egress from our own
+    software. A dropped connection leaves a process hanging until its timeout,
+    which turns a policy decision into an intermittent stall that is hard to
+    attribute. A rejection fails immediately and legibly, which is what an
+    operator wants when something unexpected tries to send mail.
+    """
+    return [
+        f'-A {CHAIN} -p tcp -m comment --comment "{COMMENT}" '
+        f"-j REJECT --reject-with icmp-port-unreachable",
+    ]
+
+
+def build_jump_rules(interface: str, bridge: str, port: int = SMTP_PORT) -> list[list[str]]:
+    """
+    Return the two jumps: host egress, and container egress.
+
+    Both are scoped to leaving via `interface`, so loopback and
+    container-to-container traffic are untouched.
+    """
+    if port != SMTP_PORT:
+        raise EgressScopeError(
+            f"port {port} is outside T-074's scope — only TCP/{SMTP_PORT} may be denied"
+        )
+    if port in FORBIDDEN_PORTS:
+        raise EgressScopeError(f"port {port} must never be denied by T-074")
+    if not interface or " " in interface:
+        raise EgressScopeError(f"implausible interface name: {interface!r}")
+    if not bridge or " " in bridge:
+        raise EgressScopeError(f"implausible bridge name: {bridge!r}")
+
+    common = [
+        "-p", "tcp",
+        "--dport", str(port),
+        "-m", "comment", "--comment",
+    ]
+    return [
+        # Host processes.
+        ["OUTPUT", "-o", interface, *common, f"{COMMENT} host", "-j", CHAIN],
+        # Container processes. Scoped by the compose bridge so wg0 peer traffic,
+        # which also traverses DOCKER-USER, keeps its current policy.
+        ["DOCKER-USER", "-i", bridge, "-o", interface, *common, f"{COMMENT} containers", "-j", CHAIN],
+    ]
+
+
+def build_restore_document() -> str:
+    """One atomic `iptables-restore --noflush` transaction for the chain."""
+    body = "\n".join(build_chain_rules())
+    return f"*filter\n:{CHAIN} - [0:0]\n{body}\nCOMMIT\n"
+
+
+def assert_scope(document: str, jumps: list[list[str]]) -> None:
+    """Fail before anything is applied if the generated rules drifted."""
+    joined = document + " " + " ".join(" ".join(j) for j in jumps) + " "
+    for port in FORBIDDEN_PORTS:
+        if f"--dport {port} " in joined:
+            raise EgressScopeError(f"generated rules reference forbidden port {port}")
+    if f"--dport {SMTP_PORT} " not in joined:
+        raise EgressScopeError("no rule denies TCP/25 — the control would be absent")
+    for generated in ("-A DOCKER ", "-A DOCKER-FORWARD", "-A DOCKER-INGRESS"):
+        if generated in joined:
+            raise EgressScopeError("must not write into Docker-generated chains")
+    if "-A INPUT" in document or "-A FORWARD" in document or "-A OUTPUT" in document:
+        raise EgressScopeError("only T-074's own chain may be populated here")
+    if "wg0" in joined:
+        raise EgressScopeError("WireGuard is deliberately out of scope")
+    if "-j REJECT" not in document:
+        raise EgressScopeError("no reject rule present — the control would be absent")
+
+
+def _run(argv: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(  # noqa: S603
+        argv, input=input_text, capture_output=True, text=True, check=False
+    )
+
+
+def detect_bridge(network: str = "beauty-gr_default", runner=_run) -> str:
+    """
+    Resolve the compose network's bridge interface at apply time.
+
+    Not hardcoded: the name contains the network id and changes if the compose
+    network is recreated. A stale name would silently produce a rule that
+    matches nothing, leaving containers able to send while the run reports
+    success.
+    """
+    result = runner([
+        "docker", "network", "inspect", network,
+        "--format", '{{index .Options "com.docker.network.bridge.name"}}',
+    ])
+    name = (result.stdout or "").strip()
+    if result.returncode == 0 and name and name != "<no value>":
+        return name
+    result = runner(["docker", "network", "inspect", network, "--format", "{{.Id}}"])
+    if result.returncode != 0 or not result.stdout.strip():
+        raise EgressScopeError(f"cannot resolve the bridge for network {network!r}")
+    return "br-" + result.stdout.strip()[:12]
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--interface", required=True)
+    parser.add_argument("--network", default="beauty-gr_default")
+    parser.add_argument("--bridge", help="override bridge detection")
+    parser.add_argument("--apply", action="store_true")
+    args = parser.parse_args(argv)
+
+    try:
+        bridge = args.bridge or detect_bridge(args.network)
+        document = build_restore_document()
+        jumps = build_jump_rules(args.interface, bridge)
+        assert_scope(document, jumps)
+    except EgressScopeError as exc:
+        print(f"FAIL: {exc}", file=sys.stderr)
+        return 1
+
+    print(f"# deny outbound TCP/{SMTP_PORT} via {args.interface}; container bridge {bridge}")
+    if not args.apply:
+        print(document, end="")
+        for chain, *rule in jumps:
+            print(f"# jump: iptables -I {chain} 1 {' '.join(rule)}")
+        print("# dry run — nothing applied")
+        return 0
+
+    restore = _run(["iptables-restore", "--noflush"], input_text=document)
+    if restore.returncode != 0:
+        print(f"FAIL: iptables-restore: {restore.stderr.strip()}", file=sys.stderr)
+        return 1
+
+    for chain, *rule in jumps:
+        if _run(["iptables", "-C", chain, *rule]).returncode == 0:
+            print(f"jump in {chain} already present — not duplicated")
+            continue
+        inserted = _run(["iptables", "-I", chain, "1", *rule])
+        if inserted.returncode != 0:
+            print(f"FAIL: could not install jump in {chain}: {inserted.stderr.strip()}", file=sys.stderr)
+            return 1
+        print(f"jump installed in {chain}")
+
+    print("applied")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/ops/t074/t074-smtp-egress.service b/ops/t074/t074-smtp-egress.service
new file mode 100644
index 0000000..c71ad9f
--- /dev/null
+++ b/ops/t074/t074-smtp-egress.service
@@ -0,0 +1,41 @@
+# T-074 — reinstate the outbound SMTP denial after a reboot or a Docker restart.
+#
+# `PartOf=docker.service` is the load-bearing line here, and for a reason
+# specific to this ticket. Docker rebuilds its own chains when it starts, and
+# recreating the compose network changes the bridge name. This unit re-runs the
+# apply, which resolves the bridge from the current state rather than from a
+# stored value — so a network recreated under a new id gets a correct rule
+# instead of a stale one that silently matches nothing.
+#
+# It does not fetch anything and needs no network of its own.
+#
+# Install:
+#   cp t074-smtp-egress.service /etc/systemd/system/
+#   systemctl daemon-reload && systemctl enable t074-smtp-egress.service
+#
+# Known limitation, deliberately not automated: if the compose network is
+# removed and recreated *without* restarting Docker, systemd sees no event and
+# this unit does not re-run. Re-run it by hand after such a change —
+# `systemctl restart t074-smtp-egress` — or the container half of the rule will
+# point at a bridge that no longer exists. The apply refuses to run at all when
+# the bridge cannot be resolved, so the failure is loud rather than silent.
+
+[Unit]
+Description=T-074 outbound SMTP restriction (TCP/25)
+After=network-online.target docker.service
+Wants=network-online.target
+Requires=docker.service
+PartOf=docker.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# Idempotent by construction: the chain is rebuilt in one atomic transaction
+# and each jump is inserted only when absent, so repeated starts cannot stack
+# duplicates.
+ExecStart=/usr/bin/python3 /opt/t074/smtp_egress.py --interface eth0 --apply
+StandardOutput=journal
+StandardError=journal
+
+[Install]
+WantedBy=multi-user.target
