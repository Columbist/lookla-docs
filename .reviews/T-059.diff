@@ -0,0 +1,36 @@
+import type { LucideIcon } from 'lucide-react';
+
+/**
+ * T-059 — the one shared icon contract for Visual Baseline v1. Wraps a
+ * lucide-react icon component with the product's fixed size/stroke scale
+ * so no call site invents its own numbers.
+ *
+ * Decorative by default (aria-hidden="true") — matches every existing
+ * icon-adjacent control in the codebase, which already carries its own
+ * accessible name via a real <label>, aria-label, or visible text (T-055/
+ * T-057). Pass `decorative={false}` only for the rare icon that is itself
+ * the sole conveyor of meaning with no adjacent label — even then, prefer
+ * fixing the control to have a real accessible name instead.
+ */
+export type IconSize = 16 | 20 | 24;
+
+const STROKE_WIDTH = 1.75;
+
+interface IconProps {
+  icon: LucideIcon;
+  size?: IconSize;
+  decorative?: boolean;
+  className?: string;
+}
+
+export default function Icon({ icon: LucideGlyph, size = 20, decorative = true, className }: IconProps) {
+  return (
+    <LucideGlyph
+      size={size}
+      strokeWidth={STROKE_WIDTH}
+      aria-hidden={decorative ? 'true' : undefined}
+      focusable="false"
+      className={className}
+    />
+  );
+}
