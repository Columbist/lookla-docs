+
+/*
+ * T-059 — Visual Baseline v1 foundation tokens (Direction B, Clean
+ * Marketplace). Values are copied verbatim from the approved Visual
+ * Baseline Audit's token proposal, extended only where the audit left a
+ * semantic category undefined (documented per-token below) and adjusted
+ * only where WCAG contrast validation (see docs/06_ENGINEERING/
+ * VISUAL_BASELINE_V1.md) required a stronger value — never a softer one.
+ *
+ * Single theme only (no dark mode) — matches the ticket's explicit
+ * "premature dark mode" prohibition and the audit's own scope.
+ *
+ * These tokens are not yet consumed by any real page under T-059 except
+ * the global body background/text/font (see layout.tsx and the base
+ * styles below) — page-level consumption is later, independently
+ * reviewable tickets (see the migration map in VISUAL_BASELINE_V1.md).
+ */
+:root {
+  /* Surfaces — audit verbatim */
+  --bg: #faf8f6;
+  --surface: #ffffff;
+  --surface-subtle: #f1ece7; /* not in the audit; a third warm-neutral step for subtle section backgrounds, between --bg and --surface */
+  --surface-elevated: #ffffff; /* audit communicates elevation via --shadow-elevated, not a distinct surface colour */
+
+  /* Text — audit verbatim, --text-muted darkened from the audit's draft
+     #9C938C (3.01:1 on white, fails WCAG AA) to #7C7069 (4.80:1) */
+  --text: #1e1a19;
+  --text-secondary: #6b625c;
+  --text-muted: #7c7069;
+  --text-inverse: #ffffff; /* not in the audit; needed for text on --brand fills */
+
+  /* Brand / action — the audit's --action / --action-hover, renamed to
+     the ticket's requested `brand` category. This is the single colour
+     meant to replace pink-600's overloaded role (brand + every action +
+     focus + active all at once) with one deliberately bounded action
+     colour. */
+  --brand: #a62e5c;
+  --brand-hover: #8a2549;
+  --brand-active: #711d3c; /* not in the audit; darker pressed-state step, same hue family */
+  --brand-soft: #f3e4ea; /* not in the audit; light tint for selected/active backgrounds (chips, active nav) */
+
+  /* Accent — the audit's --accent (muted gold), plus a darkened
+     text/icon-safe variant. --accent alone is 2.40:1 on white and must
+     never carry text or a meaningful (non-decorative) icon; --accent-strong
+     (5.03:1) is the variant for anything read as content, e.g. a verified
+     badge label. */
+  --accent: #c9a24b;
+  --accent-strong: #8a6a2c;
+  --accent-soft: #f7efdc; /* not in the audit; light tint for accent-coloured chip backgrounds */
+
+  /* Border */
+  --border: #e7e1db; /* audit verbatim */
+  --border-strong: #d3c9c0; /* not in the audit; deeper step for stronger separators/hover borders */
+
+  /* Focus — darkened from the audit's draft #D98CAE (2.53:1 vs surface,
+     2.38:1 vs bg — fails the 3:1 non-text/focus-indicator requirement) to
+     #B84B7C (4.84:1 / 4.57:1). Deliberately distinct from both --brand and
+     --danger so focus is never confused with either. */
+  --focus: #b84b7c;
+
+  /* Status — success/open reused from the audit verbatim; warning kept as
+     reserved per the audit ("not currently needed"); danger is new (the
+     audit intentionally did not define an error red, since it correctly
+     treats "closed" as a neutral status rather than an error — see
+     --closed below); closed is the audit's own token, verbatim. */
+  --success: #3e7a52;
+  --success-text: #2f6140; /* darkened for AA text-on-success-soft (audit's --success alone is 4.39:1, borderline) */
+  --success-soft: #e7f0e9;
+  --warning: #b0742a;
+  --warning-soft: #f5e9d8;
+  --danger: #a83232;
+  --danger-soft: #f5e1df;
+  --closed: #57504b;
+  --closed-soft: #ede9e5;
+
+  /* Shape */
+  --radius-sm: 6px;    /* inputs, badges */
+  --radius-md: 10px;   /* cards, buttons */
+  --radius-pill: 999px; /* status pills, chips */
+
+  /* Depth — two levels only, per the audit and Step 7's explicit cap */
+  --shadow-resting: 0 1px 2px rgba(30, 26, 25, 0.05), 0 2px 8px rgba(30, 26, 25, 0.04);
+  --shadow-elevated: 0 4px 16px rgba(30, 26, 25, 0.10);
+}
+
+/*
+ * Typography scale — semantic roles per T-059 Step 5/6. Sizes follow the
+ * audit's proposed 12/13/14/16/18/22/28/36 scale. Line-heights: 1.4 for
+ * body sizes, 1.2 for 22px+ headings (Step 5). Weights: 400 body, 500
+ * labels/buttons, 600 card titles, 700 page headings (Step 5) — four
+ * weights total, matching the four static weight files actually loaded
+ * (see layout.tsx / VISUAL_BASELINE_V1.md's font-loading contract).
+ *
+ * These are utility classes, not element selectors — h1/h2/etc. keep
+ * whatever semantic level a page already uses; a class here only changes
+ * appearance, never document structure (Step 6's explicit requirement).
+ */
+@layer components {
+  .text-display    { font-size: 36px; line-height: 1.2; font-weight: 700; }
+  .text-page-title { font-size: 28px; line-height: 1.2; font-weight: 700; }
+  .text-section-title { font-size: 22px; line-height: 1.2; font-weight: 600; }
+  .text-card-title { font-size: 16px; line-height: 1.4; font-weight: 600; }
+  .text-body       { font-size: 16px; line-height: 1.4; font-weight: 400; }
+  .text-body-sm    { font-size: 14px; line-height: 1.4; font-weight: 400; }
+  .text-label      { font-size: 13px; line-height: 1.4; font-weight: 500; }
+  .text-button     { font-size: 14px; line-height: 1.4; font-weight: 500; }
+  .text-meta       { font-size: 12px; line-height: 1.4; font-weight: 400; }
+  .text-caption    { font-size: 12px; line-height: 1.4; font-weight: 400; }
+}
+
+/*
+ * Global base — the one sitewide, uniform (never patchwork) application
+ * approved as T-059's proving surface. Page-level components that already
+ * set an explicit bg-white/bg-gray-50 (most of them) will still render
+ * their own colour on top of this — this base only becomes visible where
+ * no page-level class already overrides it. The font swap is the one
+ * genuinely visible, uniform, sitewide change this ticket makes to
+ * production.
+ */
+body {
+  background: var(--bg);
+  color: var(--text);
+  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
+}
+
+/*
+ * Shared focus-visible treatment — defined here so every future ticket's
+ * interactive elements can opt in via `focus-visible:outline-focus`
+ * (Tailwind alias, see tailwind.config.ts) without redefining the colour.
+ * Not swept across existing components in this ticket (see the migration
+ * map) — existing `focus:ring-pink-200` usages are untouched until each
+ * surface's own visual ticket lands, so nothing regresses today.
+ */
+.focus-ring-token:focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 2px;
+}
