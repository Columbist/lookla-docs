@@ -0,0 +1,37 @@
+import type { ButtonHTMLAttributes, ReactNode } from 'react';
+
+/**
+ * T-059 — the one shared primary/secondary button pattern for Visual
+ * Baseline v1. Consumes only semantic tokens (brand/surface/border/text),
+ * never a raw Tailwind colour utility, so a future palette change never
+ * requires touching a call site. Not yet wired into any shipped page —
+ * proven on the internal design-system-preview route only (see T-059's
+ * migration boundary in docs/06_ENGINEERING/VISUAL_BASELINE_V1.md); every
+ * real button in production today (search submit, contact actions, header
+ * CTA, etc.) keeps its own literal Tailwind classes until its own
+ * page-level visual ticket lands, so nothing in production changes shape
+ * or colour as a side effect of this component existing.
+ *
+ * Preserves T-057's 44px minimum control height unconditionally.
+ */
+type Variant = 'primary' | 'secondary';
+
+interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
+  variant?: Variant;
+  children: ReactNode;
+}
+
+const BASE = 'inline-flex items-center justify-center gap-2 rounded-md text-button min-h-[44px] px-4 transition-colors focus-ring-token disabled:opacity-50 disabled:pointer-events-none';
+
+const VARIANT_CLASSES: Record<Variant, string> = {
+  primary: 'bg-brand text-text-inverse hover:bg-brand-hover active:bg-brand-active',
+  secondary: 'bg-surface text-text border border-border hover:border-border-strong',
+};
+
+export default function Button({ variant = 'primary', className = '', children, ...rest }: ButtonProps) {
+  return (
+    <button type="button" className={`${BASE} ${VARIANT_CLASSES[variant]} ${className}`} {...rest}>
+      {children}
+    </button>
+  );
+}
