+++ b/frontend/lib/visualBaselineTokens.test.ts
@@ -0,0 +1,182 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { contrastRatio, WCAG_AA_NORMAL_TEXT, WCAG_AA_NON_TEXT } from './colorContrast';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const frontendRoot = path.join(here, '..');
+const globalsCss = fs.readFileSync(path.join(frontendRoot, 'app', 'globals.css'), 'utf-8');
+const tailwindConfig = fs.readFileSync(path.join(frontendRoot, 'tailwind.config.ts'), 'utf-8');
+const layoutSource = fs.readFileSync(path.join(frontendRoot, 'app', '[locale]', 'layout.tsx'), 'utf-8');
+
+/** Extracts a CSS custom property's hex value straight out of globals.css — never a second hardcoded copy of the palette, so this test always checks what's actually shipped. */
+function tokenHex(name: string): string {
+  const re = new RegExp(`${name}:\\s*(#[0-9a-fA-F]{3,8})\\s*;`);
+  const m = globalsCss.match(re);
+  if (!m) throw new Error(`token ${name} not found in globals.css`);
+  return m[1];
+}
+
+describe('T-059: required semantic tokens exist exactly once', () => {
+  const required = [
+    '--bg', '--surface', '--surface-subtle', '--surface-elevated',
+    '--text', '--text-secondary', '--text-muted', '--text-inverse',
+    '--brand', '--brand-hover', '--brand-active', '--brand-soft',
+    '--accent', '--accent-strong', '--accent-soft',
+    '--border', '--border-strong', '--focus',
+    '--success', '--success-text', '--success-soft',
+    '--warning', '--warning-soft',
+    '--danger', '--danger-soft',
+    '--closed', '--closed-soft',
+    '--radius-sm', '--radius-md', '--radius-pill',
+    '--shadow-resting', '--shadow-elevated',
+  ];
+
+  for (const token of required) {
+    test(`${token} is defined`, () => {
+      const re = new RegExp(`\\s${token.replace('--', '\\-\\-')}:\\s*[^;]+;`);
+      assert.ok(re.test(globalsCss), `expected ${token} to be declared in globals.css`);
+    });
+  }
+
+  test('no token is declared twice inside :root (no accidental duplicate/conflicting definition)', () => {
+    const rootBlock = globalsCss.slice(globalsCss.indexOf(':root {'), globalsCss.indexOf('\n}\n', globalsCss.indexOf(':root {')));
+    for (const token of required) {
+      const count = (rootBlock.match(new RegExp(`\\s${token.replace('--', '\\-\\-')}:`, 'g')) || []).length;
+      assert.equal(count, 1, `${token} should be declared exactly once inside :root, found ${count}`);
+    }
+  });
+
+  test('status colours (success/warning/danger/closed) are independent of --brand — no status token references var(--brand)', () => {
+    for (const token of ['--success', '--warning', '--danger', '--closed']) {
+      const re = new RegExp(`${token.replace('--', '\\-\\-')}:\\s*([^;]+);`);
+      const m = globalsCss.match(re);
+      assert.ok(m && !m[1].includes('var(--brand'), `${token} must not derive from --brand`);
+    }
+  });
+
+  test('--focus is a distinct value from --brand and --danger (never confused with either)', () => {
+    const focus = tokenHex('--focus');
+    const brand = tokenHex('--brand');
+    const danger = tokenHex('--danger');
+    assert.notEqual(focus.toLowerCase(), brand.toLowerCase());
+    assert.notEqual(focus.toLowerCase(), danger.toLowerCase());
+  });
+
+  test('token names are semantic, not colour names (no --pink/--pink500-style token)', () => {
+    assert.ok(!/--(pink|magenta|rose)\d*\s*:/i.test(globalsCss));
+  });
+});
+
+describe('T-059: Tailwind aliases resolve to the semantic CSS variables', () => {
+  const aliasPairs: [string, string][] = [
+    ['bg:', 'var(--bg)'], ['surface:', 'var(--surface)'], ['text:', 'var(--text)'],
+    ['brand:', 'var(--brand)'], ['accent:', 'var(--accent)'], ['border:', 'var(--border)'],
+    ['focus:', 'var(--focus)'], ['success:', 'var(--success)'], ['danger:', 'var(--danger)'],
+    ['closed:', 'var(--closed)'],
+  ];
+  for (const [tw, cssVar] of aliasPairs) {
+    test(`Tailwind "${tw.replace(':', '')}" resolves to ${cssVar}`, () => {
+      assert.ok(tailwindConfig.includes(`${tw} "${cssVar}"`), `expected tailwind.config.ts to alias ${tw} -> ${cssVar}`);
+    });
+  }
+
+  test('borderRadius/boxShadow/fontFamily are also token-driven, not new literal values', () => {
+    assert.ok(tailwindConfig.includes('borderRadius:'));
+    assert.ok(tailwindConfig.includes('boxShadow:'));
+    assert.ok(tailwindConfig.includes('"var(--font-inter)"'));
+  });
+});
+
+describe('T-059: contrast — core pairs meet WCAG AA', () => {
+  const textPairs: [string, string, string, string][] = [
+    ['text on bg', '--text', '--bg', 'normal'],
+    ['text on surface', '--text', '--surface', 'normal'],
+    ['text-secondary on bg', '--text-secondary', '--bg', 'normal'],
+    ['text-secondary on surface', '--text-secondary', '--surface', 'normal'],
+    ['text-muted on bg', '--text-muted', '--bg', 'normal'],
+    ['text-muted on surface', '--text-muted', '--surface', 'normal'],
+    ['text-inverse on brand', '--text-inverse', '--brand', 'normal'],
+    ['text-inverse on brand-hover', '--text-inverse', '--brand-hover', 'normal'],
+    ['brand on surface (links/secondary text)', '--brand', '--surface', 'normal'],
+    ['success-text on success-soft', '--success-text', '--success-soft', 'normal'],
+    ['closed on closed-soft', '--closed', '--closed-soft', 'normal'],
+    ['danger on danger-soft', '--danger', '--danger-soft', 'normal'],
+    ['accent-strong on surface', '--accent-strong', '--surface', 'normal'],
+  ];
+
+  for (const [label, fgTok, bgTok, kind] of textPairs) {
+    test(`${label} >= ${WCAG_AA_NORMAL_TEXT}:1`, () => {
+      const ratio = contrastRatio(tokenHex(fgTok), tokenHex(bgTok));
+      assert.ok(ratio >= WCAG_AA_NORMAL_TEXT, `${label}: ${ratio.toFixed(2)}:1, required ${WCAG_AA_NORMAL_TEXT}:1`);
+    });
+  }
+
+  test('focus indicator meets the 3:1 non-text contrast requirement against both surface and bg', () => {
+    const vsSurface = contrastRatio(tokenHex('--focus'), tokenHex('--surface'));
+    const vsBg = contrastRatio(tokenHex('--focus'), tokenHex('--bg'));
+    assert.ok(vsSurface >= WCAG_AA_NON_TEXT, `focus vs surface: ${vsSurface.toFixed(2)}:1`);
+    assert.ok(vsBg >= WCAG_AA_NON_TEXT, `focus vs bg: ${vsBg.toFixed(2)}:1`);
+  });
+
+  test('plain --accent (not accent-strong) is documented as decorative-only — its own contrast on surface is allowed to be below 4.5:1 because no token/component may use it for text', () => {
+    const ratio = contrastRatio(tokenHex('--accent'), tokenHex('--surface'));
+    // This assertion exists to make the constraint explicit and testable:
+    // if --accent is ever strengthened to text-safe contrast, accent-strong
+    // becomes redundant — that's fine, but should be a deliberate change.
+    assert.ok(ratio < WCAG_AA_NORMAL_TEXT, 'if this now passes, reconsider whether --accent-strong is still needed');
+  });
+});
+
+describe('T-059: typography — semantic classes exist, do not redefine heading semantics', () => {
+  const roles = ['text-display', 'text-page-title', 'text-section-title', 'text-card-title', 'text-body', 'text-body-sm', 'text-label', 'text-button', 'text-meta', 'text-caption'];
+  for (const role of roles) {
+    test(`.${role} is defined in globals.css`, () => {
+      assert.ok(globalsCss.includes(`.${role}`), `expected .${role} to be defined`);
+    });
+  }
+
+  test('typography classes are plain classes, not element selectors (h1/h2/etc. keep their own semantics)', () => {
+    assert.ok(!/h1\s*{/.test(globalsCss) && !/h1\s*,/.test(globalsCss), 'must not globally restyle <h1> by element selector');
+  });
+
+  test('four weights only: 400/500/600/700 appear in the typography scale, no others', () => {
+    const typographyBlock = globalsCss.slice(globalsCss.indexOf('@layer components'), globalsCss.indexOf('@layer components') + 1200);
+    const weights = [...typographyBlock.matchAll(/font-weight:\s*(\d+)/g)].map(m => m[1]);
+    const uniqueWeights = new Set(weights);
+    assert.ok(uniqueWeights.size <= 4, `expected at most 4 distinct weights, found ${[...uniqueWeights].join(', ')}`);
+    for (const w of uniqueWeights) assert.ok(['400', '500', '600', '700'].includes(w), `unexpected weight ${w}`);
+  });
+});
+
+describe('T-059: font loading contract', () => {
+  test('Inter is loaded via next/font/google (self-hosted at build time, no runtime CDN request)', () => {
+    assert.ok(layoutSource.includes("import { Inter } from 'next/font/google';"));
+  });
+
+  test('subsets cover latin, latin-ext, greek, and cyrillic', () => {
+    const block = layoutSource.slice(layoutSource.indexOf('const inter = Inter({'), layoutSource.indexOf('});', layoutSource.indexOf('const inter = Inter({')));
+    for (const subset of ['latin', 'latin-ext', 'greek', 'cyrillic']) {
+      assert.ok(block.includes(`'${subset}'`), `expected subset "${subset}"`);
+    }
+  });
+
+  test('exactly the 4 weights the type scale uses are requested — 400/500/600/700, not the full variable range', () => {
+    const block = layoutSource.slice(layoutSource.indexOf('const inter = Inter({'), layoutSource.indexOf('});', layoutSource.indexOf('const inter = Inter({')));
+    const weightMatch = block.match(/weight:\s*\[([^\]]+)\]/);
+    assert.ok(weightMatch, 'expected an explicit weight array, not the unbounded variable font');
+    const weights = weightMatch![1].split(',').map(w => w.trim().replace(/'/g, ''));
+    assert.deepEqual(weights.sort(), ['400', '500', '600', '700']);
+  });
+
+  test('display: swap avoids invisible-text layout shift', () => {
+    assert.ok(layoutSource.includes("display: 'swap'"));
+  });
+
+  test('the font variable is attached to <html>, and the fallback stack still includes the pre-existing system-ui stack', () => {
+    assert.ok(layoutSource.includes('className={inter.variable}'));
+    assert.ok(globalsCss.includes('var(--font-inter), ui-sans-serif, system-ui, sans-serif'));
+  });
+});
