+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'page.tsx'), 'utf-8');
+
+describe('T-059: design-system-preview — internal, unlinked, non-indexed proving route', () => {
+  test('is excluded from search indexing', () => {
+    assert.ok(source.includes('robots: { index: false, follow: false }'));
+  });
+
+  test('renders real localized strings via next-intl, never lorem/placeholder text', () => {
+    assert.ok(source.includes("getTranslations({ locale, namespace: 'home' })"));
+    assert.ok(source.includes("getTranslations({ locale, namespace: 'search' })"));
+    assert.ok(!/lorem ipsum/i.test(source));
+  });
+
+  test('proves every typography role defined in globals.css', () => {
+    for (const role of ['text-display', 'text-page-title', 'text-section-title', 'text-card-title', 'text-body', 'text-body-sm', 'text-label', 'text-meta']) {
+      assert.ok(source.includes(`className="${role}`) || source.includes(`className={\`${role}`), `expected ${role} to be demonstrated`);
+    }
+  });
+
+  test('proves both Button variants and a disabled state', () => {
+    assert.ok(source.includes('variant="primary"'));
+    assert.ok(source.includes('variant="secondary"'));
+    assert.ok(source.includes('disabled'));
+  });
+
+  test('proves the Icon system at all 3 defined sizes', () => {
+    assert.ok(source.includes('size={24}'));
+    assert.ok(source.includes('size={20}'));
+    assert.ok(source.includes('size={16}'));
+  });
+
+  test('proves all 4 status pill colours (success/closed/accent-strong/danger)', () => {
+    assert.ok(source.includes('--success-soft'));
+    assert.ok(source.includes('--closed-soft'));
+    assert.ok(source.includes('--accent-soft'));
+    assert.ok(source.includes('--danger-soft'));
+  });
+
+  test('does not import or render any real page component (SalonCard, SearchBar, Header, Footer) — this route proves tokens in isolation, it does not preview a redesigned real page', () => {
+    assert.ok(!source.includes("from '@/components/SalonCard'"));
+    assert.ok(!source.includes("from '@/components/SearchBar'"));
+    assert.ok(!source.includes("from '@/components/Header'"));
+  });
+});
