--- /dev/null
+++ b/frontend/app/[locale]/search/searchShellVisual.test.ts
@@ -0,0 +1,197 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const frontendRoot = path.join(here, '..', '..', '..');
+const source = fs.readFileSync(path.join(here, 'page.tsx'), 'utf-8');
+
+function readMessages(locale: string): any {
+  return JSON.parse(fs.readFileSync(path.join(frontendRoot, 'messages', `${locale}.json`), 'utf-8'));
+}
+
+const LOCALES = ['el', 'en', 'ru', 'uk'];
+
+const searchFormBlock = source.slice(source.indexOf('<form\n            role="search"'), source.indexOf('{/* Filter button */}'));
+const filterTriggerBlock = source.slice(source.indexOf('{/* Filter button */}'), source.indexOf('<div className="ml-auto'));
+const listMapBlock = source.slice(source.indexOf('<div className="ml-auto'), source.indexOf('</div>\n        </div>\n      </div>'));
+
+describe('T-064: hard-coded Greek rating text — fixed', () => {
+  test('the literal Greek string Όλες οι αξιολογήσεις no longer appears anywhere in page.tsx', () => {
+    assert.ok(!source.includes('Όλες οι αξιολογήσεις'));
+  });
+
+  test('the rating select default option now uses a localization key, not a literal string', () => {
+    assert.ok(source.includes("<option value=\"\">{t('all_ratings')}</option>"));
+  });
+
+  test('all_ratings is defined, non-empty, and locale-appropriate in all 4 locales', () => {
+    const expected: Record<string, string> = { el: 'Όλες οι αξιολογήσεις', en: 'All ratings', ru: 'Все рейтинги', uk: 'Всі рейтинги' };
+    for (const locale of LOCALES) {
+      const value = readMessages(locale).search.all_ratings;
+      assert.equal(value, expected[locale], `${locale}.search.all_ratings mismatch`);
+    }
+  });
+
+  test('no English fallback leakage: el/ru/uk all_ratings are not copies of the English string', () => {
+    const en = readMessages('en').search.all_ratings;
+    for (const locale of ['el', 'ru', 'uk']) {
+      assert.notEqual(readMessages(locale).search.all_ratings, en);
+    }
+  });
+
+  test('the rating filter semantics are unchanged: same 3 numeric option values, same default empty value, same onChange wiring', () => {
+    const ratingBlock = filterTriggerBlock.slice(filterTriggerBlock.indexOf("t('filter_rating')"), filterTriggerBlock.indexOf('clear_filters') === -1 ? filterTriggerBlock.length : filterTriggerBlock.indexOf("(area || city || category || minRating)"));
+    assert.ok(ratingBlock.includes('value="3"'));
+    assert.ok(ratingBlock.includes('value="4"'));
+    assert.ok(ratingBlock.includes('value="4.5"'));
