+# The marker of whatever generation is installed right now, preserved byte for
+# byte — including the case where there is none. It is the only thing that
+# authorises a rollback, so losing it disarms the protection that is already in
+# place. The backup lives inside the generation directory, on the same
+# filesystem, so putting it back is a rename and cannot half-succeed.
+MARKER="$STATE_DIR/current"
+MARKER_BACKUP="$GEN_DIR/previous-current"
+if [[ -f "$MARKER" ]]; then
+  cp -p "$MARKER" "$MARKER_BACKUP"
+fi
 
-printf '%s' "$GENERATION" > "$STATE_DIR/current"
+restore_previous_marker() {
+  if [[ -f "$MARKER_BACKUP" ]]; then
+    mv -f "$MARKER_BACKUP" "$MARKER"
+    log "restored the previous generation marker: $(cat "$MARKER")"
+  else
+    rm -f "$MARKER"
+  fi
+}
+
+printf '%s' "$GENERATION" > "$MARKER"
 
 TIMER_UNIT="lookla-t074-rollback-$GENERATION"
+# The rollback is run through an explicit interpreter rather than executed as a
+# file. $STATE_DIR lives under /run, which is mounted noexec on this host, so
+# exec'ing the path fails with EACCES no matter what mode bits it carries and
+# the timer can never be armed. Passing the script to bash reads it instead of
+# exec'ing it, which noexec does not restrict. A test asserts the rollback path
+# is never handed to systemd-run as the executable itself.
 systemd-run --on-active="$ROLLBACK_AFTER" --unit="$TIMER_UNIT" \
-  --description="T-074 automatic rollback ($GENERATION)" "$ROLLBACK" >/dev/null \
-  || fail "could not arm the rollback timer — nothing has been applied"
+  --description="T-074 automatic rollback ($GENERATION)" /bin/bash "$ROLLBACK" >/dev/null \
+  || {
+    # Nothing has been applied and no timer exists. Leaving the new marker in
+    # place would name a generation that was never installed; deleting it
+    # outright would disarm the generation that *is* installed. Put back
+    # exactly what was there.
+    restore_previous_marker
+    fail "could not arm the rollback timer — nothing has been applied"
+  }
 log "rollback armed: ${ROLLBACK_AFTER}s as $TIMER_UNIT.timer"
 
+# Only now are the older timers retired. Stopping them before the new one is
+# armed would leave a failed rollout with the previous generation's rules still
+# installed, its timer stopped and its marker replaced — protection in place
+# with nothing able to remove it. The new unit is skipped by name.
+for unit in $(systemctl list-units --all --no-legend 'lookla-t074-rollback-*.timer' 2>/dev/null | awk '{print $1}'); do
+  [[ "$unit" == "$TIMER_UNIT.timer" ]] && continue
+  log "stopping stale rollback timer: $unit"
+  systemctl stop "$unit" 2>/dev/null || true
+done
+rm -f "$MARKER_BACKUP"
+
 # Only now is the firewall touched.
 apply_rules || fail "apply failed — the armed rollback will restore automatically"
 verify_live || fail "rules are not present after apply — the armed rollback will restore automatically"
