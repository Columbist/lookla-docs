+++ b/ops/t072/apply_t072.sh
@@ -0,0 +1,179 @@
+#!/usr/bin/env bash
+# T-072 — contain an open HTTP relay and three orphaned public Lookla servers.
+#
+# Rollback here is deliberately NOT one all-or-nothing restoration. The thing
+# being removed is active abuse: if an unrelated verification step fails, the
+# correct outcome is to restore Lookla, the VPN and SSH — not to hand the
+# internet back an open relay because a smoke check was flaky. So the timed
+# automatic guard covers only the layers that can take the site or the VPN
+# down (nginx and the firewall). Tinyproxy and the orphaned processes get
+# manual rollback scripts that an operator runs deliberately, never a timer.
+#
+# Order is chosen so that the more dangerous change is always the one already
+# proven:
+#   1. back up everything, write the three separate rollback scripts
+#   2. arm the timed guard for nginx+firewall only
+#   3. firewall first — it is reversible in milliseconds and closes the abuse
+#      immediately, before any service is reconfigured
+#   4. nginx: `-t` then reload (never restart: a restart drops established VPN
+#      connections a reload preserves)
+#   5. tinyproxy config + restart (its own service only)
+#   6. stop the orphans last, once nothing else can still need them
+#
+# Usage: ./apply_t072.sh --interface eth0 [--rollback-after 900] [--dry-run]
+
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO="$(cd "$HERE/../.." && pwd)"
+BACKUP_DIR="/var/backups/t072"
+STREAM_DIR="/etc/nginx/stream.d"
+TP_CONF="/etc/tinyproxy/tinyproxy.conf"
+ROLLBACK_AFTER=900
+INTERFACE=""
+DRY_RUN=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --interface)      INTERFACE="$2"; shift 2 ;;
+    --rollback-after) ROLLBACK_AFTER="$2"; shift 2 ;;
+    --dry-run)        DRY_RUN=1; shift ;;
+    *) echo "unknown argument: $1" >&2; exit 2 ;;
+  esac
+done
+
+[[ -n "$INTERFACE" ]] || { echo "--interface is required" >&2; exit 2; }
+[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 2; }
+
+log()  { printf '[t072] %s\n' "$*"; }
+fail() { printf '[t072] FAIL: %s\n' "$*" >&2; exit 1; }
+
+STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
+BACKUP="$BACKUP_DIR/$STAMP"
+mkdir -p "$BACKUP"
+iptables-save                 > "$BACKUP/iptables.rules"
+cp -a "$STREAM_DIR"             "$BACKUP/stream.d"
+cp -a "$TP_CONF"                "$BACKUP/tinyproxy.conf"
+ss -lntup                     > "$BACKUP/listeners-before.txt" 2>/dev/null || true
+[[ -s "$BACKUP/iptables.rules" ]] || fail "iptables backup empty — refusing to continue"
+ln -sfn "$BACKUP" "$BACKUP_DIR/latest"
+log "backup: $BACKUP"
+
+# ── rollback 1: nginx + firewall (the timed guard restores only this) ────────
+cat > "$BACKUP/rollback-network.sh" <<NET
+#!/usr/bin/env bash
+# Restores the layers that can take Lookla or the VPN down. Deliberately does
+# NOT restore tinyproxy's public exposure.
+set -euo pipefail
+for port in 8888 3997 3998 3999; do
+  iptables -D INPUT -i ${INTERFACE} -p tcp --dport \$port -m comment --comment "T-072 contain public listener \$port" -j LOOKLA-T072-DENY 2>/dev/null || true
+done
+iptables -F LOOKLA-T072-DENY 2>/dev/null || true
+iptables -X LOOKLA-T072-DENY 2>/dev/null || true
+cp -a $BACKUP/stream.d/port443.conf ${STREAM_DIR}/port443.conf
+nginx -t && nginx -s reload
+echo "[t072] network layer rolled back from $BACKUP"
+NET
+
+# ── rollback 2: tinyproxy — manual only, never automatic ─────────────────────
+cat > "$BACKUP/rollback-tinyproxy.sh" <<TP
+#!/usr/bin/env bash
+# MANUAL ONLY. This restores a configuration that was measured serving 93
+# external clients as an open relay. Run it only with a deliberate decision.
+set -euo pipefail
+cp -a $BACKUP/tinyproxy.conf ${TP_CONF}
+systemctl restart tinyproxy
+echo "[t072] tinyproxy config restored — VERIFY IT IS NOT PUBLICLY REACHABLE"
+TP
+
+# ── rollback 3: orphaned servers — manual, and normally never wanted ─────────
+cat > "$BACKUP/rollback-orphans.sh" <<'ORPH'
+#!/usr/bin/env bash
+# MANUAL ONLY, and normally never wanted. The three next-server processes were
+# orphaned `npx next` invocations serving an outdated Lookla build on public
+# ports, bypassing Cloudflare. Production is served by the beauty_web
+# container; restarting these restores an exposure, not a capability.
+echo "[t072] refusing to relaunch orphaned public servers automatically."
+echo "       Production frontend is the beauty_web container."
+exit 1
+ORPH
+
+chmod +x "$BACKUP"/rollback-*.sh
+log "rollback scripts: network (timed) + tinyproxy (manual) + orphans (manual)"
+
+if [[ $DRY_RUN -eq 1 ]]; then
+  log "dry run"
+  python3 "$HERE/containment.py" --interface "$INTERFACE"
+  diff -u "$TP_CONF" "$REPO/ops/t072/tinyproxy.conf" || true
+  diff -u "$STREAM_DIR/port443.conf" "$REPO/ops/nginx/stream.d/port443.conf" || true
+  exit 0
+fi
+
+# ── 2. arm the timed guard for the network layer only ────────────────────────
+systemd-run --on-active="${ROLLBACK_AFTER}" --unit=t072-rollback \
+  --description="T-072 automatic network rollback" "$BACKUP/rollback-network.sh" >/dev/null
+log "timed network rollback armed: ${ROLLBACK_AFTER}s (nginx+firewall only, by design)"
+
+# ── 3. firewall first: closes the abuse immediately, trivially reversible ────
+python3 "$HERE/containment.py" --interface "$INTERFACE" --apply \
+  || fail "firewall apply failed"
+
+# ── 4. nginx: remove the empty-SNI route into the relay ──────────────────────
+install -m 0644 "$REPO/ops/nginx/stream.d/port443.conf" "$STREAM_DIR/port443.conf.new"
+mv -f "$STREAM_DIR/port443.conf.new" "$STREAM_DIR/port443.conf"
+if ! nginx -t; then
+  cp -a "$BACKUP/stream.d/port443.conf" "$STREAM_DIR/port443.conf"
+  fail "nginx -t rejected the new config — previous config restored"
+fi
+nginx -s reload || fail "nginx reload failed"
+log "nginx reloaded — empty SNI no longer routes to the proxy"
+
+# ── 5. tinyproxy: loopback only ──────────────────────────────────────────────
+install -m 0644 "$REPO/ops/t072/tinyproxy.conf" "$TP_CONF"
+if ! systemctl restart tinyproxy; then
+  cp -a "$BACKUP/tinyproxy.conf" "$TP_CONF"
+  systemctl restart tinyproxy || true
+  fail "tinyproxy failed to start with the new config — previous config restored"
+fi
+sleep 2
+if ss -lnt 2>/dev/null | grep -qE '(0\.0\.0\.0|\[::\]):8888'; then
+  fail "tinyproxy is STILL listening publicly — investigate before continuing"
+fi
+log "tinyproxy restricted to loopback"
+
+# ── 6. stop the orphans last ─────────────────────────────────────────────────
+for port in 3997 3998 3999; do
+  pid="$(ss -lntp 2>/dev/null | grep ":$port " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true)"
+  [[ -n "${pid:-}" ]] || { log "port $port: no listener"; continue; }
+  log "stopping orphan on :$port (pid $pid)"
+  kill -TERM "$pid" 2>/dev/null || true
+  for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
+  if kill -0 "$pid" 2>/dev/null; then
+    log "  did not exit on TERM, sending KILL"
+    kill -KILL "$pid" 2>/dev/null || true
+  fi
+done
+sleep 2
+still="$(ss -lnt 2>/dev/null | grep -cE ':(3997|3998|3999) ' || true)"
+[[ "$still" -eq 0 ]] || fail "ports 3997-3999 still have listeners after termination"
+log "orphaned servers stopped"
+
+ss -lntup > "$BACKUP/listeners-after.txt" 2>/dev/null || true
+
+cat <<'NEXT'
+
+[t072] Applied. The timed rollback covers nginx+firewall ONLY — it will not
+       restore the open proxy. Verify from an EXTERNAL host, then cancel it:
+
+         1. origin:8888, :3997, :3998, :3999  → denied/timed out
+         2. public :443 with empty SNI        → reject, no tinyproxy log entry
+         3. https://lookla.gr/ through Cloudflare, all four locales
+         4. VPN clients still connecting
+         5. a second, independent SSH session still works
+
+         systemctl stop t072-rollback.timer
+
+       Manual rollbacks (deliberate use only):
+         /var/backups/t072/latest/rollback-network.sh
+         /var/backups/t072/latest/rollback-tinyproxy.sh
+NEXT
diff --git a/ops/t072/containment.py b/ops/t072/containment.py
