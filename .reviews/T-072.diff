@@ -0,0 +1,170 @@
+#!/usr/bin/env python3
+"""
+T-072 — deny external access to listeners that should never have been public.
+
+Two unrelated services were found reachable from the internet during the T-049
+inventory:
+
+  * `tinyproxy` on `0.0.0.0:8888` with `Allow 0.0.0.0/0` and no authentication —
+    an open HTTP relay, measured being used by 93 external hosts and hitting
+    its 100-connection ceiling ~15,900 times in four hours.
+  * three orphaned `next-server` processes on `*:3997-3999` serving Lookla
+    itself, bypassing both Cloudflare and the T-049 gate.
+
+The rules here are blunt on purpose. Unlike T-049, which had to preserve a
+legitimate external audience for the port it filtered, these ports have **no
+established external consumer at all** — so the correct rule is "deny from the
+public interface", not "allow a list". Loopback is untouched, which is what
+lets tinyproxy keep serving the one local client while its abusers are cut
+off.
+
+This does not replace binding the service to loopback; it complements it. A
+firewall rule alone leaves the service listening, and binding alone would
+still be reachable through nginx's stream router, which connects from
+loopback. Both are required, which is why they ship together.
+
+Rule construction is pure so the scope — exactly these ports, only inbound on
+the external interface, nothing else — is testable without a firewall.
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+
+CHAIN = "LOOKLA-T072-DENY"
+COMMENT = "T-072 contain public listener"
+
+#: The listeners this ticket contains. Each has been confirmed to have no
+#: legitimate external consumer; see the backlog entry for the evidence.
+CONTAINED_PORTS = (8888, 3997, 3998, 3999)
+
+#: Ports that must never appear in a T-072 rule. 80 and 443 belong to T-049 and
+#: to the shared SNI router — filtering 443 here would disconnect the VPN, the
+#: exact mistake T-049 was redesigned to avoid. 22 is the way back in.
+FORBIDDEN_PORTS = (22, 80, 443, 4443, 8443, 3000, 5432, 6379, 8001)
+
+
+class ContainmentScopeError(ValueError):
+    """Raised when a generated rule would exceed T-072's approved scope."""
+
+
+def build_chain_rules() -> list[str]:
+    """
+    Return the `iptables-restore` lines for T-072's chain.
+
+    A single DROP. The chain is only ever entered for the contained ports on
+    the external interface (see `build_jump_rules`), so there is nothing to
+    accept first: no external source is permitted to any of them.
+    """
+    return [
+        f'-A {CHAIN} -m comment --comment "{COMMENT}" -j DROP',
+    ]
+
+
+def build_jump_rules(interface: str, ports=CONTAINED_PORTS) -> list[list[str]]:
+    """Return one jump argv per contained port, scoped to the external interface."""
+    if not interface or " " in interface:
+        raise ContainmentScopeError(f"implausible interface name: {interface!r}")
+    jumps = []
+    for port in ports:
+        if port in FORBIDDEN_PORTS:
+            raise ContainmentScopeError(
+                f"port {port} must never be filtered by T-072 — it belongs to "
+                "T-049, the shared SNI router, or management access"
+            )
+        if port not in CONTAINED_PORTS:
+            raise ContainmentScopeError(
+                f"port {port} is outside T-072's approved scope {CONTAINED_PORTS}"
+            )
+        jumps.append([
+            "-i", interface,
+            "-p", "tcp",
+            "--dport", str(port),
+            "-m", "comment", "--comment", f"{COMMENT} {port}",
+            "-j", CHAIN,
+        ])
+    return jumps
+
+
+def build_restore_document() -> str:
+    """One atomic `iptables-restore --noflush` transaction for the chain."""
+    body = "\n".join(build_chain_rules())
+    return f"*filter\n:{CHAIN} - [0:0]\n{body}\nCOMMIT\n"
+
+
+def assert_scope(document: str, jumps: list[list[str]]) -> None:
+    """Fail loudly before anything is applied if the scope drifted."""
+    joined = document + " " + " ".join(" ".join(j) for j in jumps)
+    for port in FORBIDDEN_PORTS:
+        if f"--dport {port} " in joined + " ":
+            raise ContainmentScopeError(
+                f"generated rules reference forbidden port {port}"
+            )
+    if "DOCKER" in joined:
+        raise ContainmentScopeError("generated rules must not reference Docker chains")
+    if "-A INPUT" in document:
+        raise ContainmentScopeError("only T-072's own chain may be populated here")
+    if "-j DROP" not in document:
+        raise ContainmentScopeError("no deny rule present — the control would be absent")
+    # Every contained port must actually be covered; a jump silently dropped
+    # would leave a listener exposed while the run still reported success.
+    for port in CONTAINED_PORTS:
+        if f"--dport {port} " not in " ".join(" ".join(j) for j in jumps) + " ":
+            raise ContainmentScopeError(f"contained port {port} has no jump rule")
+
+
+def _run(argv: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(  # noqa: S603
+        argv, input=input_text, capture_output=True, text=True, check=False
+    )
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--interface", required=True)
+    parser.add_argument(
+        "--apply",
+        action="store_true",
+        help="apply the rules; without it the transaction is only printed",
+    )
+    args = parser.parse_args(argv)
+
+    try:
+        document = build_restore_document()
+        jumps = build_jump_rules(args.interface)
+        assert_scope(document, jumps)
+    except ContainmentScopeError as exc:
+        print(f"FAIL: {exc}", file=sys.stderr)
+        return 1
+
+    print(f"# containing ports {CONTAINED_PORTS} on {args.interface}")
+    if not args.apply:
+        print(document, end="")
+        for jump in jumps:
+            print(f"# jump: iptables -I INPUT 1 {' '.join(jump)}")
+        print("# dry run — nothing applied")
+        return 0
+
+    restore = _run(["iptables-restore", "--noflush"], input_text=document)
+    if restore.returncode != 0:
+        print(f"FAIL: iptables-restore: {restore.stderr.strip()}", file=sys.stderr)
+        return 1
+
+    for jump in jumps:
+        if _run(["iptables", "-C", "INPUT", *jump]).returncode == 0:
+            print(f"jump for {jump[5]} already present — not duplicated")
+            continue
+        inserted = _run(["iptables", "-I", "INPUT", "1", *jump])
+        if inserted.returncode != 0:
+            print(f"FAIL: could not install jump: {inserted.stderr.strip()}", file=sys.stderr)
+            return 1
+        print(f"jump installed for port {jump[5]}")
+
+    print("applied")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
