new file mode 100644
index 0000000..19421b2
--- /dev/null
+++ b/ops/t072/tinyproxy.conf
@@ -0,0 +1,52 @@
+# T-072 — tinyproxy restricted to loopback.
+#
+# The previous configuration combined `Port 8888` with an implicit wildcard
+# bind and `Allow 0.0.0.0/0`, and set no `BasicAuth` — an open, unauthenticated
+# HTTP relay reachable from the whole internet. Measured over four hours it was
+# serving 93 external clients and exhausting its 100-connection ceiling roughly
+# 15,900 times. Destinations were entirely external (no loopback, RFC1918,
+# Docker, WireGuard or metadata targets appeared in 90,977 parsed requests), so
+# this was outbound relay abuse rather than a pivot into internal systems —
+# but the host's address is the one attributed to that traffic.
+#
+# The service is kept, bound to loopback only, until the 88 requests observed
+# from 127.0.0.1 are traced to a process. Deleting a service whose consumer is
+# unidentified is the mistake T-049 avoided with the VPN; removing its public
+# exposure is not.
+#
+# Deliberately NOT done here:
+#   * no `BasicAuth` on a public listener — credentials on an open relay make
+#     it an authenticated open relay, not a contained one;
+#   * no WireGuard allowlist — there were zero WireGuard clients, so there is
+#     nothing to preserve;
+#   * no IPv6 listener.
+#
+# If personal use is later confirmed, it comes back through WireGuard with
+# authentication, as its own reviewed change. The public unauthenticated
+# listener is not restored.
+
+User tinyproxy
+Group tinyproxy
+
+# Bind explicitly. Without `Listen`, tinyproxy accepts on every interface.
+Listen 127.0.0.1
+Port 8888
+
+Timeout 600
+
+DefaultErrorFile "/usr/share/tinyproxy/default.html"
+StatFile "/usr/share/tinyproxy/stats.html"
+
+LogFile "/var/log/tinyproxy/tinyproxy.log"
+LogLevel Info
+
+PidFile "/run/tinyproxy/tinyproxy.pid"
+
+MaxClients 100
+
+# Loopback only. `Allow 0.0.0.0/0` is what made this an open relay; with a
+# loopback bind an Allow list is belt-and-braces, and it stays narrow so that
+# re-binding to a wider address later cannot silently re-open the relay.
+Allow 127.0.0.1
+
+ViaProxyName "tinyproxy"
