+    assert.ok(id && id.length > 0);
+  });
+
+  test('reuses the same id on repeated calls for the same entry (idempotent)', () => {
+    const h = fakeHistory(null);
+    const first = ensureEntryId(h);
+    const second = ensureEntryId(h);
+    assert.equal(first, second);
+  });
+
+  test('merges into existing history.state — does not replace it wholesale', () => {
+    const h = fakeHistory({ nextInternalState: 'preserve-me', anotherKey: 42 });
+    ensureEntryId(h);
+    const state = h.state as Record<string, unknown>;
+    assert.equal(state.nextInternalState, 'preserve-me');
+    assert.equal(state.anotherKey, 42);
+    assert.ok(state.__lookla);
+  });
