+import type { SalonListItem } from './api';
+import type { Locale } from '@/i18n/request';
+
+/**
+ * T-056: restores already-loaded search results and scroll position when a
+ * user returns via browser Back from a salon detail page.
+ *
+ * Deliberately in-memory (a module-scope Map), never sessionStorage or
+ * localStorage: the public Cookie Policy (app/[locale]/cookies/content.ts,
+ * all 4 locales, section 1) states "Lookla does not use any other form of
+ * browser storage (localStorage, sessionStorage)" — a factual claim already
+ * published and verified against the running site. An in-memory cache also
+ * satisfies every invalidation rule this ticket needs for free: it survives
+ * genuine SPA navigation within the same tab (Next.js <Link> transitions
+ * never reload the JS realm — verified directly against production), but a
+ * hard reload or a new tab starts a fresh JS realm with an empty cache,
+ * which is exactly the "always fresh" behavior those two cases require.
+ */
+
+export const SNAPSHOT_VERSION = 1;
+const SNAPSHOT_TTL_MS = 30 * 60 * 1000;
+const MAX_SALONS = 500;
+const HISTORY_STATE_KEY = '__lookla';
+
+export interface SearchReturnSnapshot {
+  version: 1;
+  createdAt: number;
+  entryId: string;
+  searchKey: string;
+  locale: Locale;
+  view: 'list' | 'map';
+  salons: SalonListItem[];
+  currentPage: number;
+  hasMore: boolean;
+  total: number;
+  scrollY: number;
+}
+
+const snapshotCache = new Map<string, SearchReturnSnapshot>();
+
+function readEntryId(historyState: unknown): string | undefined {
+  if (!historyState || typeof historyState !== 'object') return undefined;
+  const namespaced = (historyState as Record<string, unknown>)[HISTORY_STATE_KEY];
+  if (!namespaced || typeof namespaced !== 'object') return undefined;
+  const id = (namespaced as Record<string, unknown>).entryId;
+  return typeof id === 'string' && id ? id : undefined;
+}
+
+/**
+ * Assigns (once) or reuses a per-history-entry identifier, merged into the
+ * existing history.state object under a namespaced key. Never replaces
+ * history.state wholesale — Next.js's own router state (and anything else
+ * already there) is preserved via spread. Idempotent: calling this again on
+ * an entry that already has an id returns the same id.
+ */
+export function ensureEntryId(historyObj: History = window.history): string | null {
+  try {
+    const existing = readEntryId(historyObj.state);
+    if (existing) return existing;
+    const id = typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
+      ? crypto.randomUUID()
+      : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
+    const prevState = historyObj.state && typeof historyObj.state === 'object' ? historyObj.state : {};
+    historyObj.replaceState(
+      { ...prevState, [HISTORY_STATE_KEY]: { ...(prevState as Record<string, unknown>)[HISTORY_STATE_KEY] as object, entryId: id } },
+      '',
+    );
+    return id;
+  } catch {
+    return null; // history API unavailable/blocked — safe fallback is "no restoration", never a crash
+  }
+}
+
+/** Reads the current entry's id without assigning one — used by the restore path, which must never create an id for an entry that never had one. */
+export function readCurrentEntryId(historyObj: History = window.history): string | null {
+  try {
+    return readEntryId(historyObj.state) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+export interface SearchKeyParams {
+  area: string;
+  city: string;
+  q: string;
+  category: string;
+  minRating: string;
+}
+
+/**
+ * Every parameter that changes result identity — the same fields
+ * buildParams() in search/page.tsx sends to /api/salons, minus limit/page
+ * (pagination, not identity). Excludes view (list/map share the same
+ * underlying list identity) and any tracking parameter. Query is trimmed
+ * for key-comparison purposes only — the URL's own (harmless, cosmetic)
+ * whitespace handling is unrelated and untouched by this.
+ */
+export function computeSearchKey(params: SearchKeyParams): string {
+  return [params.area, params.city, params.q.trim(), params.category, params.minRating].join('');
+}
+
+function isFiniteNumber(v: unknown): v is number {
+  return typeof v === 'number' && Number.isFinite(v);
+}
+
+function isValidSalonList(v: unknown): v is SalonListItem[] {
+  if (!Array.isArray(v) || v.length > MAX_SALONS) return false;
+  return v.every(s => s && typeof s === 'object' && typeof (s as Record<string, unknown>).id === 'number' && typeof (s as Record<string, unknown>).name === 'string');
+}
+
+const VALID_LOCALES = ['el', 'en', 'ru', 'uk'];
+
+/** Runtime validation — any structural problem discards the snapshot silently; never throws into the UI. */
+export function isValidSnapshot(v: unknown): v is SearchReturnSnapshot {
+  if (!v || typeof v !== 'object') return false;
+  const s = v as Record<string, unknown>;
+  if (s.version !== SNAPSHOT_VERSION) return false;
+  if (!isFiniteNumber(s.createdAt) || Date.now() - (s.createdAt as number) > SNAPSHOT_TTL_MS || (s.createdAt as number) > Date.now()) return false;
+  if (typeof s.entryId !== 'string' || !s.entryId) return false;
+  if (typeof s.searchKey !== 'string') return false;
+  if (!VALID_LOCALES.includes(s.locale as string)) return false;
+  if (s.view !== 'list' && s.view !== 'map') return false;
+  if (!isValidSalonList(s.salons)) return false;
+  if (!isFiniteNumber(s.currentPage) || (s.currentPage as number) < 1) return false;
+  if (typeof s.hasMore !== 'boolean') return false;
+  if (!isFiniteNumber(s.total) || (s.total as number) < 0) return false;
+  if (!isFiniteNumber(s.scrollY) || (s.scrollY as number) < 0) return false;
+  return true;
+}
+
+/** Never throws — a failed save must never break navigation. */
+export function saveSnapshot(snapshot: SearchReturnSnapshot): void {
+  try {
+    if (!isValidSnapshot(snapshot)) return;
+    snapshotCache.set(snapshot.entryId, snapshot);
+  } catch {
+    // swallow — saving a snapshot must never break the navigation it's attached to
+  }
+}
+
+/** Returns a validated, identity-matching snapshot, or null. Every mismatch is a safe fallback to a fresh page-1 load — never a UI error. */
+export function getValidSnapshot(entryId: string | null, searchKey: string, locale: Locale): SearchReturnSnapshot | null {
+  if (!entryId) return null;
+  try {
+    const snap = snapshotCache.get(entryId);
+    if (!snap) return null;
+    if (!isValidSnapshot(snap)) {
+      snapshotCache.delete(entryId);
+      return null;
+    }
+    if (snap.entryId !== entryId || snap.searchKey !== searchKey || snap.locale !== locale) return null;
+    return snap;
+  } catch {
+    return null;
+  }
+}
+
+/** Test-only: clears the module-scope cache between test cases. Not used by app code. */
+export function __clearSnapshotCacheForTests(): void {
+  snapshotCache.clear();
+}
