+// Minimal fake History — real enough to exercise the actual merge/idempotency
+// logic, without needing jsdom (this repo's test runner is plain node --test).
+function fakeHistory(initialState: unknown = null): History {
+  let state = initialState;
+  return {
+    get state() { return state; },
+    replaceState(newState: unknown) { state = newState; },
+  } as unknown as History;
+}
+
+function validSnapshot(overrides: Partial<SearchReturnSnapshot> = {}): SearchReturnSnapshot {
+  return {
+    version: SNAPSHOT_VERSION,
+    createdAt: Date.now(),
+    entryId: 'entry-1',
+    searchKey: 'piraeus',
+    locale: 'en',
+    view: 'list',
+    salons: [{ id: 1, name: 'Test Salon', rating_count: 0, is_verified: false }],
+    currentPage: 2,
+    hasMore: true,
+    total: 90,
+    scrollY: 1200,
+    ...overrides,
+  } as SearchReturnSnapshot;
+}
