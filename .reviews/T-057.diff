+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const frontendRoot = path.join(here, '..', '..', '..');
+const source = fs.readFileSync(path.join(here, 'page.tsx'), 'utf-8');
+
+function readMessages(locale: string) {
+  return JSON.parse(fs.readFileSync(path.join(frontendRoot, 'messages', `${locale}.json`), 'utf-8'));
+}
+
+const searchFormBlock = source.slice(source.indexOf('<form\n            role="search"'), source.indexOf('{/* Filter button */}'));
+const filterTriggerBlock = source.slice(source.indexOf('{/* Filter button */}'), source.indexOf('<div className="ml-auto'));
+const listMapBlock = source.slice(source.indexOf('<div className="ml-auto'), source.indexOf('</div>\n        </div>\n      </div>'));
+
+describe('T-057: search form semantics', () => {
+  test('the query input and submit button are wrapped in a role="search" <form>', () => {
+    assert.ok(searchFormBlock.includes('role="search"'));
+    assert.ok(searchFormBlock.includes('<form'));
+  });
+
+  test('the form is not nested inside another form anywhere in the file', () => {
+    const codeOnly = source.replace(/\/\/.*$/gm, '');
+    const formOpens = (codeOnly.match(/<form\b/g) || []).length;
+    assert.equal(formOpens, 1, 'exactly one <form> element should exist on this page');
+  });
