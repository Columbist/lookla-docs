+++ b/frontend/app/[locale]/globalShell.test.ts
@@ -0,0 +1,90 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'layout.tsx'), 'utf-8');
+
+describe('T-060: global shell — sticky-footer layout', () => {
+  test('body is a flex column, min-h-screen', () => {
+    assert.ok(source.includes('className="flex min-h-screen flex-col"'));
+  });
+
+  test('the children wrapper has flex-1 so Footer sits at the bottom on short pages', () => {
+    assert.ok(source.includes('<div className="flex-1">{children}</div>'));
+  });
+
+  test('Footer and CookieConsent remain siblings of the content wrapper, in the same order as before', () => {
+    const bodyBlock = source.slice(source.indexOf('<body'), source.indexOf('</body>'));
+    const contentIdx = bodyBlock.indexOf('{children}');
+    const footerIdx = bodyBlock.indexOf('<Footer');
+    const consentIdx = bodyBlock.indexOf('<CookieConsent');
+    assert.ok(contentIdx < footerIdx && footerIdx < consentIdx);
+  });
+});
+
+describe('T-060 REQUEST CHANGES fix: <main> landmark lives per-page, not at the layout level', () => {
+  test('the shell wrapper around {children} is still a plain <div> here — each of the 4 unified-shell pages owns its own <main>, so a layout-level one would double up', () => {
+    const codeOnly = source.replace(/\{\/\*[\s\S]*?\*\/\}/g, '');
+    assert.ok(!codeOnly.includes('<main'));
+  });
+
+  test('the reasoning is documented inline: Header sets role="banner" explicitly, and each page places its own <main> as a sibling after Header', () => {
+    assert.ok(source.includes('role="banner"'));
+    assert.ok(source.toLowerCase().includes('sibling'));
+  });
+});
+
+describe('T-060 REQUEST CHANGES fix: exactly one <main id="main-content"> per public page, Header/Footer outside it', () => {
+  const pages: Record<string, string> = {
+    homepage: fs.readFileSync(path.join(here, 'page.tsx'), 'utf-8'),
+    search: fs.readFileSync(path.join(here, 'search', 'page.tsx'), 'utf-8'),
+    detail: fs.readFileSync(path.join(here, 'salons', '[slug]', 'SalonDetailClient.tsx'), 'utf-8'),
+    privacy: fs.readFileSync(path.join(here, 'privacy', 'page.tsx'), 'utf-8'),
+    cookies: fs.readFileSync(path.join(here, 'cookies', 'page.tsx'), 'utf-8'),
+    masters: fs.readFileSync(path.join(here, 'masters', 'page.tsx'), 'utf-8'),
+  };
+
+  for (const [name, content] of Object.entries(pages)) {
+    test(`${name}: exactly one <main id="main-content"> and it isn't nested inside another <main>`, () => {
+      const mainOpenCount = (content.match(/<main[ >]/g) || []).length;
+      const mainCloseCount = (content.match(/<\/main>/g) || []).length;
+      assert.equal(mainOpenCount, 1, `${name} must render exactly one <main>, found ${mainOpenCount}`);
+      assert.equal(mainCloseCount, 1, `${name} must close exactly one <main>, found ${mainCloseCount}`);
+      assert.ok(content.includes('id="main-content"'), `${name}'s <main> must carry id="main-content"`);
+    });
+
+    test(`${name}: <Header .../> call appears before <main>, i.e. outside/above it in the JSX`, () => {
+      const headerIdx = content.indexOf('<Header');
+      const mainIdx = content.indexOf('<main');
+      assert.ok(headerIdx > -1 && headerIdx < mainIdx, `${name} must render <Header> before <main>`);
+    });
+  }
+
+  test('search: the toolbar (T-057-protected) renders as Header\'s children — outside <main>, since it is chrome, not results content', () => {
+    const content = pages.search;
+    const headerOpenIdx = content.indexOf('<Header locale={locale} variant="search">');
+    const headerCloseIdx = content.indexOf('</Header>');
+    const mainIdx = content.indexOf('<main');
+    assert.ok(headerOpenIdx > -1 && headerOpenIdx < headerCloseIdx && headerCloseIdx < mainIdx);
+  });
+});
+
+describe('T-060 regression: font/token setup from T-059 is untouched', () => {
+  test('Inter font loading is unchanged', () => {
+    assert.ok(source.includes("import { Inter } from 'next/font/google';"));
+    assert.ok(source.includes('className={inter.variable}'));
+  });
+
+  test('locale validation (notFound for unsupported locales) is unchanged', () => {
+    assert.ok(source.includes("const locales = ['el', 'en', 'ru', 'uk'];"));
+    assert.ok(source.includes('if (!locales.includes(locale)) notFound();'));
+  });
+
+  test('GoogleAnalytics wiring is unchanged', () => {
+    assert.ok(source.includes('<Suspense fallback={null}>'));
+    assert.ok(source.includes('<GoogleAnalytics />'));
+  });
+});
