+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'LanguageSwitcher.tsx'), 'utf-8');
+
+describe('T-060: LanguageSwitcher — query-preservation fix', () => {
+  test('imports next/navigation\'s useSearchParams and the new buildLocaleSwitchPath helper', () => {
+    assert.ok(source.includes("import { useSearchParams } from 'next/navigation';"));
+    assert.ok(source.includes("import { buildLocaleSwitchPath } from '@/lib/localeSwitchHref';"));
+  });
+
+  test('router.replace is called with the query-preserving path, not the bare pathname', () => {
+    assert.ok(source.includes('router.replace(buildLocaleSwitchPath(pathname, searchParams.toString()), { locale });'));
+    assert.ok(!source.includes('router.replace(pathname, { locale });'), 'the old query-dropping call must be fully replaced');
+  });
+
+  test('still uses router.replace (not push) — T-056 entry-id semantics for the current history entry are unaffected', () => {
+    assert.ok(source.includes('router.replace('));
+    assert.ok(!source.includes('router.push('));
+  });
+});
+
+describe('T-060: LanguageSwitcher — tokens, touch targets, current-locale semantics', () => {
+  test('uses semantic tokens, not the legacy pink-600/gray-400 palette', () => {
+    assert.ok(!source.includes('text-pink-600'));
+    assert.ok(!source.includes('text-gray-400'));
+    assert.ok(source.includes('text-brand'));
+    assert.ok(source.includes('text-text-muted'));
+  });
+
+  test('each locale button meets the 44x44 minimum touch target', () => {
+    assert.ok(source.includes('min-w-[44px] min-h-[44px]'));
+  });
+
+  test('the current locale is identifiable beyond colour alone via aria-current', () => {
+    assert.ok(source.includes("aria-current={l === currentLocale ? 'true' : undefined}"));
+  });
+
+  test('uses the shared focus-ring token', () => {
+    assert.ok(source.includes('focus-ring-token'));
+  });
+
+  test('no flag emoji (Unicode regional-indicator pairs) or flag-image labeling — locale codes remain plain text', () => {
+    assert.ok(!/[\u{1F1E6}-\u{1F1FF}]/u.test(source), 'no regional-indicator flag emoji');
+    assert.ok(!/<img[^>]*flag/i.test(source), 'no flag image');
+  });
+
+  test('type="button" — never accidentally submits a surrounding form', () => {
+    assert.ok(source.includes('type="button"'));
+  });
+});
+
+describe('T-060 regression: consent/analytics semantics for language_change are unchanged', () => {
+  test('the already-active-locale early return still exists, unchanged', () => {
+    assert.ok(source.includes('if (locale === currentLocale) return;'));
+  });
+
+  test('trackEvent(\'language_change\', ...) call site is unchanged in shape', () => {
+    assert.ok(source.includes("trackEvent('language_change', { from_locale: currentLocale as Locale, to_locale: locale as Locale, surface });"));
+  });
+
+  test('all 4 locales and both surfaces (header/footer) remain supported', () => {
+    assert.ok(source.includes("const LOCALES = ['el', 'en', 'ru', 'uk'] as const;"));
+    assert.ok(source.includes("surface: 'header' | 'footer';"));
+  });
+});
