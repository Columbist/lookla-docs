+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { buildLocaleSwitchPath } from './localeSwitchHref';
+
+describe('T-060: buildLocaleSwitchPath — fixes the found-live query-loss bug', () => {
+  test('a pathname with no query string is returned unchanged', () => {
+    assert.equal(buildLocaleSwitchPath('/search', ''), '/search');
+  });
+
+  test('a query string (without a leading ?) is appended with exactly one ?', () => {
+    assert.equal(buildLocaleSwitchPath('/search', 'area=athens-center&view=map'), '/search?area=athens-center&view=map');
+  });
+
+  test('a query string that already has a leading ? is not double-prefixed', () => {
+    assert.equal(buildLocaleSwitchPath('/search', '?area=athens-center'), '/search?area=athens-center');
+  });
+
+  test('reproduces the exact production bug scenario: /en/search?area=athens-center&view=map switching to ru', () => {
+    // usePathname() from next-intl is already locale-stripped, so the
+    // caller passes "/search", not "/en/search" — this is the input the
+    // router.replace(path, { locale: 'ru' }) call receives.
+    const result = buildLocaleSwitchPath('/search', 'area=athens-center&view=map');
+    assert.equal(result, '/search?area=athens-center&view=map');
+  });
+
+  test('an empty search string never produces a trailing bare "?"', () => {
+    const result = buildLocaleSwitchPath('/', '');
+    assert.ok(!result.endsWith('?'));
+  });
+});
diff --git a/frontend/lib/localeSwitchHref.ts b/frontend/lib/localeSwitchHref.ts
new file mode 100644
index 0000000..b68306a
--- /dev/null
+++ b/frontend/lib/localeSwitchHref.ts
@@ -0,0 +1,15 @@
+/**
+ * T-060 — fixes a found-live bug: switching locale via LanguageSwitcher
+ * previously dropped the entire query string (confirmed on production:
+ * `/en/search?area=athens-center&view=map` -> `/ru/search`, filters and
+ * view state silently lost). next-intl's own `usePathname()` is already
+ * query-string-free by design, so the query has to be re-attached
+ * explicitly by the caller before handing the path to the router.
+ *
+ * Pure and dependency-free so the query-preservation logic itself is
+ * directly testable without mocking next-intl's router/pathname hooks.
+ */
+export function buildLocaleSwitchPath(pathname: string, search: string): string {
+  const clean = search.startsWith('?') ? search.slice(1) : search;
+  return clean ? `${pathname}?${clean}` : pathname;
+}
