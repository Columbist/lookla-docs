+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { isActiveRoute } from './activeRoute';
+
+describe('T-060: isActiveRoute', () => {
+  test('exact match is active', () => {
+    assert.equal(isActiveRoute('/search', '/search'), true);
+  });
+
+  test('a different route is not active', () => {
+    assert.equal(isActiveRoute('/masters', '/search'), false);
+  });
+
+  test('a nested path under the target is active (prefix rule)', () => {
+    assert.equal(isActiveRoute('/masters/123', '/masters'), true);
+  });
+
+  test('a salon detail page is NOT considered active for "/search" even though it is reachable from search', () => {
+    assert.equal(isActiveRoute('/salons/some-salon-12345', '/search'), false);
+  });
+
+  test('a route that merely starts with the same characters but is not a real nested path is not active (no accidental prefix collision)', () => {
+    // "/searching" starts with "/search" as a raw string but is not "/search" or "/search/..."
+    assert.equal(isActiveRoute('/searching', '/search'), false);
+  });
+
+  test('the homepage root is only active for itself, not for every other route', () => {
+    assert.equal(isActiveRoute('/', '/'), true);
+    assert.equal(isActiveRoute('/search', '/'), false);
+  });
+});
