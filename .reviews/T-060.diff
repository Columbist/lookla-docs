+++ b/frontend/lib/activeRoute.ts
@@ -0,0 +1,18 @@
+/**
+ * T-060 — shared active-navigation-state rule for the global shell.
+ * `pathname` is expected to come from next-intl's own `usePathname()`
+ * (already locale-stripped, already query-string-free), so this never
+ * needs to know about the current locale or any search params itself.
+ *
+ * Rule: exact match, or the target followed by a `/` (a nested route
+ * under it). No nested routes exist under `/search` or `/masters` today
+ * — the prefix rule is here so a future nested route (e.g. `/masters/x`)
+ * is still correctly recognized as "under Professionals" without this
+ * function needing to change. A salon detail page (`/salons/[slug]`) is
+ * deliberately its own route, not nested under `/search`, so it is never
+ * treated as the "Salons & Studios" nav item being active.
+ */
+export function isActiveRoute(pathname: string, target: string): boolean {
+  if (pathname === target) return true;
+  return pathname.startsWith(`${target}/`);
+}
