+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, 'Footer.tsx'), 'utf-8');
+
+describe('T-060: Footer — Direction B tokens applied', () => {
+  test('uses semantic tokens, not the legacy pink-600/gray-* palette', () => {
+    assert.ok(!source.includes('border-gray-100'));
+    assert.ok(!source.includes('bg-white'));
+    assert.ok(!source.includes('text-gray-500'));
+    assert.ok(!source.includes('text-gray-700'));
+    assert.ok(!source.includes('text-gray-400'));
+    assert.ok(source.includes('border-border'));
+    assert.ok(source.includes('bg-surface'));
+    assert.ok(source.includes('text-text-secondary'));
+    assert.ok(source.includes('text-text-muted'));
+  });
+
+  test('uses the shared focus-ring token on every link/button', () => {
+    const count = (source.match(/focus-ring-token/g) || []).length;
+    assert.equal(count, 3, 'expected the 3 footer links/buttons (privacy, cookies, cookie settings) to all carry the focus-ring token');
+  });
+});
+
+describe('T-060: Footer — touch targets', () => {
+  test('every link/button meets the 44px minimum height', () => {
+    const count = (source.match(/min-h-\[44px\]/g) || []).length;
+    assert.equal(count, 3);
+  });
+});
+
+describe('T-060 regression: footer landmark and all destinations preserved', () => {
+  test('the semantic <footer> landmark is unchanged', () => {
+    assert.ok(source.includes('<footer'));
+  });
+
+  test('all 3 legal/consent destinations remain: privacy, cookies, cookie settings', () => {
+    assert.ok(source.includes("href={`${prefix}/privacy`}"));
+    assert.ok(source.includes("href={`${prefix}/cookies`}"));
+    assert.ok(source.includes('onClick={openCookieSettings}'));
+  });
+
+  test('cookie-settings visibility still gates on isAnalyticsConsentFeatureEnabled()', () => {
+    assert.ok(source.includes('{isAnalyticsConsentFeatureEnabled() && ('));
+  });
+
+  test('no fake company address, support channel, social link, or newsletter signup was added', () => {
+    assert.ok(!/address|support@|newsletter|instagram\.com|facebook\.com|twitter\.com|x\.com/i.test(source));
+  });
+
+  test('copyright line text is unchanged (correct legal entity, no new claim)', () => {
+    assert.ok(source.includes('© 2026 Lookla — Beauty Marketplace Greece'));
+  });
+
+  test('LanguageSwitcher wiring is unchanged (surface="footer")', () => {
+    assert.ok(source.includes('<LanguageSwitcher currentLocale={locale} surface="footer" />'));
+  });
+});
