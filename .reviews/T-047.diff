++"""
++The ordered plan an erasure run follows.
++
++Every step in `PERSONAL_DATA_MATRIX.md` §3 is declared here, including the
++ones this PR does not implement. Declaring them matters: a dry run has to
++show the whole plan, and a run must *stop* at the first unimplemented step
++rather than skip it and call itself finished. `implemented=False` is a
++blocker, never a no-op.
++
++Order is load-bearing:
++
++  freeze        before anything else, so the subject cannot write during the run
++  snapshot      before any foreign key is cleared, or the anchors are lost
++  owner_decision before the destructive phase, because it can block the run
++  <destructive> the matrix's Action column, in FK-safe order
++  verify        after everything, reading the snapshot taken at the start
++"""
++from dataclasses import dataclass
++from typing import Callable, Optional
++
++
++@dataclass(frozen=True)
++class Step:
++    key: str
++    title: str
++    #: What the step does to the database. Read-only steps are safe to repeat.
++    destructive: bool
++    #: False until a later, bounded PR lands the handler. The engine blocks.
++    implemented: bool
++    #: Resolved from the registry in `handlers.py`; None while unimplemented.
++    handler: Optional[Callable] = None
++    #: A step that needs a human decision recorded before the run can finish.
++    manual: bool = False
++
++
++#: Registered by `handlers.register`, keyed by step key.
++HANDLERS: dict = {}
++
++
++def _h(key: str):
++    def wrap(fn):
++        HANDLERS[key] = fn
++        return fn
++    return wrap
++
++
++PLAN: tuple = (
++    Step("freeze_account", "Deactivate the account so it cannot write during the run",
++         destructive=False, implemented=True),
++    Step("capture_snapshot", "Record every anchor id before any link is cleared",
++         destructive=False, implemented=True),
++    Step("owner_decision", "Salon-owner associations need a recorded decision",
++         destructive=False, implemented=True, manual=True),
++
++    # ── declared, not implemented in this PR ──────────────────────────────
++    Step("delete_credentials", "Sessions, verification, reset and claim tokens",
++         destructive=True, implemented=False),
++    Step("tombstone_account", "Clear the direct identifiers on the users row",
++         destructive=True, implemented=False),
++    Step("tombstone_professional", "Clear the professional profile and its children",
++         destructive=True, implemented=False),
++    Step("revoke_webhooks", "Revoke the secret, disable, delete the row",
++         destructive=True, implemented=False),
++    Step("clear_second_roles", "Null resolver, reviewer and submitter references",
++         destructive=True, implemented=False),
++    Step("tombstone_bookings", "Contact fields on appointments and requests",
++         destructive=True, implemented=False),
++    Step("list_free_text", "Collect the free text a human must read",
++         destructive=False, implemented=False, manual=True),
++
++    Step("verify", "Re-read every anchor and prove nothing disallowed remains",
++         destructive=False, implemented=False),
++)
++
++BY_KEY = {step.key: step for step in PLAN}
++KEYS = tuple(step.key for step in PLAN)
++
++
++def resolved(step: Step) -> Step:
++    """Attach the registered handler, if this step has one."""
++    handler = HANDLERS.get(step.key)
++    return Step(
++        key=step.key, title=step.title, destructive=step.destructive,
++        implemented=step.implemented and handler is not None,
++        handler=handler, manual=step.manual,
++    )
