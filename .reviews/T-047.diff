+    monkeypatch.setenv("ALEMBIC_EXPECTED_DATABASE", PRODUCTION_DB)
+    monkeypatch.setenv("ALEMBIC_EXPECTED_USER", "beauty")
+
+    with pytest.raises(TargetRefused, match="ALEMBIC_EXPECTED_SERVER is unset"):
+        assert_allowed(PROD, PRODUCTION_DB)
