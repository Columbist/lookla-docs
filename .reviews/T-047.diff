+--- /dev/null
++++ b/backend/alembic_target_guard.py
+@@ -0,0 +1,124 @@
++"""
++Refuse to migrate a database nobody said to migrate.
++
++On 2026-08-06 a migration meant for a disposable Postgres ran against
++production instead. The command carried `DATABASE_URL=...`, which nothing
++reads — `env.py` builds its URL from `get_settings()` — and the container
++ran with `--network host`, where `DB_HOST=localhost` is the production
++server. Every part looked like an isolated run and none of it was.
++
++The lesson is not "be careful with URLs". It is that the target was never
++*checked*: the migration found out where it was only by succeeding. So the
++guard asks the server itself who it is, and compares that against an
++intention the caller had to state out loud:
++
++    ALEMBIC_DEPLOY_MODE       production | test   — required, no default
++    ALEMBIC_EXPECTED_DATABASE the exact database name   — required
++
++Both must be present and both must match, before the migration transaction
++is opened. A missing intention is a refusal, never a default.
++"""
++import os
++
++
++class TargetRefused(RuntimeError):
++    """The connected database is not the one the caller said they meant."""
++
++
++def resolve_url(x_arguments: dict, settings_url: str) -> str:
++    """
++    `-x url=` and `-x url_env=` win over the application settings.
++
++    `url_env` names an environment variable holding the DSN, so a password
++    need not appear in shell history or in `ps` output. `url` stays for
++    credential-free CI targets.
++    """
++    url_env = x_arguments.get("url_env")
++    if url_env:
++        value = os.environ.get(url_env)
++        if not value:
++            raise TargetRefused(
++                f"-x url_env={url_env} was given but ${url_env} is empty"
++            )
++        return value
++
++    url = x_arguments.get("url")
++    if url:
++        return url
++
++    return settings_url
++
++
++def describe(connection) -> dict:
++    """Ask the server where we actually are, rather than trusting the DSN."""
++    from sqlalchemy import text
++
++    row = connection.execute(text(
++        "SELECT current_database(), current_user, "
++        "coalesce(host(inet_server_addr()), 'local'), inet_server_port()"
++    )).one()
++    return {"database": row[0], "user": row[1], "host": row[2], "port": row[3]}
++
++
++def assert_allowed(actual: dict, production_database: str) -> str:
++    """
++    Compare the live target against the stated intention.
++
++    Returns a one-line description for the log. Raises `TargetRefused` on any
++    mismatch — including the case where nothing was stated at all, which is
++    how the accident happened.
++    """
++    mode = os.environ.get("ALEMBIC_DEPLOY_MODE", "").strip()
++    expected = os.environ.get("ALEMBIC_EXPECTED_DATABASE", "").strip()
++    where = (
++        f"{actual['database']} as {actual['user']} "
++        f"on {actual['host']}:{actual['port']}"
++    )
++
++    if mode not in ("production", "test"):
++        raise TargetRefused(
++            f"connected to {where}, but ALEMBIC_DEPLOY_MODE is "
++            f"{mode or 'unset'!r}; set it to 'production' or 'test' — this "
++            "guard has no default because the accident it exists to prevent "
++            "was a run nobody had declared"
++        )
++
++    if not expected:
++        raise TargetRefused(
++            f"connected to {where}, but ALEMBIC_EXPECTED_DATABASE is unset; "
++            "name the database you mean"
++        )
++
++    if actual["database"] != expected:
++        raise TargetRefused(
++            f"connected to {where}, but ALEMBIC_EXPECTED_DATABASE names "
++            f"{expected!r}"
++        )
++
++    is_production_target = actual["database"] == production_database
++
++    if mode == "test":
++        if is_production_target:
++            raise TargetRefused(
++                f"refusing: {where} is the database this application runs on, "
++                "and the run is declared as 'test'"
++            )
++        if "test" not in actual["database"].lower():
++            raise TargetRefused(
++                f"refusing: a 'test' run must target a database whose name says "
++                f"so; {actual['database']!r} does not"
++            )
++    else:  # production
++        if not is_production_target:
++            raise TargetRefused(
++                f"refusing: {where} is not this application's database "
++                f"({production_database!r}), but the run is declared "
++                "as 'production'"
++            )
++        if "test" in actual["database"].lower():
++            raise TargetRefused(
++                f"refusing: {actual['database']!r} looks like a test database "
++                "but the run is declared as 'production'"
++            )
++
++    return f"{mode} migration against {where}"
