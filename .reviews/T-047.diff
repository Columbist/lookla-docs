+def test_completion_requires_every_step_and_is_unreachable_today(db):
+    """
+    The point of the whole ledger: nothing may call itself finished while a
+    step is outstanding. Every destructive handler is still unimplemented, so
+    a run today can only reach BLOCKED — and that is the correct answer.
+    """
+    request = workflow.create_request(db, SUBJECT)
+
+    for _ in range(3):
+        workflow.advance(db, request)
+
+    assert request.status == RequestStatus.BLOCKED
+    outstanding = [s.step_key for s in request.steps if s.status != StepStatus.COMPLETED]
+    assert outstanding, "no steps outstanding, yet the run is not complete"
+    assert request.status != RequestStatus.COMPLETED
