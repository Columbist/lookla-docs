+"""
+T-047 control plane: the state machine, not the erasure itself.
+
+This PR builds the thing that makes erasure resumable and auditable; the
+destructive handlers land in later, bounded changes. So every test here is
+about the invariants of the ledger:
+
+    a completed step never runs twice
+    a failed step keeps its error and is retried only deliberately
+    a restart resumes rather than starting over
+    a partially finished run is never reported complete
+    a step interrupted mid-flight is failed, not guessed at
+    a blocking decision stops the run instead of being skipped
+    a dry run changes nothing
+
+The most important of them is the snapshot: it is taken before anything
+unlinks the subject, because the manual verifier this replaces checked
+`professionals WHERE user_id = :id` *after* the same procedure had set that
+column to NULL, and could therefore only ever return zero.
+"""
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from sqlalchemy import create_engine, text
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+from app.core.database import Base
+from app.models.erasure import ErasureRequest, ErasureStep, RequestStatus, StepStatus
+from app.models.professional import Professional
+from app.models.salon import Salon, SalonOwner
+from app.models.user import User
+from app.services.erasure import workflow
+from app.services.erasure.plan import KEYS
+
+SUBJECT = 100
+OTHER = 101
+SALON = 7
+SECOND_SALON = 8
+
+RAW_TABLES = """
+CREATE TABLE claiming_tokens (id INTEGER PRIMARY KEY, user_id INTEGER, salon_id INTEGER);
+CREATE TABLE webhooks (id INTEGER PRIMARY KEY, owner_user_id INTEGER, salon_id INTEGER);
+CREATE TABLE conversations (id INTEGER PRIMARY KEY, client_user_id INTEGER, salon_id INTEGER);
+CREATE TABLE messages (id INTEGER PRIMARY KEY, conversation_id INTEGER, sender_user_id INTEGER);
+CREATE TABLE appointments (id INTEGER PRIMARY KEY, client_user_id INTEGER, salon_id INTEGER);
+CREATE TABLE availability_requests (id INTEGER PRIMARY KEY, client_user_id INTEGER);
+CREATE TABLE reports (id INTEGER PRIMARY KEY, reporter_user_id INTEGER, resolved_by INTEGER);
+CREATE TABLE moderation_queue (id INTEGER PRIMARY KEY, submitter_user_id INTEGER, reviewed_by INTEGER);
+"""
+
+
+@pytest.fixture
+def db():
+    engine = create_engine(
+        "sqlite:///:memory:",
+        connect_args={"check_same_thread": False},
+        poolclass=StaticPool,
+    )
+    Base.metadata.create_all(engine)
+    with engine.begin() as conn:
+        for statement in RAW_TABLES.strip().split(";"):
+            if statement.strip():
+                conn.execute(text(statement))
+
+    session_local = sessionmaker(autocommit=False, autoflush=False, bind=engine)
+    session = session_local()
+    session.add(Salon(id=SALON, name="A salon", slug="a-salon", is_active=True))
+    session.add(Salon(id=SECOND_SALON, name="Another", slug="another", is_active=True))
+    session.add(User(id=SUBJECT, email="subject@example.com", is_active=True))
+    session.add(User(id=OTHER, email="other@example.com", is_active=True))
+    session.add(Professional(id=1, user_id=SUBJECT, name="Subject", slug="subject"))
+    session.commit()
+
+    session.engine = engine
+    session.session_local = session_local
+    try:
+        yield session
+    finally:
+        session.close()
+        engine.dispose()
+
+
+def _step(db, request, key) -> ErasureStep:
+    return (
+        db.query(ErasureStep)
+        .filter(ErasureStep.request_id == request.id, ErasureStep.step_key == key)
+        .one()
+    )
+
+
+def _claim_salon(db, user_id, salon_id=SALON):
+    db.add(SalonOwner(user_id=user_id, salon_id=salon_id))
+    db.commit()
+
+
+# ───────────────────────────── request lifecycle ─────────────────────────────
+
+
+def test_a_request_lays_out_the_whole_plan_up_front(db):
+    request = workflow.create_request(db, SUBJECT)
+
+    keys = [s.step_key for s in db.query(ErasureStep).filter(
+        ErasureStep.request_id == request.id).all()]
+    assert sorted(keys) == sorted(KEYS)
+    assert all(s.status == StepStatus.PENDING for s in request.steps)
+
+
+def test_a_second_request_for_the_same_subject_reuses_the_open_one(db):
+    first = workflow.create_request(db, SUBJECT)
+    second = workflow.create_request(db, SUBJECT)
+
+    # Two runs against one account would interleave and each see a
+    # half-erased subject.
+    assert first.id == second.id
+    assert db.query(ErasureRequest).count() == 1
+
+
+def test_a_dry_run_changes_nothing(db):
+    request = workflow.create_request(db, SUBJECT)
+
+    plan = workflow.plan_for(db, request)
+    workflow.advance(db, request, dry_run=True)
+
+    assert [p["key"] for p in plan] == list(KEYS)
+    assert any(p["erases_personal_data"] for p in plan), "the plan hides its erasing steps"
+    freeze = next(p for p in plan if p["key"] == "freeze_account")
+    assert freeze["mutates_database"] is True, (
+        "freeze writes is_active; a plan calling it read-only understates the run"
+    )
+    assert freeze["erases_personal_data"] is False
+    assert all(s.status == StepStatus.PENDING for s in request.steps)
+    assert workflow.subject_can_write(db, SUBJECT), "a dry run froze the account"
+    assert request.status == RequestStatus.PENDING
+
+
+def test_the_plan_shows_steps_that_are_not_implemented_yet(db):
+    request = workflow.create_request(db, SUBJECT)
+    plan = {p["key"]: p for p in workflow.plan_for(db, request)}
+
+    assert plan["freeze_account"]["implemented"] is True
+    assert plan["tombstone_account"]["implemented"] is False, (
+        "an unimplemented step must be visible in the plan, not silently absent"
+    )
+
+
+# ─────────────────────────────── the invariants ──────────────────────────────
+
+
+def test_the_account_is_frozen_before_anything_else_runs(db):
+    request = workflow.create_request(db, SUBJECT)
+    assert workflow.subject_can_write(db, SUBJECT)
+
+    workflow.advance(db, request)
+
+    assert not workflow.subject_can_write(db, SUBJECT)
+    assert _step(db, request, "freeze_account").status == StepStatus.COMPLETED
+
+
+def test_the_snapshot_is_taken_before_any_link_is_cleared(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+
+    snapshot = request.snapshot
+    assert snapshot["professional_ids"] == [1]
+
+    # The failure this exists to prevent: clear the link and the profile can
+    # no longer be found from the subject — but the snapshot still names it.
+    db.execute(text("UPDATE professionals SET user_id = NULL WHERE user_id = :u"),
+               {"u": SUBJECT})
+    db.commit()
+    assert db.execute(text("SELECT count(*) FROM professionals WHERE user_id = :u"),
+                      {"u": SUBJECT}).scalar() == 0
+    assert request.snapshot["professional_ids"] == [1]
+
+
+def test_an_unimplemented_step_blocks_and_is_never_reported_complete(db):
+    request = workflow.create_request(db, SUBJECT)
+
+    workflow.advance(db, request)
+
+    assert request.status == RequestStatus.BLOCKED
+    assert request.status != RequestStatus.COMPLETED
+    blocked = _step(db, request, "delete_credentials")
+    assert blocked.status == StepStatus.BLOCKED
+    # And nothing after it ran.
+    assert _step(db, request, "verify").status == StepStatus.PENDING
+
+
+def test_a_completed_step_is_not_run_a_second_time(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+    attempts = _step(db, request, "freeze_account").attempts
+
+    workflow.advance(db, request)
+    workflow.advance(db, request)
+
+    assert _step(db, request, "freeze_account").attempts == attempts == 1
+
+
+def test_resuming_continues_from_the_first_unfinished_step(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+    snapshot_taken = request.snapshot_taken_at
+
+    # A fresh session: the process restarted and knows only the ledger.
+    fresh = db.session_local()
+    reloaded = fresh.query(ErasureRequest).get(request.id)
+    workflow.advance(fresh, reloaded)
+
+    assert reloaded.snapshot_taken_at == snapshot_taken, "the snapshot was retaken"
+    assert _step(fresh, reloaded, "freeze_account").attempts == 1
+    fresh.close()
+
+
+def test_a_step_interrupted_mid_flight_fails_rather_than_being_guessed_at(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+
+    # A process death leaves exactly this: RUNNING, with the lease it held
+    # now expired.
+    interrupted = _step(db, request, "delete_credentials")
+    interrupted.status = StepStatus.RUNNING
+    interrupted.run_token = "dead-runner"
+    interrupted.lease_expires_at = datetime.now(timezone.utc) - timedelta(minutes=1)
+    db.commit()
+
+    workflow.advance(db, request)
+
+    assert interrupted.status == StepStatus.FAILED
+    assert "lease expired" in interrupted.error
+    assert request.status == RequestStatus.FAILED, (
+        "an unknown outcome must fail closed, not be assumed either way"
+    )
+
+
+def test_a_failed_step_keeps_its_error_and_stops_the_run(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+    failed = _step(db, request, "capture_snapshot")
+    failed.status = StepStatus.FAILED
+    failed.error = "boom"
+    db.commit()
+
+    workflow.advance(db, request)
+
+    assert failed.error == "boom", "the error was overwritten by the resume"
+    assert request.status == RequestStatus.FAILED
+
+
+def test_a_failed_step_is_retried_only_deliberately(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+    step = _step(db, request, "capture_snapshot")
+    step.status = StepStatus.FAILED
+    step.error = "boom"
+    db.commit()
+
+    workflow.retry_step(db, request, "capture_snapshot")
+
+    assert step.status == StepStatus.PENDING
+    assert step.error is None
+
+
+def test_a_completed_step_cannot_be_retried(db):
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+
+    with pytest.raises(ValueError, match="already completed"):
+        workflow.retry_step(db, request, "freeze_account")
+
+
+def test_a_handler_raising_leaves_the_run_failed_and_says_why(db):
+    request = workflow.create_request(db, 9999)   # no such user
+
+    workflow.advance(db, request)
+
+    step = _step(db, request, "freeze_account")
+    assert step.status == StepStatus.FAILED
+    assert "no such user" in step.error
+    assert request.status == RequestStatus.FAILED
+
+
+# ───────────────────────── the salon-owner decision ──────────────────────────
+
+
+def test_an_owned_salon_blocks_the_run_until_a_decision_is_recorded(db):
+    _claim_salon(db, SUBJECT)
+    request = workflow.create_request(db, SUBJECT)
+
+    workflow.advance(db, request)
+
+    step = _step(db, request, "owner_decision")
+    assert step.status == StepStatus.BLOCKED
+    assert str(SALON) in step.error
+    assert request.status == RequestStatus.BLOCKED
+
+
+def test_no_owned_salon_means_nothing_to_decide(db):
+    request = workflow.create_request(db, SUBJECT)
+
+    workflow.advance(db, request)
+
+    assert _step(db, request, "owner_decision").status == StepStatus.COMPLETED
+
+
+def test_a_recorded_decision_unblocks_the_step(db):
+    _claim_salon(db, SUBJECT)
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+
+    workflow.record_owner_decision(db, request, [
+        {"salon_id": SALON, "outcome": "ended",
+         "action": "deleted", "salon_notified_at": "2026-08-06T12:00:00Z"},
+    ])
+
+    step = _step(db, request, "owner_decision")
+    assert step.status == StepStatus.COMPLETED
+    assert step.result["decisions"] == [{
+        "salon_id": SALON, "outcome": "ended",
+        "action": "deleted", "salon_notified_at": "2026-08-06T12:00:00Z",
+    }]
+
+
+def test_a_decision_before_the_snapshot_is_refused(db):
+    # Recorded now, it would be written against an empty owned_salon_ids,
+    # complete the step, and let advance() sail past the gate once the real
+    # snapshot arrived. The block would look honoured and would not be.
