+++ b/backend/app/models/erasure.py
@@ -0,0 +1,120 @@
+"""
+T-047 control plane: the ledger an erasure run is driven from.
+
+These two tables carry no personal data beyond the subject's id and the ids
+of rows the run must reach. A register of who asked to be erased is itself
+personal data, so nothing here stores a name, an email or free text — only
+references and counts. `PERSONAL_DATA_MATRIX.md` §3 gives the completion
+record its own 24-month clock for the same reason.
+"""
+from datetime import datetime
+
+from sqlalchemy import (
+    Column, DateTime, ForeignKey, Index, Integer, String, Text, UniqueConstraint, func, text,
+)
+from sqlalchemy.dialects.postgresql import JSONB
+from sqlalchemy.orm import relationship
+from sqlalchemy.types import JSON
+
+from app.core.database import Base
+
+# The ledger runs against Postgres in production and SQLite under test;
+# JSONB there, JSON here, same Python values either way.
+JSONType = JSONB().with_variant(JSON(), "sqlite")
+
+
+class RequestStatus:
+    PENDING = "pending"        # accepted, nothing done
+    FROZEN = "frozen"          # the account can no longer write
+    RUNNING = "running"
+    BLOCKED = "blocked"        # a decision or a manual task is outstanding
+    FAILED = "failed"          # stopped, but retryable — still an open run
+    COMPLETED = "completed"
+    CANCELLED = "cancelled"    # abandoned deliberately; frees the subject
+
+    #: Done for good. `failed` is deliberately absent: a failed run can be
+    #: retried, so treating it as terminal would let a second run start
+    #: against the same subject while the first is still resumable.
+    TERMINAL = (COMPLETED, CANCELLED)
+
+
+class StepStatus:
+    PENDING = "pending"
+    RUNNING = "running"
+    BLOCKED = "blocked"
+    COMPLETED = "completed"
+    FAILED = "failed"
+
+
+class ErasureRequest(Base):
+    __tablename__ = "erasure_requests"
+
+    id = Column(Integer, primary_key=True)
+    subject_user_id = Column(Integer, nullable=False, index=True)
+    status = Column(String(32), nullable=False, default=RequestStatus.PENDING)
+
+    # Anchors captured before any foreign key is cleared. Once
+    # professionals.user_id is NULL the profile can no longer be found from
+    # the subject, so a run that did not record the ids first cannot verify
+    # its own work — the flaw the manual verifier had until 2026-08-06.
+    snapshot = Column(JSONType, nullable=True)
+    snapshot_taken_at = Column(DateTime(timezone=True), nullable=True)
+
+    error = Column(Text, nullable=True)
+    #: The plan this request was created under; a later deployment adding a
+    #: step must not silently redefine an in-flight run.
+    plan_version = Column(Integer, nullable=False, default=1)
+    created_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
+    updated_at = Column(
+        DateTime(timezone=True), server_default=func.now(), onupdate=datetime.utcnow, nullable=False
+    )
+
+    #: Set once, when the run genuinely finishes. `updated_at` moves on any
+    #: later touch, so the retention clock cannot be read from it.
+    completed_at = Column(DateTime(timezone=True), nullable=True)
+
+    steps = relationship(
+        "ErasureStep", back_populates="request", cascade="all, delete-orphan",
+        order_by="ErasureStep.id",
+    )
+
+    __table_args__ = (
+        # One open run per subject, enforced here rather than by a
+        # check-then-insert two processes can both pass. `failed` is open
+        # because it is retryable.
+        Index(
+            "uq_erasure_open_subject", "subject_user_id", unique=True,
+            sqlite_where=text("status NOT IN ('completed', 'cancelled')"),
+            postgresql_where=text("status NOT IN ('completed', 'cancelled')"),
+        ),
+    )
+
+
+class ErasureStep(Base):
+    __tablename__ = "erasure_steps"
+
+    id = Column(Integer, primary_key=True)
+    request_id = Column(
+        Integer, ForeignKey("erasure_requests.id", ondelete="CASCADE"), nullable=False
+    )
+    step_key = Column(String(64), nullable=False)
+    status = Column(String(32), nullable=False, default=StepStatus.PENDING)
+    attempts = Column(Integer, nullable=False, default=0)
+
+    result = Column(JSONType, nullable=True)   # row counts and ids, never content
+    error = Column(Text, nullable=True)
+    started_at = Column(DateTime(timezone=True), nullable=True)
+    completed_at = Column(DateTime(timezone=True), nullable=True)
+    #: Which runner claimed this step, and until when.
+    run_token = Column(String(64), nullable=True)
+    lease_expires_at = Column(DateTime(timezone=True), nullable=True)
+
+    request = relationship("ErasureRequest", back_populates="steps")
+
+    __table_args__ = (
+        # One row per step per request. This stops a second *row*; it does not
+        # stop a second *execution* of the same row — that is what the
+        # conditional claim and the lease in `workflow.claim_step` are for.
+        UniqueConstraint("request_id", "step_key", name="uq_erasure_step"),
+        Index("ix_erasure_steps_request", "request_id"),
+    )
