+def test_finalise_refuses_to_call_a_half_done_run_complete(db):
+    """
+    Reached directly, because `advance` cannot currently arrive here with an
+    outstanding step — every branch returns or completes. That makes the
+    guard unreachable through the public path and therefore untestable
+    through it, which is exactly how a guard stops holding without anyone
+    noticing. A mutation that dropped the check passed the whole suite until
+    this test existed.
+    """
+    request = workflow.create_request(db, SUBJECT)
+    workflow.advance(db, request)
+
+    outstanding = _step(db, request, "verify")
+    assert outstanding.status != StepStatus.COMPLETED
+
+    workflow.finalise(db, request)
+
+    assert request.status == RequestStatus.BLOCKED
+    assert "verify" in request.error
+
+    # And the other direction: with nothing outstanding it does complete, so
+    # the assertion above is not passing for the trivial reason.
+    for step in request.steps:
+        step.status = StepStatus.COMPLETED
+    db.commit()
+    workflow.finalise(db, request)
+    assert request.status == RequestStatus.COMPLETED
+    assert request.error is None
