+def test_a_missing_ledger_row_blocks_completion_rather_than_passing(db):
+    """
+    The false-zero shape again: a step key with no row was silently dropped
+    from the comparison, so "everything present is completed" read as "the run
+    is finished". A deployment that adds a step to the plan would have
+    completed every in-flight request the moment it landed.
+    """
+    request = workflow.create_request(db, SUBJECT)
+    db.query(ErasureStep).filter(
+        ErasureStep.request_id == request.id,
+        ErasureStep.step_key == "verify",
+    ).delete()
+    for step in request.steps:
+        step.status = StepStatus.COMPLETED
+    db.commit()
+
+    with pytest.raises(workflow.LedgerMismatch, match="missing=\\['verify'\\]"):
+        workflow.finalise(db, request)
