index 0000000..bdb9ff2
--- /dev/null
+++ b/backend/app/services/erasure/plan.py
@@ -0,0 +1,98 @@
+"""
+The ordered plan an erasure run follows.
+
+Every step in `PERSONAL_DATA_MATRIX.md` §3 is declared here, including the
+ones this PR does not implement. Declaring them matters: a dry run has to
+show the whole plan, and a run must *stop* at the first unimplemented step
+rather than skip it and call itself finished. `implemented=False` is a
+blocker, never a no-op.
+
+Order is load-bearing:
+
+  freeze        before anything else, so the subject cannot write during the run
+  snapshot      before any foreign key is cleared, or the anchors are lost
+  owner_decision before the destructive phase, because it can block the run
+  <destructive> the matrix's Action column, in FK-safe order
+  verify        after everything, reading the snapshot taken at the start
+"""
+from dataclasses import dataclass
+from typing import Callable, Optional
+
+
+#: Bumped whenever PLAN changes. A request records the version it was created
+#: under, so a deployment that adds a step cannot silently redefine a run that
+#: is already in flight.
+PLAN_VERSION = 1
+
+
+@dataclass(frozen=True)
+class Step:
+    key: str
+    title: str
+    #: Writes to the database at all. `freeze_account` does — it flips
+    #: `is_active` — even though it erases nothing, and a dry-run plan that
+    #: showed it as read-only would be lying about what the run touches.
+    mutates_database: bool
+    #: Removes or overwrites personal data. Strictly narrower than the above.
+    erases_personal_data: bool
+    #: False until a later, bounded PR lands the handler. The engine blocks.
+    implemented: bool
+    #: Resolved from the registry in `handlers.py`; None while unimplemented.
+    handler: Optional[Callable] = None
+    #: A step that needs a human decision recorded before the run can finish.
+    manual: bool = False
+
+
+#: Registered by `handlers.register`, keyed by step key.
+HANDLERS: dict = {}
+
+
+def _h(key: str):
+    def wrap(fn):
+        HANDLERS[key] = fn
+        return fn
+    return wrap
+
+
+PLAN: tuple = (
+    Step("freeze_account", "Deactivate the account so it cannot write during the run",
+         mutates_database=True, erases_personal_data=False, implemented=True),
+    Step("capture_snapshot", "Record every anchor id before any link is cleared",
+         mutates_database=False, erases_personal_data=False, implemented=True),
+    Step("owner_decision", "Salon-owner associations need a recorded decision",
+         mutates_database=False, erases_personal_data=False, implemented=True, manual=True),
+
+    # ── declared, not implemented in this PR ──────────────────────────────
+    Step("delete_credentials", "Sessions, verification, reset and claim tokens",
+         mutates_database=True, erases_personal_data=True, implemented=False),
+    Step("tombstone_account", "Clear the direct identifiers on the users row",
+         mutates_database=True, erases_personal_data=True, implemented=False),
+    Step("tombstone_professional", "Clear the professional profile and its children",
+         mutates_database=True, erases_personal_data=True, implemented=False),
+    Step("revoke_webhooks", "Revoke the secret, disable, delete the row",
+         mutates_database=True, erases_personal_data=True, implemented=False),
+    Step("clear_second_roles", "Null resolver, reviewer and submitter references",
+         mutates_database=True, erases_personal_data=True, implemented=False),
+    Step("tombstone_bookings", "Contact fields on appointments and requests",
+         mutates_database=True, erases_personal_data=True, implemented=False),
+    Step("list_free_text", "Collect the free text a human must read",
+         mutates_database=False, erases_personal_data=False, implemented=False, manual=True),
+
+    Step("verify", "Re-read every anchor and prove nothing disallowed remains",
+         mutates_database=False, erases_personal_data=False, implemented=False),
+)
+
+BY_KEY = {step.key: step for step in PLAN}
+KEYS = tuple(step.key for step in PLAN)
+
+
+def resolved(step: Step) -> Step:
+    """Attach the registered handler, if this step has one."""
+    handler = HANDLERS.get(step.key)
+    return Step(
+        key=step.key, title=step.title,
+        mutates_database=step.mutates_database,
+        erases_personal_data=step.erases_personal_data,
+        implemented=step.implemented and handler is not None,
+        handler=handler, manual=step.manual,
+    )
diff --git a/backend/app/services/erasure/workflow.py b/backend/app/services/erasure/workflow.py
new file mode 100644
index 0000000..f279cdf
--- /dev/null
+++ b/backend/app/services/erasure/workflow.py
@@ -0,0 +1,429 @@
+"""
+T-047 control plane: a staged, resumable erasure run.
+
+The invariants this module holds, each with a test:
+
+    one open run per subject, enforced by the database
+    a step is claimed atomically; two runners cannot execute one step
+    a running step is interrupted only after its lease expires
+    a completed step never runs twice
+    a failed step keeps its error and is retried only deliberately
+    a process restart resumes; it does not start over
+    a run is complete only when every expected step is present and completed
+    a blocking decision stops the run rather than being skipped
+
+Why a state machine at all: erasure cannot be one transaction. A Postgres
+transaction cannot stay open while an operator reads messages, and deleting
+an object in external storage cannot be atomic with a commit. The work is
+staged, and the ledger is what makes stopping between stages safe.
+"""
+import secrets
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy import text
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+
+from app.models.erasure import ErasureRequest, ErasureStep, RequestStatus, StepStatus
+from app.services.erasure import handlers  # noqa: F401  (registers the handlers)
+from app.services.erasure.handlers import StepBlocked
+from app.services.erasure.plan import KEYS, PLAN, PLAN_VERSION, resolved
+
+#: How long a claimed step may run before another runner may take it over.
+#: Long enough that a slow handler is not stolen; short enough that a dead
+#: runner does not hold the queue for a shift.
+LEASE = timedelta(minutes=15)
+
+
+class LedgerMismatch(RuntimeError):
+    """The ledger does not match the plan it claims to follow."""
+
+
+def _now():
+    return datetime.now(timezone.utc)
+
+
+def _aware(value):
+    """Postgres hands back tz-aware datetimes; SQLite does not."""
+    if value is None:
+        return None
+    return value if value.tzinfo else value.replace(tzinfo=timezone.utc)
+
+
+def _open_request(db: Session, subject_user_id: int):
+    return (
+        db.query(ErasureRequest)
+        .filter(
+            ErasureRequest.subject_user_id == subject_user_id,
+            ErasureRequest.status.notin_(RequestStatus.TERMINAL),
+        )
+        .order_by(ErasureRequest.id)
+        .first()
+    )
+
+
+def create_request(db: Session, subject_user_id: int) -> ErasureRequest:
+    """
+    Start a run, or return the one already open for this subject.
+
+    The database holds this invariant, not this function: two processes can
+    both find nothing and both insert, and only the partial unique index
+    decides which one wins. The loser reads the winner's row.
+    """
+    existing = _open_request(db, subject_user_id)
+    if existing:
+        return existing
+
+    request = ErasureRequest(
+        subject_user_id=subject_user_id,
+        status=RequestStatus.PENDING,
+        plan_version=PLAN_VERSION,
+    )
+    db.add(request)
+    try:
+        db.flush()
+        for key in KEYS:
+            db.add(ErasureStep(request_id=request.id, step_key=key, status=StepStatus.PENDING))
+        db.commit()
+    except IntegrityError:
+        db.rollback()
+        winner = _open_request(db, subject_user_id)
+        if winner is None:                        # pragma: no cover — defensive
+            raise
+        return winner
+    db.refresh(request)
+    return request
+
+
+def _steps(db: Session, request: ErasureRequest) -> list[ErasureStep]:
+    """
+    Ledger rows in plan order — and only if the ledger matches the plan.
+
+    Silently dropping a key that has no row is how "everything present is
+    completed" turns into "the run is finished". The same false-zero shape as
+    the verifier that queried `professionals` by a column it had just cleared.
+    """
+    rows = {s.step_key: s for s in db.query(ErasureStep).filter(
+        ErasureStep.request_id == request.id).all()}
+    missing = [k for k in KEYS if k not in rows]
+    unknown = [k for k in rows if k not in KEYS]
+    if missing or unknown:
+        raise LedgerMismatch(
+            f"request {request.id} does not match plan v{PLAN_VERSION}: "
+            f"missing={missing or 'none'}, unknown={unknown or 'none'}"
+        )
+    return [rows[key] for key in KEYS]
+
+
+def plan_for(db: Session, request: ErasureRequest) -> list[dict]:
+    """The whole plan with each step's current state — the dry-run answer."""
+    by_key = {s.step_key: s for s in db.query(ErasureStep).filter(
+        ErasureStep.request_id == request.id).all()}
+    out = []
+    for step in PLAN:
+        row = by_key.get(step.key)
+        r = resolved(step)
+        out.append({
+            "key": step.key,
+            "title": step.title,
+            "mutates_database": step.mutates_database,
+            "erases_personal_data": step.erases_personal_data,
+            "manual": step.manual,
+            "implemented": r.implemented,
+            "status": row.status if row else "absent",
+            "attempts": row.attempts if row else 0,
+            "error": row.error if row else None,
+            "result": row.result if row else None,
+        })
+    return out
+
+
+def _reclaim_expired(db: Session, request: ErasureRequest) -> bool:
+    """
+    A step whose lease has run out is failed — not resumed, not repeated.
+
+    Whether its work landed is unknown, and guessing either way is wrong:
+    assuming success skips work that may not have happened, assuming failure
+    repeats a destructive statement. A runner still inside its lease is left
+    alone; declaring it dead is exactly how one step runs twice.
+    """
+    now = _now()
+    found = False
+    for step in _steps(db, request):
+        if step.status != StepStatus.RUNNING:
+            continue
+        if _aware(step.lease_expires_at) and _aware(step.lease_expires_at) > now:
+            continue                              # still owned, still alive
+        step.status = StepStatus.FAILED
+        step.run_token = None
+        step.error = (
+            "lease expired while running — the runner stopped before recording an "
+            "outcome, so whether this step's work landed is unknown; inspect, then retry"
+        )
+        found = True
+    if found:
+        db.commit()
+    return found
+
+
+def claim_step(db: Session, step: ErasureStep, run_token: str) -> bool:
+    """
+    Take a pending step, atomically.
+
+    One conditional UPDATE: the row leaves `pending` for exactly one caller.
+    The unique constraint on (request, step) stops a second *row*; nothing but
+    this stops a second *execution* of the same row.
+    """
+    result = db.execute(
+        text(
+            "UPDATE erasure_steps SET status = :running, run_token = :token, "
+            "attempts = attempts + 1, started_at = :now, lease_expires_at = :lease "
+            "WHERE id = :id AND status = :pending"
+        ),
+        {
+            "running": StepStatus.RUNNING, "pending": StepStatus.PENDING,
+            "token": run_token, "id": step.id,
+            "now": _now(), "lease": _now() + LEASE,
+        },
+    )
+    db.commit()
+    if result.rowcount != 1:
+        return False
+    db.refresh(step)
+    return True
+
+
+def _release(db: Session, step: ErasureStep, status: str, error: str) -> None:
+    step.status = status
+    step.error = error
+    step.run_token = None
+    step.lease_expires_at = None
+
+
+def advance(db: Session, request: ErasureRequest, dry_run: bool = False) -> ErasureRequest:
+    """
+    Run steps in order until one blocks, one fails, or the plan is done.
+
+    Safe to call repeatedly: completed steps are skipped, so this is also the
+    resume path. `dry_run` executes nothing and mutates nothing.
+    """
+    if dry_run:
+        return request
+    if request.status in RequestStatus.TERMINAL:
+        return request
+    if request.plan_version != PLAN_VERSION:
+        request.status = RequestStatus.BLOCKED
+        request.error = (
+            f"created under plan v{request.plan_version}, this process runs "
+            f"v{PLAN_VERSION}; a run does not change meaning mid-flight"
+        )
+        db.commit()
+        return request
+
+    if _reclaim_expired(db, request):
+        request.status = RequestStatus.FAILED
+        request.error = "a previous runner's lease expired mid-step"
+        db.commit()
+        return request
+
+    run_token = secrets.token_hex(8)
+
+    for step in _steps(db, request):
+        if step.status == StepStatus.COMPLETED:
+            continue
+        if step.status == StepStatus.FAILED:
+            request.status = RequestStatus.FAILED
+            request.error = f"step {step.step_key} failed and has not been retried"
+            db.commit()
+            return request
+        if step.status == StepStatus.RUNNING:
+            # Someone else holds it, inside their lease. Not ours to touch.
+            request.status = RequestStatus.RUNNING
+            db.commit()
+            return request
+
+        spec = resolved(next(s for s in PLAN if s.key == step.step_key))
+        if not spec.implemented:
+            step.status = StepStatus.BLOCKED
+            step.error = "no handler yet — implemented in a later, bounded change"
+            request.status = RequestStatus.BLOCKED
+            db.commit()
+            return request
+
+        if not claim_step(db, step, run_token):
+            # Another runner took it between our read and our claim.
+            request.status = RequestStatus.RUNNING
+            db.commit()
+            return request
+
+        request.status = RequestStatus.RUNNING
+        db.commit()
+
+        try:
+            result = spec.handler(db, request)
+        except StepBlocked as blocked:
+            db.rollback()
+            _release(db, step, StepStatus.BLOCKED, str(blocked))
+            request.status = RequestStatus.BLOCKED
+            db.commit()
+            return request
+        except Exception as exc:                  # noqa: BLE001 — recorded, not swallowed
+            db.rollback()
+            _release(db, step, StepStatus.FAILED, f"{type(exc).__name__}: {exc}")
+            request.status = RequestStatus.FAILED
+            request.error = f"step {step.step_key} failed"
+            db.commit()
+            return request
+
+        step.status = StepStatus.COMPLETED
+        step.completed_at = _now()
+        step.result = result
+        step.error = None
+        step.run_token = None
+        step.lease_expires_at = None
+        if step.step_key == "capture_snapshot":
+            request.snapshot = result
+            request.snapshot_taken_at = _now()
+        if step.step_key == "freeze_account":
+            request.status = RequestStatus.FROZEN
+        db.commit()
+
+    return finalise(db, request)
+
+
+def finalise(db: Session, request: ErasureRequest) -> ErasureRequest:
+    """
+    Decide whether a run that ran out of steps is actually finished.
+
+    Separate and callable because it is the last line of defence: today every
+    path through `advance` either returns early or completes the step it
+    touched, so a run cannot reach here half-done. That is a property of the
+    current loop, not a guarantee about the next handler somebody adds — and
+    an untestable guard is one that quietly stops holding.
+
+    `_steps` raises when the ledger and the plan disagree, so a missing row
+    cannot pass as "nothing outstanding".
+    """
+    outstanding = [s.step_key for s in _steps(db, request)
+                   if s.status != StepStatus.COMPLETED]
+    if outstanding:
+        request.status = RequestStatus.BLOCKED
+        request.error = f"not complete — outstanding: {', '.join(outstanding)}"
+    else:
+        request.status = RequestStatus.COMPLETED
+        request.error = None
+        if request.completed_at is None:
+            request.completed_at = _now()
+    db.commit()
+    return request
+
+
+#: Outcomes the matrix allows for a salon-owner association (§2.5.1), with
+#: the evidence each one requires. Free text is deliberately not among them:
+#: this ledger is kept for 24 months, and a register of erasure requests must
+#: not become a place where notes about people accumulate. Where a written
+#: basis genuinely exists, the ledger holds a reference to it, not its text.
+OWNER_OUTCOMES = {
+    "transferred": ("successor_user_id", "accepted_at"),
+    "ended": ("action", "salon_notified_at"),
+    "retained_access_revoked": ("basis_reference", "access_revoked_at"),
+}
+
+
+def record_owner_decision(db: Session, request: ErasureRequest, decisions: list[dict]):
+    """
+    Record one decision per owned salon, with the evidence its outcome needs.
+
+    Preconditions matter as much as the payload. Recorded before the snapshot
+    exists, a decision would be written against an empty `owned_salon_ids`,
+    mark the step complete, and let `advance` sail past the gate once the
+    real snapshot arrived — the block would look honoured and would not be.
+    """
+    steps = {s.step_key: s for s in _steps(db, request)}
+    step = steps["owner_decision"]
+
+    if request.snapshot_taken_at is None:
+        raise ValueError("no snapshot yet — the owned salons are not known")
+    for required in ("freeze_account", "capture_snapshot"):
+        if steps[required].status != StepStatus.COMPLETED:
+            raise ValueError(f"{required} has not completed; nothing to decide against")
+    if step.status != StepStatus.BLOCKED:
+        raise ValueError(
+            f"owner_decision is {step.status}, not blocked; there is no decision pending"
+        )
+
+    owned = set((request.snapshot or {}).get("owned_salon_ids") or [])
+    given = [d.get("salon_id") for d in decisions]
+    if len(given) != len(set(given)):
+        raise ValueError("two decisions for the same salon")
+    missing = owned - set(given)
+    extra = set(given) - owned
+    if missing:
+        raise ValueError(f"no decision recorded for salon(s): {sorted(missing)}")
+    if extra:
+        raise ValueError(f"decision recorded for salon(s) not owned: {sorted(extra)}")
+
+    cleaned = []
+    for decision in decisions:
+        outcome = decision.get("outcome")
+        if outcome not in OWNER_OUTCOMES:
+            raise ValueError(
+                f"outcome must be one of {sorted(OWNER_OUTCOMES)}, got {outcome!r}"
+            )
+        entry = {"salon_id": decision["salon_id"], "outcome": outcome}
+        for field in OWNER_OUTCOMES[outcome]:
+            value = decision.get(field)
+            if value in (None, "", []):
+                raise ValueError(
+                    f"outcome {outcome!r} for salon {decision['salon_id']} requires {field!r}"
+                )
+            entry[field] = value
+        cleaned.append(entry)
+
+    step.status = StepStatus.COMPLETED
+    step.completed_at = _now()
+    step.error = None
+    step.result = {"decisions": cleaned}
+    request.status = RequestStatus.RUNNING
+    request.error = None
+    db.commit()
+    return step
+
+
+def cancel_request(db: Session, request: ErasureRequest, reason_code: str) -> ErasureRequest:
+    """Abandon a run for good, freeing the subject for a new one."""
+    if not reason_code.strip():
+        raise ValueError("cancelling needs a reason code")
+    request.status = RequestStatus.CANCELLED
+    request.error = f"cancelled: {reason_code}"
+    db.commit()
+    return request
+
+
+def retry_step(db: Session, request: ErasureRequest, step_key: str) -> ErasureStep:
+    """Put one failed or blocked step back in the queue, deliberately."""
+    step = (
+        db.query(ErasureStep)
+        .filter(ErasureStep.request_id == request.id, ErasureStep.step_key == step_key)
+        .one()
+    )
+    if step.status == StepStatus.COMPLETED:
+        raise ValueError(f"step {step_key} is already completed; it is not re-runnable")
+    if step.status == StepStatus.RUNNING:
+        raise ValueError(f"step {step_key} is running; wait for its lease to expire")
+    step.status = StepStatus.PENDING
+    step.error = None
+    step.run_token = None
+    step.lease_expires_at = None
+    request.status = RequestStatus.RUNNING
+    request.error = None
+    db.commit()
+    return step
+
+
+def subject_can_write(db: Session, subject_user_id: int) -> bool:
+    """True while the subject's account is still active — used by tests."""
+    row = db.execute(
+        text("SELECT is_active FROM users WHERE id = :uid"), {"uid": subject_user_id}
+    ).first()
+    return bool(row and row[0])
diff --git a/backend/tests/test_alembic_target_guard.py b/backend/tests/test_alembic_target_guard.py
new file mode 100644
index 0000000..91801f1
--- /dev/null
+++ b/backend/tests/test_alembic_target_guard.py
@@ -0,0 +1,348 @@
+"""
+The guard that stops a migration reaching a database nobody named.
+
+On 2026-08-06 a migration meant for a disposable Postgres ran against
+production: the command carried `DATABASE_URL=...`, which nothing reads, and
+the container ran with `--network host`, where `DB_HOST=localhost` is the
+production server. Two empty tables were created and `alembic_version` moved
+to `0004`; both were reverted.
+
+Nothing in that sequence was reckless in isolation, which is the point — the
+run never checked where it was, and found out only by succeeding. So the
+guard asks the server who it is and compares that against an intention the
+caller had to state. These tests are about refusals: the allow paths are
+exercised by the migration smoke test below, against a real database.
+"""
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from alembic_target_guard import (  # noqa: E402
+    TargetRefused, assert_allowed, resolve_url,
+)
+
+PRODUCTION_DB = "beauty_gr"
+PROD = {"database": PRODUCTION_DB, "user": "beauty", "host": "10.0.0.1", "port": 5432}
+SCRATCH = {"database": "lookla_test", "user": "postgres", "host": "127.0.0.1", "port": 55433}
+
+
+@pytest.fixture(autouse=True)
+def clean_env(monkeypatch):
+    for name in ("ALEMBIC_DEPLOY_MODE", "ALEMBIC_EXPECTED_DATABASE",
+                 "ALEMBIC_EXPECTED_USER", "ALEMBIC_EXPECTED_SERVER"):
+        monkeypatch.delenv(name, raising=False)
+
+
+def _declare(monkeypatch, mode, expected, user=None, server=None, actual=None):
+    actual = actual or (PROD if mode == "production" else SCRATCH)
+    monkeypatch.setenv("ALEMBIC_DEPLOY_MODE", mode)
+    monkeypatch.setenv("ALEMBIC_EXPECTED_DATABASE", expected)
+    monkeypatch.setenv("ALEMBIC_EXPECTED_USER", user or actual["user"])
+    monkeypatch.setenv("ALEMBIC_EXPECTED_SERVER",
+                       server or f"{actual['host']}:{actual['port']}")
+
+
+# ───────────────────────────── url resolution ────────────────────────────────
+
+
+def test_settings_are_used_when_nothing_is_passed():
+    # A normal deploy container keeps working exactly as before.
+    assert resolve_url({}, "postgresql://from-settings") == "postgresql://from-settings"
+
+
+def test_an_explicit_url_wins_over_settings():
+    assert resolve_url({"url": "postgresql://explicit"}, "postgresql://settings") == \
+        "postgresql://explicit"
+
+
+def test_a_url_can_be_passed_by_environment_variable_name(monkeypatch):
+    # So a password need not appear in shell history or in `ps`.
+    monkeypatch.setenv("SOME_DSN", "postgresql://secret")
+    assert resolve_url({"url_env": "SOME_DSN"}, "postgresql://settings") == \
+        "postgresql://secret"
+
+
+def test_naming_an_empty_variable_is_refused_rather_than_falling_back(monkeypatch):
+    # Falling back to settings here is how a typo reaches production.
+    monkeypatch.delenv("MISSING_DSN", raising=False)
+    with pytest.raises(TargetRefused, match="MISSING_DSN"):
+        resolve_url({"url_env": "MISSING_DSN"}, "postgresql://settings")
+
+
+# ─────────────────────────────── the refusals ────────────────────────────────
+
+
+def test_an_undeclared_run_is_refused(monkeypatch):
+    # The 2026-08-06 command, exactly: no mode, no expected database.
+    with pytest.raises(TargetRefused, match="ALEMBIC_DEPLOY_MODE"):
+        assert_allowed(PROD, PRODUCTION_DB)
+
+
+def test_a_run_without_an_expected_database_is_refused(monkeypatch):
+    monkeypatch.setenv("ALEMBIC_DEPLOY_MODE", "test")
+    monkeypatch.setenv("ALEMBIC_EXPECTED_USER", "postgres")
+    monkeypatch.setenv("ALEMBIC_EXPECTED_SERVER", "127.0.0.1:55433")
+    with pytest.raises(TargetRefused, match="ALEMBIC_EXPECTED_DATABASE is unset"):
+        assert_allowed(SCRATCH, PRODUCTION_DB)
+
+
+def test_a_mismatched_expected_database_is_refused(monkeypatch):
