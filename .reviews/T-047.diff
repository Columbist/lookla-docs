++"""
++The guard that stops a migration reaching a database nobody named.
++
++On 2026-08-06 a migration meant for a disposable Postgres ran against
++production: the command carried `DATABASE_URL=...`, which nothing reads, and
++the container ran with `--network host`, where `DB_HOST=localhost` is the
++production server. Two empty tables were created and `alembic_version` moved
++to `0004`; both were reverted.
++
++Nothing in that sequence was reckless in isolation, which is the point — the
++run never checked where it was, and found out only by succeeding. So the
++guard asks the server who it is and compares that against an intention the
++caller had to state. These tests are about refusals: the allow paths are
++exercised by the migration smoke test below, against a real database.
++"""
++import os
++import subprocess
++import sys
++from pathlib import Path
++
++import pytest
++
++sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
++from alembic_target_guard import (  # noqa: E402
++    TargetRefused, assert_allowed, describe, resolve_url,
++)
++
++PRODUCTION_DB = "beauty_gr"
++PROD = {"database": PRODUCTION_DB, "user": "beauty", "host": "10.0.0.1", "port": 5432}
++SCRATCH = {"database": "lookla_test", "user": "postgres", "host": "127.0.0.1", "port": 55433}
++
++
++@pytest.fixture(autouse=True)
++def clean_env(monkeypatch):
++    monkeypatch.delenv("ALEMBIC_DEPLOY_MODE", raising=False)
++    monkeypatch.delenv("ALEMBIC_EXPECTED_DATABASE", raising=False)
++
++
++def _declare(monkeypatch, mode, expected):
++    monkeypatch.setenv("ALEMBIC_DEPLOY_MODE", mode)
++    monkeypatch.setenv("ALEMBIC_EXPECTED_DATABASE", expected)
++
++
++# ───────────────────────────── url resolution ────────────────────────────────
++
++
++def test_settings_are_used_when_nothing_is_passed():
++    # A normal deploy container keeps working exactly as before.
++    assert resolve_url({}, "postgresql://from-settings") == "postgresql://from-settings"
++
++
++def test_an_explicit_url_wins_over_settings():
++    assert resolve_url({"url": "postgresql://explicit"}, "postgresql://settings") == \
++        "postgresql://explicit"
++
++
++def test_a_url_can_be_passed_by_environment_variable_name(monkeypatch):
++    # So a password need not appear in shell history or in `ps`.
++    monkeypatch.setenv("SOME_DSN", "postgresql://secret")
++    assert resolve_url({"url_env": "SOME_DSN"}, "postgresql://settings") == \
++        "postgresql://secret"
++
++
++def test_naming_an_empty_variable_is_refused_rather_than_falling_back(monkeypatch):
++    # Falling back to settings here is how a typo reaches production.
