@@ -0,0 +1,87 @@
+"""
+The handlers this PR implements: freeze, snapshot, and the owner decision.
+
+Nothing here is destructive. `freeze_account` writes one boolean, and it is
+the write that makes everything after it safe — an erasure that runs while
+the subject is still creating rows can never be complete.
+"""
+from sqlalchemy import text
+from sqlalchemy.orm import Session
+
+from app.services.erasure.plan import _h
+
+# Every table the run must reach, as (label, SQL returning ids or a count).
+# Ids where a later step needs to find the row again after its link to the
+# subject is gone; counts where the link survives.
+_ANCHOR_QUERIES = (
+    ("professional_ids", "SELECT id FROM professionals WHERE user_id = :uid"),
+    ("owned_salon_ids", "SELECT salon_id FROM salon_owners WHERE user_id = :uid"),
+    ("webhook_ids", "SELECT id FROM webhooks WHERE owner_user_id = :uid"),
+    ("conversation_ids", "SELECT id FROM conversations WHERE client_user_id = :uid"),
+    ("appointment_ids", "SELECT id FROM appointments WHERE client_user_id = :uid"),
+    ("availability_request_ids",
+     "SELECT id FROM availability_requests WHERE client_user_id = :uid"),
+    ("reported_ids", "SELECT id FROM reports WHERE reporter_user_id = :uid"),
+    ("resolved_report_ids", "SELECT id FROM reports WHERE resolved_by = :uid"),
+    ("moderation_submitted_ids",
+     "SELECT id FROM moderation_queue WHERE submitter_user_id = :uid"),
+    ("moderation_reviewed_ids",
+     "SELECT id FROM moderation_queue WHERE reviewed_by = :uid"),
+    ("message_ids", "SELECT id FROM messages WHERE sender_user_id = :uid"),
+    ("claiming_token_ids", "SELECT id FROM claiming_tokens WHERE user_id = :uid"),
+    ("refresh_token_ids", "SELECT id FROM refresh_tokens WHERE user_id = :uid"),
+    ("email_verification_ids", "SELECT id FROM email_verifications WHERE user_id = :uid"),
+    ("password_reset_ids", "SELECT id FROM password_resets WHERE user_id = :uid"),
+)
+
+
+class StepBlocked(Exception):
+    """Raised by a step that needs a human before the run can go on."""
+
+
+@_h("freeze_account")
+def freeze_account(db: Session, request) -> dict:
+    uid = request.subject_user_id
+    if not db.execute(text("SELECT 1 FROM users WHERE id = :uid"), {"uid": uid}).first():
+        raise ValueError(f"no such user: {uid}")
+    db.execute(text("UPDATE users SET is_active = false WHERE id = :uid"), {"uid": uid})
+    return {"frozen_user_id": uid}
+
+
+@_h("capture_snapshot")
+def capture_snapshot(db: Session, request) -> dict:
+    """
+    Record the ids before anything unlinks them.
+
+    This is the step whose absence broke the manual verifier: it checked
+    `professionals WHERE user_id = :id` *after* the same procedure had set
+    that column to NULL, so it could only ever return zero. Ids captured
+    here are what the verification phase reads.
+    """
+    uid = request.subject_user_id
+    snapshot: dict = {"subject_user_id": uid}
+    for label, sql in _ANCHOR_QUERIES:
+        rows = db.execute(text(sql), {"uid": uid}).fetchall()
+        snapshot[label] = [row[0] for row in rows]
+    return snapshot
+
+
+@_h("owner_decision")
+def owner_decision(db: Session, request) -> dict:
+    """
+    Salon ownership is not the subject's alone to destroy.
+
+    `salon_owners.user_id` cascades on delete, but this workflow never
+    deletes the users row, so the cascade never fires and the row keeps
+    granting owner access to a pseudonymised account. Ending it flips a
+    salon's "Owner verified" state and can strand a business, so one of the
+    three outcomes in the matrix (§2.5.1) must be recorded by a human before
+    the run may finish. No rows here, nothing to decide.
+    """
+    owned = (request.snapshot or {}).get("owned_salon_ids") or []
+    if not owned:
+        return {"owned_salon_ids": []}
+    raise StepBlocked(
+        "salon-owner associations need a recorded decision (transfer, end, or "
+        f"retain with access revoked) for salon(s): {sorted(owned)}"
+    )
