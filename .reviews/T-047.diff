+
+# ──────────────────────────────── the allows ─────────────────────────────────
+
+
+def test_a_declared_test_run_against_a_scratch_database_is_allowed(monkeypatch):
+    _declare(monkeypatch, "test", "lookla_test")
+    assert "test migration" in assert_allowed(SCRATCH, PRODUCTION_DB)
+
+
+def test_a_declared_production_run_against_production_is_allowed(monkeypatch):
+    _declare(monkeypatch, "production", PRODUCTION_DB)
+    assert "production migration" in assert_allowed(PROD, PRODUCTION_DB)
+
+
+# ───────────────────── the guard against a real database ─────────────────────
+
+
+def _database_url() -> str:
+    url = os.environ.get("TEST_DATABASE_URL")
+    if url:
+        return url
+    if os.environ.get("CI"):
+        pytest.fail(
+            "TEST_DATABASE_URL is unset on CI — the migration cannot be exercised "
+            "against a real database, and a skipped migration test is how the "
+            "2026-08-06 accident stayed invisible"
+        )
+    pytest.skip("set TEST_DATABASE_URL to run the migration smoke test")
+
+
+def _identity(engine) -> dict:
+    from sqlalchemy import text
+
+    with engine.connect() as conn:
+        database, user, host, port = conn.execute(text(
+            "SELECT current_database(), current_user, "
+            "coalesce(host(inet_server_addr()), 'local'), inet_server_port()"
+        )).one()
+    return {"database": database, "user": user, "host": host, "port": port}
+
+
+def _declared_for(engine) -> dict:
+    ident = _identity(engine)
+    return {
+        "ALEMBIC_DEPLOY_MODE": "test",
+        "ALEMBIC_EXPECTED_DATABASE": ident["database"],
+        "ALEMBIC_EXPECTED_USER": ident["user"],
+        "ALEMBIC_EXPECTED_SERVER": f"{ident['host']}:{ident['port']}",
+    }
+
+
+def _scratch_engine():
+    """
+    Prove the target is disposable **before** touching it.
+
+    The first version of this file dropped the schema and *then* ran Alembic,
+    whose guard would refuse — so a mistyped `TEST_DATABASE_URL=production`
+    would have destroyed production and the negative test would have read the
+    resulting empty database as proof that the refusal worked. The test
+    written in response to the accident could have caused it.
+
+    So: connect, ask the server who it is, and refuse anything that is not
+    visibly a scratch database, before any DDL runs.
+    """
+    from sqlalchemy import create_engine
+
+    from app.core.config import get_settings
+
+    url = _database_url()
+    engine = create_engine(url)
+    ident = _identity(engine)
+    database, user, host, port = (
+        ident["database"], ident["user"], ident["host"], ident["port"])
+
+    where = f"{database} as {user} on {host}:{port}"
+    if database == get_settings().db_name:
+        engine.dispose()
+        pytest.fail(f"refusing to run destructively against {where}: "
+                    "that is this application's own database")
+    if "test" not in database.lower():
+        engine.dispose()
+        pytest.fail(f"refusing to run destructively against {where}: "
+                    "a scratch database's name must say so")
+    return engine
+
+
+def _reset_scratch(engine):
+    from sqlalchemy import text
+
+    with engine.begin() as conn:
+        conn.execute(text("DROP SCHEMA IF EXISTS public CASCADE"))
+        conn.execute(text("CREATE SCHEMA public"))
+
+
+def _alembic(url: str, *args, expect_ok: bool = True, **env_extra):
+    backend = Path(__file__).resolve().parents[1]
+    env = {
+        **os.environ,
+        "ALEMBIC_URL": url,
+        "PYTHONPATH": str(backend),
+        **env_extra,
+    }
+    proc = subprocess.run(  # noqa: S603
+        [sys.executable, "-m", "alembic", "-x", "url_env=ALEMBIC_URL", *args],
+        cwd=backend, env=env, capture_output=True, text=True,
+    )
+    if expect_ok:
+        assert proc.returncode == 0, proc.stdout + proc.stderr
+    return proc
+
+
+def test_the_smoke_preflight_refuses_the_application_database(monkeypatch):
+    """
+    The guard on the test itself, exercised without needing a second server:
+    point the preflight at the application's own database name and it must
+    refuse before returning an engine to drop things with.
+    """
+    from app.core.config import get_settings
+
+    monkeypatch.setattr(
+        "app.core.config.get_settings",
+        lambda: type("S", (), {"db_name": "lookla_test"})(),
+    )
+    # Now the scratch database *is* the configured one, so the preflight
+    # must treat it as production and refuse.
+    with pytest.raises(BaseException) as excinfo:
+        _scratch_engine()
+    assert "own database" in str(excinfo.value)
+    assert get_settings  # keeps the import meaningful under linting
+
+
+def test_the_migration_applies_and_reverses_against_a_real_database():
+    """
+    `0001` is a stamp placeholder — the production tables predate Alembic —
+    so a database cannot be built from nothing. The run is stamped at `0003`
+    and exercises `0004`, which is self-contained.
+    """
+    from sqlalchemy import inspect
+
+    engine = _scratch_engine()
+    _reset_scratch(engine)
+    url = str(engine.url.render_as_string(hide_password=False))
+
+    declared = _declared_for(engine)
+    _alembic(url, "stamp", "0003", **declared)
+    _alembic(url, "upgrade", "head", **declared)
+
+    tables = set(inspect(engine).get_table_names())
+    assert {"erasure_requests", "erasure_steps"} <= tables
+
+    _alembic(url, "downgrade", "0003", **declared)
+    tables = set(inspect(engine).get_table_names())
+    assert not ({"erasure_requests", "erasure_steps"} & tables), (
+        "downgrade left its tables behind"
+    )
+    engine.dispose()
+
+
+def test_an_undeclared_run_leaves_the_database_untouched():
+    """
+    "The database is empty afterwards" was the wrong assertion: an empty
+    database is also what a successful `DROP SCHEMA` leaves behind. The claim
+    that matters is that nothing *changed*, so a sentinel goes in first and
+    must still be there afterwards.
+    """
+    from sqlalchemy import inspect, text
+
+    engine = _scratch_engine()
+    _reset_scratch(engine)
+    url = str(engine.url.render_as_string(hide_password=False))
+
+    with engine.begin() as conn:
+        conn.execute(text("CREATE TABLE sentinel (id integer primary key, mark text)"))
+        conn.execute(text("INSERT INTO sentinel (id, mark) VALUES (1, 'untouched')"))
+
+    proc = _alembic(url, "upgrade", "head", expect_ok=False,
+                    ALEMBIC_DEPLOY_MODE="", ALEMBIC_EXPECTED_DATABASE="",
+                    ALEMBIC_EXPECTED_USER="", ALEMBIC_EXPECTED_SERVER="")
+
+    assert proc.returncode != 0
+    assert "TargetRefused" in proc.stdout + proc.stderr
+
+    with engine.begin() as conn:
+        mark = conn.execute(text("SELECT mark FROM sentinel WHERE id = 1")).scalar()
+    assert mark == "untouched", "the refusal happened after something was written"
+
+    tables = set(inspect(engine).get_table_names())
+    assert not ({"erasure_requests", "erasure_steps", "alembic_version"} & tables), (
+        "an undeclared run created tables before refusing"
+    )
+    engine.dispose()
