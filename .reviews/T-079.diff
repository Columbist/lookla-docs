index 0000000..a0875f3
--- /dev/null
+++ b/backend/tests/test_owner_claim_verify_race.py
@@ -0,0 +1,404 @@
+"""
+T-079: a claim token stays valid while somebody else claims the salon.
+
+`claim/verify` inserted into `salon_owners` without re-checking ownership.
+`ON CONFLICT DO NOTHING` does not help: the only uniqueness is the composite
+(user_id, salon_id), so two *different* users for one salon is a valid pair.
+Two people request a claim on an unclaimed salon, the first verifies and
+becomes owner, and the second's token — still unused, still unexpired — adds
+a second owner row and returns success.
+
+The sequential case is covered here against SQLite. The concurrent case is
+not: SQLite serialises writes on its own, so it would "pass" whether or not
+the code takes a row lock, and would prove nothing about `FOR UPDATE`. That
+case runs against a real Postgres and is guarded so it cannot quietly turn
+into a skip on CI — a test that vanishes is not a test that passed.
+"""
+import os
+import threading
+import time
+
+import pytest
+from fastapi import Request
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine, text
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+from app.main import app
+from app.core.database import get_db, Base
+from app.core.deps import get_current_user
+from app.models.salon import Salon
+from app.models.user import User
+
+SALON = 1
+FIRST = 10
+SECOND = 11
+TOKEN_A = "AAA111"
+TOKEN_B = "BBB222"
+
+CLAIMING_TOKENS_DDL = {
+    "sqlite": """
+        CREATE TABLE claiming_tokens (
+            id         INTEGER PRIMARY KEY AUTOINCREMENT,
+            user_id    INTEGER NOT NULL,
+            salon_id   INTEGER NOT NULL,
+            token      VARCHAR NOT NULL,
+            expires_at TIMESTAMP NOT NULL,
+            used_at    TIMESTAMP,
+            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
+            UNIQUE (user_id, salon_id)
+        )
+    """,
+    "postgresql": """
+        CREATE TABLE claiming_tokens (
+            id         SERIAL PRIMARY KEY,
+            user_id    INTEGER NOT NULL,
+            salon_id   INTEGER NOT NULL,
+            token      VARCHAR NOT NULL,
+            expires_at TIMESTAMPTZ NOT NULL,
+            used_at    TIMESTAMPTZ,
+            created_at TIMESTAMPTZ DEFAULT NOW(),
+            UNIQUE (user_id, salon_id)
+        )
+    """,
+}
+
+
+def _seed(engine):
+    """One unclaimed salon, two users, and a live token for each."""
+    dialect = engine.dialect.name
+    Base.metadata.create_all(engine)
+    with engine.begin() as conn:
+        conn.execute(text(CLAIMING_TOKENS_DDL[dialect]))
+
+    session = sessionmaker(bind=engine)()
+    session.add(Salon(id=SALON, name="Up for grabs", slug="up-for-grabs", is_active=True))
+    session.add(User(id=FIRST, email="first@example.com", role="user"))
+    session.add(User(id=SECOND, email="second@example.com", role="user"))
+    session.commit()
+    session.close()
+
+    future = "CURRENT_TIMESTAMP + interval '1 hour'" if dialect == "postgresql" \
+        else "datetime('now', '+1 hour')"
+    with engine.begin() as conn:
+        for uid, tok in ((FIRST, TOKEN_A), (SECOND, TOKEN_B)):
+            conn.execute(text(
+                f"INSERT INTO claiming_tokens (user_id, salon_id, token, expires_at) "
+                f"VALUES (:u, :s, :t, {future})"
+            ), {"u": uid, "s": SALON, "t": tok})
+
+
+def _owner_count(engine) -> int:
+    with engine.begin() as conn:
+        return conn.execute(text(
+            "SELECT count(*) FROM salon_owners WHERE salon_id = :s"
+        ), {"s": SALON}).scalar()
+
+
+def _live_tokens(engine) -> int:
+    with engine.begin() as conn:
+        return conn.execute(text(
+            "SELECT count(*) FROM claiming_tokens WHERE salon_id = :s AND used_at IS NULL"
+        ), {"s": SALON}).scalar()
+
+
+# ─────────────────────────── sequential, on SQLite ───────────────────────────
+
+
+@pytest.fixture
+def client():
+    engine = create_engine(
+        "sqlite:///:memory:",
+        connect_args={"check_same_thread": False},
+        poolclass=StaticPool,
+    )
+    _seed(engine)
+    session_local = sessionmaker(autocommit=False, autoflush=False, bind=engine)
+
+    def override_get_db():
+        db = session_local()
+        try:
+            yield db
+        finally:
+            db.close()
+
+    current = {"id": FIRST}
+
+    def override_user():
+        session = session_local()
+        try:
+            return session.get(User, current["id"])
+        finally:
+            session.close()
+
+    app.dependency_overrides[get_db] = override_get_db
+    app.dependency_overrides[get_current_user] = override_user
+
+    test_client = TestClient(app)
+    test_client.engine = engine
+    test_client.act_as = lambda uid: current.__setitem__("id", uid)
+    try:
+        yield test_client
+    finally:
+        test_client.close()
+        app.dependency_overrides.pop(get_db, None)
+        app.dependency_overrides.pop(get_current_user, None)
+        engine.dispose()
+
+
+def _verify(client, uid, token):
+    client.act_as(uid)
+    return client.post(f"/api/owner/claim/verify?salon_id={SALON}&token={token}")
+
+
+def test_the_first_verification_claims_the_salon(client):
+    r = _verify(client, FIRST, TOKEN_A)
+    assert r.status_code == 200, r.text
+    assert _owner_count(client.engine) == 1
+
+
+def test_a_second_token_cannot_add_a_second_owner(client):
+    assert _verify(client, FIRST, TOKEN_A).status_code == 200
+
+    r = _verify(client, SECOND, TOKEN_B)
+
+    assert r.status_code == 409, f"expected 409, got {r.status_code}: {r.text}"
+    assert _owner_count(client.engine) == 1, "a second owner row was created"
+
+
+def test_claiming_burns_every_other_outstanding_token(client):
+    assert _live_tokens(client.engine) == 2
+    assert _verify(client, FIRST, TOKEN_A).status_code == 200
+
+    assert _live_tokens(client.engine) == 0, (
+        "a token that can now only produce a second owner survived the claim"
+    )
+
+
+def test_the_refused_token_is_burned_too(client):
+    assert _verify(client, FIRST, TOKEN_A).status_code == 200
+    assert _verify(client, SECOND, TOKEN_B).status_code == 409
+
+    # Refusing without burning would leave it to be retried for an hour.
+    with client.engine.begin() as conn:
+        used = conn.execute(text(
+            "SELECT used_at FROM claiming_tokens WHERE token = :t"
+        ), {"t": TOKEN_B}).scalar()
+    assert used is not None
+
+
+def test_a_missing_salon_is_404(client):
+    client.act_as(FIRST)
+    r = client.post(f"/api/owner/claim/verify?salon_id=9999&token={TOKEN_A}")
+    assert r.status_code == 404, r.text
+
+
+# ───────────────────────── concurrent, on real Postgres ──────────────────────
+
+
+def _postgres_url() -> str:
+    """
+    Resolve the scratch database, and refuse to be skipped on CI.
+
+    A concurrency test that silently skips is worse than no test: the suite
+    stays green and the guarantee is unproven. On CI the absence of the URL is
+    a failure, not a reason to opt out.
+    """
+    url = os.environ.get("TEST_DATABASE_URL")
+    if url:
+        return url
+    if os.environ.get("CI"):
+        pytest.fail(
+            "TEST_DATABASE_URL is unset on CI — the concurrent-claim guarantee "
+            "cannot be proven against SQLite, which serialises writes by itself"
+        )
+    pytest.skip("set TEST_DATABASE_URL to run the concurrent claim test")
+
+
+def _assert_scratch_database(url: str) -> None:
+    """
+    This test drops and recreates the public schema. Refuse anything that is
+    not visibly a scratch database — an env var pointed at the wrong host is
+    not a mistake worth making twice.
+    """
+    name = url.rsplit("/", 1)[-1].split("?")[0]
+    if "test" not in name.lower():
+        pytest.fail(
+            f"TEST_DATABASE_URL names {name!r}, which is not recognisably a "
+            "test database; this test drops the public schema"
+        )
+
+
+def test_two_simultaneous_verifications_produce_one_owner():
+    url = _postgres_url()
+    _assert_scratch_database(url)
+    engine = create_engine(url, poolclass=None)
+    with engine.begin() as conn:
+        conn.execute(text("DROP SCHEMA IF EXISTS public CASCADE"))
+        conn.execute(text("CREATE SCHEMA public"))
+    _seed(engine)
+
+    session_local = sessionmaker(autocommit=False, autoflush=False, bind=engine)
+
+    def override_get_db():
+        db = session_local()
+        try:
+            yield db
+        finally:
+            db.close()
+
+    # The identity travels on the request, not in a thread-local: TestClient
+    # runs the app on its own portal thread, so a value set by the calling
+    # thread is not visible where the dependency actually resolves.
+    def override_user(request: Request):
+        session = session_local()
+        try:
+            return session.get(User, int(request.headers["x-test-user"]))
+        finally:
+            session.close()
+
+    app.dependency_overrides[get_db] = override_get_db
+    app.dependency_overrides[get_current_user] = override_user
+
+    barrier = threading.Barrier(2)
+    results = {}
+
+    def attempt(uid, token):
+        # Plain TestClient, not the context-manager form: entering it runs the
+        # app lifespan, which opens its own connection to the real configured
+        # database and fails here. Only the request path is under test.
+        c = TestClient(app)
+        try:
+            barrier.wait(timeout=10)
+            r = c.post(
+                f"/api/owner/claim/verify?salon_id={SALON}&token={token}",
+                headers={"x-test-user": str(uid)},
+            )
+            results[uid] = r.status_code
+        finally:
+            c.close()
+
+    threads = [
+        threading.Thread(target=attempt, args=(FIRST, TOKEN_A)),
+        threading.Thread(target=attempt, args=(SECOND, TOKEN_B)),
+    ]
+    try:
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(timeout=30)
+
+        assert sorted(results.values()) == [200, 409], (
+            f"expected exactly one winner, got {results}"
+        )
+        assert _owner_count(engine) == 1, "concurrent verifications created two owners"
+    finally:
+        app.dependency_overrides.pop(get_db, None)
+        app.dependency_overrides.pop(get_current_user, None)
+        engine.dispose()
+
+
+def test_a_request_arriving_during_a_claim_is_refused_and_issues_no_token():
+    """
+    The other half of the race: `request` against an in-flight `verify`.
+
+    With the lock only in `verify`, a `request` running concurrently reads
+    `salon_owners` before the claim commits, passes its ownership guard, and
+    inserts a token *after* the claim has burnt the outstanding ones — so a
+    live token survives a completed claim and the endpoint reports success for
+    an already-claimed salon.
+
+    The claim is simulated by holding exactly what verify holds: the salon row
+    lock, an uncommitted owner row, and the token sweep. The request must
+    block on that lock, and answer 409 once it is released.
+    """
+    url = _postgres_url()
+    _assert_scratch_database(url)
+    engine = create_engine(url, poolclass=None)
+    with engine.begin() as conn:
+        conn.execute(text("DROP SCHEMA IF EXISTS public CASCADE"))
+        conn.execute(text("CREATE SCHEMA public"))
+    _seed(engine)
+
+    session_local = sessionmaker(autocommit=False, autoflush=False, bind=engine)
+
+    def override_get_db():
+        db = session_local()
+        try:
+            yield db
+        finally:
+            db.close()
+
+    def override_user(request: Request):
+        session = session_local()
+        try:
+            return session.get(User, int(request.headers["x-test-user"]))
+        finally:
+            session.close()
+
+    app.dependency_overrides[get_db] = override_get_db
+    app.dependency_overrides[get_current_user] = override_user
+
+    holder = session_local()
+    result = {}
+
+    def fire_request():
+        c = TestClient(app)
+        try:
+            r = c.post(
+                "/api/owner/claim/request",
+                json={"salon_id": SALON},
+                headers={"x-test-user": str(SECOND)},
+            )
+            result["status"] = r.status_code
+        finally:
+            c.close()
+
+    try:
+        # A claim in flight: lock held, owner written, tokens swept, no commit.
+        holder.execute(text("SELECT id FROM salons WHERE id = :s FOR UPDATE"), {"s": SALON})
+        holder.execute(text(
+            "INSERT INTO salon_owners (user_id, salon_id) VALUES (:u, :s)"
+        ), {"u": FIRST, "s": SALON})
+        holder.execute(text(
+            "UPDATE claiming_tokens SET used_at = CURRENT_TIMESTAMP "
+            "WHERE salon_id = :s AND used_at IS NULL"
+        ), {"s": SALON})
+
+        thread = threading.Thread(target=fire_request)
+        thread.start()
+
+        # It must actually block. Without the lock in `request` nothing waits,
+        # the request completes against the stale read, and this loop times
+        # out — which is the failure this test exists to produce.
+        deadline = time.monotonic() + 15
+        blocked = False
+        while time.monotonic() < deadline:
+            with engine.connect() as probe:
+                blocked = probe.execute(text(
+                    "SELECT count(*) FROM pg_stat_activity "
+                    "WHERE wait_event_type = 'Lock' AND state = 'active'"
+                )).scalar() > 0
+            if blocked:
+                break
+            time.sleep(0.2)
+
+        assert blocked, (
+            "claim/request did not wait for the salon lock — it read ownership "
+            "while a claim was in flight"
+        )
+        assert "status" not in result, "the request completed before the claim committed"
+
+        holder.commit()
+        thread.join(timeout=20)
+
+        assert result.get("status") == 409, (
+            f"expected 409 once the claim landed, got {result.get('status')}"
+        )
+        assert _live_tokens(engine) == 0, "a live token survived a completed claim"
+    finally:
+        holder.close()
+        app.dependency_overrides.pop(get_db, None)
+        app.dependency_overrides.pop(get_current_user, None)
+        engine.dispose()
