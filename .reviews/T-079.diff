+def _lock_salon(db: Session, salon_id: int) -> bool:
+    """
+    Serialise everything that decides ownership of one salon.
+
+    Both claim endpoints read `salon_owners` and then write on the strength of
+    what they read, so both must hold the same lock or the read is stale by
+    the time the write lands. With the lock only in `verify`, a `request`
+    running concurrently could still pass the ownership guard against an
+    uncommitted claim and issue a token that outlives it.
+
+    The lock is on the salon row, so it serialises claims for that salon and
+    nothing else. SQLite has no FOR UPDATE and needs none — it serialises
+    writes on its own — so the clause is added only on Postgres.
+    """
+    sql = "SELECT id FROM salons WHERE id = :sid"
+    if db.bind.dialect.name == "postgresql":
+        sql += " FOR UPDATE"
+    return db.execute(text(sql), {"sid": salon_id}).first() is not None
+
+
