index 0000000..9355334
--- /dev/null
+++ b/frontend/lib/mapPreviewNavigation.test.ts
@@ -0,0 +1,146 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+/**
+ * T-068 — the map preview's "view salon" control must navigate client-side so
+ * T-056's in-memory search-return snapshot survives the trip.
+ *
+ * The snapshot is written by a save-on-unmount cleanup in the search page and
+ * stored in a module-scope Map. A full-document navigation destroys the JS
+ * realm and therefore the store, so the mechanism only works if leaving the
+ * page is a client-side transition.
+ */
+
+const src = readFileSync('components/MapView.tsx', 'utf8');
+const codeOnly = src
+  .replace(/\/\*[\s\S]*?\*\//g, '')
+  .replace(/\/\/.*$/gm, '')
+  .replace(/\{\/\*[\s\S]*?\*\/\}/g, '');
+
+/** The JSX block for the salon-destination control. */
+const salonLinkBlock = (() => {
+  const idx = codeOnly.indexOf('/salons/${selected');
+  assert.ok(idx > -1, 'expected a salon destination in MapView');
+  const start = codeOnly.lastIndexOf('<', idx);
+  return codeOnly.slice(start, idx + 400);
+})();
+
+describe('T-068: the salon destination navigates client-side', () => {
+  test('is rendered with next/link, not a bare anchor', () => {
+    assert.ok(/^<Link\b/.test(salonLinkBlock), `expected <Link>, got: ${salonLinkBlock.slice(0, 40)}`);
+  });
+
+  test('next/link is imported', () => {
+    assert.ok(/^import Link from 'next\/link';$/m.test(src));
+  });
+
+  test('no plain <a> points at an internal /salons/ route any more', () => {
+    // A hard navigation to a salon route from this component would silently
+    // reintroduce the snapshot loss.
+    const anchors = codeOnly.match(/<a\b[\s\S]{0,400}?>/g) ?? [];
+    const offenders = anchors.filter(a => /\/salons\//.test(a));
+    assert.deepEqual(offenders, [], `internal salon route still on a plain <a>: ${JSON.stringify(offenders)}`);
+  });
+});
+
+describe('T-068: only the mechanism changed', () => {
+  test('the destination is byte-identical to before', () => {
+    assert.ok(
+      codeOnly.includes('href={`${prefix}/salons/${selected.slug || selected.id}`}'),
+      'destination expression must be unchanged (slug with numeric id fallback)',
+    );
+  });
+
+  test('salon_open is unchanged in name, shape and source', () => {
+    assert.ok(
+      /onClick=\{\(\) => trackEvent\('salon_open', \{ salon_id: String\(selected\.id\), source: 'search_map', locale: locale as Locale \}\)\}/.test(
+        codeOnly,
+      ),
+      'the analytics call must be byte-identical',
+    );
+  });
+
+  test('salon_open still has exactly one call site in this component', () => {
+    assert.equal((codeOnly.match(/trackEvent\(/g) ?? []).length, 1);
+    assert.equal((codeOnly.match(/'salon_open'/g) ?? []).length, 1);
+  });
+
+  test('the visual treatment is unchanged', () => {
+    assert.ok(
+      salonLinkBlock.includes(
+        'text-body-sm bg-brand text-text-inverse px-3 py-1 rounded-sm font-medium hover:bg-brand-hover transition-colors focus-ring-token',
+      ),
+      'className must be identical — T-068 is not a visual change',
+    );
+  });
+});
+
+describe('T-068: external protocols stay plain anchors', () => {
+  test('the tel: quick-dial is NOT routed through next/link', () => {
+    const idx = codeOnly.indexOf('tel:${selected.phone_primary}');
+    assert.ok(idx > -1, 'expected the tel: link to still exist');
+    const start = codeOnly.lastIndexOf('<', idx);
+    const block = codeOnly.slice(start, idx + 60);
+    assert.ok(/^<a\b/.test(block), 'tel: must remain a plain <a> — it is a protocol, not a route');
+  });
+
+  test('no Link wraps a non-route protocol', () => {
+    const links = codeOnly.match(/<Link\b[\s\S]{0,300}?>/g) ?? [];
+    for (const l of links) {
+      assert.ok(!/href=\{`(tel|mailto|https?):/.test(l), `Link must not carry an external protocol: ${l.slice(0, 60)}`);
+    }
+  });
+
+  test('the quick-dial keeps its accessible name from T-067', () => {
+    assert.ok(codeOnly.includes("aria-label={t('callSalon')}"));
+  });
+});
+
+describe('T-068: T-056 snapshot machinery is untouched', () => {
+  const page = readFileSync('app/[locale]/search/page.tsx', 'utf8');
+
+  test('the search page was not modified to special-case the map link', () => {
+    // The capture-phase freeze selector already matches whatever Link renders,
+    // so no page-level change was needed. If a map-specific branch appears
+    // here, the fix drifted out of its intended scope.
+    assert.ok(
+      page.includes(`closest?.('a[href*="/salons/"]')`),
+      'the generic freeze selector must remain generic',
+    );
+    assert.ok(!/search_map|MapView.*scroll/i.test(page.replace(/\/\*[\s\S]*?\*\//g, '')),
+      'the search page must not gain map-specific snapshot handling');
+  });
+
+  test('the snapshot is still written only by the save-on-unmount cleanup', () => {
+    assert.equal(
+      (page.match(/saveSnapshot\(/g) ?? []).length,
+      1,
+      'exactly one save site must remain',
+    );
+  });
+
+  test('MapView does not read or write the snapshot store itself', () => {
+    for (const banned of ['saveSnapshot', 'readSnapshot', 'searchReturnState']) {
+      assert.ok(!codeOnly.includes(banned), `${banned} does not belong in MapView`);
+    }
+  });
+});
+
+describe('T-068: T-063 keyboard model still intact', () => {
+  test('the preview is still reachable and closable by keyboard', () => {
+    assert.ok(/e\.key === 'Enter' \|\| e\.key === ' '/.test(codeOnly), 'Enter/Space activation preserved');
+    assert.ok(/e\.key !== 'Escape'/.test(codeOnly), 'Escape handling preserved');
+  });
+
+  test('keyboard activation still moves focus to the first link in the preview', () => {
+    // The destination is now a Link, which still renders an <a href>, so the
+    // existing focus query keeps working.
+    assert.ok(/querySelector<HTMLElement>\('a\[href\]'\)/.test(codeOnly));
+  });
+
+  test('the roving tabindex contract is unchanged', () => {
+    assert.ok(/keyboard: false/.test(codeOnly));
+    assert.ok(/'tabindex', entry\.salon\.id === activeIdRef\.current \? '0' : '-1'/.test(codeOnly));
+  });
+});
