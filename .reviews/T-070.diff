+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { LatestRequestTracker, isAbortError, type RequestHandle } from './latestRequest';
+
+/**
+ * Deterministic deferred — the settlement ORDER is the thing under test, so
+ * these never rely on timers. `resolve B; assert; resolve A; assert still B`.
+ */
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => { resolve = res; reject = rej; });
+  return { promise, resolve, reject };
+}
+
+/** Minimal model of the component's guarded write paths, for race tests. */
+function makeMapModel() {
+  const tracker = new LatestRequestTracker();
+  const state = { salons: [] as string[], loading: false, resolved: false, error: false };
+  const events: string[] = [];
+
+  async function run(source: Promise<string[]>, opts: { failWith?: unknown } = {}) {
+    const request = tracker.start();
+    state.loading = true;
+    state.error = false;
+    state.resolved = false;
+    try {
+      const data = await source;
+      if (!tracker.owns(request)) return;
+      state.salons = data;
+      state.resolved = true;
+      events.push(`resolved:${data.length}`);
+    } catch (err) {
+      if (isAbortError(err, request.signal)) return;
+      if (!tracker.owns(request)) return;
+      state.salons = [];
+      state.error = true;
+      events.push('error');
+      if (opts.failWith) { /* shape parity with the component */ }
+    } finally {
+      if (tracker.owns(request)) state.loading = false;
+    }
+  }
+  return { tracker, state, events, run };
+}
+
+describe('T-070: generation tokens', () => {
+  test('increase monotonically', () => {
+    const t = new LatestRequestTracker();
+    const a = t.start(), b = t.start(), c = t.start();
+    assert.ok(a.generation < b.generation && b.generation < c.generation);
+  });
+
+  test('starting a request aborts the previous controller', () => {
+    const t = new LatestRequestTracker();
+    const a = t.start();
+    assert.equal(a.signal.aborted, false);
+    t.start();
+    assert.equal(a.signal.aborted, true, 'the superseded request must be aborted');
+  });
+
+  test('only the newest handle owns the tracker', () => {
+    const t = new LatestRequestTracker();
+    const a = t.start();
+    const b = t.start();
+    assert.equal(t.owns(a), false);
+    assert.equal(t.owns(b), true);
+  });
+
+  test('ownership fails on an aborted signal even at the same generation', () => {
+    // Belt and braces: the generation check alone would pass here.
+    const t = new LatestRequestTracker();
+    const a = t.start();
+    assert.equal(t.owns(a), true);
+    t.invalidate();
+    assert.equal(t.owns(a), false);
+  });
+
+  test('invalidate aborts and revokes ownership without starting a request', () => {
+    const t = new LatestRequestTracker();
+    const a = t.start();
+    const before = t.currentGeneration;
+    t.invalidate();
+    assert.equal(a.signal.aborted, true);
+    assert.equal(t.owns(a), false);
+    assert.ok(t.currentGeneration > before);
+  });
