+/**
+ * T-070 — latest-request ownership for the map fetch.
+ *
+ * The defect this exists to prevent, reproduced in production during T-069
+ * verification: a slow `area=all` request landed *after* an in-page filter
+ * change to `area=glyfada` had already resolved, and its `.then` replaced 76
+ * Glyfada markers with 2000 all-area markers while the URL and the active
+ * filter still read Glyfada. Every asynchronous write path in the map fetch
+ * (`.then`, `.catch`, `.finally`) was unguarded.
+ *
+ * Two layers, deliberately:
+ *
+ *  1. `AbortController` — best-effort network cancellation and resource
+ *     cleanup. It is NOT the correctness guarantee: an abort can land too
+ *     late, a response can already be in flight through the parse step, and
+ *     transports do not all stop identically.
+ *  2. A monotonically increasing **generation token** — this *is* the
+ *     correctness guarantee. Ownership is assigned when the request starts
+ *     and re-checked after every asynchronous boundary.
+ *
+ * Ownership is never inferred by comparing a response against current state
+ * after the fact: two different requests can legitimately produce identical
+ * looking data (the production case had both counts land in the same
+ * `51_plus` bucket, which is exactly why the stale response stayed invisible
+ * to an analytics-only check).
+ */
+
+export interface RequestHandle {
+  /** Monotonic token identifying this request. */
+  readonly generation: number;
+  /** Signal to hand to `fetch`; aborted when this request is superseded. */
+  readonly signal: AbortSignal;
+}
+
+/**
+ * Tracks which map request is currently authoritative.
+ *
+ * Plain class, no React: the ownership rules are the part worth testing, and
+ * they are testable here without a DOM, a component or a timer.
+ */
+export class LatestRequestTracker {
+  private generation = 0;
+  private controller: AbortController | null = null;
+
+  /**
+   * Supersedes any in-flight request and claims ownership for a new one.
+   * Aborting first means the previous request's own ownership check fails
+   * immediately, even before its generation is compared.
+   */
+  start(): RequestHandle {
+    this.controller?.abort();
+    const controller = new AbortController();
+    this.controller = controller;
+    this.generation += 1;
+    return { generation: this.generation, signal: controller.signal };
+  }
+
+  /**
+   * True only if `handle` is still the authoritative request.
+   *
+   * Must be called after *every* await/then boundary — including inside
+   * `catch` and `finally`. A stale request reaching `finally` and clearing
+   * `loading` would otherwise terminate the loading state of a newer request
+   * that is still running.
+   */
+  owns(handle: RequestHandle): boolean {
+    if (handle.signal.aborted) return false;
+    return handle.generation === this.generation;
+  }
+
+  /**
+   * Invalidates all in-flight requests without starting a new one — used on
+   * unmount, so nothing can write state after the component is gone.
+   */
+  invalidate(): void {
+    this.controller?.abort();
+    this.controller = null;
+    this.generation += 1;
+  }
+
+  /** Current generation. Exposed for assertions and debugging only. */
+  get currentGeneration(): number {
+    return this.generation;
+  }
+}
+
+/**
+ * True when a rejection is an abort rather than a real failure.
+ *
+ * An abort is a normal consequence of superseding a request and must never
+ * surface as an application error, a Retry prompt, or console noise. Checks
+ * both the DOMException name and the signal, since runtimes differ in what
+ * they reject an aborted fetch with.
+ */
+export function isAbortError(error: unknown, signal?: AbortSignal): boolean {
+  if (signal?.aborted) return true;
+  if (typeof error === 'object' && error !== null && 'name' in error) {
+    return (error as { name?: unknown }).name === 'AbortError';
+  }
+  return false;
+}
