+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const frontendRoot = path.join(here, '..', '..', '..', '..');
+const source = fs.readFileSync(path.join(here, 'SalonDetailClient.tsx'), 'utf-8');
+const contactSource = fs.readFileSync(path.join(frontendRoot, 'components', 'ContactButtons.tsx'), 'utf-8');
+
+function codeOnly(src: string): string {
+  return src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '');
+}
+
+function readMessages(locale: string): any {
+  return JSON.parse(fs.readFileSync(path.join(frontendRoot, 'messages', `${locale}.json`), 'utf-8'));
+}
+
+const LOCALES = ['el', 'en', 'ru', 'uk'];
+
+describe('T-066: hard-coded photo-count text — fixed', () => {
+  test('the literal Greek string φωτογραφίες no longer appears anywhere in code (comments/JSDoc stripped first)', () => {
+    assert.ok(!codeOnly(source).includes('φωτογραφίες'));
+  });
+
+  test('the more-photos button uses a localization key with dynamic count, not a concatenated string', () => {
+    assert.ok(source.includes("t('more_photos', { count: salon.photos.length - 3 })"));
+  });
+
+  test('more_photos is defined with correct ICU plural categories in all 4 locales', () => {
+    for (const locale of LOCALES) {
+      const value = readMessages(locale).salon.more_photos;
+      assert.ok(typeof value === 'string' && value.includes('plural'), `${locale}.salon.more_photos must use ICU plural syntax`);
+      assert.ok(value.includes('one {') && value.includes('other {'), `${locale}.salon.more_photos missing one/other categories`);
+    }
+  });
+
+  test('Russian and Ukrainian more_photos additionally define few/many categories (matching the established search.results_summary precedent)', () => {
+    for (const locale of ['ru', 'uk']) {
+      const value = readMessages(locale).salon.more_photos;
+      assert.ok(value.includes('few {') && value.includes('many {'), `${locale}.salon.more_photos missing few/many categories`);
+    }
+  });
+
+  test('no English fallback leakage: el/ru/uk more_photos are not copies of the English string', () => {
+    const en = readMessages('en').salon.more_photos;
+    for (const locale of ['el', 'ru', 'uk']) {
+      assert.notEqual(readMessages(locale).salon.more_photos, en);
+    }
+  });
+
+  test('the button accessible name (aria-label) uses the same localized, pluralized text as the visible label', () => {
+    const btnBlock = source.slice(source.indexOf('{i === 2 && salon.photos.length > 3'), source.indexOf('{i === 2 && salon.photos.length > 3') + 500);
+    const ariaCount = (btnBlock.match(/t\('more_photos', \{ count: salon\.photos\.length - 3 \}\)/g) || []).length;
+    assert.equal(ariaCount, 2, 'both aria-label and the visible text must use the same t() call');
+  });
+
+  test('existing click-to-reveal behaviour (setShowAllPhotos) is unchanged', () => {
+    assert.ok(source.includes('onClick={() => setShowAllPhotos(true)}'));
+  });
+
+  test('no new lightbox/carousel behaviour was added alongside the fix', () => {
+    assert.ok(!/lightbox|carousel|swiper/i.test(source));
+  });
+});
+
+describe('T-066: gallery — fallback contract reused from T-065, per-image failure handling', () => {
+  test('a shared GalleryImage component tracks per-photo load failure, converging on the same PhotoFallback used for a missing URL', () => {
+    assert.ok(source.includes('function GalleryImage('));
+    assert.ok(source.includes('const [failed, setFailed] = useState(false);'));
+    assert.ok(source.includes('if (failed) return <PhotoFallback'));
+    assert.ok(source.includes('onError={() => setFailed(true)}'));
+  });
+
+  test('PhotoFallback is decorative (Building2 icon, aria-hidden by Icon default), not an emoji, not category-specific', () => {
+    const fallbackFn = source.slice(source.indexOf('function PhotoFallback('), source.indexOf('function GalleryImage('));
+    assert.ok(fallbackFn.includes('<Icon icon={Building2}'));
+    assert.ok(!/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u.test(codeOnly(fallbackFn)));
+    assert.ok(!fallbackFn.includes('decorative={false}'));
+  });
