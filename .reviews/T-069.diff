@@ -0,0 +1,57 @@
+/**
+ * T-069 — decides whether the map's result state is *resolved* enough to be
+ * worth reporting as a `search_results_view`.
+ *
+ * The defect this exists to prevent: `mapLoading` is initialised to `false`,
+ * and although the fetch effect is declared before the tracking effect, the
+ * `setMapLoading(true)` it performs does not change the value already captured
+ * in the current render's closure. So on the very first map render the tracking
+ * effect saw `mapLoading === false` with `mapSalons === []` and reported
+ * `result_count_bucket: "0"` — a "zero results" view that was never a real
+ * user-visible state, the request had simply not started yet.
+ *
+ * That false zero then caused a second, real report to be sent immediately
+ * afterwards, and (because T-058's dedup store holds one material key per
+ * history entry) overwrote the dedup key so both fired again on Back.
+ *
+ * "Not loading" is therefore not the same as "resolved". Resolution is tracked
+ * explicitly: a request must have *settled* before any bucket — including a
+ * genuine `"0"` — may be reported.
+ */
+
+export interface MapResultsState {
+  /** A fetch is currently in flight. */
+  loading: boolean;
+  /** The most recent fetch failed. */
+  error: boolean;
+  /**
+   * A fetch has settled successfully since the last time the query inputs
+   * changed. False before the first fetch starts, and false again as soon as a
+   * new fetch is initiated for new inputs.
+   */
+  resolved: boolean;
+}
+
+/**
+ * True only when the map's result count reflects a completed request and is
+ * therefore safe to report.
+ *
+ * Deliberately requires `resolved` rather than inferring it from `!loading`:
+ * the whole defect was that `!loading` is true both before a request starts
+ * and after it finishes, and those two states are indistinguishable from the
+ * count alone (both can present as an empty array).
+ */
+export function isMapResultStateReportable(state: MapResultsState): boolean {
+  if (state.loading) return false;
+  if (state.error) return false;
+  return state.resolved;
+}
+
+/**
+ * True when an empty map result may legitimately be reported as `"0"` — i.e.
+ * the system actually knows the completed request matched nothing, rather than
+ * merely not having an answer yet.
+ */
+export function isGenuineEmptyMapResult(state: MapResultsState, count: number): boolean {
+  return isMapResultStateReportable(state) && count === 0;
+}
