+    // file was wrong. What matters is that T-069 added no event to this page.
+    const names = [...codeOnly.matchAll(/trackEvent\('([a-z_]+)'/g)].map(m => m[1]).sort();
+    assert.deepEqual(names, ['area_select', 'search_results_view', 'search_results_view']);
+  });
+
+  test('salon_open and contact_action owners are untouched by T-069', () => {
+    const card = readFileSync('components/SalonCard.tsx', 'utf8');
+    const map = readFileSync('components/MapView.tsx', 'utf8');
+    assert.ok(/trackEvent\('salon_open'/.test(card), 'SalonCard still owns its salon_open');
+    assert.ok(/source: 'search_map'/.test(map), "MapView still owns its search_map salon_open");
+    for (const src of [card, map]) {
+      assert.ok(!/mapResolved|isMapResultStateReportable/.test(src), 'T-069 state must not leak into event owners');
+    }
+  });
+
+  test('consent gating is still delegated to trackEvent, not re-implemented here', () => {
+    assert.ok(!/getAnalyticsConsent/.test(codeOnly), 'the page must not gate consent itself');
+  });
+});
