+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  isMapResultStateReportable,
+  isGenuineEmptyMapResult,
+  type MapResultsState,
+} from './mapResultsResolution';
+
+const st = (o: Partial<MapResultsState> = {}): MapResultsState => ({
+  loading: false, error: false, resolved: false, ...o,
+});
+
+describe('T-069: only a resolved map result state is reportable', () => {
+  test('the pre-request state is NOT reportable — this is the defect being fixed', () => {
+    // mapLoading is initialised false, so the very first map render presented
+    // as "not loading, zero results" before the fetch had even started.
+    assert.equal(isMapResultStateReportable(st({ loading: false, resolved: false })), false);
+  });
+
+  test('an in-flight request is not reportable', () => {
+    assert.equal(isMapResultStateReportable(st({ loading: true, resolved: false })), false);
+    assert.equal(isMapResultStateReportable(st({ loading: true, resolved: true })), false);
+  });
+
+  test('a failed request is not reportable', () => {
+    assert.equal(isMapResultStateReportable(st({ error: true, resolved: true })), false);
+  });
+
+  test('a settled successful request IS reportable', () => {
+    assert.equal(isMapResultStateReportable(st({ resolved: true })), true);
+  });
+
+  test('"not loading" alone is never sufficient', () => {
+    // The whole bug: !loading is true both before a request starts and after it
+    // finishes, and an empty array looks identical in both.
+    assert.equal(isMapResultStateReportable(st({ loading: false })), false);
+  });
+});
+
+describe('T-069: a zero bucket requires a genuinely empty resolved result', () => {
+  test('unresolved emptiness is not a real zero', () => {
+    assert.equal(isGenuineEmptyMapResult(st({ resolved: false }), 0), false);
+  });
+
+  test('loading emptiness is not a real zero', () => {
+    assert.equal(isGenuineEmptyMapResult(st({ loading: true }), 0), false);
+  });
+
+  test('a completed request that matched nothing IS a real zero', () => {
+    assert.equal(isGenuineEmptyMapResult(st({ resolved: true }), 0), true);
+  });
+
+  test('a resolved non-empty result is not a zero', () => {
+    assert.equal(isGenuineEmptyMapResult(st({ resolved: true }), 2000), false);
+  });
+
+  test('an errored empty result is not reported as a zero', () => {
+    assert.equal(isGenuineEmptyMapResult(st({ error: true, resolved: true }), 0), false);
+  });
+});
+
+describe('T-069: full lifecycle — slow map API produces no transient zero', () => {
+  test('a slow request emits nothing until it settles, then exactly one reportable state', () => {
+    // Replays the real production sequence that produced the false zero.
+    const sequence: Array<{ label: string; state: MapResultsState; count: number }> = [
+      { label: 'map view selected, fetch not yet started', state: st(), count: 0 },
+      { label: 'fetch in flight', state: st({ loading: true }), count: 0 },
+      { label: 'fetch settled with 2000 salons', state: st({ resolved: true }), count: 2000 },
+    ];
+    const reportable = sequence.filter(s => isMapResultStateReportable(s.state));
+    assert.equal(reportable.length, 1, `expected exactly one reportable state, got ${reportable.map(r => r.label).join(', ')}`);
+    assert.equal(reportable[0].count, 2000, 'the reportable state must be the settled one');
+  });
+
+  test('a new request invalidates a previous resolution, so stale counts are not re-reported', () => {
+    // Filter change: resolved goes back to false while the new fetch runs.
+    assert.equal(isMapResultStateReportable(st({ resolved: true })), true);
+    assert.equal(isMapResultStateReportable(st({ loading: true, resolved: false })), false);
+  });
+
+  test('a retry after an error stays unreportable until it succeeds', () => {
+    assert.equal(isMapResultStateReportable(st({ error: true })), false);
+    assert.equal(isMapResultStateReportable(st({ loading: true })), false);
+    assert.equal(isMapResultStateReportable(st({ resolved: true })), true);
+  });
+});
+
